{
  "format": 1,
  "name": "tutorial_shutdown",
  "spec": ["tutorial 4.3", "tutorial 8.7"],
  "description": "TU5: a tutorial running with a window and a cheat manager. Shutdown unregisters the cheat and its handler first (whether or not Init registered anything: the cISC4App slot 21 test is not repeated), then closes the window, drops both references and clears +0x40, then unsubscribes the three messages in the order 0xAA3840E6, 0xEA8AE29A, 0x26C63343. IsTutorial is left at 1. A pre-save posted afterwards does nothing.",
  "steps": [
    {"op": "tut_env", "cheats": true, "registry_result": true},
    {"op": "tut_create"},
    {"op": "tut_read", "hex": "02000100000000a3d302cc", "expect": true},
    {"op": "tut_call", "method": "init", "expect": true},
    {"op": "tut_expect_events", "events": [
      {"event": "subscribe", "type": "0xEA8AE29A"},
      {"event": "subscribe", "type": "0xAA3840E6"},
      {"event": "subscribe", "type": "0x26C63343"},
      {"event": "register_cheat"}
    ]},
    {"op": "tut_call", "method": "start_tutorial", "expect": true},
    {"op": "tut_expect", "state": {"is_tutorial": 1, "window": true, "window_refs": 2, "end_pending": false}},
    {"op": "tut_clear_events"},
    {"op": "tut_call", "method": "shutdown", "expect": true},
    {"op": "tut_expect_events", "events": [
      {"event": "unregister_cheat"},
      {"event": "close_window"},
      {"event": "unsubscribe", "type": "0xAA3840E6"},
      {"event": "unsubscribe", "type": "0xEA8AE29A"},
      {"event": "unsubscribe", "type": "0x26C63343"}
    ]},
    {"op": "tut_expect", "state": {"is_tutorial": 1, "window": false, "window_refs": 0, "end_pending": false}},
    {"op": "tut_message", "type": "PreSave", "expect": true},
    {"op": "tut_expect_events", "events": []},
    {"op": "tut_expect", "state": {"is_tutorial": 1, "window": false, "window_refs": 0}}
  ]
}
