{
  "format": 1,
  "name": "power_lifecycle",
  "spec": ["power 4.1", "power 4.2", "power 4.3", "power 6", "power 15.21"],
  "description": "Test 21, from 4.1-4.3 and 6: a new city's Init acquires the services, reads the tuning (ordinance factor 0x0911E117 index 0), registers the agent at levels 6, 4, 10 with flags 2, sets the queue length 2 of the nine per-type history IDs, subscribes to the ten messages in order, creates the powered grid (instance 0x49D5BC86, tract size 1, all 0), sets state 4 and, with no department 0x8910BC8A in the budget, creates it (group 0x4A357EAF), names it (0x6A3FF01C, 0x4A493980), sets its max funding to the tuning's 120 x 0.01f = 1.1999999 (0x3F999999, section 8, PW8), creates line item 1 (not locally funded) and names it 0x2A75F757. A second Init registers nothing again (initialized and running are set) and, holding a department, does not look it up (4.1 step 1, PW11: no GetDepartmentBudget call). DoIdle before ConnectionsReady does nothing even with a pending recompute; after it, one call moves 4 -> 0. Every message returns true. Shutdown releases the department, unsubscribes, removes the agent and drops the grid; a second Shutdown does nothing. With a department already in the budget, Init takes it (AddRef) and creates none.",
  "steps": [
    {"op": "power_create"},
    {"op": "power_expect", "state": {"initialized": false, "running": false, "enabled": false, "state": 0, "factor": 1.0, "has_grid": false}},
    {"op": "power_init", "expect": true},
    {"op": "power_expect_events", "events": [
      {"event": "acquire_services"},
      {"event": "factor", "id": "0x0911E117", "index": 0},
      {"event": "add_agent", "level": 6, "name": "cSC4PowerSimulator", "flags": 2},
      {"event": "add_agent", "level": 4, "name": "cSC4PowerSimulator", "flags": 2},
      {"event": "add_agent", "level": 10, "name": "cSC4PowerSimulator", "flags": 2},
      {"event": "history_queue", "series": "0xAA120D5E", "length": 2},
      {"event": "history_queue", "series": "0xAA120D61", "length": 2},
      {"event": "history_queue", "series": "0xAA120D63", "length": 2},
      {"event": "history_queue", "series": "0xAA120D65", "length": 2},
      {"event": "history_queue", "series": "0xAA120D66", "length": 2},
      {"event": "history_queue", "series": "0xAA120D68", "length": 2},
      {"event": "history_queue", "series": "0xAA120D6A", "length": 2},
      {"event": "history_queue", "series": "0xAA120D6B", "length": 2},
      {"event": "history_queue", "series": "0xAA120D6D", "length": 2},
      {"event": "subscribe", "types": ["0x99EF1142", "0x99EF1143", "0x07699455", "0xCA1B151C", "0x278E6003",
        "0xC2C09554", "0xE8BDA2E7", "0xEA418D8F", "0x6AC284F3", "0x26D31EC1"]},
      {"event": "create_grid", "instance": "0x49D5BC86", "size": 1},
      {"event": "create_department", "id": "0x8910BC8A", "group": "0x4A357EAF"},
      {"event": "department_name", "department": "0x8910BC8A", "group": "0x6A3FF01C", "instance": "0x4A493980"},
      {"event": "max_funding", "department": "0x8910BC8A", "value": 1.2, "bits": "0x3F999999"},
      {"event": "create_line_item", "department": "0x8910BC8A", "line": 1, "local": false},
      {"event": "line_item_name", "item": ["0x8910BC8A", 1], "group": "0x6A3FF01C", "instance": "0x2A75F757"}]},
    {"op": "power_expect", "state": {"initialized": true, "running": true, "enabled": false, "state": 4,
      "recompute": false, "age_plants": false, "unused_flag": 0, "map_size": [256, 256], "bitmap_words": 2048,
      "has_grid": true, "radius": 2, "max_funding": 1.2, "max_funding_bits": "0x3F999999"}},
    {"op": "power_expect_grid", "exists": true, "instance": "0x49D5BC86", "tract_size": 1, "counts": [256, 256], "others": 0},
    {"op": "power_expect_world", "departments": ["0x8910BC8A"],
      "line_items": [{"department": "0x8910BC8A", "line": 1, "exists": true, "expenses": 0, "secondary": 0}]},
    {"op": "power_expect_world", "department_lookups": {"0x8910BC8A": 1}},
    {"op": "power_expect_refs", "refs": {"0x10001": 1}},

    {"op": "power_clear_events"},
    {"op": "power_init", "expect": true},
    {"op": "power_expect_world", "department_lookups": {"0x8910BC8A": 0}},
    {"op": "power_expect_events", "events": [{"event": "acquire_services"}]},
    {"op": "power_expect_refs", "refs": {"0x10001": 1}},

    {"op": "power_set", "state": {"recompute": true}},
    {"op": "power_idle", "count": 3, "expect_state": 4},
    {"op": "power_message", "type": "SimIdle", "expect": true},
    {"op": "power_message", "type": "SimNewDay", "expect": true},
    {"op": "power_expect", "state": {"state": 4, "recompute": true}},
    {"op": "power_message", "type": "ConnectionsReady", "expect": true},
    {"op": "power_expect", "state": {"enabled": true}},
    {"op": "power_message", "type": "SimIdle", "expect": true},
    {"op": "power_expect", "state": {"state": 0, "recompute": false}},
    {"op": "power_message", "type": "0x12345678", "expect": true},
    {"op": "power_clear_events"},

    {"op": "power_shutdown", "expect": true},
    {"op": "power_expect_events", "events": [
      {"event": "release_services"},
      {"event": "unsubscribe", "types": ["0x99EF1142", "0x99EF1143", "0x07699455", "0xCA1B151C", "0x278E6003",
        "0xC2C09554", "0xE8BDA2E7", "0xEA418D8F", "0x6AC284F3", "0x26D31EC1"]},
      {"event": "remove_agent"}]},
    {"op": "power_expect", "state": {"initialized": false, "running": false, "has_grid": false, "map_size": [0, 0], "department": null}},
    {"op": "power_expect_refs", "refs": {"0x10001": 0}},
    {"op": "power_shutdown", "expect": true},
    {"op": "power_expect_event_count", "count": 0},

    {"op": "power_create"},
    {"op": "power_init", "expect": true},
    {"op": "power_expect_event_count", "filter": {"event": "create_department"}, "count": 0},
    {"op": "power_expect_world", "departments": ["0x8910BC8A"]},
    {"op": "power_expect_refs", "refs": {"0x10001": 1}}
  ]
}
