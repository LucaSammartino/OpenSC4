{
  "format": 1,
  "name": "flora_daily_burnt_removal",
  "spec": ["flora 6.8", "flora 6.9", "flora 7"],
  "description": "Derived by hand from flora 6.8 and 7 (tests 9 and 10 of 16). Each day: burnAccumulator += burnRate; if >= 1: -= 1 and burntRemovalAccumulator += burntRemovalStep; if that is >= 1: n = floor, subtract n, pop and remove (RemoveOccupant, then release the list's reference) up to n burnt trees, oldest first. Shipped (rate 1/1 = 1, step 1): one tree a day; the five trees killed in order 1..5 go on days 1..5 and day 6 removes nothing. Code defaults (no tuning exemplar: rate 1, step 4): four on day 1, the fifth on day 2. Tuning (4, 2.5): rate 0.25, so the first accumulator reaches 1 on day 4 (0.25, 0.5, 0.75, 1.0): step 2.5 -> two trees removed, 0.5 left; day 8: 0.5 + 2.5 = 3.0 -> three trees, 0 left. Test 10, tuning 0xC9DBDD00 = 0.5 (rate 2), step 1: after days 1, 2, 3 the first accumulator is 1, 2, 3 (it gains 2 and loses 1 a day, quirk) and exactly one tree is removed each day. Each burnt tree holds two references (the occupant manager's and the list's) until the removal drops both.",
  "steps": [
    {"op": "flora_types", "types": [{"type": "0x29CFF3CB", "never_auto": true}, {"type": "0x1000", "table": 0.6}]},
    {"op": "flora_env", "occupants": [
      {"id": 1, "type": "flora", "pos": [100, 260, 100], "flora_type": "0x1000", "state": 1},
      {"id": 2, "type": "flora", "pos": [120, 260, 100], "flora_type": "0x1000", "state": 1},
      {"id": 3, "type": "flora", "pos": [140, 260, 100], "flora_type": "0x1000", "state": 1},
      {"id": 4, "type": "flora", "pos": [160, 260, 100], "flora_type": "0x1000", "state": 1},
      {"id": 5, "type": "flora", "pos": [180, 260, 100], "flora_type": "0x1000", "state": 1}]},
    {"op": "flora_create"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_call", "method": "kill", "args": [1], "expect": true},
    {"op": "flora_call", "method": "kill", "args": [2], "expect": true},
    {"op": "flora_call", "method": "kill", "args": [3], "expect": true},
    {"op": "flora_call", "method": "kill", "args": [4], "expect": true},
    {"op": "flora_call", "method": "kill", "args": [5], "expect": true},
    {"op": "flora_expect", "state": {"burnt": [1, 2, 3, 4, 5], "burn_rate": 1, "burnt_removal_step": 1}},
    {"op": "flora_expect_refs", "refs": {"1": 2, "5": 2}},
    {"op": "flora_clear_events"},
    {"op": "flora_days", "count": 1},
    {"op": "flora_expect_events", "events": [{"event": "remove", "occupant": 1}]},
    {"op": "flora_expect", "state": {"burnt": [2, 3, 4, 5], "burn_accumulator": 0, "burnt_removal_accumulator": 0}},
    {"op": "flora_expect_refs", "refs": {"1": 0, "2": 2}},
    {"op": "flora_expect_occupant", "occupant": 1, "in_manager": false},
    {"op": "flora_days", "count": 4},
    {"op": "flora_expect_events", "events": [{"event": "remove", "occupant": 2}, {"event": "remove", "occupant": 3},
      {"event": "remove", "occupant": 4}, {"event": "remove", "occupant": 5}]},
    {"op": "flora_days", "count": 1},
    {"op": "flora_expect_events", "events": []},
    {"op": "flora_expect", "state": {"burnt": []}},

    {"op": "flora_tuning", "none": true},
    {"op": "flora_env", "occupants": [
      {"id": 11, "type": "flora", "pos": [100, 260, 200], "flora_type": "0x1000", "state": 1},
      {"id": 12, "type": "flora", "pos": [120, 260, 200], "flora_type": "0x1000", "state": 1},
      {"id": 13, "type": "flora", "pos": [140, 260, 200], "flora_type": "0x1000", "state": 1},
      {"id": 14, "type": "flora", "pos": [160, 260, 200], "flora_type": "0x1000", "state": 1},
      {"id": 15, "type": "flora", "pos": [180, 260, 200], "flora_type": "0x1000", "state": 1}]},
    {"op": "flora_create"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_expect", "state": {"burn_rate": 1, "burnt_removal_step": 4}},
    {"op": "flora_call", "method": "kill", "args": [11], "expect": true},
    {"op": "flora_call", "method": "kill", "args": [12], "expect": true},
    {"op": "flora_call", "method": "kill", "args": [13], "expect": true},
    {"op": "flora_call", "method": "kill", "args": [14], "expect": true},
    {"op": "flora_call", "method": "kill", "args": [15], "expect": true},
    {"op": "flora_clear_events"},
    {"op": "flora_days", "count": 1},
    {"op": "flora_expect_events", "events": [{"event": "remove", "occupant": 11}, {"event": "remove", "occupant": 12},
      {"event": "remove", "occupant": 13}, {"event": "remove", "occupant": 14}]},
    {"op": "flora_days", "count": 1},
    {"op": "flora_expect_events", "events": [{"event": "remove", "occupant": 15}]},
    {"op": "flora_expect", "state": {"burnt": [], "burn_accumulator": 0, "burnt_removal_accumulator": 0}},

