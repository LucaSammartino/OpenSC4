    {"op": "flora_create"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_expect", "state": {"burn_rate": 0.25, "burnt_removal_step": 2.5}},
    {"op": "flora_call", "method": "kill", "args": [21], "expect": true},
