    {"op": "flora_clear_events"},
    {"op": "flora_days", "count": 3},
    {"op": "flora_expect_events", "events": []},
    {"op": "flora_expect", "state": {"burn_accumulator": 0.75, "burnt_removal_accumulator": 0}},
    {"op": "flora_days", "count": 1},
    {"op": "flora_expect_events", "events": [{"event": "remove", "occupant": 21}, {"event": "remove", "occupant": 22}]},
    {"op": "flora_expect", "state": {"burn_accumulator": 0, "burnt_removal_accumulator": 0.5}},
    {"op": "flora_days", "count": 3},
    {"op": "flora_expect_events", "events": []},
    {"op": "flora_days", "count": 1},
    {"op": "flora_expect_events", "events": [{"event": "remove", "occupant": 23}, {"event": "remove", "occupant": 24},
