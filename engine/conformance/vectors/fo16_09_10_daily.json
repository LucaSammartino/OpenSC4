    {"op": "flora_env", "occupants": [
      {"id": 31, "type": "flora", "pos": [100, 260, 400], "flora_type": "0x1000", "state": 1},
      {"id": 32, "type": "flora", "pos": [120, 260, 400], "flora_type": "0x1000", "state": 1},
      {"id": 33, "type": "flora", "pos": [140, 260, 400], "flora_type": "0x1000", "state": 1},
      {"id": 34, "type": "flora", "pos": [160, 260, 400], "flora_type": "0x1000", "state": 1}]},
    {"op": "flora_create"},
