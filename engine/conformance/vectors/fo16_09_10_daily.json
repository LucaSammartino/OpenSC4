    {"op": "flora_expect", "state": {"burn_rate": 2, "burnt_removal_step": 1}},
    {"op": "flora_call", "method": "kill", "args": [31], "expect": true},
    {"op": "flora_call", "method": "kill", "args": [32], "expect": true},
    {"op": "flora_call", "method": "kill", "args": [33], "expect": true},
    {"op": "flora_call", "method": "kill", "args": [34], "expect": true},
    {"op": "flora_clear_events"},
    {"op": "flora_days", "count": 1},
    {"op": "flora_expect_events", "events": [{"event": "remove", "occupant": 31}]},
    {"op": "flora_expect", "state": {"burn_accumulator": 1, "burnt_removal_accumulator": 0}},
    {"op": "flora_days", "count": 1},
