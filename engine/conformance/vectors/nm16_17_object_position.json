{
  "format": 1,
  "name": "net_object_position",
  "spec": ["network-manager 8.6", "network-manager 16.17"],
  "description": "Cell (10, 20) (x0 = 160, z0 = 320), offsets (3, 0.5, 5), o = 2, rotation 1, not flipped: x = x0 + oz = 165, z = z0 + 16 - ox = 333, orientation (2 + 1) & 3 = 3, y = altitude(165, 333) + 0.5 = 7.5 on flat terrain at 7. Flipped: x = 16 - 2 (x - x0) + x = 171, orientation -(2 + 1) mod 4 = 1, y still taken before the mirror. Rotations 0, 2, 3 and an out-of-range rotation (0, 0).",
  "steps": [
    {"op": "net_env", "terrain": 7.0},
    {"op": "net_call", "method": "object_position", "args": [[10, 20], 1, false, 2, [3, 0.5, 5]],
      "expect": {"pos": [165, 7.5, 333], "orientation": 3}},
    {"op": "net_call", "method": "object_position", "args": [[10, 20], 1, true, 2, [3, 0.5, 5]],
      "expect": {"pos": [171, 7.5, 333], "orientation": 1}},
    {"op": "net_call", "method": "object_position", "args": [[10, 20], 0, false, 0, [3, 0, 5]],
      "expect": {"pos": [173, 7, 331], "orientation": 0}},
    {"op": "net_call", "method": "object_position", "args": [[10, 20], 2, false, 0, [3, 0, 5]],
      "expect": {"pos": [163, 7, 325], "orientation": 2}},
    {"op": "net_call", "method": "object_position", "args": [[10, 20], 3, false, 3, [3, 0, 5]],
      "expect": {"pos": [171, 7, 323], "orientation": 2}},
    {"op": "net_call", "method": "object_position", "args": [[10, 20], 4, false, 1, [3, 0, 5]],
      "expect": {"pos": [0, 7, 0], "orientation": 1}}
  ]
}
