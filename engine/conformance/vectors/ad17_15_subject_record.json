    {"op": "adv_write", "object": "s", "name": "r2", "expect": true},
    {"op": "adv_expect_record", "name": "r2", "hex": "0400010000C03F0000204005000000060000000100000078563412"},
    {"op": "adv_subject", "name": "t"},
    {"op": "adv_read", "object": "t", "record": "r2", "expect": true},
    {"op": "adv_expect", "object": "t", "state": {"location": [1.5, 2.5], "object": 1, "data1": 5, "data2": 6}},
    {"op": "adv_read", "object": "t", "hex": "0300010000C03F0000204005000000060000000100000078563412", "expect": false, "note": "version 3"}
  ]
