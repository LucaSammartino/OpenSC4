{
  "format": 1,
  "name": "port_developers_growth_failures",
  "spec": ["port-developers 4.5", "port-developers 10"],
  "description": "Growth edge cases. Any of the six airport growth messages grows every triggered port; a seaport ignores them. A port below 96 % of its capacity does not grow. ConstructDefaultLot failing leaves the port on the new lot at its old stage. [quirk] When CreateLot fails the old lot is already demolished: the port keeps its stage and has no lot (section 10 point 8); [choice] the month then skips it (it keeps last month's efficiency, 0.04, so the history value is 4). A port at its last stage does not grow.",
  "steps": [
    {"op": "pd_create", "kind": "airport"},
    {"op": "pd_init"},
    {"op": "pd_lot", "lot": "0x10", "config": ["0xCA2436C0", 1], "x": 3, "z": 4, "rect": [3, 4, 7, 6], "days": 10},
    {"op": "pd_occupant", "occupant": "0x100", "lot": "0x10"},
    {"op": "pd_message", "msg": "0x99EF1142", "data": "0x100"},
    {"op": "pd_env", "offices": [[9599], [0]]},
    {"op": "pd_month"},
    {"op": "pd_clear_events"},
    {"op": "pd_message", "msg": "0x0B3BE81A"},
    {"op": "pd_expect_events", "events": []},
    {"op": "pd_env", "offices": [[9600], [0]], "construct": false},
    {"op": "pd_month"},
    {"op": "pd_clear_events"},
    {"op": "pd_message", "msg": "0x0B3BE81A"},
    {"op": "pd_expect_events", "filter": {"event": "construct"}, "events": [{"event": "construct", "lot": "0x9000"}]},
    {"op": "pd_expect_port", "index": 0, "state": {"stage": 0, "lot": "0x9000", "swapping": true}},
    {"op": "pd_lot", "lot": "0x9000", "state": 1},
    {"op": "pd_env", "create_lot": false, "construct": true},
    {"op": "pd_message", "msg": "0x2B3BE44A"},
    {"op": "pd_expect_events", "filter": {"event": "create_lot"}, "events": [{"event": "create_lot", "lot": null}]},
    {"op": "pd_expect_port", "index": 0, "state": {"stage": 0, "lot": null}},
    {"op": "pd_clear_events"},
    {"op": "pd_month"},
    {"op": "pd_expect", "state": {"month_ran": true, "skipped": 1}},
    {"op": "pd_expect_events", "events": [{"event": "history", "key": "0x6A3E9032", "value": 4}]},

    {"op": "pd_create", "kind": "airport"},
    {"op": "pd_read", "hex": "0200 0100 9D0E27CA 0B00 0100 02000000 0000 0300 0400", "expect": true},
    {"op": "pd_lot", "lot": "0x10", "state": 1},
    {"op": "pd_init"},
    {"op": "pd_set_port", "index": 0, "trips": 40000},
    {"op": "pd_clear_events"},
    {"op": "pd_message", "msg": "0xEA394B74"},
    {"op": "pd_expect_events", "events": []},

    {"op": "pd_create", "kind": "seaport"},
    {"op": "pd_message", "msg": "0xEA394B74", "expect": true},
    {"op": "pd_expect_events", "events": []}
  ]
}
