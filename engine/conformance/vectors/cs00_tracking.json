{
  "format": 1,
  "name": "citysit_tracking",
  "spec": ["city-situation 3", "city-situation 4.2"],
  "description": "AdviceAdded tracks a drivable, untracked candidate (an indicator and a listener) while fewer than max CSI vehicles are tracked; a blocked one (flag 1) is skipped. With max CSI 1 the second advice has no vehicle; an inserted automaton lets it look again once max CSI allows. AdviceRemoved untracks; AdviceRemovedAll is ignored. A removed occupant is dropped and its entry looks for another vehicle; the 'disabled' notifications (0xB, 0xC with data3 0x14) drop it too. PostCityInit re-triggers the advisor's advices only after a load.",
  "steps": [
    {"op": "citysit_create"},
    {"op": "citysit_add_ref", "expect": 1},
    {"op": "citysit_init", "expect": true},
    {"op": "citysit_call", "method": "set_max_csi", "args": [1]},
    {"op": "citysit_advice", "advice": "0x500", "guid": "0x8C151EFD"},
    {"op": "citysit_advice", "advice": "0x501", "guid": 2},
    {"op": "citysit_automaton", "automaton": "0x700"},
    {"op": "citysit_automaton", "automaton": "0x701", "flags": 3},
    {"op": "citysit_automaton", "automaton": "0x702"},
    {"op": "citysit_env", "candidates": {"0x500": ["0x701", "0x700"], "0x501": ["0x700", "0x702"]}},
    {"op": "citysit_clear_events"},
    {"op": "citysit_message", "type": "AdviceAdded", "object": "0x500", "expect": true},
    {"op": "citysit_expect_events", "events": [{"event": "track", "automaton": "0x700", "handle": 1}, {"event": "listen", "automaton": "0x700"}]},
    {"op": "citysit_call", "method": "is_situation_available", "args": ["0x700"], "expect": true},
    {"op": "citysit_message", "type": "AdviceAdded", "object": "0x501", "expect": true},
    {"op": "citysit_expect_events", "events": []},
    {"op": "citysit_expect", "state": {"track_list": [{"advice": "0x500", "automaton": "0x700", "handle": 1}, {"advice": "0x501", "automaton": null, "handle": 0}]}},
    {"op": "citysit_call", "method": "set_max_csi", "args": [5]},
    {"op": "citysit_message", "type": "OccupantInserted", "object": "0x702", "expect": true},
    {"op": "citysit_expect_events", "events": [{"event": "track", "automaton": "0x702", "handle": 2}, {"event": "listen", "automaton": "0x702"}]},
    {"op": "citysit_call", "method": "get_tracked_automata_count", "args": [], "expect": 2},
    {"op": "citysit_message", "type": "AdviceRemoved", "object": "0x500", "expect": true},
    {"op": "citysit_expect_events", "events": [{"event": "untrack", "handle": 1}, {"event": "unlisten", "automaton": "0x700"}]},
    {"op": "citysit_message", "type": "AdviceRemovedAll", "expect": true},
    {"op": "citysit_call", "method": "get_tracked_automata_count", "args": [], "expect": 1},
    {"op": "citysit_message", "type": "OccupantRemoved", "object": "0x702", "expect": true},
    {"op": "citysit_expect_events", "events": [{"event": "untrack", "handle": 2}, {"event": "unlisten", "automaton": "0x702"}, {"event": "track", "automaton": "0x700", "handle": 3}, {"event": "listen", "automaton": "0x700"}]},
    {"op": "citysit_message", "type": "AutomatonNotify", "object": "0x700", "data2": "0xC", "data3": "0x13", "expect": true},
    {"op": "citysit_call", "method": "get_tracked_automata_count", "args": [], "expect": 1},
    {"op": "citysit_env", "candidates": {"0x501": []}},
    {"op": "citysit_message", "type": "AutomatonNotify", "object": "0x700", "data2": "0xC", "data3": "0x14", "expect": true},
    {"op": "citysit_call", "method": "get_tracked_automata_count", "args": [], "expect": 0},
    {"op": "citysit_env", "candidates": {"0x501": ["0x700"]}},
    {"op": "citysit_message", "type": "AutomatonNotify", "object": "0x700", "data2": "0xB", "expect": true},
    {"op": "citysit_message", "type": "PostCityInit", "expect": true},
    {"op": "citysit_call", "method": "get_tracked_automata_count", "args": [], "expect": 0},
    {"op": "citysit_set", "loaded_from_save": true},
    {"op": "citysit_message", "type": "PostCityInit", "expect": true},
    {"op": "citysit_call", "method": "get_tracked_automata_count", "args": [], "expect": 1}
  ]
}
