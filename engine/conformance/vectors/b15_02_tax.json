{
  "format": 1,
  "name": "budget_tax",
  "spec": ["budget 2", "budget 5.2", "budget 6", "budget 15.2"],
  "description": "ComputeTax with the shipped tuning: the tax-type table (all 36 purpose x lot-wealth cells, untaxed cells skipped, [choice] purpose 9 untaxed), a 10,000 building at 9 % paying 90 / 82 / 75 on easy / medium / hard, the waning-wealth multipliers 1 / 0.75 / 0.5 ([choice] 1.0 outside 0..2), the land-value curve applied as roundHalfEven(curve(lv) x sizeX x sizeZ), GetTaxIncome(t) following a rate change at once, and a 1,000-lot total within +-1 of the float64 reference.",
  "steps": [
    {"op": "budget_env", "difficulty": 2},
    {"op": "budget_create"},
    {"op": "budget_init", "tuning": {"0x6A9C7718": [500000, 200000, 100000], "0x890E0A99": 25, "0x090E0A9F": -100000,
      "0x490E0AA6": 5000, "0x090E0AAC": 10, "0x890E0AB4": 200000, "0x8A3FB98D": 8.5, "0x0A3FB9A8": 120,
      "0x0C032488": [9, 9, 9], "0xEBFF69E7": [1.2, 1.1, 1.0], "0x8A480DF7": [1, 0.75, 0.5], "0x4AC519B8": [0, 0, 255, 0]}},

    {"op": "budget_lots", "lots": [{"purpose": 1, "building_wealth": 1, "lot_wealth": 1, "value": 10000}]},
    {"op": "budget_env", "difficulty": 0},
    {"op": "budget_call", "method": "compute_tax", "expect": 90},
    {"op": "budget_env", "difficulty": 1},
    {"op": "budget_call", "method": "compute_tax", "expect": 82},
    {"op": "budget_env", "difficulty": 2},
    {"op": "budget_call", "method": "compute_tax", "expect": 75},
    {"op": "budget_expect", "state": {"tax": {"0": {"weighted_assessed": 10000, "monthly_tax": 75}}}},
    {"op": "budget_call", "method": "tax_income_for", "args": [0], "expect": 75},
    {"op": "budget_call", "method": "set_tax_rate", "args": [0, 12], "expect": true},
    {"op": "budget_call", "method": "tax_income_for", "args": [0], "expect": 100, "note": "current rate x last month's assessed value"},
    {"op": "budget_call", "method": "tax_income_for", "args": [12], "expect": 0},
    {"op": "budget_call", "method": "set_tax_rate", "args": [12, 5], "expect": false},
    {"op": "budget_call", "method": "set_tax_rate", "args": [0, 9]},

    {"op": "budget_lots", "lots": [
      {"purpose": 0, "lot_wealth": 0, "building_wealth": 0, "value": 1000}, {"purpose": 0, "lot_wealth": 1, "building_wealth": 1, "value": 1000},
      {"purpose": 0, "lot_wealth": 2, "building_wealth": 2, "value": 1000}, {"purpose": 0, "lot_wealth": 3, "building_wealth": 3, "value": 1000},
      {"purpose": 1, "lot_wealth": 0, "building_wealth": 0, "value": 1000}, {"purpose": 1, "lot_wealth": 1, "building_wealth": 1, "value": 1000},
      {"purpose": 1, "lot_wealth": 2, "building_wealth": 2, "value": 1000}, {"purpose": 1, "lot_wealth": 3, "building_wealth": 3, "value": 1000},
      {"purpose": 2, "lot_wealth": 0, "building_wealth": 0, "value": 1000}, {"purpose": 2, "lot_wealth": 1, "building_wealth": 1, "value": 1000},
      {"purpose": 2, "lot_wealth": 2, "building_wealth": 2, "value": 1000}, {"purpose": 2, "lot_wealth": 3, "building_wealth": 3, "value": 1000},
      {"purpose": 3, "lot_wealth": 0, "building_wealth": 0, "value": 1000}, {"purpose": 3, "lot_wealth": 1, "building_wealth": 1, "value": 1000},
      {"purpose": 3, "lot_wealth": 2, "building_wealth": 2, "value": 1000}, {"purpose": 3, "lot_wealth": 3, "building_wealth": 3, "value": 1000},
      {"purpose": 4, "lot_wealth": 0, "building_wealth": 0, "value": 1000}, {"purpose": 4, "lot_wealth": 1, "building_wealth": 1, "value": 1000},
      {"purpose": 4, "lot_wealth": 2, "building_wealth": 2, "value": 1000}, {"purpose": 4, "lot_wealth": 3, "building_wealth": 3, "value": 1000},
      {"purpose": 5, "lot_wealth": 0, "building_wealth": 0, "value": 1000}, {"purpose": 5, "lot_wealth": 1, "building_wealth": 1, "value": 1000},
      {"purpose": 5, "lot_wealth": 2, "building_wealth": 2, "value": 1000}, {"purpose": 5, "lot_wealth": 3, "building_wealth": 3, "value": 1000},
      {"purpose": 6, "lot_wealth": 0, "building_wealth": 0, "value": 1000}, {"purpose": 6, "lot_wealth": 1, "building_wealth": 1, "value": 1000},
      {"purpose": 6, "lot_wealth": 2, "building_wealth": 2, "value": 1000}, {"purpose": 6, "lot_wealth": 3, "building_wealth": 3, "value": 1000},
      {"purpose": 7, "lot_wealth": 0, "building_wealth": 0, "value": 1000}, {"purpose": 7, "lot_wealth": 1, "building_wealth": 1, "value": 1000},
      {"purpose": 7, "lot_wealth": 2, "building_wealth": 2, "value": 1000}, {"purpose": 7, "lot_wealth": 3, "building_wealth": 3, "value": 1000},
      {"purpose": 8, "lot_wealth": 0, "building_wealth": 0, "value": 1000}, {"purpose": 8, "lot_wealth": 1, "building_wealth": 1, "value": 1000},
      {"purpose": 8, "lot_wealth": 2, "building_wealth": 2, "value": 1000}, {"purpose": 8, "lot_wealth": 3, "building_wealth": 3, "value": 1000},
      {"purpose": 9, "lot_wealth": 1, "building_wealth": 1, "value": 1000},
      {"purpose": 1, "lot_wealth": 1, "building_wealth": 1, "value": 1000, "has_building": false},
      {"purpose": 1, "lot_wealth": 1, "building_wealth": 1, "value": 1000, "livable": false}
    ]},
    {"op": "budget_call", "method": "compute_tax"},
    {"op": "budget_expect", "state": {"tax": {
      "0": {"weighted_assessed": 1000}, "1": {"weighted_assessed": 1000}, "2": {"weighted_assessed": 1000},
      "3": {"weighted_assessed": 2000}, "4": {"weighted_assessed": 2000}, "5": {"weighted_assessed": 2000},
      "6": {"weighted_assessed": 1000}, "7": {"weighted_assessed": 1000},
      "8": {"weighted_assessed": 3000}, "9": {"weighted_assessed": 3000}, "10": {"weighted_assessed": 3000}, "11": {"weighted_assessed": 3000}}}},

    {"op": "budget_lots", "lots": [{"purpose": 1, "building_wealth": 2, "lot_wealth": 1, "value": 10000}]},
    {"op": "budget_call", "method": "compute_tax", "expect": 56, "note": "0.75 x 10,000 at 9 %: 56.25"},
    {"op": "budget_lots", "lots": [{"purpose": 1, "building_wealth": 3, "lot_wealth": 1, "value": 10000}]},
    {"op": "budget_call", "method": "compute_tax", "expect": 37, "note": "0.5 x 10,000: 37.5"},
    {"op": "budget_lots", "lots": [{"purpose": 1, "building_wealth": 1, "lot_wealth": 2, "value": 10000}]},
    {"op": "budget_call", "method": "compute_tax", "expect": 75, "note": "[choice] negative wealth difference: 1.0 (group R$$)"},
    {"op": "budget_expect", "state": {"tax": {"1": {"weighted_assessed": 10000}, "0": {"weighted_assessed": 0}}}},

    {"op": "budget_create"},
    {"op": "budget_init", "tuning": {"0x4AC519B8": [0, 0, 255, 127.5], "0xEBFF69E7": [1.2, 1.1, 1.0]}},
    {"op": "budget_lots", "lots": [{"purpose": 1, "building_wealth": 1, "lot_wealth": 1, "value": 0, "land_value": 1}]},
    {"op": "budget_call", "method": "compute_tax"},
    {"op": "budget_expect", "state": {"tax": {"0": {"weighted_assessed": 0}}}, "note": "curve(1) = 0.5 -> roundHalfEven -> 0"},
    {"op": "budget_lots", "lots": [{"purpose": 1, "building_wealth": 1, "lot_wealth": 1, "value": 0, "land_value": 3}]},
    {"op": "budget_call", "method": "compute_tax"},
    {"op": "budget_expect", "state": {"tax": {"0": {"weighted_assessed": 2}}}, "note": "1.5 -> 2"},
    {"op": "budget_lots", "lots": [{"purpose": 1, "building_wealth": 1, "lot_wealth": 1, "value": 100, "land_value": 100, "size_x": 2, "size_z": 3}]},
    {"op": "budget_call", "method": "compute_tax"},
    {"op": "budget_expect", "state": {"tax": {"0": {"weighted_assessed": 400}}}, "note": "curve(100) = 50 x 6 = 300 + 100"},

    {"op": "budget_create"},
    {"op": "budget_init", "tuning": {"0xEBFF69E7": [1.2, 1.1, 1.0]}},
    {"op": "budget_lots", "lots": [{"purpose": 1, "building_wealth": 1, "lot_wealth": 1, "value": 12345, "repeat": 1000}]},
    {"op": "budget_call", "method": "compute_tax", "expect_min": 92586, "expect_max": 92588,
      "note": "float64 reference: 1000 x 9 x 12345 / 1200 = 92587.5 -> 92587, +-1 per 1000 lots"}
  ]
}
