{
  "format": 1,
  "name": "disaster_short_form",
  "spec": ["disasters 7", "disasters 8", "disasters 9", "disasters 10", "disasters 11"],
  "description": "The short-form disasters run to their ends. An earthquake (one at a time) clamps its epicentre to the city, plays QuakeStart, places a repulsor and begins an episode; it deforms the terrain with brushes 0x11 and 0x12, then ends the long terrain operation, stops the texture updates and ends the episode. A pipe burst needs a watered pipe, leaks once per pipe, bursts after RandomDoubleRange(30, 60) s, waits four ticks and spreads to the connected cells that hold pipes, then ends. The toxic cheat spills at its cell (two spills merge) and Shutdown removes the occupants and unsubscribes the cheat. The volcano (lava enabled by the shipped exemplar) starts its deformation and its lava, which is GetPhase 2 and not active; after T = 50 s of lava (strictly more) it ends the episode and waits in state 3 (phase 1) until asked to end, which removes it. An effect disaster follows its effect and ends when its effect finishes.",
  "steps": [
    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_clear_events"},
    {"op": "dis_call", "method": "attempt_start", "args": ["earthquake", 500, 9000], "expect": 1},
    {"op": "dis_call", "method": "attempt_start", "args": ["earthquake", 1, 1], "expect": null, "note": "one at a time"},
    {"op": "dis_expect_instance", "instance": 1, "state": {"type": "0x42963812", "location": [31, 63]}},
    {"op": "dis_expect_event_count", "filter": {"event": "effect_at", "name": "QuakeStart"}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "repulsor"}, "min": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "emergency_pause"}, "count": 1},
    {"op": "dis_tick", "instance": 1, "us": 100000, "count": 1000},
    {"op": "dis_expect_instance", "instance": 1, "absent": true},
    {"op": "dis_expect_event_count", "filter": {"event": "brush", "brush": "0x11"}, "min": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "brush", "brush": "0x12"}, "min": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "end_long_terrain"}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "stop_textures"}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "emergency_resume"}, "count": 1},

    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_cell", "cell": [3, 3], "pipe": "0x500", "pipe_neighbours": [[4, 3], [99, 3]]},
    {"op": "dis_cell", "cell": [4, 3], "pipe": "0x501"},
    {"op": "dis_clear_events"},
    {"op": "dis_env", "doubles": [0.0, 0.0], "note": "both burst times at the low bound (the stub's ranges default to 0.99)"},
    {"op": "dis_call", "method": "attempt_start", "args": ["pipe_burst", 9, 9], "expect": null},
    {"op": "dis_call", "method": "attempt_start", "args": ["pipe_burst", 3, 3], "expect": 1},
    {"op": "dis_call", "method": "attempt_start", "args": ["pipe_burst", 3, 3], "expect": null, "note": "already leaks"},
    {"op": "dis_expect_events", "filter": {"event": "post"}, "events": [
      {"event": "post", "type": "0xEA1F0DCD", "data1": 3, "data2": 3},
      {"event": "post", "type": "0xCA1B1E64", "data1": 1, "data4": "0x4A1332E8", "void1": 1}
    ]},
    {"op": "dis_tick", "instance": 1, "us": 30000000},
    {"op": "dis_tick", "instance": 1, "us": 1, "count": 4},
    {"op": "dis_tick", "instance": 1, "us": 30000000},
    {"op": "dis_tick", "instance": 1, "us": 1, "count": 4},
    {"op": "dis_expect_instance", "instance": 1, "absent": true},
    {"op": "dis_expect_events", "filter": {"event": "demolish_pipe"}, "events": [
      {"event": "demolish_pipe", "pipe": "0x500", "flags": "0x302"},
      {"event": "demolish_pipe", "pipe": "0x501", "flags": "0x302"}
    ]},

    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_message", "target": {"manager": "toxic"}, "type": "ToxicSpill", "data1": 5, "data2": 6, "data3": 40, "expect": true},
    {"op": "dis_message", "target": {"manager": "toxic"}, "type": "ToxicSpill", "data1": 5, "data2": 6, "data3": 40, "expect": true},
    {"op": "dis_expect", "state": {"toxic_amounts": [80]}},
    {"op": "dis_clear_events"},
    {"op": "dis_shutdown", "expect": true},
    {"op": "dis_expect", "state": {"toxic_instance": null}},
    {"op": "dis_expect_event_count", "filter": {"event": "remove_toxic"}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "unsubscribe", "target": {"manager": "0xEBFB0404"}, "type": "0x0BFB41BA"}, "count": 1},

    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_clear_events"},
    {"op": "dis_env", "tuning": {"volcano": "shipped"}},
    {"op": "dis_call", "method": "attempt_start", "args": ["volcano", 100, 100], "expect": 1},
    {"op": "dis_call", "method": "attempt_start", "args": ["volcano", 1, 1], "expect": null},
    {"op": "dis_expect_event_count", "filter": {"event": "volcano_deformation"}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "lava", "radius": 100}, "count": 1},
    {"op": "dis_expect_volcano", "instance": 1, "state": {"state": 5, "phase": 2, "lava_flowing": true}},
    {"op": "dis_call", "method": "active_count", "args": ["volcano"], "expect": 0},
    {"op": "dis_tick", "instance": 1, "us": 50000000, "note": "at T the lava still flows"},
    {"op": "dis_expect_event_count", "filter": {"event": "lava_end"}, "count": 0},
    {"op": "dis_tick", "instance": 1, "us": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "lava_end"}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "emergency_resume"}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "post", "type": "0xAA1B2002"}, "count": 1},
    {"op": "dis_expect_volcano", "instance": 1, "state": {"state": 3, "phase": 1, "lava_flowing": false, "lava_has_run": true}},
    {"op": "dis_call", "method": "active_count", "args": ["volcano"], "expect": 1},
    {"op": "dis_call", "method": "volcano_request_end", "args": [1], "expect": true},
    {"op": "dis_expect_instance", "instance": 1, "absent": true},
    {"op": "dis_expect_event_count", "filter": {"event": "lava"}, "count": 1},
    {"op": "dis_env", "tuning": {"volcano": null}},

    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_call", "method": "start_disaster_effect", "args": ["0xE1", 160, 320], "expect": 1},
    {"op": "dis_expect_instance", "instance": 1, "state": {"type": "0x6A7B4397", "phase": 1, "location": [10, 20]}},
    {"op": "dis_call", "method": "is_disaster_ongoing", "expect": true},
    {"op": "dis_message", "target": {"instance": 1}, "type": "EffectMoved", "void1": "0xE1", "x": 32, "z": 48, "expect": true},
    {"op": "dis_expect_instance", "instance": 1, "state": {"location": [2, 3]}},
    {"op": "dis_message", "target": {"instance": 1}, "type": "EffectFinished", "void1": "0xE2", "expect": false},
    {"op": "dis_message", "target": {"instance": 1}, "type": "EffectFinished", "void1": "0xE1", "expect": true},
    {"op": "dis_expect_instance", "instance": 1, "absent": true},
    {"op": "dis_call", "method": "is_disaster_ongoing", "expect": false}
  ]
}
