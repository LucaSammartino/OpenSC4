{
  "format": 1,
  "name": "growth_developer_draw_sequence",
  "spec": ["growth-developer 7", "growth-developer 5.4"],
  "description": "Draw sequence over five developers sharing one file-local generator seeded 12345 (Python LCG model). Each industrial update with purpose 5..8 draws exactly one salt in state 20, even with an empty decline list; R, CS and an industrial-zone developer with purpose 4 draw nothing. Pinned: the draw count and the shared generator's LCG state after each update, and that the salts held by the industrial developers are the drawn values 0x0C63D3DC, 0xFED6A704, 0x6E80D665. Not pinned ([compat-limit], module docs): which industrial developer gets which salt; gdev_expect_salts compares as a multiset.",
  "steps": [
    {"op": "gdev_env", "cells": [16, 16]},
    {"op": "gdev_statics", "seed": 12345},
    {"op": "gdev_create", "label": "ir"},
    {"op": "gdev_init", "dev": "ir", "props": {"0x00000021": {"u32": "0x4100"}, "0x87CD6300": {"u8": 3}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 1}, "0x87CD6332": {"u8": 5}}, "expect": true},
    {"op": "gdev_create", "label": "r"},
    {"op": "gdev_init", "dev": "r", "props": {"0x00000021": {"u32": "0x1010"}, "0x87CD6300": {"u8": 1}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 1}, "0x87CD6332": {"u8": 1}}, "expect": true},
    {"op": "gdev_create", "label": "cs"},
    {"op": "gdev_init", "dev": "cs", "props": {"0x00000021": {"u32": "0x3110"}, "0x87CD6300": {"u8": 2}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 1}, "0x87CD6332": {"u8": 2}}, "expect": true},
    {"op": "gdev_create", "label": "id"},
    {"op": "gdev_init", "dev": "id", "props": {"0x00000021": {"u32": "0x4200"}, "0x87CD6300": {"u8": 3}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 2}, "0x87CD6332": {"u8": 6}}, "expect": true},
    {"op": "gdev_create", "label": "i4"},
    {"op": "gdev_init", "dev": "i4", "props": {"0x00000021": {"u32": "0x4999"}, "0x87CD6300": {"u8": 3}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 2}, "0x87CD6332": {"u8": 4}}, "expect": true},
    {"op": "gdev_update", "dev": "ir"},
    {"op": "gdev_expect", "dev": "ir", "state": {"draws": 1, "rng_lcg": "0xD3DC167E"}},
    {"op": "gdev_expect_salts", "devs": ["ir"], "salts": ["0x0C63D3DC"]},
    {"op": "gdev_update", "dev": "r"},
    {"op": "gdev_update", "dev": "cs"},
    {"op": "gdev_update", "dev": "i4"},
    {"op": "gdev_expect", "dev": "r", "state": {"last_salt": null, "draws": 1, "rng_lcg": "0xD3DC167E"}},
    {"op": "gdev_expect", "dev": "cs", "state": {"last_salt": null, "draws": 1, "rng_lcg": "0xD3DC167E"}},
    {"op": "gdev_expect", "dev": "i4", "state": {"last_salt": null, "draws": 1, "rng_lcg": "0xD3DC167E"}},
    {"op": "gdev_update", "dev": "id"},
    {"op": "gdev_expect", "dev": "id", "state": {"draws": 2, "rng_lcg": "0xA70427DF"}},
    {"op": "gdev_expect_salts", "devs": ["ir", "id"], "salts": ["0x0C63D3DC", "0xFED6A704"]},
    {"op": "gdev_update", "dev": "r"},
    {"op": "gdev_expect", "dev": "r", "state": {"last_salt": null, "draws": 2, "rng_lcg": "0xA70427DF"}},
    {"op": "gdev_update", "dev": "ir"},
    {"op": "gdev_expect", "dev": "ir", "state": {"draws": 3, "rng_lcg": "0xD6651C2C"}},
    {"op": "gdev_expect_salts", "devs": ["ir", "id"], "salts": ["0x0C63D3DC", "0xFED6A704", "0x6E80D665"]}
  ]
}
