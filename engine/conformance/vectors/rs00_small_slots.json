{
  "format": 1,
  "name": "residential_small_slots",
  "spec": ["residential 6.6", "residential 10.1", "REH 4.2", "REH 4.8"],
  "description": "Slot 5 GetProximityMap(w): w 1..3 -> the proximity grid, anything else -> null. Slots 50 / 51 -> 200; 17 / 18 -> 0. Slots 37 / 38 GetCellEQByWealth / GetCellHQByWealth(x, z, w) read tract (x / E, z / E) by unsigned division of the w - 1 grid; [choice] w = 0 or > 3 and a negative x (a huge unsigned cell, out of range) give 0.0. Slots 52-55: the global auto-budget flags, setters return the value. Slots 56 / 57: the occupant's bool property 0x6C05FC4D, default false. Slot 19 in a city without the REH budget items (the default hook) sets the dirty flag and returns true.",
  "steps": [
    {"op": "residential_env", "cells": [8, 8]},
    {"op": "residential_create"},
    {"op": "residential_init", "expect": true},
    {"op": "residential_call", "method": "get_proximity", "args": [0, 0, 0], "expect": null},
    {"op": "residential_call", "method": "get_proximity", "args": [4, 0, 0], "expect": null},
    {"op": "residential_grid_set", "grid": "proximity2", "cells": [[3, 4, 17]]},
    {"op": "residential_call", "method": "get_proximity", "args": [2, 3, 4], "expect": 17},
    {"op": "residential_call", "method": "max_quotient", "expect": 200},
    {"op": "residential_call", "method": "total_city_upkeep_cost", "expect": 0},
    {"op": "residential_tract", "x": 1, "z": 1, "steady": [1, 1, 1], "eq": [1, 2, 3], "hq": [4, 5, 6]},
    {"op": "residential_call", "method": "get_cell_eq_by_wealth", "args": [5, 6, 2], "expect": 2.0},
    {"op": "residential_call", "method": "get_cell_hq_by_wealth", "args": [7, 4, 3], "expect": 6.0},
    {"op": "residential_call", "method": "get_cell_eq_by_wealth", "args": [5, 6, 0], "expect": 0.0},
    {"op": "residential_call", "method": "get_cell_eq_by_wealth", "args": [5, 6, 4], "expect": 0.0},
    {"op": "residential_call", "method": "get_cell_eq_by_wealth", "args": [-4, 6, 2], "expect": 0.0},
    {"op": "residential_call", "method": "get_cell_hq", "args": [4, 4], "expect": 5.0},
    {"op": "residential_call", "method": "global_auto_budget_schools", "expect": false},
    {"op": "residential_call", "method": "set_global_auto_budget_schools", "args": [true], "expect": true},
    {"op": "residential_call", "method": "global_auto_budget_schools", "expect": true},
    {"op": "residential_call", "method": "set_global_auto_budget_hospitals", "args": [false], "expect": false},
    {"op": "residential_call", "method": "global_auto_budget_hospitals", "expect": false},
    {"op": "residential_call", "method": "get_auto_budget", "args": [5], "expect": false},
    {"op": "residential_call", "method": "set_auto_budget", "args": [5, true], "expect": true},
    {"op": "residential_call", "method": "get_auto_budget", "args": [5], "expect": true},
    {"op": "residential_set", "state": {"dirty": false}},
    {"op": "residential_call", "method": "set_occupant_funding", "args": [5, 1.0, 1.0, true], "expect": true},
    {"op": "residential_expect", "state": {"dirty": true}}
  ]
}
