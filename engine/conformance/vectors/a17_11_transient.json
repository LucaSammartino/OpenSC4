    {"op": "aura_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x2A09B21A"}]},
    {"op": "aura_expect_grid", "grid": "transient", "cells": [[1, 1, 5], [4, 1, -5]], "others": 0},
    {"op": "aura_set", "state": {"state": 17}},
    {"op": "aura_clear_events"},
    {"op": "aura_idle", "expect_state": 0},
    {"op": "aura_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x2A09B21A"}]},
    {"op": "aura_expect_grid", "grid": "transient", "cells": [[1, 1, 3], [4, 1, -3]], "others": 0},
    {"op": "aura_set", "state": {"state": 17}},
    {"op": "aura_clear_events"},
    {"op": "aura_idle", "expect_state": 0},
    {"op": "aura_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x2A09B21A"}]},
    {"op": "aura_expect_grid", "grid": "transient", "cells": [[1, 1, 2], [4, 1, -2]], "others": 0},
