{
  "format": 1,
  "name": "om18_06_insert_messages",
  "spec": ["occupant-manager 5.1", "occupant-manager 5.5", "occupant-manager 5.6", "occupant-manager 18.6"],
  "description": "Insert of a new, uninitialised occupant with data4 = 7: Create (data4 0, from its Init) then Insert (data3 = the type, data4 7, flag 1 already set). Flag 1 set, box stored, one reference. A second Insert returns false and posts nothing. An initialised occupant with flag 4 posts only Insert, data2 = true. Insert takes the reference before Init.",
  "steps": [
    {"op": "om_create"},
    {"op": "om_call", "method": "set_city_size", "args": [1024, 1024], "expect": true},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_occupant", "occupant": "0x1", "type": "0x0BEE", "min": [10, 0, 10], "max": [20, 5, 20]},
    {"op": "om_trace", "refs": true},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 7, "expect": true},
    {"op": "om_expect_events", "events": [{"event": "add_ref", "occupant": "0x1"}, {"event": "post", "type": "0x99EF1140", "occupant": "0x1", "data2": false, "data3": "0x0BEE", "data4": 0, "inserted": false}, {"event": "post", "type": "0x99EF1142", "occupant": "0x1", "data2": false, "data3": "0x0BEE", "data4": 7, "inserted": true, "sync": false}]},
    {"op": "om_expect_occupant", "occupant": "0x1", "state": {"flags": 1, "om_box": [64, 64, 64, 64], "initialized": true}},
    {"op": "om_expect_refs", "refs": {"0x1": 1}},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 7, "expect": false},
    {"op": "om_expect_events", "events": []},
    {"op": "om_expect_refs", "refs": {"0x1": 1}},
    {"op": "om_occupant", "occupant": "0x2", "min": [10, 0, 10], "max": [20, 10, 20], "flags": 4, "initialized": true},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "insert", "occupant": "0x2", "data4": 3, "expect": true},
    {"op": "om_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x99EF1142", "occupant": "0x2", "data2": true, "data3": "0x100", "data4": 3}]},
    {"op": "om_expect_cell", "cell": [64, 64], "occupants": ["0x2", "0x1"]}
  ]
}
