{
  "format": 1,
  "name": "power_pole_decay",
  "spec": ["power 7.5", "power 7.6", "power 15.15", "foundations 12.3", "foundations 18"],
  "description": "Test 15, by hand from 7.6 with the shipped pole curve (0,-0.02)(25,-0.005)(50,0)(100,0.025)(110,0.05); products checked in Python/numpy. 100 poles, brokenFraction 0, funding 0 % -> 0 - (-0.02) = 0.02f -> target trunc(100 x 0.02f): the exact 1.99999996 rounds to 2.0 at 24 bits -> 2; the pole list is random_shuffled (99 rand() calls) and the first two non-distressed poles of the shuffled copy become distressed (brokenCount 2). Funding 50 % -> curve 0, fraction unchanged, target equal: no shuffle, no rand(). Funding 100 % -> 0.02 - 0.025 < 0 clamps to 0 -> target 0 -> 99 calls, both repaired. The same through the month with the department's funding (0 then 100 %). 1000 poles -> 1000 x 0.02f = 19.9999996 -> 20.0 -> 20, 999 calls; 50 poles -> 0.99999998 -> 1.0 -> 1, 49 calls.",
  "steps": [
    {"op": "power_env", "pole_set": {"first": 2000, "count": 100, "cost": 1, "origin": [0, 0]}},
    {"op": "power_create"},
    {"op": "power_init"},
    {"op": "power_message", "type": "OccupantInserted", "occupants": {"first": 2000, "count": 100}},
    {"op": "power_expect", "state": {"pole_count": 100, "broken_count": 0, "cost_base": 100}},
    {"op": "power_expect_rand", "calls": 0},
    {"op": "power_call", "method": "apply_pole_funding", "args": [0.0]},
    {"op": "power_expect_rand", "calls": 99},
    {"op": "power_expect", "state": {"broken_fraction": 0.02, "broken_count": 2}},
    {"op": "power_expect_world", "distressed": 2},
    {"op": "power_call", "method": "apply_pole_funding", "args": [0.5]},
    {"op": "power_expect_rand", "calls": 0},
    {"op": "power_expect", "state": {"broken_fraction": 0.02, "broken_count": 2}},
    {"op": "power_call", "method": "apply_pole_funding", "args": [1.0]},
    {"op": "power_expect_rand", "calls": 99},
    {"op": "power_expect", "state": {"broken_fraction": 0.0, "broken_count": 0}},
    {"op": "power_expect_world", "distressed": 0},

    {"op": "power_env", "departments": [{"id": "0x8910BC8A", "funding": 0.0}]},
    {"op": "power_message", "type": "SimNewMonth"},
    {"op": "power_expect_rand", "calls": 99},
    {"op": "power_expect", "state": {"broken_count": 2}},
    {"op": "power_expect_world", "distressed": 2},
    {"op": "power_env", "departments": [{"id": "0x8910BC8A", "funding": 1.0}]},
    {"op": "power_message", "type": "SimNewMonth"},
    {"op": "power_expect_rand", "calls": 99},
    {"op": "power_expect", "state": {"broken_count": 0}},
    {"op": "power_expect_world", "distressed": 0},

    {"op": "power_env", "pole_set": {"first": 3000, "count": 1000, "cost": 1, "origin": [0, 100]}},
    {"op": "power_create"},
    {"op": "power_init"},
    {"op": "power_message", "type": "OccupantInserted", "occupants": {"first": 3000, "count": 1000}},
    {"op": "power_call", "method": "apply_pole_funding", "args": [0.0]},
    {"op": "power_expect_rand", "calls": 999},
    {"op": "power_expect", "state": {"pole_count": 1000, "broken_count": 20}},
    {"op": "power_expect_world", "distressed": 20},

    {"op": "power_env", "pole_set": {"first": 5000, "count": 50, "cost": 1, "origin": [100, 0]}},
    {"op": "power_create"},
    {"op": "power_init"},
    {"op": "power_message", "type": "OccupantInserted", "occupants": {"first": 5000, "count": 50}},
    {"op": "power_call", "method": "apply_pole_funding", "args": [0.0]},
    {"op": "power_expect_rand", "calls": 49},
    {"op": "power_expect", "state": {"pole_count": 50, "broken_count": 1}},
    {"op": "power_expect_world", "distressed": 21}
  ]
}
