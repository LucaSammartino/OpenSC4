    {"op": "lm_cell_mode", "mode": 255, "alpha": 255, "texture_alpha": true, "expect_mode": "alpha"},
    {"op": "lm_cell_mode", "mode": 0, "alpha": 255, "texture_alpha": false, "expect_mode": "tinted"},
    {"op": "lm_cell_mode", "mode": 3, "alpha": 255, "texture_alpha": false, "expect_mode": "tinted"}
  ]
