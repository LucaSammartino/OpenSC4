    {"op": "plumbing_call", "method": "nearest_water", "args": [10, 10, 2, 2], "expect": 0},
    {"op": "plumbing_call", "method": "nearest_water", "args": [10, 10, 0, 5], "expect": 3},
    {"op": "plumbing_call", "method": "nearest_water", "args": [10, 10, 1, 5], "expect": 3},
    {"op": "plumbing_call", "method": "nearest_water", "args": [13, 10, 1, 0], "expect": 0},
    {"op": "plumbing_env", "clear_water": true, "water": [[0, 3]]},
    {"op": "plumbing_call", "method": "nearest_water", "args": [0, 0, 0, 5], "expect": 3},
    {"op": "plumbing_call", "method": "nearest_water", "args": [0, 0, 0, 2], "expect": -1},
    {"op": "plumbing_env", "no_terrain": true},
    {"op": "plumbing_call", "method": "nearest_water", "args": [0, 0, 0, 5], "expect": -1},
    {"op": "plumbing_call", "method": "nearest_water", "args": [0, 0, 1, 5], "expect": -1},
    {"op": "plumbing_call", "method": "nearest_water", "args": [0, 0, 2, 5], "expect": 0}
