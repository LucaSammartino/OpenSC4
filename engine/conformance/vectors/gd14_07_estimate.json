    {"op": "gdev_source", "map": "pollution", "index": 2, "size": 4, "tracts": [[0, 0, -32468]]},
    {"op": "gdev_create", "label": "a"},
    {"op": "gdev_init", "props": {"0x00000021": {"u32": "0x1010"}, "0x87CD6300": {"u8": 1}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 1}, "0x87CD6332": {"u8": 1}, "0x87CD6357": {"i32": 25}, "0x87CD6397": {"f32": [-127, -100, 127, 100]}}, "expect": true},
