    {"op": "gdev_create", "label": "b"},
    {"op": "gdev_init", "props": {"0x00000021": {"u32": "0x1010"}, "0x87CD6300": {"u8": 1}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 1}, "0x87CD6332": {"u8": 1}, "0x87CD6357": {"i32": 25}, "0x87CD6341": {"f32": [-100, -10, 100, 10]}}, "expect": true},
    {"op": "gdev_call", "method": "estimate_desirability", "args": [0, 0], "expect": 29},
