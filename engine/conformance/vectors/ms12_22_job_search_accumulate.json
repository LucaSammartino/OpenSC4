{
  "format": 1,
  "name": "mysim_job_search_accumulate",
  "spec": [
    "mysims 4.7.1"
  ],
  "description": "Destination flags are OR-ed into the dispatch's long-lived pathfinder (quirk): wealth 1 then 3 gives 0x1 then 0x5, flags stay 0x11. Wealth 0 (and anything outside 1-3) maps to 0x1.",
  "steps": [
    {
      "op": "mysim_job_search",
      "home": {
        "rect": [
          10,
          10,
          12,
          11
        ]
      },
      "searches": [
        {
          "wealth": 1,
          "end_cell": [
            5,
            5
          ]
        },
        {
          "wealth": 3,
          "end_cell": [
            5,
            5
          ]
        }
      ],
      "expect": {
        "results": [
          true,
          true
        ],
        "dest_flags": [
          1,
          5
        ],
        "flags": 17,
        "find_path": 2
      }
    },
    {
      "op": "mysim_job_search",
      "home": {
        "rect": [
          10,
          10,
          12,
          11
        ]
      },
      "searches": [
        {
          "wealth": 0,
          "end_cell": [
            5,
            5
          ]
        }
      ],
      "expect": {
        "dest_flags": [
          1
        ]
      }
    },
    {
      "op": "mysim_job_search",
      "home": {
        "rect": [
          10,
          10,
          12,
          11
        ]
      },
      "searches": [
        {
          "wealth": 7,
          "end_cell": [
            5,
            5
          ]
        }
      ],
      "expect": {
        "dest_flags": [
          1
        ]
      }
    }
  ]
}
