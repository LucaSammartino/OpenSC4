      {"id": 3, "type": "sell", "city": 89, "amount": 50}]},
    {"op": "power_set", "wire": [[100, 100]]},
    {"op": "power_clear_events"},
    {"op": "power_call", "method": "update_power_grid", "args": [100, 100]},
    {"op": "power_expect_events", "filter": {"event": "deal_flags"}, "events": [{"event": "deal_flags", "deal": 3, "flags": 32, "on": true}]},
    {"op": "power_expect_world", "deals": {"3": {"used": 0, "flags": 32}}},
    {"op": "power_expect_bitmap", "bitmap": "next", "unset": [[100, 100]]}
  ]
