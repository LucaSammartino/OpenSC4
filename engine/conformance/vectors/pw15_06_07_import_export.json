          "0x8A1E07EE": {"f32": [0, 1, 0.5, 0.92, 1, 0]}}, "budget": {"funding": 1.0, "line": 7}},
        {"id": 52, "type": "building", "cells": [12, 0, 13, 1], "props": {"0x27812854": {"u32": 100}}}],
      "deals": [{"id": 2, "type": "sell", "city": 88, "amount": 400}, {"id": 3, "type": "sell", "city": 89, "amount": 50}],
      "connections": [{"id": 3, "city": 88, "cell": [15, 3]}, {"id": 4, "city": 89, "cell": [100, 100]}]},
    {"op": "power_create"},
    {"op": "power_init"},
    {"op": "power_message", "type": "OccupantInserted", "occupants": [51, 52]},
    {"op": "power_message", "type": "ConnectionsReady"},
    {"op": "power_idle", "count": 2, "expect_state": 1},
    {"op": "power_clear_events"},
    {"op": "power_idle", "count": 1, "expect_state": 2},
    {"op": "power_expect", "state": {"production": 1000, "export": 400, "consumption": 500, "demand": 100}},
    {"op": "power_expect_bitmap", "bitmap": "next", "cells": [[15, 3]]},
    {"op": "power_expect_occupant", "occupant": 51, "props": {"0x08D9763D": 500}},
    {"op": "power_expect_world", "deals": {"2": {"used": 400, "flags": 0}, "3": {"used": 0, "flags": 0}}},
    {"op": "power_clear_events"},
    {"op": "power_idle", "count": 2, "expect_state": 4},
    {"op": "power_expect_event_count", "filter": {"event": "history", "series": "0xAA11F7D2", "value": 100}, "count": 1},
    {"op": "power_expect_event_count", "filter": {"event": "history", "series": "0x4AB2F236", "value": 400}, "count": 1},
    {"op": "power_expect_event_count", "filter": {"event": "deal_flags", "deal": 2}, "count": 0},
    {"op": "power_expect_event_count", "filter": {"event": "deal_flags", "deal": 3, "flags": 32, "on": true}, "count": 1},
    {"op": "power_call", "method": "monthly_export", "expect": 400},

