{
  "format": 1,
  "name": "disaster_unattended_burn_down",
  "spec": ["disasters 5.4", "disasters 5.9", "disasters 5.10", "disasters 18.3"],
  "description": "Coverage 0, maxStage 2 (the default), an ordinary ignition (counter 0). The first update follows the ignition; after 29 updates the counter is 29 at stage 0, after 30 it is at stage 1, and the 55th update reaches stage 2 = maxStage: BurnDownFire demolishes the lot with flags 0x300 and posts one 0x49E3DB1D with data2 0. A forced ignition starts at counter 30 and burns down at the 25th update; with maxStage below 2 it starts at half of D3cum[0].",
  "steps": [
    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_occupant", "occupant": "0x10", "cell": [5, 5]},
    {"op": "dis_call", "method": "ignite", "args": ["0x10", false, 0, true], "expect": true},
    {"op": "dis_expect_fire", "state": {"target": "0x10", "counter": 0, "stage": 0, "max_stage": 2}},
    {"op": "dis_call", "method": "fire_update", "note": "update 1, right after the ignition"},
    {"op": "dis_expect_fire", "state": {"counter": 1}},
    {"op": "dis_seconds", "count": 28},
    {"op": "dis_expect_fire", "state": {"counter": 29, "stage": 0}},
    {"op": "dis_seconds", "count": 1},
    {"op": "dis_expect_fire", "state": {"counter": 30, "stage": 1}},
    {"op": "dis_clear_events"},
    {"op": "dis_seconds", "count": 24},
    {"op": "dis_expect_fire", "state": {"counter": 54, "stage": 1}},
    {"op": "dis_expect_event_count", "filter": {"event": "post", "type": "0x49E3DB1D"}, "count": 0},
    {"op": "dis_seconds", "count": 1, "note": "the 55th update"},
    {"op": "dis_call", "method": "fire_count", "expect": 0},
    {"op": "dis_expect_events", "filter": {"event": "post", "type": "0x49E3DB1D"}, "events": [
      {"event": "post", "type": "0x49E3DB1D", "data2": 0}
    ]},

    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_occupant", "occupant": "0x20", "cell": [9, 9]},
    {"op": "dis_clear_events"},
    {"op": "dis_call", "method": "ignite", "args": ["0x20", false, 0, false], "expect": true},
    {"op": "dis_call", "method": "fire_update"},
    {"op": "dis_seconds", "count": 54},
    {"op": "dis_expect_events", "filter": {"event": "demolish"}, "events": [
      {"event": "demolish", "occupant": "0x20", "lot": "0x100020", "flags": "0x300"}
    ]},

    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_occupant", "occupant": "0x30", "cell": [9, 9]},
    {"op": "dis_call", "method": "ignite", "args": ["0x30", true, 0, true], "expect": true},
    {"op": "dis_expect_fire", "state": {"counter": 30}, "note": "the stage follows at the next update"},
    {"op": "dis_call", "method": "fire_update"},
    {"op": "dis_seconds", "count": 23},
    {"op": "dis_call", "method": "fire_count", "expect": 1},
    {"op": "dis_expect_fire", "state": {"counter": 54}},
    {"op": "dis_seconds", "count": 1, "note": "the 25th update"},
    {"op": "dis_call", "method": "fire_count", "expect": 0},

    {"op": "dis_occupant", "occupant": "0x31", "type": "prop", "cell": [12, 12], "props": {"0x49BEDA31": 1}},
    {"op": "dis_call", "method": "ignite", "args": ["0x31", true, 0, false], "expect": true},
    {"op": "dis_expect_fire", "state": {"target": "0x31", "counter": 15, "max_stage": 1}}
  ]
}
