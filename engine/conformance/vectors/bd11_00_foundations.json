{
  "format": 1,
  "name": "bds_foundations_and_retaining_walls",
  "spec": ["building-development 4.9.1", "building-development 4.9.2"],
  "description": "BDS slots 23, 26 and 29 by hand from 4.9.2 (DG6), and the building loader 0x00698490 called directly (4.9.1, DG5). Foundation 0x50 has maximum height 0x88FCC3E3 = 12.5, foundation 0x51 none, wall 0x60; the city is 64 x 64 cells (cached by Init). The cell rectangle (0x00695610): the footprint inset by 0.5 m, each corner x 0.0625 truncated toward zero, the low corner raised to 0 and the high corner lowered to 63; the worked example (pos (96, -1, 184), size 32 x 48) gives cells (5, 10)-(6, 12). Slot 23 (type 0x50, usage 2, that position, orientation 1, base -1) with the highest cell altitude 310 and the lowest 304: create (one reference, as GZCOM returns it), SetFoundationType, slot 26 (default exemplar, max height 12.5), pos.y := the highest altitude over the cells (slot 17, with water; the caller's array is written), b := the lowest, SetPosition (96, 310, 184), SetSize (32, 6, 48), SetUsage 2, SetOrientation 1, Init, insert, one Release: true. On flat ground the height is the minimum 0.5; a base >= 0 is used as it is (no altitude call); pos.y >= 0 is kept (only the lowest altitude is read). A type without 0x88FCC3E3 sets no maximum height. A type outside the foundation key map, or an exemplar that does not load: released, false. A failed insert: released, false. Slot 26: type 0 -> GetFoundationType; a null occupant -> false [choice]; an unknown type -> false. Slot 29: type 0 -> GetRetainingWallType; the wall key map's exemplar becomes the default exemplar, true; no property read; unknown -> false. The building loader: true on every path; type 0 -> GetBuildingType; an unknown type -> nothing; the box (0, 0, 0)-size from 0x27812810.",
  "steps": [
    {"op": "bds_process", "seed": 1},
    {"op": "bds_exemplars", "list": [
      {"building": "0x100", "purpose": 1, "wealth": 1, "size": [16, 10, 8]},
      {"foundation": "0x50", "props": {"0x88FCC3E3": {"f32": [12.5]}}},
      {"foundation": "0x51"},
      {"wall": "0x60"}]},
    {"op": "bds_create"},
    {"op": "bds_init", "expect": true},
    {"op": "bds_occupants", "list": [{"id": 0, "bbox": [[0, 0, 0], [0, 0, 0]]}]},
    {"op": "bds_world", "next_token": 500, "cell_altitudes": [304, 310]},

    {"op": "bds_call", "method": "foundation_cells", "args": [[96, -1, 184], 32, 48], "expect": [5, 10, 6, 12]},
    {"op": "bds_call", "method": "foundation_cells", "args": [[8, 0, 8], 64, 64], "expect": [0, 0, 2, 2]},
    {"op": "bds_call", "method": "foundation_cells", "args": [[1020, 0, 1020], 32, 32], "expect": [62, 62, 63, 63]},
    {"op": "bds_call", "method": "foundation_cells", "args": [[100, 0, 100], 0, 0], "expect": [6, 6, 6, 6]},

    {"op": "bds_clear_events"},
    {"op": "bds_call", "method": "add_foundation", "args": ["0x50", 2, [96, -1, 184], 32, 48, 1, -1], "expect": {"result": true, "pos": [96, 310, 184]}},
    {"op": "bds_expect_events", "events": [
      {"event": "create_foundation", "occ": 500},
      {"event": "set_foundation_type", "occ": 500, "type": "0x50"},
      {"event": "set_default_exemplar", "occ": 500, "key": ["0x6534284A", "0x20000000", "0x50"], "result": true},
      {"event": "set_max_height", "occ": 500, "value": 12.5},
      {"event": "area_altitude_cells", "rect": [5, 10, 6, 12], "lowest": false, "water": true},
      {"event": "area_altitude_cells", "rect": [5, 10, 6, 12], "lowest": true, "water": true},
      {"event": "set_position", "occ": 500, "pos": [96, 310, 184]},
      {"event": "set_size", "occ": 500, "size": [32, 6, 48]},
      {"event": "set_usage", "occ": 500, "usage": 2},
      {"event": "set_foundation_orientation", "occ": 500, "orientation": 1},
      {"event": "init_occupant", "occ": 500},
      {"event": "insert_occupant", "occ": 500, "result": true},
      {"event": "release", "occ": 500}]},
    {"op": "bds_expect_refs", "occupants": {"500": 1}},

    {"op": "bds_world", "cell_altitudes": [300, 300]},
    {"op": "bds_clear_events"},
    {"op": "bds_call", "method": "add_foundation", "args": ["0x51", 1, [96, 300, 184], 32, 48, 0, -1], "expect": {"result": true, "pos": [96, 300, 184]}},
    {"op": "bds_expect_events", "filter": {"occ": 501}, "events": [
      {"event": "create_foundation"},
      {"event": "set_foundation_type", "type": "0x51"},
      {"event": "set_default_exemplar", "key": ["0x6534284A", "0x20000000", "0x51"], "result": true},
      {"event": "set_position", "pos": [96, 300, 184]},
      {"event": "set_size", "size": [32, 0.5, 48]},
      {"event": "set_usage", "usage": 1},
      {"event": "set_foundation_orientation", "orientation": 0},
      {"event": "init_occupant"},
      {"event": "insert_occupant", "result": true},
      {"event": "release"}]},
    {"op": "bds_clear_events"},
    {"op": "bds_call", "method": "add_foundation", "args": ["0x51", 1, [96, 300, 184], 32, 48, 0, -1], "expect": {"result": true, "pos": [96, 300, 184]}},
    {"op": "bds_expect_events", "filter": {"event": "area_altitude_cells"}, "events": [{"lowest": true, "water": true}]},
    {"op": "bds_clear_events"},
    {"op": "bds_call", "method": "add_foundation", "args": ["0x51", 1, [96, 300, 184], 32, 48, 0, 290], "expect": {"result": true, "pos": [96, 300, 184]}},
    {"op": "bds_expect_event_count", "filter": {"event": "area_altitude_cells"}, "count": 0},
    {"op": "bds_expect_events", "filter": {"event": "set_size"}, "events": [{"occ": 503, "size": [32, 10, 48]}]},

    {"op": "bds_clear_events"},
    {"op": "bds_call", "method": "add_foundation", "args": ["0x52", 1, [96, -1, 184], 32, 48, 0, -1], "expect": {"result": false, "pos": [96, -1, 184]}},
    {"op": "bds_expect_events", "events": [
      {"event": "create_foundation", "occ": 504},
      {"event": "set_foundation_type", "occ": 504, "type": "0x52"},
      {"event": "release", "occ": 504}]},
    {"op": "bds_expect_refs", "occupants": {"504": 0}},
    {"op": "bds_occupants", "list": [{"id": 0, "resource_fails": true}]},
    {"op": "bds_clear_events"},
    {"op": "bds_call", "method": "add_foundation", "args": ["0x50", 1, [96, -1, 184], 32, 48, 0, -1], "expect": {"result": false, "pos": [96, -1, 184]}},
    {"op": "bds_expect_events", "events": [
      {"event": "create_foundation", "occ": 505},
      {"event": "set_foundation_type", "occ": 505, "type": "0x50"},
      {"event": "set_default_exemplar", "occ": 505, "result": false},
      {"event": "release", "occ": 505}]},
    {"op": "bds_occupants", "list": [{"id": 0, "resource_fails": false}]},
    {"op": "bds_world", "insert_ok": false},
    {"op": "bds_clear_events"},
    {"op": "bds_call", "method": "add_foundation", "args": ["0x50", 1, [96, 5, 184], 32, 48, 0, 0], "expect": {"result": false, "pos": [96, 5, 184]}},
    {"op": "bds_expect_events", "filter": {"occ": 506}, "events": [
      {"event": "create_foundation"},
      {"event": "set_foundation_type"},
      {"event": "set_default_exemplar", "result": true},
      {"event": "set_max_height", "value": 12.5},
      {"event": "set_position", "pos": [96, 5, 184]},
      {"event": "set_size", "size": [32, 5, 48]},
      {"event": "set_usage"},
      {"event": "set_foundation_orientation"},
      {"event": "init_occupant"},
      {"event": "insert_occupant", "result": false},
      {"event": "release"}]},
    {"op": "bds_expect_refs", "occupants": {"506": 0}},
    {"op": "bds_world", "insert_ok": true},

    {"op": "bds_occupants", "list": [{"id": 77, "foundation_type": "0x50"}, {"id": 78, "wall_type": "0x60"}, {"id": 79, "building_type": "0x100"}, {"id": 80}]},
    {"op": "bds_clear_events"},
    {"op": "bds_call", "method": "load_foundation", "args": [77, 0], "expect": true},
    {"op": "bds_call", "method": "load_foundation", "args": [80, "0x51"], "expect": true},
    {"op": "bds_call", "method": "load_foundation", "args": [0, "0x50"], "expect": false},
    {"op": "bds_call", "method": "load_foundation", "args": [77, "0x60"], "expect": false},
    {"op": "bds_call", "method": "load_foundation", "args": [80, 0], "expect": false},
    {"op": "bds_expect_events", "events": [
      {"event": "set_default_exemplar", "occ": 77, "key": ["0x6534284A", "0x20000000", "0x50"], "result": true},
      {"event": "set_max_height", "occ": 77, "value": 12.5},
      {"event": "set_default_exemplar", "occ": 80, "key": ["0x6534284A", "0x20000000", "0x51"], "result": true}]},
    {"op": "bds_call", "method": "load_wall", "args": [78, 0], "expect": true},
    {"op": "bds_call", "method": "load_wall", "args": [80, "0x60"], "expect": true},
    {"op": "bds_call", "method": "load_wall", "args": [78, "0x50"], "expect": false},
    {"op": "bds_call", "method": "load_wall", "args": [0, "0x60"], "expect": false},
    {"op": "bds_call", "method": "load_wall", "args": [80, 0], "expect": false},
    {"op": "bds_expect_events", "events": [
      {"event": "set_default_exemplar", "occ": 78, "key": ["0x6534284A", "0x30000000", "0x60"], "result": true},
      {"event": "set_default_exemplar", "occ": 80, "key": ["0x6534284A", "0x30000000", "0x60"], "result": true}]},

    {"op": "bds_call", "method": "load_building_properties", "args": [79, "0x999"], "expect": true},
    {"op": "bds_expect_events", "events": []},
    {"op": "bds_call", "method": "load_building_properties", "args": [79, 0], "expect": true},
    {"op": "bds_expect_events", "events": [
      {"event": "set_default_exemplar", "occ": 79, "key": ["0x6534284A", "0x10000000", "0x100"], "result": true},
      {"event": "set_bbox", "occ": 79, "min": [0, 0, 0], "max": [16, 10, 8]}]}
  ]
}
