{
  "format": 1,
  "name": "disaster_nested_enable_counter",
  "spec": ["disasters 2.2", "disasters 18.6"],
  "description": "EnableDisasters(false) twice, then EnableDisasters(true) once: DisastersEnabled() is false. Once more: true. A further EnableDisasters(true) keeps the counter at 0. Each call returns the state after it.",
  "steps": [
    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_call", "method": "disasters_enabled", "expect": true},
    {"op": "dis_call", "method": "enable_disasters", "args": [false], "expect": false},
    {"op": "dis_call", "method": "enable_disasters", "args": [false], "expect": false},
    {"op": "dis_expect", "state": {"disable_counter": 2}},
    {"op": "dis_call", "method": "enable_disasters", "args": [true], "expect": false},
    {"op": "dis_call", "method": "disasters_enabled", "expect": false},
    {"op": "dis_call", "method": "enable_disasters", "args": [true], "expect": true},
    {"op": "dis_call", "method": "disasters_enabled", "expect": true},
    {"op": "dis_call", "method": "enable_disasters", "args": [true], "expect": true},
    {"op": "dis_expect", "state": {"disable_counter": 0, "enabled": true}}
  ]
}
