    {"op": "pd_expect_events", "filter": {"event": "advisor"}, "events": [{"event": "advisor", "id": "0xEA394B74"}]},
    {"op": "pd_lot", "lot": "0x10", "state": 2},
    {"op": "pd_month"},
    {"op": "pd_expect_events", "filter": {"event": "advisor"}, "events": [{"event": "advisor", "id": "0xEB3BE415"}]},
    {"op": "pd_lot", "lot": "0x11", "state": 0},
    {"op": "pd_month"},
    {"op": "pd_expect_events", "filter": {"event": "advisor"}, "events": []},
    {"op": "pd_lot", "lot": "0x10", "state": 1},
    {"op": "pd_set_port", "index": 0, "stage": 1},
    {"op": "pd_env", "offices": [[16800, 0], [0, 0]]},
