{
  "format": 1,
  "name": "demolition_not_demolishable",
  "spec": ["demolition 4.5", "demolition 12.5"],
  "description": "A lot whose IsInDemolishableState() is false is skipped by DemolishLots: true, cost 0, the lot untouched (only the QueueRemovals bracket).",
  "steps": [
    {"op": "demolition_create"},
    {"op": "demolition_init", "expect": true},
    {"op": "demolition_clear_events"},
    {"op": "demolition_occupant", "occupant": "0x10", "type": "building", "cell": [5, 5], "cost": 99},
    {"op": "demolition_lot", "lot": "0x50", "rect": [5, 5, 5, 5], "zone": 1, "building": "0x10", "occupants": ["0x10"], "demolishable": false},
    {"op": "demolition_lots", "do_it": true, "lots": ["0x50"], "privilege": 0, "flags": 1, "expect": {"ok": true, "cost": 0}},
    {"op": "demolition_expect_events", "events": [{"event": "queue", "on": true}, {"event": "queue", "on": false}]},
    {"op": "demolition_expect_lot", "lot": "0x50", "state": {"state": 1, "building": "0x10"}}
  ]
}
