{
  "format": 1,
  "name": "lot_developer_tests_power_travel_zot_condition",
  "spec": ["lot-developer 5.2", "lot-developer 5.4", "lot-developer 5.5", "lot-developer 5.6", "lot-developer 16"],
  "description": "Tests 5, 6, 7 and 9 (§5.2, §5.4, §5.5, §5.6, §16), shipped tuning (stay-new 90, thresholds 0.3/0.45/0.5). Power grace: an unpowered building lot that needs power returns 1, 1, 0 on three consecutive visits; the zot property is 4 after the first; powering it resets the counter, removes the zot prop and returns 2. Travel: a residence in state 3 with road and job access but trip length 0 returns true six times (the commute zot 7 appears from the third visit) and false on the seventh; without road access it returns true, true, false with zot 6 from the first visit and one 0x4C04DE69 data1=1 per visit. Zot priority: lower numbers win (power 4 < water 5 < road 6 < commute 7); the road 'add' notification is posted before the priority check (quirk 4); a lower request removes every prop carrying 0x48E95539 equal to the current zot. Condition: state 3 gives 0-3 from the wealth difference and the occupancy thresholds; state 4 steps 1 -> 2 -> 3 -> 4 one step per visit after stay-new days, and never past 4.",
  "steps": [
    {"op": "ldev_world", "terrain_cells": [64, 64]},

    {"op": "ldev_occ", "id": 500, "is_building": true, "bbox": [[0, 0, 0], [16, 10, 16]], "note": "test 5: power grace"},
    {"op": "ldev_profile", "building": "0x3000", "purpose": 1, "wealth": 1},
    {"op": "ldev_dev", "id": 700, "purpose": 1, "wealth": 1, "desirability": 100, "water_cap": 5},
    {"op": "ldev_cfg", "id": 9, "cfg_id": "0x60000009", "w": 1, "h": 1, "stage": 1},
    {"op": "ldev_lot", "id": 1, "x": 0, "z": 0, "state": 3, "building_type": "0x3000", "building": 500,
      "cfg": 9, "wealth": 1, "needs_power": true, "has_power": false, "road": true, "job": true},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_cells", "powered": [[0, 0, 0]]},
    {"op": "ldev_clear_events"},
    {"op": "ldev_test_power", "lot": 1, "at": [0, 0], "expect": 1, "note": "first unpowered visit: 1"},
    {"op": "ldev_expect_lot", "lot": 1, "prop": {"zot": 4, "no_power": 1}},
    {"op": "ldev_test_power", "lot": 1, "at": [0, 0], "expect": 1, "note": "second: still within the grace"},
    {"op": "ldev_expect_lot", "lot": 1, "prop": {"no_power": 2}},
    {"op": "ldev_test_power", "lot": 1, "at": [0, 0], "expect": 0, "note": "third: grace over"},
    {"op": "ldev_expect_lot", "lot": 1, "prop": {"no_power": 3, "zot": 4}},
    {"op": "ldev_cells", "powered": [[0, 0, 1]]},
    {"op": "ldev_clear_events"},
    {"op": "ldev_test_power", "lot": 1, "at": [0, 0], "expect": 2, "note": "powered: counter reset, zot prop removed"},
    {"op": "ldev_expect_lot", "lot": 1, "prop": {"no_power": 0, "zot": 0}},
    {"op": "ldev_expect_events", "events": [{"event": "prop_remove"}]},

    {"op": "ldev_lot", "id": 2, "x": 1, "z": 0, "state": 3, "building_type": "0x3000", "building": 500,
      "road": true, "job": true, "note": "test 6a: commute (road and job access, trip length 0)"},
    {"op": "ldev_cells", "trip": [[1, 0, 0]]},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_clear_events"},
    {"op": "ldev_test_travel", "lot": 2, "at": [1, 0], "purpose": 1, "expect": true},
    {"op": "ldev_expect_lot", "lot": 2, "prop": {"travel": 1, "zot": null}},
    {"op": "ldev_test_travel", "lot": 2, "at": [1, 0], "purpose": 1, "expect": true},
    {"op": "ldev_expect_lot", "lot": 2, "prop": {"travel": 2, "zot": null}},
    {"op": "ldev_test_travel", "lot": 2, "at": [1, 0], "purpose": 1, "expect": true,
      "note": "third visit: the commute zot 7 appears (counter > 2)"},
    {"op": "ldev_expect_lot", "lot": 2, "prop": {"travel": 3, "zot": 7}},
    {"op": "ldev_test_travel", "lot": 2, "at": [1, 0], "purpose": 1, "expect": true},
    {"op": "ldev_test_travel", "lot": 2, "at": [1, 0], "purpose": 1, "expect": true},
    {"op": "ldev_test_travel", "lot": 2, "at": [1, 0], "purpose": 1, "expect": true},
    {"op": "ldev_expect_lot", "lot": 2, "prop": {"travel": 6}},
    {"op": "ldev_test_travel", "lot": 2, "at": [1, 0], "purpose": 1, "expect": false,
      "note": "seventh occupied visit without a commute: abandoned"},
    {"op": "ldev_expect_lot", "lot": 2, "prop": {"travel": 7, "zot": 7}},
    {"op": "ldev_expect_event_count", "filter": {"event": "prop_add"}, "count": 1,
      "note": "the commute prop is added once (visit 3); later visits hit the priority check"},

    {"op": "ldev_lot", "id": 3, "x": 2, "z": 0, "state": 3, "building_type": "0x3000", "building": 500,
      "road": false, "job": true, "note": "test 6b: no road access (zot 6, one notification per visit)"},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_clear_events"},
    {"op": "ldev_test_travel", "lot": 3, "at": [2, 0], "purpose": 1, "expect": true},
    {"op": "ldev_expect_lot", "lot": 3, "prop": {"travel": 1, "zot": 6}},
    {"op": "ldev_test_travel", "lot": 3, "at": [2, 0], "purpose": 1, "expect": true},
    {"op": "ldev_expect_lot", "lot": 3, "prop": {"travel": 2, "zot": 6}},
    {"op": "ldev_test_travel", "lot": 3, "at": [2, 0], "purpose": 1, "expect": false,
      "note": "third visit without a road: abandoned"},
    {"op": "ldev_expect_lot", "lot": 3, "prop": {"travel": 3, "zot": 6}},
    {"op": "ldev_expect_events", "note": "one data1=1 notification per visit (3); the road prop only on the first (zot 6 already shown afterwards, priority check returns). All three visits return from the no-road branch, so no PASS/prop_remove.", "events": [
      {"event": "post", "message": "0x4C04DE69", "data1": 1, "lot": 3},
      {"event": "prop_add", "type": "0x107A0000"},
      {"event": "removal_flags", "flags": 3},
      {"event": "post", "message": "0x4C04DE69", "data1": 1, "lot": 3},
      {"event": "post", "message": "0x4C04DE69", "data1": 1, "lot": 3}]},

    {"op": "ldev_lot", "id": 4, "x": 3, "z": 0, "state": 3, "building_type": "0x3000", "building": 500,
      "counter": {"zot": 4}, "note": "test 7: zot priority"},
    {"op": "ldev_occ", "id": 600, "lot": 4, "props": {"0x48E95539": 7}},
    {"op": "ldev_occ", "id": 601, "lot": 4, "props": {"0x48E95539": 7}},
    {"op": "ldev_occ", "id": 602, "lot": 4, "props": {"0x48E95539": 4}},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_clear_events"},
    {"op": "ldev_add_zot", "lot": 4, "prop": "0x107A0000", "zot": 6,
      "note": "current 4, request 6: still 4, but the data1=1 notification is posted first (quirk 4)"},
    {"op": "ldev_expect_lot", "lot": 4, "prop": {"zot": 4}},
    {"op": "ldev_expect_events", "events": [
      {"event": "post", "message": "0x4C04DE69", "data1": 1, "lot": 4}]},
    {"op": "ldev_clear_events"},
    {"op": "ldev_add_zot", "lot": 4, "prop": "0x1C440000", "zot": 7,
      "note": "current 4, request 7: still 4, no notification (only zot 6 posts)"},
    {"op": "ldev_expect_lot", "lot": 4, "prop": {"zot": 4}},
    {"op": "ldev_expect_events", "events": []},
    {"op": "ldev_lot", "id": 4, "counter": {"zot": 7}},
    {"op": "ldev_clear_events"},
    {"op": "ldev_add_zot", "lot": 4, "prop": "0x1C430000", "zot": 5,
      "note": "current 7, request 5: every 0x48E95539=7 prop is removed, zot becomes 5"},
    {"op": "ldev_expect_lot", "lot": 4, "prop": {"zot": 5}},
    {"op": "ldev_expect_events", "events": [
      {"event": "prop_remove", "occ": 600},
      {"event": "prop_remove", "occ": 601},
      {"event": "prop_add", "type": "0x1C430000"},
      {"event": "removal_flags", "flags": 3}]},
    {"op": "ldev_lot", "id": 4, "counter": {"zot": 6}},
    {"op": "ldev_clear_events"},
    {"op": "ldev_remove_zot", "lot": 4, "expect": true,
      "note": "slot 11 removes whatever zot is shown; it passes zot 0, so nothing is posted. No prop carries 0x48E95539 = 6 here (the earlier road requests were blocked by the priority check), so no prop is removed."},
    {"op": "ldev_expect_lot", "lot": 4, "prop": {"zot": 0}},
    {"op": "ldev_expect_events", "events": []},
    {"op": "ldev_lot", "id": 5, "x": 4, "z": 0, "state": 1},
    {"op": "ldev_clear_events"},
    {"op": "ldev_remove_zot", "lot": 5, "expect": false, "note": "no zot property: slot 11 returns 0"},

    {"op": "ldev_profile", "building": "0x3003", "purpose": 1, "wealth": 3, "note": "test 9: condition"},
    {"op": "ldev_profile", "building": "0x3002", "purpose": 1, "wealth": 2},
    {"op": "ldev_lot", "id": 10, "x": 5, "z": 0, "state": 3, "building_type": "0x3003", "wealth": 1,
      "condition": 0, "days": 10, "occupancy": 1.0},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_read_tuning", "note": "test 9 needs the shipped thresholds 0.3/0.45/0.5; Init reads them, but this section calls TestCondition directly"},
    {"op": "ldev_test_condition", "lot": 10, "at": [5, 0], "expect": 3,
      "note": "wealth 3 vs occupant 1: d = 2, no occupancy read (days 10 <= 90, b false) -> 3"},
    {"op": "ldev_lot", "id": 10, "building_type": "0x3000", "wealth": 1, "condition": 0, "days": 100, "occupancy": 0.40},
    {"op": "ldev_test_condition", "lot": 10, "at": [5, 0], "expect": 2,
      "note": "wealth equal: d = 0; days 100 > 90, occupancy 0.40 < distress 0.45 -> d = 1 -> 2"},
    {"op": "ldev_lot", "id": 10, "occupancy": 0.47, "counter": {"no_power": 0}},
    {"op": "ldev_test_condition", "lot": 10, "at": [5, 0], "expect": 0,
      "note": "occupancy 0.47 >= 0.45, b false -> d stays 0; no-power counter 0 -> 0"},
    {"op": "ldev_lot", "id": 10, "counter": {"no_power": 1}},
    {"op": "ldev_test_condition", "lot": 10, "at": [5, 0], "expect": 1,
      "note": "d = 0 with a non-zero no-power counter -> 1"},
    {"op": "ldev_lot", "id": 10, "building_type": "0x3002", "wealth": 1, "condition": 3, "days": 10, "occupancy": 0.48},
    {"op": "ldev_test_condition", "lot": 10, "at": [5, 0], "expect": 3,
      "note": "wealth 2 vs 1: d = 1; b = (3-1) > 1 -> true; 0.48 < renew 0.5 -> d = 2 -> 3"},
    {"op": "ldev_lot", "id": 11, "x": 6, "z": 0, "state": 4, "condition": 0, "days": 0},
    {"op": "ldev_test_condition", "lot": 11, "at": [6, 0], "expect": 1,
      "note": "state 4, condition 0 -> 1 (days 0 <= 90)"},
    {"op": "ldev_lot", "id": 11, "condition": 2, "days": 91},
    {"op": "ldev_test_condition", "lot": 11, "at": [6, 0], "expect": 3,
      "note": "state 4, condition 2, days 91 > 90 -> 3"},
    {"op": "ldev_lot", "id": 11, "condition": 4, "days": 91},
    {"op": "ldev_test_condition", "lot": 11, "at": [6, 0], "expect": 4,
      "note": "state 4, condition 4: never past 4"},
    {"op": "ldev_lot", "id": 12, "x": 7, "z": 0, "state": 2, "condition": 1, "days": 500},
    {"op": "ldev_test_condition", "lot": 12, "at": [7, 0], "expect": 1,
      "note": "state 2 (constructing): the condition is returned unchanged"}
  ]
}
