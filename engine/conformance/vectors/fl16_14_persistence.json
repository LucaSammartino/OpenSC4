    {"op": "flam_expect", "state": {"hotspots": [[1, 2, 5], [11, 10, 3]], "candidates": [[4, 4, 1]], "zoned_sum": 9, "global_multiplier": 0.95, "average": 50, "has_adjusted": true, "has_raw": true}},
    {"op": "flam_load", "slot": "a"},
