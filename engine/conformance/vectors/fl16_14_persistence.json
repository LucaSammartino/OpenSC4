    {"op": "flam_env", "cells": [16, 16]},
    {"op": "flam_tuning", "shipped": true},
    {"op": "flam_create"},
    {"op": "flam_init"},
    {"op": "flam_set", "state": {"global_multiplier": 0.95, "average": 50, "hotspots": [[11, 10, 3]]}, "raw": [[11, 10, 200]], "adjusted": [[11, 10, 190]]},
    {"op": "flam_save", "slot": "a"},
    {"op": "flam_expect_payload", "slot": "a", "length": 39, "at": [{"offset": 0, "hex": "0200"}, {"offset": 2, "hex": "0200000002e6b949"}, {"offset": 10, "hex": "0300000002e6b949"}, {"offset": 18, "hex": "333373 3f 32 01000000 0b000000 0a000000 03000000"}]},
    {"op": "flam_save", "slot": "v1"},
    {"op": "flam_save", "slot": "v3"},
    {"op": "flam_save", "slot": "short"},
    {"op": "flam_save", "slot": "huge"},
    {"op": "flam_save", "slot": "s2"},
    {"op": "flam_load", "slot": "a"},
    {"op": "flam_expect", "state": {"initialized": false, "global_multiplier": 0.95, "average": 50, "hotspots": [[11, 10, 3]], "has_adjusted": true, "has_raw": true}},
    {"op": "flam_expect_grid", "grid": "raw", "instance": "0x49D5B964", "counts": [16, 16], "cells": [[11, 10, 200]], "others": 0},
    {"op": "flam_expect_grid", "grid": "adjusted", "instance": "0x49D5B953", "cells": [[11, 10, 190]], "others": 0},
    {"op": "flam_expect_save", "slot": "a"},
    {"op": "flam_clear_events"},
    {"op": "flam_init"},
    {"op": "flam_expect_events", "filter": {"event": "create_grid"}, "events": []},
    {"op": "flam_expect", "state": {"hotspots": [[11, 10, 3]], "average": 50, "global_multiplier": 0.95, "tracts_per_day": 6}},
    {"op": "flam_days", "count": 1, "ends": [1]},
    {"op": "flam_expect", "state": {"hotspots": [], "average": 0, "global_multiplier": 0.95}},
    {"op": "flam_patch", "slot": "v1", "offset": 0, "hex": "0100"},
    {"op": "flam_load", "slot": "v1"},
    {"op": "flam_expect", "state": {"global_multiplier": 0, "average": 0, "hotspots": [], "has_adjusted": false, "has_raw": false}},
    {"op": "flam_patch", "slot": "v3", "offset": 0, "hex": "0300"},
    {"op": "flam_load", "slot": "v3"},
    {"op": "flam_expect", "state": {"hotspots": [], "has_adjusted": false}},
    {"op": "flam_patch", "slot": "short", "offset": 31, "delete": 8},
    {"op": "flam_load", "slot": "short"},
    {"op": "flam_expect", "state": {"global_multiplier": 0.95, "average": 50, "hotspots": []}},
    {"op": "flam_patch", "slot": "huge", "offset": 23, "hex": "ffffffff"},
    {"op": "flam_patch", "slot": "huge", "offset": 27, "delete": 12},
    {"op": "flam_load", "slot": "huge"},
    {"op": "flam_expect", "state": {"hotspots": []}},
