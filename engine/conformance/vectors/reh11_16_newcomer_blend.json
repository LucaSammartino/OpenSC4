{
  "format": 1,
  "name": "reh11_newcomer_blend",
  "spec": ["REH 4.7", "REH 11.16"],
  "description": "REH test 16 with both decays 0 and a flat LE of 100 (no reset). (100, 0, 0) -> (150, 0, 0) at EQ = HQ = 50: 50 newcomers with the shipped R$ newcomer EQ 20 blend as (50 + 20) / 2 = 35 (the old value is > 0), then (50 x 35 + 100 x 50) / 150 = 45. With EQ_old = 0: (50 x 20 + 0) / 150 = 6.6666665 (0x40D55555).",
  "steps": [
    {"op": "residential_env", "tuning_props": {"0x6941A67F": {"f32": [0, 100, 200, 100]}, "0xC929C433": {"f32": 0}, "0x0929C439": {"f32": 0}}},
    {"op": "residential_create"},
    {"op": "residential_init", "expect": true},
    {"op": "residential_tract", "x": 0, "z": 0, "pop": [100, 0, 0], "new": [150, 0, 0], "eq": [50, 0, 0], "hq": [50, 0, 0], "age": 30},
    {"op": "residential_call", "method": "do_population_change", "args": [0, 0]},
    {"op": "residential_expect_tract", "x": 0, "z": 0, "pop": [150, 0, 0], "eq": [45, 0, 0], "hq": [45, 0, 0]},
    {"op": "residential_tract", "x": 1, "z": 0, "pop": [100, 0, 0], "new": [150, 0, 0], "eq": [0, 0, 0], "hq": [0, 0, 0], "age": 30},
    {"op": "residential_call", "method": "do_population_change", "args": [1, 0]},
    {"op": "residential_expect_tract", "x": 1, "z": 0, "bits": true, "eq": ["0x40D55555", "0x00000000", "0x00000000"]}
  ]
}
