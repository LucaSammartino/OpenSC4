{
  "format": 1,
  "name": "om18_18_iteration",
  "spec": ["occupant-manager 9.1", "occupant-manager 9.2", "occupant-manager 9.4", "occupant-manager 15", "occupant-manager 18.18"],
  "description": "Slot 44 with min = (64, 999, 64), max = (64, -5, 64) visits only cell (64, 64) (element 1 ignored); null corners walk the city x-major. A slot-42 callback that returns false on the first occupant of a cell with three is called once and every reference is balanced. Before Init: slots 42 and 44 return true, 43, 45, 46 and 47 false.",
  "steps": [
    {"op": "om_create"},
    {"op": "om_call", "method": "set_city_size", "args": [1024, 1024], "expect": true},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_occupant", "occupant": "0x1", "min": [10, 0, 10], "max": [20, 10, 20]},
    {"op": "om_occupant", "occupant": "0x2", "min": [70, 0, 10], "max": [80, 10, 20]},
    {"op": "om_occupant", "occupant": "0x3", "min": [10, 0, 70], "max": [20, 10, 80]},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x2", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x3", "data4": 0, "expect": true},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "iterate", "min": [64, 999, 64], "max": [64, -5, 64], "expect": true},
    {"op": "om_expect_events", "filter": {"event": "callback"}, "events": [{"event": "callback", "occupant": "0x1"}]},
    {"op": "om_call", "method": "iterate", "expect": true},
    {"op": "om_expect_events", "filter": {"event": "callback"}, "events": [{"event": "callback", "occupant": "0x1"}, {"event": "callback", "occupant": "0x3"}, {"event": "callback", "occupant": "0x2"}]},
    {"op": "om_call", "method": "iterate", "min": [0, 0, 0], "max": [300, 0, 64], "expect": true, "note": "clamped to 191"},
    {"op": "om_expect_events", "filter": {"event": "callback"}, "events": [{"event": "callback", "occupant": "0x1"}, {"event": "callback", "occupant": "0x2"}]},
    {"op": "om_occupant", "occupant": "0x4", "min": [10, 0, 10], "max": [20, 10, 20]},
    {"op": "om_occupant", "occupant": "0x5", "min": [10, 0, 10], "max": [20, 10, 20]},
    {"op": "om_call", "method": "insert", "occupant": "0x4", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x5", "data4": 0, "expect": true},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "iterate_by_bbox", "min": [0, -100, 0], "max": [30, 100, 30], "stop_at": ["0x5"], "expect": true},
    {"op": "om_expect_events", "filter": {"event": "callback"}, "events": [{"event": "callback", "occupant": "0x5"}]},
    {"op": "om_expect_refs", "refs": {"0x1": 1, "0x4": 1, "0x5": 1}},
    {"op": "om_call", "method": "iterate_by_bbox", "min": [0, -100, 0], "max": [100, 100, 100], "stop_at": ["0x4"], "expect": true},
    {"op": "om_expect_events", "filter": {"event": "callback"}, "events": [{"event": "callback", "occupant": "0x5"}, {"event": "callback", "occupant": "0x4"}]},
    {"op": "om_call", "method": "iterate_by_bbox", "min": [0, -100, 0], "max": [100, 100, 100], "expect": true},
    {"op": "om_expect_events", "filter": {"event": "callback"}, "events": [{"event": "callback", "occupant": "0x5"}, {"event": "callback", "occupant": "0x4"}, {"event": "callback", "occupant": "0x1"}, {"event": "callback", "occupant": "0x3"}, {"event": "callback", "occupant": "0x2"}]},
    {"op": "om_expect_refs", "refs": {"0x1": 1, "0x2": 1, "0x3": 1, "0x4": 1, "0x5": 1}},
    {"op": "om_create"},
    {"op": "om_call", "method": "iterate_by_bbox", "min": [0, 0, 0], "max": [1, 1, 1], "expect": true},
    {"op": "om_call", "method": "iterate_by_bbox_typed", "min": [0, 0, 0], "max": [1, 1, 1], "type": 0, "expect": false},
    {"op": "om_call", "method": "iterate", "expect": true},
    {"op": "om_call", "method": "iterate_typed", "type": 0, "expect": false},
    {"op": "om_call", "method": "iterate_by_standard_cells", "expect": false},
    {"op": "om_call", "method": "iterate_by_standard_cells_typed", "type": 0, "expect": false},
    {"op": "om_expect_events", "events": []}
  ]
}
