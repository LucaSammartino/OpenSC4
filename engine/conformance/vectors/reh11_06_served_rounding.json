{
  "format": 1,
  "name": "reh11_served_rounding",
  "spec": ["REH 4.5", "REH 11.6"],
  "description": "REH test 6: GetPopulationServed rounds the float32 sum half to even. A school of units 1 (capacity 500) over tract (0, 0), with a wealth curve 0xC92D7EC0 of 50 % at every wealth (0.5 per resident): 5 residents -> 2.5 -> 2; 7 -> 3.5 -> 4; with 49.998 % and 5 residents -> 2.4999 -> 2. The rounding itself: rhe(2.5) = 2, rhe(3.5) = 4, rhe(2.4999) = 2.",
  "steps": [
    {"op": "residential_call", "method": "rhe", "args": [2.5], "expect": 2},
    {"op": "residential_call", "method": "rhe", "args": [3.5], "expect": 4},
    {"op": "residential_call", "method": "rhe", "args": [2.4999], "expect": 2},
    {"op": "residential_env", "groups": {"1": ["0x150F"]}, "props": {"1": {"0x8922041B": {"u32": 500}, "0x691B42B3": {"f32": 10}, "0xC92D7EC0": {"f32": [0, 50, 2, 50]}}}, "lots": {"1": [32, 32]}},
    {"op": "residential_create"},
    {"op": "residential_init", "expect": true},
    {"op": "residential_set", "state": {"lists": {"school_groups": [[1]]}}},
    {"op": "residential_tract", "x": 0, "z": 0, "pop": [5, 0, 0]},
    {"op": "residential_set", "state": {"state": 5}},
    {"op": "residential_run_to", "state": 7, "steps": 2},
    {"op": "residential_expect_props", "occupant": 1, "props": {"0x09220161": 2}},
    {"op": "residential_tract", "x": 0, "z": 0, "pop": [7, 0, 0]},
    {"op": "residential_set", "state": {"state": 5}},
    {"op": "residential_run_to", "state": 7, "steps": 2},
    {"op": "residential_expect_props", "occupant": 1, "props": {"0x09220161": 4}},
    {"op": "residential_env", "props": {"1": {"0xC92D7EC0": {"f32": [0, 49.998, 2, 49.998]}}}},
    {"op": "residential_tract", "x": 0, "z": 0, "pop": [5, 0, 0]},
    {"op": "residential_set", "state": {"state": 5}},
    {"op": "residential_run_to", "state": 7, "steps": 2},
    {"op": "residential_expect_props", "occupant": 1, "props": {"0x09220161": 2}}
  ]
}
