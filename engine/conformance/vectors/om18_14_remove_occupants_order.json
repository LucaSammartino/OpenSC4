{
  "format": 1,
  "name": "om18_14_remove_occupants_order",
  "spec": ["occupant-manager 5.3", "occupant-manager 18.14"],
  "description": "H in (64, 64), J spanning (64, 65)..(65, 65); slot 22(null, true, 0): the walk is x-major (x 64: z 64 then z 65) and J is met first at (64, 65), so Remove(H), Destroy(H), Remove(J), Destroy(J). Flag 1 is cleared inside the lock, before the Remove is posted. True; every cell empty; references released. A caller filter keeps what it excludes.",
  "steps": [
    {"op": "om_create"},
    {"op": "om_call", "method": "set_city_size", "args": [1024, 1024], "expect": true},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_occupant", "occupant": "0x10", "min": [10, 0, 10], "max": [20, 10, 20]},
    {"op": "om_occupant", "occupant": "0x11", "min": [10, 0, 70], "max": [100, 10, 80]},
    {"op": "om_occupant", "occupant": "0x12", "min": [200, 0, 200], "max": [210, 10, 210]},
    {"op": "om_call", "method": "insert", "occupant": "0x10", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x11", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x12", "data4": 0, "expect": true},
    {"op": "om_expect_occupant", "occupant": "0x11", "state": {"om_box": [64, 65, 65, 65]}},
    {"op": "om_filter", "filter": "0xF2", "exclude": ["0x12"]},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "remove_occupants", "filter": "0xF2", "shutdown": true, "data4": 0, "expect": true},
    {"op": "om_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x99EF1143", "occupant": "0x10", "inserted": false}, {"event": "post", "type": "0x99EF1141", "occupant": "0x10"}, {"event": "post", "type": "0x99EF1143", "occupant": "0x11", "inserted": false}, {"event": "post", "type": "0x99EF1141", "occupant": "0x11"}]},
    {"op": "om_expect", "state": {"holders": 1, "nodes": 1}},
    {"op": "om_expect_cell", "cell": [67, 67], "occupants": ["0x12"]},
    {"op": "om_expect_refs", "refs": {"0x10": 0, "0x11": 0, "0x12": 1}},
    {"op": "om_call", "method": "remove_occupants", "shutdown": false, "data4": 5, "expect": true},
    {"op": "om_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x99EF1143", "occupant": "0x12", "data4": 5}]},
    {"op": "om_expect", "state": {"holders": 0, "nodes": 0}}
  ]
}
