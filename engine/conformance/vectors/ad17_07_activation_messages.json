{
  "format": 1,
  "name": "advisor_activation_messages",
  "spec": ["advisors 6.4", "advisors 10", "advisors 17.7"],
  "description": "Activation posts AdviceAdded with the advice as the IGZUnknown; an advice with command 0x1234 also posts AdviceCommand (data1 0x1234, the advisor). Deactivation (an expire request) sends AdviceRemoved synchronously.",
  "steps": [
    {"op": "adv_advisor", "class": "Advisor", "id": 23},
    {"op": "adv_advice", "guid": 5, "command": "0x1234"},
    {"op": "adv_create"},
    {"op": "adv_init", "expect": true},
    {"op": "adv_set", "object": {"advisor": 23}, "month_counter": 1},
    {"op": "adv_clear_events"},
    {"op": "adv_day", "day": 1000, "advisor": {"advisor": 23}},
    {"op": "adv_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x8A09FA64", "data1": 0, "object": "advice:0x5"}, {"event": "post", "type": "0x8A09FA6C", "data1": "0x1234", "object": "advisor:23"}]},
    {"op": "adv_flags", "advice": {"advice": 5}, "mask": 8, "on": true, "note": "expire request"},
    {"op": "adv_day", "day": 1001, "advisor": {"advisor": 23}},
    {"op": "adv_expect_events", "filter": {"event": "send"}, "events": [{"event": "send", "type": "0x8A09FA65", "data1": 0, "object": "advice:0x5"}]},
    {"op": "adv_expect", "object": {"advice": 5}, "state": {"active": false}}
  ]
}
