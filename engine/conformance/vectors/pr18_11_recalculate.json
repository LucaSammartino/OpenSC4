{
  "format": 1,
  "name": "protection_recalculate",
  "spec": ["protection 9.1", "protection 9.4", "protection 16", "protection 18.11"],
  "description": "Test 11: jails with capacity properties 400 and 600 at full funding (jailEff 1.0); inserting each adds it to the jail list and, with a jail-purpose item whose department exists, to the locally-funded-jail list with AddLocallyFundedObject(holder, 0xEA56768A) on the jail department. Jailed 600 -> capacity 1000, ratio 0.6, per-jail populations (property 0x48D71EE1) 240 and 360, population 600. Jailed 1500 -> ratio 1: 400 and 600, population 1000, GetJailedPercentage 1.0. Capacity 0 -> ratio 0, and 0/0 gives NaN (quirk 10). Removing a jail removes it from both lists, RemoveLocallyFundedObject, Recalculate; the jails are buildings because the police removal (0x006E1570) handles only buildings (protection 9.4; this vector used occupant type 1 before that answer). Hand-derived.",
  "steps": [
    {"op": "protection_create", "kind": "police"},
    {"op": "protection_env", "tuning": "shipped"},
    {"op": "protection_init"},
    {"op": "protection_occupants", "21": {"props": {"0x48D71EE0": {"u32": 400}}, "items": {"0xEA56768A": {"local": 1.0}}}, "22": {"props": {"0x48D71EE0": {"u32": 600}}, "items": {"0xEA56768A": {"local": 1.0}}}},
    {"op": "protection_clear_events"},
    {"op": "protection_message", "type": "OccupantInserted", "occupant": 21},
    {"op": "protection_message", "type": "OccupantInserted", "occupant": 22},
    {"op": "protection_expect_events", "events": [{"event": "add_funded", "dept": "0xA2963984", "occupant": 21, "purpose": "0xEA56768A"}, {"event": "add_funded", "dept": "0xA2963984", "occupant": 22, "purpose": "0xEA56768A"}]},
    {"op": "protection_expect", "state": {"jails": [21, 22], "funded_jails": [21, 22], "capacity": 1000, "population": 0}},
    {"op": "protection_set", "state": {"jailed": 600}},
    {"op": "protection_call", "method": "recalculate"},
    {"op": "protection_expect", "state": {"capacity": 1000, "population": 600}},
    {"op": "protection_expect_occupant", "id": 21, "props": {"0x48D71EE1": 240}},
    {"op": "protection_expect_occupant", "id": 22, "props": {"0x48D71EE1": 360}},
    {"op": "protection_call", "method": "jailed_percentage", "expect": 0.6},
    {"op": "protection_set", "state": {"jailed": 1500}},
    {"op": "protection_call", "method": "recalculate"},
    {"op": "protection_expect", "state": {"capacity": 1000, "population": 1000}},
    {"op": "protection_expect_occupant", "id": 21, "props": {"0x48D71EE1": 400}},
    {"op": "protection_expect_occupant", "id": 22, "props": {"0x48D71EE1": 600}},
    {"op": "protection_call", "method": "jailed_percentage", "expect": 1.0},
    {"op": "protection_call", "method": "jail_capacity", "expect": 1000},
    {"op": "protection_call", "method": "jail_population", "expect": 1000},
    {"op": "protection_call", "method": "jail_count", "expect": 2},
    {"op": "protection_eval", "fn": "jailed_percentage", "args": [0, 0], "expect": "nan"},
    {"op": "protection_eval", "fn": "ratio_share", "args": [400, 0.6], "expect": 240},
    {"op": "protection_message", "type": "OccupantRemoved", "occupant": 21},
    {"op": "protection_expect_events", "events": [{"event": "remove_funded", "dept": "0xA2963984", "occupant": 21, "purpose": "0xEA56768A"}]},
    {"op": "protection_expect", "state": {"jails": [22], "funded_jails": [22], "capacity": 600, "population": 600}},
    {"op": "protection_occupants", "22": {"items": {"0xEA56768A": {"local": 0.0}}}},
    {"op": "protection_call", "method": "recalculate"},
    {"op": "protection_expect", "state": {"capacity": 0, "population": 0}},
    {"op": "protection_expect_occupant", "id": 22, "props": {"0x48D71EE1": 0}}
  ]
}
