    {"op": "plumbing_month"},
    {"op": "plumbing_pass"},
    {"op": "plumbing_expect_event_count", "filter": {"event": "lot_condition"}, "count": 0},
    {"op": "plumbing_expect_occupant", "occupant": "pump", "props": {"0xC910B4CF": 10.1}},
