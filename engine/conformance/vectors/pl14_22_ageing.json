    {"op": "plumbing_occupant", "occupant": "pump", "props": {"0xC910B4CF": {"f32": 60}, "0xEA1CF221": {"f32": 50}, "0xEA1CF222": {"f32": 200}}},
    {"op": "plumbing_month"},
    {"op": "plumbing_pass"},
    {"op": "plumbing_expect_events", "filter": {"event": "lot_condition"}, "events": [{"event": "lot_condition", "lot": "pump_lot", "condition": 2}]},
