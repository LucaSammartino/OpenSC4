    {"op": "plumbing_pipe", "label": "p", "x": 10, "z": 10},
    {"op": "plumbing_building", "label": "house", "x": 12, "z": 10, "props": {"0xC8ED2D84": {"u32": 500}}},
    {"op": "plumbing_month"},
    {"op": "plumbing_expect", "state": {"ageing": true}},
    {"op": "plumbing_pass"},
    {"op": "plumbing_expect_occupant", "occupant": "pump", "props": {"0x08D9763D": 500, "0xC910B4CF": 0.45}},
    {"op": "plumbing_expect", "state": {"ageing": false}},
    {"op": "plumbing_pass"},
    {"op": "plumbing_expect_occupant", "occupant": "pump", "props": {"0xC910B4CF": 0.45}},
    {"op": "plumbing_lot", "lot": "pump_lot", "needs_power": true, "has_power": false},
    {"op": "plumbing_month"},
    {"op": "plumbing_pass"},
    {"op": "plumbing_expect_occupant", "occupant": "pump", "props": {"0x08D9763D": 0, "0xC910B4CF": 0.55}},
