{
  "format": 1,
  "name": "plumbing_pipes",
  "spec": ["plumbing 5.1", "plumbing 5.2", "plumbing 5.4", "plumbing 14.3", "plumbing 14.4", "plumbing 14.16"],
  "description": "Test 3: a pipe at (10,20) answering ConnectsToNeighbor for directions 0 and 2 sets 0x10 | 0x01 | 0x04 = 0x15; message 0xEA1F0DCD (10,20) ANDs 0xE0 -> 0x00 (the pipe bit too [quirk]) and sets recompute, the pipe stays listed; a cell with 0x55 -> 0x40. The burst message has no bounds check: (64, 0) is raw index 64 = cell (0,1) [quirk]; (0xFFFFFFFF, 0) is index -1, outside the map ([choice]: ignored). Inserting a second pipe in an occupied cell ORs its bits without clearing (0x12 | 0x18 = 0x1A [quirk]); removing it ANDs 0xE0, clearing the other pipe's bits too. Test 4 (cost per pipe 0.1): SetFullExpenses(round(f32(n x 0.1f))): 1 pipe 0.1 -> 0, 12 pipes 1.2 -> 1, 18 pipes 1.8000001 -> 2, back to 17 pipes 1.7 -> 2; ties to even: 5 -> 0.5 -> 0, 15 -> 1.5 -> 2. Test 16: removing a pipe with network flags 0x10000 | 0x20000 decrements numPipes, numDistressed and numBurst and releases it. A network occupant with flag 0x80000000 (preview piece) and a building with property 0x029244DB (preview occupant) are ignored.",
  "steps": [
    {"op": "plumbing_create"},
    {"op": "plumbing_init"},
    {"op": "plumbing_message", "type": "ConnectionsReady"},
    {"op": "plumbing_clear_events"},
    {"op": "plumbing_pipe", "label": "p", "x": 10, "z": 20, "dirs": [0, 2]},
    {"op": "plumbing_expect_flags", "cells": [{"x": 10, "z": 20, "v": "0x15"}, {"x": 9, "z": 20, "v": 0}, {"x": 11, "z": 20, "v": 0}]},
    {"op": "plumbing_expect", "state": {"num_pipes": 1, "pipes": ["p"], "recompute": true}},
    {"op": "plumbing_expect_refs", "refs": {"p": 1}},
    {"op": "plumbing_expect_events", "filter": {"event": "set_expenses"}, "events": [{"event": "set_expenses", "line": 2, "value": 0}]},
    {"op": "plumbing_set", "state": {"recompute": false}},
    {"op": "plumbing_message", "type": "PipeBurst", "data1": 10, "data2": 20, "expect": true},
    {"op": "plumbing_expect_flags", "cells": [{"x": 10, "z": 20, "v": 0}]},
    {"op": "plumbing_expect", "state": {"num_pipes": 1, "pipes": ["p"], "recompute": true}},
    {"op": "plumbing_set", "flags": [{"x": 3, "z": 3, "v": "0x55"}, {"x": 0, "z": 1, "v": "0x1F"}]},
    {"op": "plumbing_message", "type": "PipeBurst", "data1": 3, "data2": 3},
    {"op": "plumbing_expect_flags", "cells": [{"x": 3, "z": 3, "v": "0x40"}]},
    {"op": "plumbing_message", "type": "PipeBurst", "data1": 64, "data2": 0},
    {"op": "plumbing_expect_flags", "cells": [{"x": 0, "z": 1, "v": 0}]},
    {"op": "plumbing_message", "type": "PipeBurst", "data1": "0xFFFFFFFF", "data2": 0, "expect": true},
    {"op": "plumbing_message", "type": "PipeBurst", "data1": 5000, "data2": 5000, "expect": true},

    {"op": "plumbing_pipe", "label": "q", "x": 30, "z": 30, "dirs": [1]},
    {"op": "plumbing_expect_flags", "cells": [{"x": 30, "z": 30, "v": "0x12"}]},
    {"op": "plumbing_pipe", "label": "r", "x": 30, "z": 30, "dirs": [3]},
    {"op": "plumbing_expect_flags", "cells": [{"x": 30, "z": 30, "v": "0x1A"}]},
    {"op": "plumbing_remove", "occupant": "r"},
    {"op": "plumbing_expect_flags", "cells": [{"x": 30, "z": 30, "v": 0}]},
    {"op": "plumbing_expect", "state": {"num_pipes": 2, "pipes": ["p", "q"]}},
    {"op": "plumbing_expect_refs", "refs": {"r": 0, "q": 1}},
    {"op": "plumbing_remove", "occupant": "r"},
    {"op": "plumbing_expect", "state": {"num_pipes": 2}},

    {"op": "plumbing_pipes", "prefix": "c", "count": 10, "x0": 0, "z0": 40},
    {"op": "plumbing_expect", "state": {"num_pipes": 12}},
    {"op": "plumbing_expect_line_item", "line": 2, "expenses": 1},
    {"op": "plumbing_pipes", "prefix": "d", "count": 6, "x0": 0, "z0": 41},
    {"op": "plumbing_expect", "state": {"num_pipes": 18}},
    {"op": "plumbing_expect_line_item", "line": 2, "expenses": 2},
    {"op": "plumbing_remove", "occupant": "d5"},
    {"op": "plumbing_expect_line_item", "line": 2, "expenses": 2},
    {"op": "plumbing_call", "method": "pipe_cost", "args": [5, 0.1], "expect": 0},
    {"op": "plumbing_call", "method": "pipe_cost", "args": [15, 0.1], "expect": 2},
    {"op": "plumbing_call", "method": "pipe_cost", "args": [12, 0.1], "expect": 1},
    {"op": "plumbing_call", "method": "pipe_cost", "args": [18, 0.1], "expect": 2},
    {"op": "plumbing_call", "method": "pipe_cost", "args": [0, 0.1], "expect": 0},

    {"op": "plumbing_pipe", "label": "b", "x": 50, "z": 50, "flags": "0x30000"},
    {"op": "plumbing_set", "state": {"num_distressed": 3, "num_burst": 2}},
    {"op": "plumbing_expect", "state": {"num_pipes": 18, "num_distressed": 3, "num_burst": 2}},
    {"op": "plumbing_remove", "occupant": "b"},
    {"op": "plumbing_expect", "state": {"num_pipes": 17, "num_distressed": 2, "num_burst": 1}},
    {"op": "plumbing_call", "method": "num_pipes", "expect": 17},
    {"op": "plumbing_call", "method": "num_distressed_pipes", "expect": 2},
    {"op": "plumbing_call", "method": "num_burst_pipes", "expect": 1},
    {"op": "plumbing_expect_refs", "refs": {"b": 0}},

    {"op": "plumbing_pipe", "label": "pv", "x": 52, "z": 52, "dirs": [0], "flags": "0x80000000"},
    {"op": "plumbing_expect", "state": {"num_pipes": 17}},
    {"op": "plumbing_expect_flags", "cells": [{"x": 52, "z": 52, "v": 0}]},
    {"op": "plumbing_building", "label": "ghost", "x": 54, "z": 54, "props": {"0x029244DB": {"bool": true}, "0xC8ED2D84": {"i32": 50}}},
    {"op": "plumbing_expect", "state": {"demand": 0}},
    {"op": "plumbing_expect_flags", "cells": [{"x": 54, "z": 54, "v": 0}]}
  ]
}
