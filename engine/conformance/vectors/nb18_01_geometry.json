{
  "format": 1,
  "name": "nb18_01_geometry",
  "spec": ["neighbors 2.1", "neighbors 2.2", "neighbors 4.2", "neighbors 6.2", "neighbors 18"],
  "description": "Conformance test 1. Side classification of (-1,5), (64,5), (5,-1), (5,64), (5,5) in a 64x64 city; for a 1x1 city at region cell (3,3) and 2x2 neighbours W (1,3), E (4,2), N (2,1), S (3,4): the neighbouring region cell and the neighbour's connection cell on each side ((2,3) -> (128,5); (4,3) -> (-1,69); (3,2) -> (69,128); (3,4) -> (5,-1)); corners and interior cells are invalid; an interior cell converts to the neighbour cell (0, 0) with our own regional city (NB6: the helper starts its outputs zeroed and has no interior row), and FindConnectionOnOtherSide still gives null there. The same through the simulator and the region: FindCityOnOtherSideOfConnection and FindConnectionOnOtherSide (the neighbour's FindConnection at the converted cell).",
  "steps": [
    {"op": "neighbors_geometry", "fn": "side", "args": [-1, 5, 64, 64], "expect": "west"},
    {"op": "neighbors_geometry", "fn": "side", "args": [64, 5, 64, 64], "expect": "east"},
    {"op": "neighbors_geometry", "fn": "side", "args": [5, -1, 64, 64], "expect": "north"},
    {"op": "neighbors_geometry", "fn": "side", "args": [5, 64, 64, 64], "expect": "south"},
    {"op": "neighbors_geometry", "fn": "side", "args": [5, 5, 64, 64], "expect": "interior"},

    {"op": "neighbors_geometry", "fn": "neighbouring_region_cell", "args": ["west", -1, 5, [3, 3], [1, 1]], "expect": [2, 3]},
    {"op": "neighbors_geometry", "fn": "neighbouring_region_cell", "args": ["east", 64, 5, [3, 3], [1, 1]], "expect": [4, 3]},
    {"op": "neighbors_geometry", "fn": "neighbouring_region_cell", "args": ["north", 5, -1, [3, 3], [1, 1]], "expect": [3, 2]},
    {"op": "neighbors_geometry", "fn": "neighbouring_region_cell", "args": ["south", 5, 64, [3, 3], [1, 1]], "expect": [3, 4]},

    {"op": "neighbors_geometry", "fn": "neighbour_connection_cell", "args": ["west", -1, 5, [2, 3], [1, 3], [2, 2]], "expect": [128, 5]},
    {"op": "neighbors_geometry", "fn": "neighbour_connection_cell", "args": ["east", 64, 5, [4, 3], [4, 2], [2, 2]], "expect": [-1, 69]},
    {"op": "neighbors_geometry", "fn": "neighbour_connection_cell", "args": ["north", 5, -1, [3, 2], [2, 1], [2, 2]], "expect": [69, 128]},
    {"op": "neighbors_geometry", "fn": "neighbour_connection_cell", "args": ["south", 5, 64, [3, 4], [3, 4], [2, 2]], "expect": [5, -1]},
    {"op": "neighbors_geometry", "fn": "neighbour_connection_cell", "args": ["interior", 5, 5, [3, 3], [3, 3], [1, 1]], "expect": [0, 0]},

    {"op": "neighbors_geometry", "fn": "is_valid_connection_cell", "args": [-1, 5, [1, 1]], "expect": true},
    {"op": "neighbors_geometry", "fn": "is_valid_connection_cell", "args": [5, 64, [1, 1]], "expect": true},
    {"op": "neighbors_geometry", "fn": "is_valid_connection_cell", "args": [128, 5, [2, 2]], "expect": true},
    {"op": "neighbors_geometry", "fn": "is_valid_connection_cell", "args": [69, 128, [2, 2]], "expect": true},
    {"op": "neighbors_geometry", "fn": "is_valid_connection_cell", "args": [-1, -1, [1, 1]], "expect": false},
    {"op": "neighbors_geometry", "fn": "is_valid_connection_cell", "args": [64, -1, [1, 1]], "expect": false},
    {"op": "neighbors_geometry", "fn": "is_valid_connection_cell", "args": [-1, 64, [1, 1]], "expect": false},
    {"op": "neighbors_geometry", "fn": "is_valid_connection_cell", "args": [64, 64, [1, 1]], "expect": false},
    {"op": "neighbors_geometry", "fn": "is_valid_connection_cell", "args": [5, 5, [1, 1]], "expect": false},

    {"op": "neighbors_geometry", "fn": "connection_inner_cell", "args": [-1, 5, 64, 64], "expect": [0, 5]},
    {"op": "neighbors_geometry", "fn": "connection_inner_cell", "args": [5, 64, 64, 64], "expect": [5, 63]},
    {"op": "neighbors_geometry", "fn": "connection_inner_cell", "args": [-1, -1, 64, 64], "expect": null},
    {"op": "neighbors_geometry", "fn": "connection_inner_cell", "args": [5, 5, 64, 64], "expect": null},

    {"op": "neighbors_env", "current": 1},
    {"op": "neighbors_city", "id": 1, "pos": [3, 3], "size": [1, 1]},
    {"op": "neighbors_city", "id": 2, "pos": [1, 3], "size": [2, 2], "conns": [["road", 128, 5, true]]},
    {"op": "neighbors_city", "id": 3, "pos": [4, 2], "size": [2, 2], "conns": [["road", -1, 69, false]]},
    {"op": "neighbors_city", "id": 4, "pos": [2, 1], "size": [2, 2]},
    {"op": "neighbors_city", "id": 5, "pos": [3, 4], "size": [2, 2]},
    {"op": "neighbors_create"},
    {"op": "neighbors_call", "method": "find_city_on_other_side_of_connection", "args": [-1, 5], "expect": 2},
    {"op": "neighbors_call", "method": "find_city_on_other_side_of_connection", "args": [64, 5], "expect": 3},
    {"op": "neighbors_call", "method": "find_city_on_other_side_of_connection", "args": [5, -1], "expect": 4},
    {"op": "neighbors_call", "method": "find_city_on_other_side_of_connection", "args": [5, 64], "expect": 5},
    {"op": "neighbors_call", "method": "neighbour_cell", "args": [-1, 5], "expect": [2, 128, 5]},
    {"op": "neighbors_call", "method": "neighbour_cell", "args": [64, 5], "expect": [3, -1, 69]},
    {"op": "neighbors_call", "method": "neighbour_cell", "args": [5, -1], "expect": [4, 69, 128]},
    {"op": "neighbors_call", "method": "neighbour_cell", "args": [5, 64], "expect": [5, 5, -1]},
    {"op": "neighbors_call", "method": "find_city_on_other_side_of_connection", "args": [10, 20], "expect": 1},
    {"op": "neighbors_call", "method": "neighbour_cell", "args": [10, 20], "expect": [1, 0, 0]},
    {"op": "neighbors_call", "method": "find_connection_on_other_side", "args": ["road", -1, 5], "expect": {"token": "0xF000", "active": true}},
    {"op": "neighbors_call", "method": "find_connection_on_other_side", "args": ["road", 64, 5], "expect": {"token": "0xF000", "active": false}},
    {"op": "neighbors_call", "method": "find_connection_on_other_side", "args": ["rail", -1, 5], "expect": null},
    {"op": "neighbors_call", "method": "find_connection_on_other_side", "args": ["road", 5, -1], "expect": null},
    {"op": "neighbors_call", "method": "find_connection_on_other_side", "args": ["road", 10, 20], "expect": null}
  ]
}
