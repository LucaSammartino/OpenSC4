{
  "format": 1,
  "name": "park_init",
  "spec": ["parks 1", "parks 3", "parks 4.1", "parks 8", "parks 12.1"],
  "description": "QueryInterface answers 1, 0xAA3FE6BC, 0x452294AA and 0xE4FDA3D4; GetGZCLSID is 0xAA3FE6BC. Init reads the tuning once per object, holds the city and the budget, creates the Parks and Recreation department (0x8A4260A6, group 0x6A357B96, name 0x6A3FF01C/0xCA49375E, maximum 1.0) only when it is missing and holds it, holds the lot manager and the message server, subscribes 0x99EF1142 and 0x99EF1143 and registers one month agent with flags 2. A second Init does nothing. Shutdown releases both lists, removes the agent, unsubscribes, then releases the message server, the department, the lot manager, the budget and the city; the latch and the tuning are kept. Release at count 1 runs Shutdown and returns 0.",
  "steps": [
    {"op": "park_create"},
    {"op": "park_identity", "class": "0xAA3FE6BC",
      "iids": {"0x1": true, "0xAA3FE6BC": true, "0x452294AA": true, "0xE4FDA3D4": true, "0x0": false, "0x0A413481": false, "0x8A41322F": false}},
    {"op": "park_expect", "state": {"initialized": false, "ref_count": 0, "threshold": 0.25, "curve_points": 0, "tuning_read": false}},

    {"op": "park_env", "create_departments": false},
    {"op": "park_init", "expect": true},
    {"op": "park_expect_events", "events": [
      {"event": "tuning"},
      {"event": "acquire", "service": "city"},
      {"event": "acquire", "service": "budget"},
      {"event": "create_department", "id": "0x8A4260A6", "group": "0x6A357B96"},
      {"event": "acquire", "service": "lot_manager"},
      {"event": "acquire", "service": "message_server"},
      {"event": "subscribe", "type": "0x99EF1142"},
      {"event": "subscribe", "type": "0x99EF1143"},
      {"event": "agent", "level": 6, "name": "cSC4ParkManager", "flags": 2}
    ]},
    {"op": "park_expect", "state": {"initialized": true, "department": null, "tuning_read": true, "city_held": true,
      "budget_held": true, "lot_manager_held": true, "message_server_held": true}},
    {"op": "park_shutdown", "expect": true},
    {"op": "park_env", "create_departments": true},
    {"op": "park_clear_events"},
    {"op": "park_init", "expect": true, "note": "the tuning is not read again"},
    {"op": "park_expect_events", "events": [
      {"event": "acquire", "service": "city"},
      {"event": "acquire", "service": "budget"},
      {"event": "create_department", "id": "0x8A4260A6", "group": "0x6A357B96"},
      {"event": "department_name", "department": "0x8A4260A6", "group": "0x6A3FF01C", "instance": "0xCA49375E"},
      {"event": "max_funding", "department": "0x8A4260A6", "max": 1.0},
      {"event": "add_ref", "token": "0x8A4260A6"},
      {"event": "acquire", "service": "lot_manager"},
      {"event": "acquire", "service": "message_server"},
      {"event": "subscribe", "type": "0x99EF1142"},
      {"event": "subscribe", "type": "0x99EF1143"},
      {"event": "agent", "level": 6, "name": "cSC4ParkManager", "flags": 2}
    ]},
    {"op": "park_expect", "state": {"department": "0x8A4260A6"}},
    {"op": "park_expect_refs", "refs": {"0x8A4260A6": 1}},
    {"op": "park_init", "expect": true},
    {"op": "park_expect_events", "events": []},

    {"op": "park_building", "occupant": "0x10", "groups": ["park"]},
    {"op": "park_building", "occupant": "0x11", "groups": ["zoo"]},
    {"op": "park_message", "type": "OccupantInserted", "occupant": "0x10", "expect": true},
    {"op": "park_message", "type": "OccupantInserted", "occupant": "0x11", "expect": true},
    {"op": "park_set", "underfunded": true},
    {"op": "park_clear_events"},
    {"op": "park_shutdown", "expect": true},
    {"op": "park_expect_events", "events": [
      {"event": "release", "token": "0x10"},
      {"event": "release", "token": "0x11"},
      {"event": "remove_agent"},
      {"event": "unsubscribe", "type": "0x99EF1142"},
      {"event": "unsubscribe", "type": "0x99EF1143"},
      {"event": "release_service", "service": "message_server"},
      {"event": "release", "token": "0x8A4260A6"},
      {"event": "release_service", "service": "lot_manager"},
      {"event": "release_service", "service": "budget"},
      {"event": "release_service", "service": "city"}
    ]},
    {"op": "park_expect", "state": {"initialized": false, "parks": [], "zoos": [], "department": null, "underfunded": true,
      "tuning_read": true, "city_held": false, "budget_held": false, "lot_manager_held": false, "message_server_held": false}},
    {"op": "park_expect_refs", "refs": {"0x8A4260A6": 0, "0x10": 0, "0x11": 0}},
    {"op": "park_shutdown", "expect": true},
    {"op": "park_expect_events", "events": []},

    {"op": "park_create", "note": "the department exists now: found, not created"},
    {"op": "park_env", "services": {"message_server": false, "city": false}},
    {"op": "park_init", "expect": true},
    {"op": "park_expect_events", "events": [
      {"event": "tuning"},
      {"event": "acquire", "service": "city", "ok": false},
      {"event": "acquire", "service": "budget"},
      {"event": "add_ref", "token": "0x8A4260A6"},
      {"event": "acquire", "service": "lot_manager"},
      {"event": "acquire", "service": "message_server", "ok": false},
      {"event": "agent"}
    ]},
    {"op": "park_shutdown", "expect": true},
    {"op": "park_expect_events", "events": [
      {"event": "remove_agent"},
      {"event": "release", "token": "0x8A4260A6"},
      {"event": "release_service", "service": "lot_manager"},
      {"event": "release_service", "service": "budget"}
    ]},
    {"op": "park_env", "services": {"message_server": true, "city": true}},

    {"op": "park_create"},
    {"op": "park_init", "expect": true},
    {"op": "park_add_ref", "expect": 1},
    {"op": "park_add_ref", "expect": 2},
    {"op": "park_release", "expect": 1},
    {"op": "park_clear_events"},
    {"op": "park_release", "expect": 0},
    {"op": "park_expect", "state": {"destroyed": true, "initialized": false, "ref_count": 1}},
    {"op": "park_expect_event_count", "filter": {"event": "remove_agent"}, "count": 1}
  ]
}
