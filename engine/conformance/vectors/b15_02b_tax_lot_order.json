{
  "format": 1,
  "name": "budget_tax_lot_order",
  "spec": ["budget 5.2", "budget 15.2", "BQ3"],
  "description": "The budget 5.2 worked example (BQ3 [compat]): medium (multiplier 1.1), 9 %, four lots whose assessed values are 104410 and 362120 in R$, then 258840 and 70630 in CS$. ComputeTax adds each lot's tax to the float32 running total first, then to its group, lot by lot in the order the lots are visited, and returns trunc(total). In list order the total is 6567.0 (0x45CD3800) and ComputeTax returns 6567; in reverse order it is 6566.9995 (0x45CD37FF), 6566. Both orders give the same lines, R$ 3848 and CS$ 2718 (sum 6566): the total is never formed from the lines or the group sums.",
  "steps": [
    {"op": "budget_env", "difficulty": 1},
    {"op": "budget_create"},
    {"op": "budget_init", "tuning": {"0x6A9C7718": [500000, 200000, 100000], "0x890E0A99": 25, "0x090E0A9F": -100000,
      "0x490E0AA6": 5000, "0x090E0AAC": 10, "0x890E0AB4": 200000, "0x8A3FB98D": 8.5, "0x0A3FB9A8": 120,
      "0x0C032488": [9, 9, 9], "0xEBFF69E7": [1.2, 1.1, 1.0], "0x8A480DF7": [1, 0.75, 0.5], "0x4AC519B8": [0, 0, 255, 0]}},

    {"op": "budget_lots", "lots": [
      {"purpose": 1, "building_wealth": 1, "lot_wealth": 1, "value": 104410},
      {"purpose": 1, "building_wealth": 1, "lot_wealth": 1, "value": 362120},
      {"purpose": 2, "building_wealth": 1, "lot_wealth": 1, "value": 258840},
      {"purpose": 2, "building_wealth": 1, "lot_wealth": 1, "value": 70630}
    ]},
    {"op": "budget_call", "method": "compute_tax", "expect": 6567, "note": "list order: total 0x45CD3800"},
    {"op": "budget_expect", "state": {"tax": {"0": {"weighted_assessed": 466530, "monthly_tax": 3848}, "3": {"weighted_assessed": 329470, "monthly_tax": 2718}}}},

    {"op": "budget_lots", "lots": [
      {"purpose": 2, "building_wealth": 1, "lot_wealth": 1, "value": 70630},
      {"purpose": 2, "building_wealth": 1, "lot_wealth": 1, "value": 258840},
      {"purpose": 1, "building_wealth": 1, "lot_wealth": 1, "value": 362120},
      {"purpose": 1, "building_wealth": 1, "lot_wealth": 1, "value": 104410}
    ]},
    {"op": "budget_call", "method": "compute_tax", "expect": 6566, "note": "reverse order: total 0x45CD37FF"},
    {"op": "budget_expect", "state": {"tax": {"0": {"weighted_assessed": 466530, "monthly_tax": 3848}, "3": {"weighted_assessed": 329470, "monthly_tax": 2718}}}}
  ]
}
