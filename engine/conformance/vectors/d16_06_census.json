{
  "format": 1,
  "name": "demand_census",
  "spec": ["demand 6.1", "demand 6.2", "demand 6.3", "demand 6.4", "demand 10.2", "demand 13", "demand 16.6"],
  "description": "Census on a fake city (4x2 cells): a 2x1 R$ lot contributes once per cell; EQ buckets 50 -> 1, 51 -> 2, 150 -> 3, 151 -> 4 (the EQ is truncated first); desirability/100 clamped to 0..1 weights occupancy; purpose 4 (Tourism), lots without capacity and negative desirability add nothing; C/I lots count under devType + 1. A new city starts in state 3; only NewMonth sets 3 -> 0 and a running census is not restarted; SimIdle(data3) slices the scan (deadline checked per cell [choice], at least one cell per call) and a single unbounded slice gives the same census; deltas against the previous census are applied as pending supply (regionUse 1) or demand (regionUse 2), not at all for regionUse 0, and the previous value is only updated where the node exists.",
  "steps": [
    {"op": "demand_env", "cells": [4, 2], "clock_step": 1},
    {"op": "demand_building", "type": "0x100", "purpose": 1},
    {"op": "demand_building", "type": "0x200", "purpose": 2},
    {"op": "demand_building", "type": "0x300", "purpose": 4},
    {"op": "demand_cells", "cells": [{"x": 0, "z": 0, "building_type": "0x100", "wealth": 1, "eq": 50, "desirability": 100, "capacity": 100, "workforce": 0.5}, {"x": 1, "z": 0, "building_type": "0x100", "wealth": 1, "eq": 51.9, "desirability": 100, "capacity": 100, "workforce": 0.5}, {"x": 2, "z": 0, "building_type": "0x100", "wealth": 2, "eq": 150, "desirability": 50, "capacity": 200, "workforce": 0.25}, {"x": 3, "z": 0, "building_type": "0x100", "wealth": 3, "eq": 151, "desirability": 150, "capacity": 40, "workforce": 1.0}, {"x": 0, "z": 1, "building_type": "0x200", "wealth": 2, "desirability": 80, "capacity": 50}, {"x": 1, "z": 1, "building_type": "0x300", "wealth": 2, "desirability": 100, "capacity": 999}, {"x": 2, "z": 1, "building_type": "0x200", "wealth": 2, "desirability": 100, "capacity": 999, "has_capacity": false}, {"x": 3, "z": 1, "building_type": "0x200", "wealth": 2, "desirability": -20, "capacity": 1000}]},
    {"op": "demand_exemplar", "instance": "0x1011", "region_use": 1},
    {"op": "demand_exemplar", "instance": "0x1021", "region_use": 1},
    {"op": "demand_exemplar", "instance": "0x1031", "region_use": 1},
    {"op": "demand_exemplar", "instance": "0x2111", "region_use": 1},
    {"op": "demand_exemplar", "instance": "0x2123", "region_use": 2},
    {"op": "demand_exemplar", "instance": "0x2134", "region_use": 0},
    {"op": "demand_exemplar", "instance": "0x3121", "region_use": 1},
    {"op": "demand_create"},
    {"op": "demand_init", "expect": true},
    {"op": "demand_expect", "state": {"census_state": 3, "previous_census": {"0x1011": 0, "0x1021": 0, "0x1031": 0, "0x2111": 0, "0x2112": 0, "0x2113": 0, "0x2114": 0, "0x2121": 0, "0x2122": 0, "0x2123": 0, "0x2124": 0, "0x2131": 0, "0x2132": 0, "0x2133": 0, "0x2134": 0, "0x3111": 0, "0x3121": 0, "0x3131": 0, "0x3321": 0, "0x3331": 0, "0x4101": 0, "0x4201": 0, "0x4301": 0, "0x4401": 0}}},
    {"op": "demand_message", "type": "SimIdle", "data3": 1000, "expect": true},
    {"op": "demand_message", "type": "SimNewDay", "expect": true},
    {"op": "demand_expect", "state": {"census_state": 3}},
    {"op": "demand_message", "type": "SimNewMonth", "expect": true},
    {"op": "demand_expect", "state": {"census_state": 0}},
    {"op": "demand_message", "type": "SimIdle", "data3": 2},
    {"op": "demand_expect", "state": {"census_state": 1, "cursor": [2, 0], "current_census": {"0x1011": 200, "0x1021": 0, "0x1031": 0, "0x2111": 50, "0x2112": 50, "0x2113": 0, "0x2114": 0, "0x2121": 0, "0x2122": 0, "0x2123": 0, "0x2124": 0, "0x2131": 0, "0x2132": 0, "0x2133": 0, "0x2134": 0, "0x3111": 0, "0x3121": 0, "0x3131": 0, "0x3321": 0, "0x3331": 0, "0x4101": 0, "0x4201": 0, "0x4301": 0, "0x4401": 0}}},
