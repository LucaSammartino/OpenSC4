    {"op": "demand_expect", "state": {"census_state": 2, "current_census": {"0x1011": 200, "0x1021": 100, "0x1031": 40, "0x2111": 50, "0x2112": 50, "0x2113": 0, "0x2114": 0, "0x2121": 0, "0x2122": 0, "0x2123": 25, "0x2124": 0, "0x2131": 0, "0x2132": 0, "0x2133": 0, "0x2134": 40, "0x3111": 0, "0x3121": 40, "0x3131": 0, "0x3321": 0, "0x3331": 0, "0x4101": 0, "0x4201": 0, "0x4301": 0, "0x4401": 0}, "previous_census": {"0x1011": 200, "0x1021": 100, "0x1031": 40, "0x2111": 50, "0x2112": 0, "0x2113": 0, "0x2114": 0, "0x2121": 0, "0x2122": 0, "0x2123": 25, "0x2124": 0, "0x2131": 0, "0x2132": 0, "0x2133": 0, "0x2134": 40, "0x3111": 0, "0x3121": 40, "0x3131": 0, "0x3321": 0, "0x3331": 0, "0x4101": 0, "0x4201": 0, "0x4301": 0, "0x4401": 0}}},
    {"op": "demand_expect_node", "key": "0x1011", "state": {"supply": 200, "new_supply": 0}},
    {"op": "demand_expect_node", "key": "0x2123", "state": {"new_demand": 0}},
    {"op": "demand_message", "type": "SimIdle", "data3": 0},
    {"op": "demand_expect", "state": {"census_state": 3}},
    {"op": "demand_cells", "replace": false, "cells": [{"x": 0, "z": 0, "building_type": "0x100", "wealth": 1, "eq": 50, "desirability": 50, "capacity": 100, "workforce": 0.5}]},
    {"op": "demand_message", "type": "SimNewMonth"},
