{
  "format": 1,
  "name": "hw12_02_store",
  "spec": ["history 4.1", "history 4.8", "history 12"],
  "description": "Test 2. RecordHistoryData only sends 0x89EFA536 (data1 = key, data2 = value) through MessageSend; before Init nothing is subscribed, so nothing is stored. After Init the warehouse's DoMessage stores it. The recording example of 4.8: SetSize(K, 2), days 100, 101, 101, 102 record 5, 6, 7, 8: after day 101 (100, 5), (101, 7); day 102 erases (100, 5) and appends (102, 8). A record on an earlier day (50, unsigned day <= last.date) overwrites the last value. A new key gets maxCount 0. A full queue (4 points, maxCount 2 set without trimming) drops one point per record.",
  "steps": [
    {"op": "hw_create"},
    {"op": "hw_env", "date": 100},
    {"op": "hw_call", "method": "record", "args": ["0xAA11F837", 1], "expect": true},
    {"op": "hw_expect_events", "events": [{"event": "send", "msg": "0x89EFA536", "data1": "0xAA11F837", "data2": 1, "delivered": false}]},
    {"op": "hw_expect", "series": "0xAA11F837", "missing": true},
    {"op": "hw_call", "method": "init", "expect": true},
    {"op": "hw_clear_events"},
    {"op": "hw_call", "method": "set_size", "args": ["0xAA11F837", 2], "expect": true},
    {"op": "hw_call", "method": "record", "args": ["0xAA11F837", 5], "expect": true},
    {"op": "hw_env", "date": 101},
    {"op": "hw_call", "method": "record", "args": ["0xAA11F837", 6], "expect": true},
    {"op": "hw_call", "method": "record", "args": ["0xAA11F837", 7], "expect": true},
    {"op": "hw_expect", "series": "0xAA11F837", "points": [[100, 5], [101, 7]], "max_count": 2},
    {"op": "hw_env", "date": 102},
    {"op": "hw_call", "method": "record", "args": ["0xAA11F837", 8], "expect": true},
    {"op": "hw_expect", "series": "0xAA11F837", "points": [[101, 7], [102, 8]]},
    {"op": "hw_expect_events", "filter": {"event": "send"}, "events": [{"msg": "0x89EFA536", "data1": "0xAA11F837", "data2": 5, "delivered": true}, {"data2": 6}, {"data2": 7}, {"data2": 8}]},
    {"op": "hw_env", "date": 50},
    {"op": "hw_call", "method": "message", "args": ["0x89EFA536", "0xAA11F837", 9], "expect": true},
    {"op": "hw_expect", "series": "0xAA11F837", "points": [[101, 7], [102, 9]]},
    {"op": "hw_call", "method": "message", "args": ["0x89EFA536", "0x1234", "0xFFFFFFFD"], "expect": true},
    {"op": "hw_expect", "series": "0x1234", "points": [[50, -3]], "max_count": 0},
    {"op": "hw_series", "key": "0x77", "points": [[1, 1], [2, 2], [3, 3], [4, 4]], "max_count": 2},
    {"op": "hw_env", "date": 5},
    {"op": "hw_call", "method": "record", "args": ["0x77", 5], "expect": true},
    {"op": "hw_expect", "series": "0x77", "points": [[2, 2], [3, 3], [4, 4], [5, 5]]}
  ]
}
