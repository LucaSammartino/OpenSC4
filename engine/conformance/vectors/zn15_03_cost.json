{
  "format": 1,
  "name": "zn15_03_cost",
  "spec": [
    "zones 6",
    "zones 4",
    "zones 15.3"
  ],
  "description": "Conformance test 3 (cost, \u00a76). On 6 unzoned dry flat cells (3 \u00d7 2 at x 0..2, z 0..1), PlaceZone(type 1, commit, skipFunds = 0, checkSlope = 0) with funds 1000 -> cost 60 (6 \u00d7 (create[1] 10 + destroy[0] 0)), funds 940, zoneCount[1] = 6, zoneCount[0] = 4090. Re-zoning them to 4 -> cost 66 (6 \u00d7 (10 + destroy[1] 1)), funds 874. Re-zoning them to 4 again -> cost 0, counts unchanged, one ZoningChange posted. With funds 59 and a fresh 3 \u00d7 2 rect whose cost is 60 -> false, error 1, grid unchanged. The developer is not created, so committing runs no parcellization (no lots); the test isolates the zone manager's cost accounting.",
  "steps": [
    {
      "op": "zone_env",
      "cells": [
        64,
        64
      ],
      "funds": 1000
    },
    {
      "op": "zone_create",
      "session": 0,
      "manager": true,
      "developer": false
    },
    {
      "op": "zone_init"
    },
    {
      "op": "zone_place_zone",
      "region": {
        "rect": [
          0,
          0,
          2,
          1
        ]
      },
      "type": 1,
      "commit": true,
      "skip_funds": false,
      "check_slope": false,
      "skip_size": true,
      "check_lot_inside": true,
      "expect": {
        "ok": true,
        "cost": 60,
        "error": 0
      }
    },
    {
      "op": "zone_expect",
      "state": {
        "funds": 940
      },
      "zones": [
        [
          0,
          0,
          1
        ],
        [
          1,
          0,
          1
        ],
        [
          2,
          0,
          1
        ],
        [
          0,
          1,
          1
        ],
        [
          1,
          1,
          1
        ],
        [
          2,
          1,
          1
        ]
      ]
    },
    {
      "op": "zone_call",
      "target": "manager",
      "method": "zone_count",
      "args": [
        1
      ],
      "expect": 6
    },
    {
      "op": "zone_call",
      "target": "manager",
      "method": "zone_count",
      "args": [
        0
      ],
      "expect": 4090
    },
    {
      "op": "zone_place_zone",
      "region": {
        "rect": [
          0,
          0,
          2,
          1
        ]
      },
      "type": 4,
      "commit": true,
      "skip_funds": false,
      "check_slope": false,
      "skip_size": true,
      "check_lot_inside": true,
      "expect": {
        "ok": true,
        "cost": 66,
        "error": 0
      }
    },
    {
      "op": "zone_expect",
      "state": {
        "funds": 874
      }
    },
    {
      "op": "zone_call",
      "target": "manager",
      "method": "zone_count",
      "args": [
        4
      ],
      "expect": 6
    },
    {
      "op": "zone_call",
      "target": "manager",
      "method": "zone_count",
      "args": [
        1
      ],
      "expect": 0
    },
    {
      "op": "zone_clear_events"
    },
    {
      "op": "zone_place_zone",
      "region": {
        "rect": [
          0,
          0,
          2,
          1
        ]
      },
      "type": 4,
      "commit": true,
      "skip_funds": false,
      "check_slope": false,
      "skip_size": true,
      "check_lot_inside": true,
      "expect": {
        "ok": true,
        "cost": 0,
        "error": 0
      }
    },
    {
      "op": "zone_call",
      "target": "manager",
      "method": "zone_count",
      "args": [
        4
      ],
      "expect": 6
    },
    {
      "op": "zone_expect",
      "zoning_changes": [
        {
          "zone": 4,
          "check_slope": false,
          "rect": [
            0,
            0,
            2,
            1
          ]
        }
      ]
    },
    {
      "op": "zone_env",
      "funds": 59
    },
    {
      "op": "zone_place_zone",
      "region": {
        "rect": [
          40,
          40,
          42,
          41
        ]
      },
      "type": 1,
      "commit": true,
      "skip_funds": false,
      "check_slope": false,
      "skip_size": true,
      "check_lot_inside": true,
      "expect": {
        "ok": false,
        "cost": 60,
        "error": 1
      }
    },
    {
      "op": "zone_expect",
      "state": {
        "funds": 59
      },
      "zones": [
        [
          40,
          40,
          0
        ],
        [
          42,
          41,
          0
        ]
      ]
    }
  ]
}
