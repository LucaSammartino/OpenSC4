{
  "format": 1,
  "name": "om18_08_newest_first",
  "spec": ["occupant-manager 4.2", "occupant-manager 7", "occupant-manager 8", "occupant-manager 18.8"],
  "description": "A, B, C inserted in that order into cell (66, 66): slot 30 returns C (front); slot 38 over that cell returns [C, B, A]; after removing C slot 30 returns B. Query results are released by the runner.",
  "steps": [
    {"op": "om_create"},
    {"op": "om_call", "method": "set_city_size", "args": [1024, 1024], "expect": true},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_occupant", "occupant": "0x1", "min": [130, 0, 130], "max": [140, 10, 140]},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 0, "expect": true},
    {"op": "om_occupant", "occupant": "0x2", "min": [130, 0, 130], "max": [140, 10, 140]},
    {"op": "om_call", "method": "insert", "occupant": "0x2", "data4": 0, "expect": true},
    {"op": "om_occupant", "occupant": "0x3", "min": [130, 0, 130], "max": [140, 10, 140]},
    {"op": "om_call", "method": "insert", "occupant": "0x3", "data4": 0, "expect": true},
    {"op": "om_call", "method": "first_in_cell", "args": [66, 66], "expect": "0x3"},
    {"op": "om_call", "method": "by_cells", "min": [66, 66], "max": [66, 66], "expect": true, "expect_list": ["0x3", "0x2", "0x1"]},
    {"op": "om_call", "method": "remove", "occupant": "0x3", "expect": true},
    {"op": "om_call", "method": "first_in_cell", "args": [66, 66], "expect": "0x2"},
    {"op": "om_call", "method": "first_in_cell", "args": [66, 66], "filter": {"type": 7}, "expect": null},
    {"op": "om_call", "method": "first_in_cell", "args": [192, 66], "expect": null, "note": "outside 0..191"},
    {"op": "om_expect_refs", "refs": {"0x1": 1, "0x2": 1, "0x3": 0}}
  ]
}
