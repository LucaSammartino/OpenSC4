{
  "format": 1,
  "name": "bds_idle_and_monthly_state_machine",
  "spec": ["building-development 3.1", "building-development 4.1", "building-development 4.2", "building-development 4.3"],
  "description": "The monthly / idle state machine, by hand from 3.1, 4.1 and 4.2. Developers 0x1010 (257, IsMapUpdateFinished false twice after each StartMapUpdate) and 0x3110 (258, finishes at once); shipped tuning; census R 10000, C 4000, I 2000 -> supply clamp(8000, 8192, 20480) = 8192. SimBegin (level 0) in state 0: supply 8192, StartMapUpdate for 257 then 258 (ascending type), state 1. A SimNewMonth while state != 0 does nothing. SimIdle: state 1 -> cursor = first developer, state 2, ask 257: false -> return (state 2, cursor 0x1010); next SimIdle asks 257 again: false; next: 257 true, 258 true -> state 3 -> 4 (no PlanGrowth). Next SimIdle (state 4): PlanDecline (no developer below -20: one RandomUint32Uniform(0), no step, empty plan) and state 0. A day message runs DoIdle (state 0: nothing) then Grow (ads 0: one non-stepping draw) and the decline plan. SimNewMonth in state 0 starts the next rebuild (with 2 more unfinished answers for 257). A day message in state 1 runs DoIdle first: the rebuild progresses on day messages too. The idle message's data3 is ignored.",
  "steps": [
    {"op": "bds_process", "seed": 1},
    {"op": "bds_world", "tuning": "shipped", "census": {"0x1001": 10000, "0x3001": 4000, "0x4001": 2000}},
    {"op": "bds_exemplars", "list": [{"developer": "0x1010"}, {"developer": "0x3110"}]},
    {"op": "bds_developers", "devs": {"0x1010": {"ad": 0, "finish_after": 2}, "0x3110": {"ad": 0}}},
    {"op": "bds_create", "grow_budget": 4294967295},
    {"op": "bds_init", "expect": true},
    {"op": "bds_clear_events"},
    {"op": "bds_message", "type": "SimBegin", "expect": true},
    {"op": "bds_expect_events", "events": [
      {"event": "start_map_update", "dev": 257},
      {"event": "start_map_update", "dev": 258}]},
    {"op": "bds_expect", "state": {"state": 1, "supply": 8192.0, "cursor": null}},
    {"op": "bds_message", "type": "SimNewMonth", "expect": true},
    {"op": "bds_expect_events", "events": []},

    {"op": "bds_message", "type": "SimIdle", "data3": 77, "expect": true},
    {"op": "bds_expect_events", "events": [{"event": "map_update_finished", "dev": 257, "result": false}]},
    {"op": "bds_expect", "state": {"state": 2, "cursor": "0x1010"}},
    {"op": "bds_clear_events"},
    {"op": "bds_message", "type": "SimIdle"},
    {"op": "bds_expect_events", "events": [{"event": "map_update_finished", "dev": 257, "result": false}]},
    {"op": "bds_clear_events"},
    {"op": "bds_message", "type": "SimIdle"},
    {"op": "bds_expect_events", "events": [
      {"event": "map_update_finished", "dev": 257, "result": true},
      {"event": "map_update_finished", "dev": 258, "result": true}]},
    {"op": "bds_expect", "state": {"state": 4, "cursor": null, "decline_plan": []}},
    {"op": "bds_clear_events"},
    {"op": "bds_message", "type": "SimIdle"},
    {"op": "bds_expect_events", "events": [{"event": "draw", "n": 0, "value": 0, "stepped": false}]},
    {"op": "bds_expect", "state": {"state": 0, "steps": 0}},
    {"op": "bds_clear_events"},
    {"op": "bds_message", "type": "SimIdle"},
    {"op": "bds_expect_events", "events": []},

    {"op": "bds_day"},
    {"op": "bds_expect_events", "events": [{"event": "draw", "n": 0, "stepped": false}]},
    {"op": "bds_clear_events"},
    {"op": "bds_world", "census": {"0x1001": 30000, "0x3001": 12000.5, "0x4001": 9000.25}},
    {"op": "bds_message", "type": "SimNewMonth"},
    {"op": "bds_expect_events", "events": [
      {"event": "start_map_update", "dev": 257},
      {"event": "start_map_update", "dev": 258}]},
    {"op": "bds_expect", "state": {"state": 1, "supply": 20480.0}},
    {"op": "bds_clear_events"},
    {"op": "bds_day"},
    {"op": "bds_expect_events", "events": [
      {"event": "map_update_finished", "dev": 257, "result": false},
      {"event": "draw", "n": 0, "stepped": false}]},
    {"op": "bds_expect", "state": {"state": 2}},
    {"op": "bds_clear_events"},
    {"op": "bds_day", "count": 3},
    {"op": "bds_expect_events", "events": [
      {"event": "map_update_finished", "dev": 257, "result": false},
      {"event": "draw", "n": 0, "stepped": false},
      {"event": "map_update_finished", "dev": 257, "result": true},
      {"event": "map_update_finished", "dev": 258, "result": true},
      {"event": "draw", "n": 0, "stepped": false},
      {"event": "draw", "n": 0, "stepped": false},
      {"event": "draw", "n": 0, "stepped": false}]},
    {"op": "bds_expect", "state": {"state": 0, "steps": 0}},

    {"op": "bds_call", "method": "monthly"},
    {"op": "bds_call", "method": "daily"},
    {"op": "bds_expect", "state": {"state": 1}},
    {"op": "bds_set", "state": {"state": 3}},
    {"op": "bds_clear_events"},
    {"op": "bds_call", "method": "do_idle"},
    {"op": "bds_call", "method": "monthly"},
    {"op": "bds_expect_events", "events": []},
    {"op": "bds_expect", "state": {"state": 3}}
  ]
}
