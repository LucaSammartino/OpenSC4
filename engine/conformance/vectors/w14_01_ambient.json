{
  "format": 1,
  "name": "weather_ambient",
  "spec": ["weather 3", "weather 6.1", "weather 8.1", "weather 9", "weather 14.1"],
  "description": "Ambient temperature baseTemp*(1 + cos(2pi(m-8)/12)*ampA*ampB) and moisture baseMoisture*(1 + cos(2pi(m-1)/12)*ampA*ampB) of the season month. Shipped tuning (65, 0.5, 0.5 / 0.2, 0.2, 1): month 8 -> 81.25, month 2 -> 48.75, moisture month 1 -> 0.24, month 7 -> 0.16. Without the exemplar the code defaults apply (24, 0.5, 0.5 / 0.5, 0.5, 0.4): 30, 18, 0.6, 0.4. Init sets the ambient values to the base values and reads every tuning field (clamps: subdiv >= 1, tempAmpA and moistAmpA to [0, 1], seaWeight >= 0; slopeK = value*255; windSpread = tan(deg*pi/360)*0.5); cellsPerWeek = cells / subdivX.",
  "steps": [
    {"op": "weather_env", "size": [16, 16], "month": 8},
    {"op": "weather_tuning", "shipped": true},
    {"op": "weather_create", "rng": {"stub": {"uniform": [0.5], "gaussian": [0], "int": [0]}}},
    {"op": "weather_init", "expect": true},
    {"op": "weather_expect", "state": {"initialized": true, "count_x": 16, "count_z": 16, "cell_width_x": 16, "inv_cell_width_x": 0.0625,
      "size_x": 256, "city_cells_per_cell_x": 1, "subdiv_x": 1, "subdiv_z": 1, "blend_radius": 1, "base_temp": 65, "temp_amp_a": 0.5,
      "temp_amp_b": 0.5, "ambient_temp": 65, "sea_radius": 10, "sea_weight": 0.9, "height_factor": 0.082, "wind_factor": 0.25,
      "base_moisture": 0.2, "moist_amp_a": 0.2, "moist_amp_b": 1, "ambient_moisture": 0.2, "slope_k": 89.25, "high_moisture": 1,
      "curvature_threshold": 2.5, "tuning80": 40, "tuning81": 16, "default_wind_speed": 3, "default_wind_dir": [0, 1],
      "wind_spread": 0.28867513, "cells_per_week": 256, "last_season": -1, "wind_month": -1}},
    {"op": "weather_call", "method": "new_current_ambient_values", "args": [8]},
    {"op": "weather_expect", "state": {"ambient_temp": 81.25, "ambient_moisture": 0.16535899, "wind_month": 8}},
    {"op": "weather_call", "method": "new_current_ambient_values", "args": [2]},
    {"op": "weather_expect", "state": {"ambient_temp": 48.75, "wind_month": 2}},
    {"op": "weather_call", "method": "new_current_ambient_values", "args": [1]},
    {"op": "weather_expect", "state": {"ambient_moisture": 0.24}},
    {"op": "weather_call", "method": "new_current_ambient_values", "args": [7]},
    {"op": "weather_expect", "state": {"ambient_moisture": 0.16}},
    {"op": "weather_message", "type": "SimNewMonth", "data3": 8, "expect": true},
    {"op": "weather_expect", "state": {"ambient_temp": 81.25, "ambient_moisture": 0.16535899, "wind_month": 8, "last_season": 2}},

    {"op": "weather_tuning", "none": true},
    {"op": "weather_create", "rng": {"stub": {"uniform": [0.5], "gaussian": [0], "int": [0]}}},
    {"op": "weather_init", "expect": true},
    {"op": "weather_expect", "state": {"subdiv_x": 8, "blend_radius": 1, "base_temp": 24, "ambient_temp": 24, "sea_radius": 6,
      "sea_weight": 0.95, "height_factor": 0.0035, "wind_factor": 0.25, "base_moisture": 0.5, "moist_amp_a": 0.5, "moist_amp_b": 0.4,
      "ambient_moisture": 0.5, "slope_k": 128, "high_moisture": 0.12, "curvature_threshold": 4, "tuning80": 64, "tuning81": 15,
      "default_wind_speed": 3, "default_wind_dir": [0, 1], "wind_speed": 3, "wind_dir": [1, 0], "wind_spread": 0.25, "cells_per_week": 32}},
    {"op": "weather_call", "method": "new_current_ambient_values", "args": [8]},
    {"op": "weather_expect", "state": {"ambient_temp": 30, "ambient_moisture": 0.41339746}},
    {"op": "weather_call", "method": "new_current_ambient_values", "args": [2]},
    {"op": "weather_expect", "state": {"ambient_temp": 18}},
    {"op": "weather_call", "method": "new_current_ambient_values", "args": [1]},
    {"op": "weather_expect", "state": {"ambient_moisture": 0.6}},

    {"op": "weather_tuning", "props": {"0xA7607D70": {"i32": 0}, "0xA7607D74": {"f32": 1.5}, "0xA7607D77": {"f32": -1},
      "0xA7607D7B": {"f32": -0.5}, "0xA7607D86": {"f32": 5}, "0xA7607D87": {"f32": -1}, "0xA7607D88": {"f32": 0},
      "0xA7607D89": {"f32": 90}}},
    {"op": "weather_create"},
    {"op": "weather_init", "expect": true},
    {"op": "weather_expect", "state": {"subdiv_x": 1, "subdiv_z": 8, "temp_amp_a": 1, "sea_weight": 0, "moist_amp_a": 0,
      "default_wind_speed": 5, "default_wind_dir": [-1, 0], "wind_spread": 0.5, "cells_per_week": 256, "base_temp": 24}}
  ]
}
