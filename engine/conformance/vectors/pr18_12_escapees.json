{
  "format": 1,
  "name": "protection_escapees",
  "spec": ["protection 9.5", "protection 10", "protection 12", "protection 16", "protection 18.12"],
  "description": "Test 12: BeginJailbreak of a jail with capacity 600: r = RandomDoubleRangeUniform(lo 0.1, hi 0.5) (stub u 0.375 -> r = 0.25), escaped = roundHalfEven(600 x 0.25) = 150, jailed 400 -> 250, Recalculate (population 250), post 0x2A614891 naming the jail, 'jailbreak' controllers added; returns true. The next DoMonthly: rehabilitation 25 -> 225; GetJailedPercentage 0.375 < end threshold 0.8 ends it (controllers removed, 0x2A614892, released); the start pass then draws nothing (chance curve(37.5) = 0). GetJailbreakBuildings with an empty list leaves the caller's list (quirk 7). A start: jailed 1000 of 600 -> rehab 100 -> 900 > capacity -> percentage 1.0, chance 1.0, uniform 0.5 < 1 begins (u 0.5 -> r 0.3, 180 escape -> 720). Quirk 8 (9.4): removing the jail drops it from the jail and funded-jail lists (two references, RemoveLocallyFundedObject, Recalculate -> capacity 0) but it stays in the jailbreak list holding one reference. Hand-derived.",
  "steps": [
    {"op": "protection_create", "kind": "police", "rng": {"stub": {"range": [0.375, 0.5], "uniform": [0.5]}}},
    {"op": "protection_env", "tuning": "shipped"},
    {"op": "protection_init"},
    {"op": "protection_occupants", "21": {"props": {"0x48D71EE0": {"u32": 600}}, "items": {"0xEA56768A": {"local": 1.0}}}},
    {"op": "protection_message", "type": "OccupantInserted", "occupant": 21},
    {"op": "protection_set", "state": {"jailed": 400}},
    {"op": "protection_call", "method": "recalculate"},
    {"op": "protection_clear_events"},
    {"op": "protection_call", "method": "begin_jailbreak", "args": [21], "expect": true},
    {"op": "protection_expect_events", "events": [{"event": "rng", "kind": "range", "lo": 0.10000000149011612, "hi": 0.5, "value": 0.2500000009313226}, {"event": "post", "type": "0x2A614891", "subject": 21}, {"event": "add_controllers", "group": "jailbreak", "occupant": 21}]},
    {"op": "protection_expect", "state": {"jailed": 250, "population": 250, "jailbreaks": [21]}},
    {"op": "protection_expect_refs", "refs": {"21": 3}},
    {"op": "protection_call", "method": "is_in_jailbreak", "args": [21], "expect": true},
    {"op": "protection_call", "method": "jailbreak_buildings", "args": [2], "expect": {"count": 1, "list": [21]}},
    {"op": "protection_message", "type": "SimNewMonth"},
    {"op": "protection_expect_events", "events": [{"event": "remove_controllers", "group": "jailbreak", "occupant": 21}, {"event": "post", "type": "0x2A614892", "subject": 21}]},
    {"op": "protection_expect", "state": {"jailed": 225, "population": 225, "jailbreaks": []}},
    {"op": "protection_expect_refs", "refs": {"21": 2}},
    {"op": "protection_call", "method": "jailbreak_buildings", "args": [2], "expect": {"count": 0, "list": [4294967295, 4294967295]}},
    {"op": "protection_set", "state": {"jailed": 1000}},
    {"op": "protection_message", "type": "SimNewMonth"},
    {"op": "protection_expect_events", "events": [{"event": "rng", "kind": "uniform", "value": 0.5}, {"event": "rng", "kind": "range", "lo": 0.10000000149011612, "hi": 0.5, "value": 0.30000000074505806}, {"event": "post", "type": "0x2A614891", "subject": 21}, {"event": "add_controllers", "group": "jailbreak", "occupant": 21}]},
    {"op": "protection_expect", "state": {"jailed": 720, "jailbreaks": [21]}},
    {"op": "protection_expect_refs", "refs": {"21": 3}},
    {"op": "protection_clear_events"},
    {"op": "protection_message", "type": "OccupantRemoved", "occupant": 21},
    {"op": "protection_expect_events", "events": [{"event": "remove_funded", "dept": "0xA2963984", "occupant": 21, "purpose": "0xEA56768A"}]},
    {"op": "protection_expect", "state": {"jails": [], "funded_jails": [], "jailbreaks": [21], "capacity": 0, "population": 0}},
    {"op": "protection_expect_refs", "refs": {"21": 1}},
    {"op": "protection_eval", "fn": "escapees", "args": [600, 0.25], "expect": 150}
  ]
}
