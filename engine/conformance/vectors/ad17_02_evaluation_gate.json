{
  "format": 1,
  "name": "advisor_evaluation_gate",
  "spec": ["advisors 6.2", "advisors 17.2"],
  "description": "An advice (frequency 35, timeout 45, trigger true) created on day 1000 in month 5 starts with nextDay 1000, expiry 0 and lastMonth 4. The day pass on day 1000 activates it (expiry 1045, lastMonth 5) and posts AdviceAdded with the advice; day 1045 deactivates it (nextDay 1080) and sends AdviceRemoved synchronously. On day 1080 in month 6 with lastMonth 6 it is not evaluated; after the next monthly step it is evaluated and activated again.",
  "steps": [
    {"op": "adv_advisor", "class": "Advisor", "id": 23},
    {"op": "adv_create"},
    {"op": "adv_init", "expect": true},
    {"op": "adv_set", "object": {"advisor": 23}, "month_counter": 5, "current_day": 1000},
    {"op": "adv_advice", "guid": "0x100", "trigger": "true", "once": false},
    {"op": "adv_advisor_init", "object": {"advisor": 23}, "table_index": 1, "expect": true},
    {"op": "adv_expect", "object": {"advice": "0x100"}, "state": {"active": false, "next_day": 1000, "expiry": 0, "last_month": 4}},
    {"op": "adv_clear_events"},

    {"op": "adv_day", "day": 1000, "advisor": {"advisor": 23}},
    {"op": "adv_expect", "object": {"advice": "0x100"}, "state": {"active": true, "expiry": 1045, "last_month": 5}},
    {"op": "adv_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x8A09FA64", "data1": 0, "object": "advice:0x100"}]},
    {"op": "adv_day", "day": 1045, "advisor": {"advisor": 23}},
    {"op": "adv_expect", "object": {"advice": "0x100"}, "state": {"active": false, "expiry": 0, "next_day": 1080}},
    {"op": "adv_expect_events", "filter": {"event": "send", "type": "0x8A09FA65"}, "events": [{"event": "send", "type": "0x8A09FA65", "data1": 0, "object": "advice:0x100"}]},

    {"op": "adv_set", "object": {"advisor": 23}, "month_counter": 6, "info": {"guid": "0x100", "last_month": 6}},
    {"op": "adv_day", "day": 1080, "advisor": {"advisor": 23}},
    {"op": "adv_expect", "object": {"advice": "0x100"}, "state": {"active": false}, "note": "lastMonth = month: not evaluated"},
    {"op": "adv_simulate", "advisor": {"advisor": 23}, "kind": 1},
    {"op": "adv_day", "day": 1080, "advisor": {"advisor": 23}},
    {"op": "adv_expect", "object": {"advice": "0x100"}, "state": {"active": true, "expiry": 1125}}
  ]
}
