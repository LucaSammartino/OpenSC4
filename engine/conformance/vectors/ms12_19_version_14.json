{
  "format": 1,
  "name": "mysim_version_14",
  "spec": ["mysims 6.2", "mysims 12.19"],
  "description": "A version-14 record (five discarded s32 instead of the car and pedestrian keys, no rows 25 and 31) loads with the keys zero and the last player trip day 0; it is written back as version 17.",
  "steps": [
    {"op": "mysim_create"},
