{
  "format": 1,
  "name": "residential_grade_totals",
  "spec": ["REH 2", "REH 4.6", "RS13"],
  "description": "RS13: the grade totals are accumulated by the EQ / HQ boost (residents reached x boost: 100 x 1.0 from a school of units 1 over a tract of 100), reset by state 0, never read and not saved: the record stays 452 bytes and a simulator read from it starts at 0.",
  "steps": [
    {"op": "residential_env", "groups": {"1": ["0x150F"]}, "props": {"1": {"0x8922041B": {"u32": 500}, "0x691B42B3": {"f32": 10}}}, "lots": {"1": [32, 32]}},
    {"op": "residential_create"},
    {"op": "residential_init", "expect": true},
    {"op": "residential_set", "state": {"lists": {"school_groups": [[1]]}}},
    {"op": "residential_tract", "x": 0, "z": 0, "steady": [100, 0, 0]},
    {"op": "residential_set", "state": {"state": 5}},
    {"op": "residential_run_to", "state": 7, "steps": 2},
    {"op": "residential_expect", "state": {"school_grade_total": 100, "hospital_grade_total": 0}},
    {"op": "residential_set", "state": {"lists": {"school_groups": [[]]}}},
    {"op": "residential_write", "slot": "a", "expect": true, "length": 452},
    {"op": "residential_set", "state": {"state": 0}},
    {"op": "residential_run_to", "state": 13, "steps": 1},
    {"op": "residential_expect", "state": {"school_grade_total": 0}},
    {"op": "residential_read", "slot": "a", "expect": true},
    {"op": "residential_expect", "state": {"school_grade_total": 0, "hospital_grade_total": 0}}
  ]
}
