{
  "format": 1,
  "name": "citysit_popup_and_entry_points",
  "spec": ["city-situation 3", "city-situation 4.3", "city-situation 4.6"],
  "description": "0xEBB67EF7 hides the mission status panel, ends an open MySim dialog and shows the popup by status (briefing while idle); button 6 activates the mission, 7 starts a joyride, 1 after a finished mission posts 0x6BB350E4, which leaves the player-drive mode and ends the situation. The player leaving the vehicle ends a mission unless it is finished. A target mission without a target cannot start (status 5, the popup posted without a vehicle, false); closing that popup cancels. InitiateSituationByGuid without a briefing activates at once. The cheat csitrigger and Lua activate_situation post 0xAC1045EF. ResetTutorials clears the counts and the reward list and saves the preferences.",
  "steps": [
    {"op": "citysit_env", "debug": true},
    {"op": "citysit_create"},
    {"op": "citysit_add_ref", "expect": 1},
    {"op": "citysit_advice", "advice": "0x500", "guid": "0x8C151EFD"},
    {"op": "citysit_advice", "advice": "0x501", "guid": 2, "mission_type": 1},
    {"op": "citysit_init", "expect": true},
    {"op": "citysit_call", "method": "initiate_situation", "args": ["0x500", "0x700", true], "expect": true},
    {"op": "citysit_env", "button": 6},
    {"op": "citysit_clear_events"},
    {"op": "citysit_message", "type": "ShowPopup", "object": "0x500", "void1": "0x700", "expect": true},
    {"op": "citysit_expect_events", "filter": {"event": "popup"}, "events": [{"event": "popup", "popup": "briefing", "advice": "0x500", "vehicle": "0x700"}]},
    {"op": "citysit_call", "method": "get_current_status", "args": [], "expect": 3},
    {"op": "citysit_env", "button": 7},
    {"op": "citysit_message", "type": "ShowPopup", "object": "0x500", "void1": "0x700", "expect": true},
    {"op": "citysit_expect_event_count", "filter": {"event": "joyride", "vehicle": "0x700"}, "count": 1},
    {"op": "citysit_call", "method": "handle_status_changed", "args": [2]},
    {"op": "citysit_env", "button": 1},
    {"op": "citysit_clear_events"},
    {"op": "citysit_message", "type": "ShowPopup", "object": "0x500", "void1": "0x700", "expect": true},
    {"op": "citysit_expect_events", "events": [{"event": "hide_mission_status_panel"}, {"event": "end_mysim_dialog"}, {"event": "popup", "popup": "failure", "advice": "0x500", "vehicle": "0x700"}, {"event": "post", "type": "0x6BB350E4", "advice": "0x500"}]},
    {"op": "citysit_message", "type": "PlayerLeftVehicle", "expect": true},
    {"op": "citysit_call", "method": "get_active_situation", "args": [], "expect": "0x500"},
    {"op": "citysit_message", "type": "PopupClosed", "object": "0x500", "expect": true},
    {"op": "citysit_expect_events", "events": [{"event": "drive", "vehicle": "0x700", "on": false}, {"event": "send", "type": "0xABBBCA64", "advice": "0x500", "data1": 0}]},
    {"op": "citysit_call", "method": "get_active_situation", "args": [], "expect": null},
    {"op": "citysit_call", "method": "initiate_situation", "args": ["0x501", "0x700", true], "expect": false},
    {"op": "citysit_call", "method": "get_current_status", "args": [], "expect": 5},
    {"op": "citysit_expect_event_count", "filter": {"event": "post", "type": "0xEBB67EF7", "advice": "0x501", "vehicle": null}, "count": 1},
    {"op": "citysit_message", "type": "ShowPopup", "object": "0x501", "expect": true},
    {"op": "citysit_expect_event_count", "filter": {"event": "popup", "popup": "success", "advice": "0x501"}, "count": 1},
    {"op": "citysit_call", "method": "get_active_situation", "args": [], "expect": null},
    {"op": "citysit_expect_refs", "refs": {"0x501": 0}},
    {"op": "citysit_message", "type": "InitiateByGuid", "data1": "0x8C151EFD", "data2": 0, "expect": true},
    {"op": "citysit_call", "method": "get_current_status", "args": [], "expect": 3},
    {"op": "citysit_call", "method": "get_active_situation", "args": [], "expect": "0x500"},
    {"op": "citysit_message", "type": "PlayerLeftVehicle", "expect": true},
    {"op": "citysit_call", "method": "get_active_situation", "args": [], "expect": null},
    {"op": "citysit_call", "method": "initiate_situation_by_guid", "args": ["0x1234", true, 0], "expect": false},
    {"op": "citysit_clear_events"},
    {"op": "citysit_message", "type": "Cheat", "data1": "0x8C4136DB", "text": "csitrigger 8c151efd", "expect": true},
    {"op": "citysit_call", "method": "lua_activate_situation", "args": ["0x8C151EFD", false], "expect": true},
    {"op": "citysit_expect_events", "events": [{"event": "post", "type": "0xAC1045EF", "data1": "0x8C151EFD", "data2": 1}, {"event": "post", "type": "0xAC1045EF", "data1": "0x8C151EFD", "data2": 0}]},
    {"op": "citysit_message", "type": "PopupNoAdvice", "expect": true},
    {"op": "citysit_expect_event_count", "filter": {"event": "popup", "popup": "briefing", "advice": null}, "count": 1},
    {"op": "citysit_set", "success_counts": {"0x1": 4}},
    {"op": "citysit_env", "rewards": [1, 2]},
    {"op": "citysit_clear_events"},
    {"op": "citysit_call", "method": "reset_tutorials", "args": []},
    {"op": "citysit_expect", "state": {"success_counts": {}}},
    {"op": "citysit_expect_world", "state": {"rewards": []}},
    {"op": "citysit_expect_events", "events": [{"event": "save_preferences"}]}
  ]
}
