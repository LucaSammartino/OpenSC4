    {"op": "om_call", "method": "position_to_standard_cell", "args": [-0.1, -0.1], "expect": [-1, -1]},
    {"op": "om_call", "method": "position_to_standard_cell", "args": [-16, -16], "expect": [-1, -1]},
    {"op": "om_call", "method": "position_to_standard_cell", "args": [4095.99, 4095.99], "expect": [255, 255]},
    {"op": "om_call", "method": "position_to_standard_cell", "args": [4096, 4096], "expect": [256, 256]},
