{
  "format": 1,
  "name": "flora_kill",
  "spec": ["flora 6.9", "flora 5"],
  "description": "Derived by hand from flora 6.9 and the RemoveOccupant row of 5 (test 22 of 16). KillFloraOccupant on an inserted flora occupant in state 1: SetState(3), SetType(0x29CFF3CB Burnt Tree), SetStaticFloraData(the Burnt Tree record), one 0x99EF1145, AddRef and append to the burnt list; returns true. Again: state is 3 -> true, nothing changes. A building (no cISC4FloraOccupant) -> false; a flora occupant without flag 1 (not inserted) -> false; a flora occupant already in state 3 -> true without being listed. RemoveOccupant (data3 = flora type) of a listed occupant removes it from the list and releases the list's reference; a preview occupant (property 0x029244DB) or data3 of another type is ignored. Without a Burnt Tree record the static record is set to null.",
  "steps": [
    {"op": "flora_types", "types": [{"type": "0x29CFF3CB", "never_auto": true}, {"type": "0x1000", "table": 0.6}]},
    {"op": "flora_env", "occupants": [
      {"id": 1, "type": "flora", "pos": [100, 260, 100], "flora_type": "0x1000", "state": 1},
      {"id": 2, "type": "building", "bbox": [[200, 250, 200], [210, 270, 210]]},
      {"id": 3, "type": "flora", "pos": [300, 260, 100], "flora_type": "0x1000", "state": 1, "in_manager": false},
      {"id": 4, "type": "flora", "pos": [400, 260, 100], "flora_type": "0x1000", "state": 3},
      {"id": 5, "type": "flora", "pos": [500, 260, 100], "flora_type": "0x1000", "state": 2, "preview": true}]},
    {"op": "flora_create"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_clear_events"},
    {"op": "flora_call", "method": "kill", "args": [1], "expect": true},
    {"op": "flora_expect_events", "events": [
      {"event": "set_state", "occupant": 1, "value": 3},
      {"event": "set_type", "occupant": 1, "value": "0x29CFF3CB"},
      {"event": "set_record", "occupant": 1, "record": "0x29CFF3CB"},
      {"event": "change", "occupant": 1}]},
    {"op": "flora_expect", "state": {"burnt": [1]}},
    {"op": "flora_expect_refs", "refs": {"1": 2}},
    {"op": "flora_expect_occupant", "occupant": 1, "state": 3, "flora_type": "0x29CFF3CB", "record": "0x29CFF3CB", "in_manager": true},
    {"op": "flora_call", "method": "kill", "args": [1], "expect": true},
    {"op": "flora_expect_events", "events": []},
    {"op": "flora_expect", "state": {"burnt": [1]}},
    {"op": "flora_call", "method": "kill", "args": [2], "expect": false},
    {"op": "flora_call", "method": "kill", "args": [3], "expect": false},
    {"op": "flora_call", "method": "kill", "args": [4], "expect": true},
    {"op": "flora_expect_events", "events": []},
    {"op": "flora_expect", "state": {"burnt": [1]}},
    {"op": "flora_call", "method": "kill", "args": [5], "expect": true},
    {"op": "flora_expect", "state": {"burnt": [1, 5]}},

    {"op": "flora_message", "type": "RemoveOccupant", "occupant": 1, "data3": "building", "expect": true},
    {"op": "flora_expect", "state": {"burnt": [1, 5]}},
    {"op": "flora_message", "type": "RemoveOccupant", "occupant": 5, "data3": "flora", "expect": true},
    {"op": "flora_expect", "state": {"burnt": [1, 5]}},
    {"op": "flora_message", "type": "RemoveOccupant", "occupant": 1, "data3": "flora", "expect": true},
    {"op": "flora_expect", "state": {"burnt": [5]}},
    {"op": "flora_expect_refs", "refs": {"1": 1, "5": 2}},
    {"op": "flora_message", "type": "RemoveOccupant", "occupant": 1, "data3": "flora", "expect": true},
    {"op": "flora_expect_refs", "refs": {"1": 1}},

    {"op": "flora_types", "types": [{"type": "0x1000", "table": 0.6}]},
    {"op": "flora_registry", "reset": true},
    {"op": "flora_env", "occupants": [{"id": 6, "type": "flora", "pos": [600, 260, 100], "flora_type": "0x1000", "state": 0}]},
    {"op": "flora_create"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_clear_events"},
    {"op": "flora_call", "method": "kill", "args": [6], "expect": true},
    {"op": "flora_expect_events", "events": [
      {"event": "set_state", "occupant": 6, "value": 3},
      {"event": "set_type", "occupant": 6, "value": "0x29CFF3CB"},
      {"event": "set_record", "occupant": 6, "record": null},
      {"event": "change", "occupant": 6}]}
  ]
}
