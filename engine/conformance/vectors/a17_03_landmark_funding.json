    {"op": "aura_init", "expect": true},
    {"op": "aura_clear_events"},
    {"op": "aura_env", "funding": {"0x10": 0.5, "0x20": 1.2, "0x0": 0.25}},
    {"op": "aura_set_grid", "grid": "dept:0x10", "cells": [[1, 1, 30], [2, 2, -8]]},
