    {"op": "aura_env", "funding": {"0x30": 1.0, "0x40": 1.0}},
    {"op": "aura_set_grid", "grid": "dept:0x30", "cells": [[5, 5, 20000]]},
    {"op": "aura_set_grid", "grid": "dept:0x40", "cells": [[5, 5, 20000]]},
