    {"op": "aura_idle", "expect_state": 4},
    {"op": "aura_expect", "state": {"department_cursor": null}},
    {"op": "aura_expect_grid", "grid": "landmark_map", "cells": [[1, 1, 28], [2, 2, -4], [3, 3, 7]], "others": 0},
    {"op": "aura_create"},
