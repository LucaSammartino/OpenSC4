{
  "format": 1,
  "name": "aura_landmark_funding",
  "spec": ["aura 6.3", "aura 17.3"],
  "description": "State 3, one department per call in ascending ID: A (0x10, funding 0.5, value 30) gives trunc(15) = 15; B (0x20, 1.2, value 10) gives trunc(15 + 12.0) = 27; the third call publishes 27 and moves to 4 (N + 1 calls). Negative values are not scaled: -8, then trunc(-8 + 3 x 1.2) = trunc(-4.4) = -4. Department ID 0 uses 1.0 even with a funding entry (1 + 15 + 12 = 28; value 7 kept). A cursor naming a department that does not exist resets the cursor and moves to 4 without publishing (the map keeps its previous values). f32 steps per foundations 18; values from a Python model.",
  "steps": [
    {"op": "aura_create"},
    {"op": "aura_init", "expect": true},
    {"op": "aura_clear_events"},
    {"op": "aura_env", "funding": {"0x10": 0.5, "0x20": 1.2, "0x0": 0.25}},
    {"op": "aura_set_grid", "grid": "dept:0x10", "cells": [[1, 1, 30], [2, 2, -8]]},
    {"op": "aura_set_grid", "grid": "dept:0x20", "cells": [[1, 1, 10], [2, 2, 3]]},
    {"op": "aura_expect", "state": {"departments": [16, 32]}},
    {"op": "aura_set", "state": {"state": 3, "department_cursor": null}},
    {"op": "aura_idle", "expect_state": 3},
    {"op": "aura_expect", "state": {"department_cursor": 16}},
    {"op": "aura_expect_grid", "grid": "landmark_work", "cells": [[1, 1, 15], [2, 2, -8]], "others": 0},
    {"op": "aura_expect_grid", "grid": "landmark_map", "others": 0},
    {"op": "aura_idle", "expect_state": 3},
    {"op": "aura_expect", "state": {"department_cursor": 32}},
    {"op": "aura_expect_grid", "grid": "landmark_work", "cells": [[1, 1, 27], [2, 2, -4]], "others": 0},
    {"op": "aura_expect_grid", "grid": "landmark_map", "others": 0},
    {"op": "aura_idle", "expect_state": 4},
    {"op": "aura_expect", "state": {"department_cursor": null}},
    {"op": "aura_expect_grid", "grid": "landmark_map", "cells": [[1, 1, 27], [2, 2, -4]], "others": 0},
    {"op": "aura_set_grid", "grid": "dept:0x0", "cells": [[3, 3, 7], [1, 1, 1]]},
    {"op": "aura_expect", "state": {"departments": [0, 16, 32]}},
    {"op": "aura_set", "state": {"state": 3}},
    {"op": "aura_idle", "count": 3, "expect_state": 3},
    {"op": "aura_idle", "expect_state": 4},
    {"op": "aura_expect_grid", "grid": "landmark_map", "cells": [[1, 1, 28], [2, 2, -4], [3, 3, 7]], "others": 0},
    {"op": "aura_set", "state": {"state": 3, "department_cursor": "0x15"}},
    {"op": "aura_idle", "expect_state": 4},
    {"op": "aura_expect", "state": {"department_cursor": null}},
    {"op": "aura_expect_grid", "grid": "landmark_map", "cells": [[1, 1, 28], [2, 2, -4], [3, 3, 7]], "others": 0}
  ]
}
