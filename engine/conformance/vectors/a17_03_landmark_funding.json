    {"op": "aura_expect", "state": {"departments": [16, 32]}},
    {"op": "aura_set", "state": {"state": 3, "department_cursor": null}},
    {"op": "aura_idle", "expect_state": 3},
    {"op": "aura_expect", "state": {"department_cursor": 16}},
    {"op": "aura_expect_grid", "grid": "landmark_work", "cells": [[1, 1, 15], [2, 2, -8]], "others": 0},
    {"op": "aura_expect_grid", "grid": "landmark_map", "others": 0},
    {"op": "aura_idle", "expect_state": 3},
    {"op": "aura_expect", "state": {"department_cursor": 32}},
    {"op": "aura_expect_grid", "grid": "landmark_work", "cells": [[1, 1, 27], [2, 2, -4]], "others": 0},
    {"op": "aura_expect_grid", "grid": "landmark_map", "others": 0},
    {"op": "aura_idle", "expect_state": 4},
