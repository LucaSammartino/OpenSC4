{
  "format": 1,
  "name": "bds_suitability",
  "spec": ["building-development 4.8", "building-development 4.12", "building-development 4.7.3", "building-development 11.11"],
  "description": "Test 11, by hand from the check table of 4.8 (the harness passes reason = -1, so a passing profile leaves -1: 'reason untouched'). Profile: building zone 1, wealth 1, purpose 1, cell (5, 5). Cell (5, 5): zone 3, lot 1 in state 1, powered, land value type 1, land value 25. lvMin = lvMax = 0 and type = wealth -> true. Cell zone 4 -> BuildingFitsInZone(1, 4) false -> reason 0. No lot -> 3. Unpowered -> 5; after the FightThePower cheat message -> passes. lvMin 10, lvMax 20, land value 25 -> 1; the range is inclusive (10 and 20 pass); lvMin 0 / lvMax 20 is a range check, not the type check. Building zone 7 with land value type 2 != wealth 1 and range 0/0 -> passes (zones 7, 8, 9 skip the type check); zone 1 with type 2 -> 2. Lot state 2 -> 4. Order of the checks: zone before lot, lot before power, power before land value, land value before state (each pair broken at once gives the earlier reason). The cell zone is sign-extended from int8: cell zone -1 matches building zone -1 but not 255 (reason 0).",
  "steps": [
    {"op": "bds_process", "seed": 1},
    {"op": "bds_create"},
    {"op": "bds_init", "expect": true},
    {"op": "bds_lots", "lots": [{"id": 1, "building_type": 0, "rect": [5, 5, 5, 5], "state": 1}],
      "cells": [{"x": 5, "z": 5, "zone": 3, "powered": true, "lv_type": 1, "lv": 25, "lot": 1}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "purpose": 1, "x": 5, "z": 5}],
      "expect": {"result": true, "reason": -1}},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 2, "wealth": 1, "purpose": 2, "x": 5, "z": 5}],
      "expect": {"result": true, "reason": -1}},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5, "lv_min": 10, "lv_max": 20}],
      "expect": {"result": false, "reason": 1}},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5, "lv_min": 0, "lv_max": 20}],
      "expect": {"result": false, "reason": 1}},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5, "lv_min": 25, "lv_max": 25}],
      "expect": {"result": true, "reason": -1}},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5, "lv_min": 20, "lv_max": 30}],
      "expect": {"result": true, "reason": -1}},
    {"op": "bds_lots", "cells": [{"x": 5, "z": 5, "lv": 10}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5, "lv_min": 10, "lv_max": 20}],
      "expect": {"result": true, "reason": -1}},
    {"op": "bds_lots", "cells": [{"x": 5, "z": 5, "lv": 20}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5, "lv_min": 10, "lv_max": 20}],
      "expect": {"result": true, "reason": -1}},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5, "lv_min": 10, "lv_max": 0}],
      "expect": {"result": false, "reason": 1}},

    {"op": "bds_lots", "cells": [{"x": 5, "z": 5, "lv_type": 2}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5}],
      "expect": {"result": false, "reason": 2}},
    {"op": "bds_lots", "cells": [{"x": 5, "z": 5, "zone": 7}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 7, "wealth": 1, "purpose": 5, "x": 5, "z": 5}],
      "expect": {"result": true, "reason": -1}},
    {"op": "bds_lots", "cells": [{"x": 5, "z": 5, "zone": 9}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 8, "wealth": 1, "x": 5, "z": 5}],
      "expect": {"result": true, "reason": -1}},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 9, "wealth": 3, "x": 5, "z": 5}],
      "expect": {"result": true, "reason": -1}},
    {"op": "bds_lots", "cells": [{"x": 5, "z": 5, "zone": 3, "lv_type": 1}]},

    {"op": "bds_lots", "cells": [{"x": 5, "z": 5, "zone": 4}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5}],
      "expect": {"result": false, "reason": 0}},
    {"op": "bds_lots", "cells": [{"x": 5, "z": 5, "zone": 4, "lot": null}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5}],
      "expect": {"result": false, "reason": 0}},
    {"op": "bds_lots", "cells": [{"x": 5, "z": 5, "zone": 3}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5}],
      "expect": {"result": false, "reason": 3}},
    {"op": "bds_lots", "cells": [{"x": 5, "z": 5, "powered": false}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5}],
      "expect": {"result": false, "reason": 3}},
    {"op": "bds_lots", "cells": [{"x": 5, "z": 5, "lot": 1}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5}],
      "expect": {"result": false, "reason": 5}},
    {"op": "bds_lots", "cells": [{"x": 5, "z": 5, "lv_type": 2}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5}],
      "expect": {"result": false, "reason": 5}},
    {"op": "bds_message", "type": "Cheat", "data1": "0x08DAD89A", "expect": true},
    {"op": "bds_call", "method": "cheats", "expect": {"plumbing": false, "power": true, "caps": false, "debug_growth": false, "coffee_bar": false}},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5}],
      "expect": {"result": false, "reason": 2}},
    {"op": "bds_lots", "lots": [{"id": 1, "state": 2}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5}],
      "expect": {"result": false, "reason": 2}},
    {"op": "bds_lots", "cells": [{"x": 5, "z": 5, "lv_type": 1}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5}],
      "expect": {"result": false, "reason": 4}},
    {"op": "bds_lots", "lots": [{"id": 1, "state": 3}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5}],
      "expect": {"result": false, "reason": 4}},
    {"op": "bds_lots", "lots": [{"id": 1, "state": 1}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 1, "wealth": 1, "x": 5, "z": 5}],
      "expect": {"result": true, "reason": -1}},

    {"op": "bds_lots", "cells": [{"x": 5, "z": 5, "zone": -1}]},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": -1, "wealth": 1, "x": 5, "z": 5}],
      "expect": {"result": true, "reason": -1}},
    {"op": "bds_call", "method": "suitable", "args": [{"zone": 255, "wealth": 1, "x": 5, "z": 5}],
      "expect": {"result": false, "reason": 0}}
  ]
}
