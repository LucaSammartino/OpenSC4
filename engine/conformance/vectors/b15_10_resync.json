{
  "format": 1,
  "name": "budget_resync",
  "spec": ["budget 7.2", "budget 15.10"],
  "description": "RecalculateAllLineItemCurrentExpenses recomputes local lines from the buildings' local funding and moves the department percentage only when both thresholds are exceeded (|a - 100p| > 0.5 and |C - pF| > n + 2). Each department has one non-local line and one local line with one building whose local funding property was changed behind the department's back. Case 1 (1000 / 1000 at 50 %): a = 75, both exceeded, p -> 0.75 and both lines 750. Case 2 (10 / 10 at 85 %): a = 90 but |C - F| = 2 <= 4, unchanged. Case 3 (10000 / 10000 at 99.655 %): |C - F| = 35 but |a - 100| = 0.175, unchanged.",
  "steps": [
    {"op": "budget_env", "difficulty": 2, "year": 2000, "month": 1},
    {"op": "budget_create"},
    {"op": "budget_init"},

    {"op": "budget_call", "method": "create_department_budget", "args": [1, 1], "expect": 1},
    {"op": "budget_dept", "dept": 1, "method": "create_line_item", "args": [1, false], "expect": 1},
    {"op": "budget_dept", "dept": 1, "method": "create_line_item", "args": [2, true], "expect": 2},
    {"op": "budget_line", "dept": 1, "line": 1, "method": "set_full_expenses", "args": [1000]},
    {"op": "budget_holder", "holder": "A", "props": {"0xEA54D283": {"u32": [1]}, "0xEA54D284": {"u32": [2]},
      "0xEA54D285": {"u32": [7]}, "0xEA54D286": {"i64": [1000]}}},
    {"op": "budget_dept", "dept": 1, "method": "add_locally_funded_object", "args": ["A", 7], "expect": true},
    {"op": "budget_line", "dept": 1, "line": 2, "method": "current_expenses", "expect": 1000},
    {"op": "budget_holder", "holder": "A", "props": {"0xEA54D283": {"u32": [1]}, "0xEA54D284": {"u32": [2]},
      "0xEA54D285": {"u32": [7]}, "0xEA54D286": {"i64": [1000]}, "0xEA54D287": {"f32": [50]}}},
    {"op": "clear_events"},
    {"op": "budget_dept", "dept": 1, "method": "recalculate_all_line_item_current_expenses", "expect": true},
    {"op": "budget_dept", "dept": 1, "method": "funding_percentage", "expect": 0.75},
    {"op": "budget_line", "dept": 1, "line": 1, "method": "current_expenses", "expect": 750},
    {"op": "budget_line", "dept": 1, "line": 2, "method": "current_expenses", "expect": 750},
    {"op": "budget_expect_holder", "holder": "A", "prop": "0xEA54D287", "values": {"f32": [75]}},
    {"op": "expect_events", "filter": {"event": "post", "type": "FundingPercentageChanged"}, "events": [
      {"data2": 1, "data3": 0}
    ]},
    {"op": "budget_dept", "dept": 1, "method": "recalculate_all_line_item_current_expenses", "expect": true},
    {"op": "budget_dept", "dept": 1, "method": "funding_percentage", "expect": 0.75, "note": "in sync now"},

    {"op": "budget_call", "method": "create_department_budget", "args": [2, 1], "expect": 2},
    {"op": "budget_dept", "dept": 2, "method": "create_line_item", "args": [1, false], "expect": 1},
    {"op": "budget_dept", "dept": 2, "method": "create_line_item", "args": [2, true], "expect": 2},
    {"op": "budget_line", "dept": 2, "line": 1, "method": "set_full_expenses", "args": [10]},
    {"op": "budget_holder", "holder": "B", "props": {"0xEA54D283": {"u32": [2]}, "0xEA54D284": {"u32": [2]},
      "0xEA54D285": {"u32": [7]}, "0xEA54D286": {"i64": [10]}}},
    {"op": "budget_dept", "dept": 2, "method": "add_locally_funded_object", "args": ["B", 7], "expect": true},
    {"op": "budget_holder", "holder": "B", "props": {"0xEA54D283": {"u32": [2]}, "0xEA54D284": {"u32": [2]},
      "0xEA54D285": {"u32": [7]}, "0xEA54D286": {"i64": [10]}, "0xEA54D287": {"f32": [85]}}},
    {"op": "clear_events"},
    {"op": "budget_dept", "dept": 2, "method": "recalculate_all_line_item_current_expenses", "expect": true},
    {"op": "budget_dept", "dept": 2, "method": "funding_percentage", "expect": 1.0},
    {"op": "budget_line", "dept": 2, "line": 1, "method": "current_expenses", "expect": 10},
    {"op": "budget_line", "dept": 2, "line": 2, "method": "current_expenses", "expect": 8},
    {"op": "expect_event_count", "filter": {"event": "post", "type": "FundingPercentageChanged"}, "count": 0},

    {"op": "budget_call", "method": "create_department_budget", "args": [3, 1], "expect": 3},
    {"op": "budget_dept", "dept": 3, "method": "create_line_item", "args": [1, false], "expect": 1},
    {"op": "budget_dept", "dept": 3, "method": "create_line_item", "args": [2, true], "expect": 2},
    {"op": "budget_line", "dept": 3, "line": 1, "method": "set_full_expenses", "args": [10000]},
    {"op": "budget_holder", "holder": "C", "props": {"0xEA54D283": {"u32": [3]}, "0xEA54D284": {"u32": [2]},
      "0xEA54D285": {"u32": [7]}, "0xEA54D286": {"i64": [10000]}}},
    {"op": "budget_dept", "dept": 3, "method": "add_locally_funded_object", "args": ["C", 7], "expect": true},
    {"op": "budget_holder", "holder": "C", "props": {"0xEA54D283": {"u32": [3]}, "0xEA54D284": {"u32": [2]},
      "0xEA54D285": {"u32": [7]}, "0xEA54D286": {"i64": [10000]}, "0xEA54D287": {"f32": [99.655]}}},
    {"op": "clear_events"},
    {"op": "budget_dept", "dept": 3, "method": "recalculate_all_line_item_current_expenses", "expect": true},
    {"op": "budget_dept", "dept": 3, "method": "funding_percentage", "expect": 1.0},
    {"op": "budget_line", "dept": 3, "line": 1, "method": "current_expenses", "expect": 10000},
    {"op": "budget_line", "dept": 3, "line": 2, "method": "current_expenses", "expect": 9965},
    {"op": "expect_event_count", "filter": {"event": "post", "type": "FundingPercentageChanged"}, "count": 0}
  ]
}
