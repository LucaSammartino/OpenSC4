{
  "format": 1,
  "name": "net_component_11_empty",
  "spec": ["network-manager 1", "network-manager 4.2", "network-manager 16.2"],
  "description": "The network lot manager (class 0xE9A6CD3B; QueryInterface 1, 0x89A5BA3F, 0x452294AA, 0xE4FDA3D4) writes u16 2, u32 0 lots, u32 0 potholes. A record of version 1 reads false and nothing after the version is read.",
  "steps": [
    {"op": "net_create"},
    {"op": "net_identity", "of": "lots", "class": "0xE9A6CD3B",
      "iids": {"0x1": true, "0x89A5BA3F": true, "0x452294AA": true, "0xE4FDA3D4": true, "0xA9764C8C": false}},
    {"op": "net_write", "of": "lots", "expect": true, "length": 10, "hex": "0200 00000000 00000000"},
    {"op": "net_read", "of": "lots", "hex": "0100 00000000 00000000", "expect": false, "position": 2},
    {"op": "net_read", "of": "lots", "hex": "0200 00000000 00000000", "expect": true, "position": 10},
    {"op": "net_expect", "of": "lots", "state": {"lots": [], "potholes": []}}
  ]
}
