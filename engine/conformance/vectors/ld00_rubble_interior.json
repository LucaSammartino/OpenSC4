{
  "format": 1,
  "name": "lot_developer_rubble_interior",
  "spec": ["lot-developer 7.3", "lot-developer 10.2", "lot-developer 10.3"],
  "description": "AddLotRubbleProps for a large, non-burnt box (§7.3), file RNG seed 12345. A 16x16 box gives area 256, count trunc(256 / 128) + 4 = 6, so four corners and two interiors; it is large (dx > 12 and dz > 12), so corners draw R9 then R10 = Uniform(6). Corners: R9=0 skips, R9=1 places (R10 gives d2; orientation (i+2) mod 4 when d2 = 0 else i; type T6[d2]). Interiors draw R11 = Uniform(4) (orientation), R12 = Uniform(6) (type), then R13 and R14 = RandomDoubleRangeGaussian over x and z (the file generator's multiplicative state, polar method). The whole draw sequence is pinned here; the Gaussian values come from the shared generator's multiplicative path.",
  "steps": [
    {"op": "ldev_world", "terrain_cells": [64, 64]},
    {"op": "ldev_lot", "id": 1, "x": 0, "z": 0, "state": 3},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_clear_events"},
    {"op": "ldev_add_rubble", "lot": 1, "min": [0, 5, 0], "max": [16, 5, 16], "burnt": false},
    {"op": "ldev_expect_draws", "note": "corners 0-3 then interiors 4-5, exactly as §7.3 / §10.3 order them",
      "draws": [
        ["R9", 2, 0],
        ["R9", 2, 1],
        ["R10", 6, 2],
        ["R9", 2, 1],
        ["R10", 6, 5],
        ["R9", 2, 0],
        ["R11", 4, 2],
        ["R12", 6, 2],
        ["R13", 0, 6.511194705963135],
        ["R14", 0, 11.828765869140625],
        ["R11", 4, 3],
        ["R12", 6, 5],
        ["R13", 0, 7.508758068084717],
        ["R14", 0, 7.686899185180664]]},
    {"op": "ldev_expect_events", "filter": {"event": "create_prop"},
      "note": "corner 1 (d2 2 -> T6[2] = 0x1DD10000), corner 3 (d2 5 -> T6[5] = 0x1DD30000), interior 4 (d2 2 -> 0x1DD10000), interior 5 (d2 5 -> 0x1DD30000)",
      "events": [
        {"event": "create_prop", "type": "0x1DD10000"},
        {"event": "create_prop", "type": "0x1DD30000"},
        {"event": "create_prop", "type": "0x1DD10000"},
        {"event": "create_prop", "type": "0x1DD30000"}]},

    {"op": "ldev_clear_lots"},
    {"op": "ldev_lot", "id": 2, "x": 0, "z": 0, "state": 3},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_clear_events"},
    {"op": "ldev_add_rubble", "lot": 2, "min": [0, 5, 0], "max": [16, 5, 16], "burnt": true,
      "note": "burnt: R10 / R12 are Uniform(2), types from the burnt tables"},
    {"op": "ldev_expect_draws",
      "draws": [
        ["R9", 2, 0],
        ["R9", 2, 1],
        ["R10", 2, 0],
        ["R9", 2, 1],
        ["R10", 2, 1],
        ["R9", 2, 0],
        ["R11", 4, 2],
        ["R12", 2, 0],
        ["R13", 0, 6.511194705963135],
        ["R14", 0, 11.828765869140625],
        ["R11", 4, 3],
        ["R12", 2, 1],
        ["R13", 0, 7.508758068084717],
        ["R14", 0, 7.686899185180664]]},
    {"op": "ldev_expect_events", "filter": {"event": "create_prop"},
      "note": "burnt corners {0x1C480000, 0x1C460000}[d2] and interiors {0x1C470000, 0x1C490000}[d2]",
      "events": [
        {"event": "create_prop", "type": "0x1C480000"},
        {"event": "create_prop", "type": "0x1C460000"},
        {"event": "create_prop", "type": "0x1C470000"},
        {"event": "create_prop", "type": "0x1C490000"}]},

    {"op": "ldev_clear_lots"},
    {"op": "ldev_lot", "id": 3, "x": 0, "z": 0, "state": 3},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_clear_events"},
    {"op": "ldev_add_rubble", "lot": 3, "min": [0, 5, 0], "max": [8, 5, 8], "burnt": false,
      "note": "an 8x8 box is small: corners get nothing (no draw), count 4 so no interiors either"},
    {"op": "ldev_expect_draws", "draws": []},
    {"op": "ldev_expect_events", "filter": {"event": "create_prop"}, "events": []}
  ]
}
