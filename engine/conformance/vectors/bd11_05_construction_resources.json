{
  "format": 1,
  "name": "bds_construction_resources",
  "spec": ["building-development 4.6", "building-development 5", "demand 3.2", "building-development 11.5"],
  "description": "Test 5, by hand from 4.6. Supply 20480, demand 20400: Claim(100) -> t = 20500 > 20480 -> false, nothing changes, nothing posted; Claim(80) -> t = 20480, not supply < t -> AddToDemandValue(80), EndOfCycle (posts ActiveDemandChanged, key 0) -> true, demand 20480; GetFree = trunc(0) = 0; Release(80) -> demand 20400 and EndOfCycle had a pending value -> true; GetFree = 80. Supply 8192, demand 9000 -> GetFree = trunc(-808) < 0 -> 0, GetTotal = 8192. Extra: Release(0) adds -0.0, so EndOfCycle sees nothing pending and returns false (the Release result is EndOfCycle's); releases have no lower bound (supply 100, demand 10, Release(50) -> demand -40, GetFree 140); Claim exactly up to the supply passes (demand 40, Claim(60) -> t = 100); GetTotal truncates 100.75 -> 100 and GetFree trunc(r24(100.75 - 0.5)) = 100.",
  "steps": [
    {"op": "bds_process", "seed": 1},
    {"op": "bds_create"},
    {"op": "bds_init", "expect": true},
    {"op": "bds_set", "state": {"supply": 20480, "demand": 20400}},
    {"op": "bds_clear_events"},
    {"op": "bds_call", "method": "claim", "args": [100], "expect": false},
    {"op": "bds_expect", "state": {"supply": 20480, "demand": 20400}},
    {"op": "bds_expect_events", "events": []},
    {"op": "bds_call", "method": "claim", "args": [80], "expect": true},
    {"op": "bds_expect", "state": {"demand": 20480}},
    {"op": "bds_expect_events", "events": [{"event": "active_demand_changed", "key": 0}]},
    {"op": "bds_call", "method": "free_resources", "expect": 0},
    {"op": "bds_call", "method": "release", "args": [80], "expect": true},
    {"op": "bds_expect", "state": {"demand": 20400}},
    {"op": "bds_expect_events", "events": [{"event": "active_demand_changed", "key": 0}]},
    {"op": "bds_call", "method": "free_resources", "expect": 80},
    {"op": "bds_set", "state": {"supply": 8192, "demand": 9000}},
    {"op": "bds_call", "method": "free_resources", "expect": 0},
    {"op": "bds_call", "method": "total_resources", "expect": 8192},

    {"op": "bds_call", "method": "release", "args": [0], "expect": false},
    {"op": "bds_set", "state": {"supply": 100, "demand": 10}},
    {"op": "bds_call", "method": "release", "args": [50], "expect": true},
    {"op": "bds_expect", "state": {"demand": -40}},
    {"op": "bds_call", "method": "free_resources", "expect": 140},
    {"op": "bds_set", "state": {"supply": 100, "demand": 40}},
    {"op": "bds_call", "method": "claim", "args": [60], "expect": true},
    {"op": "bds_expect", "state": {"demand": 100}},
    {"op": "bds_call", "method": "claim", "args": [1], "expect": false},
    {"op": "bds_set", "state": {"supply": 100.75, "demand": 0.5}},
    {"op": "bds_call", "method": "total_resources", "expect": 100},
    {"op": "bds_call", "method": "free_resources", "expect": 100}
  ]
}
