{
  "format": 1,
  "name": "bds_stage_multiplier_and_tuning",
  "spec": ["building-development 4.13", "building-development 11.15"],
  "description": "Test 15 and the tuning reads of 4.13, by hand. Shipped tuning (0x47E2C380 = {8192, 20480}, 0x47E2C383 = {1.2, 1.1, 1.0}): Init reads 8192 / 20480 / 0.5 / 10 / [1.2, 1.1, 1.0]; GetStagePopulationMultiplier at difficulty 1 = 1.1 (0x3F8CCCCD), 0 = 1.2, 2 = 1.0, 3 = 1.0 ([choice]: index outside the vector -> 1.0; the original reads past it). The difficulty is read at each call. No tuning exemplar: the code defaults 100, 2000, 0.5, 10 and an empty vector (-> 1.0 at every difficulty). Defaults are assigned before every read: a re-read with an exemplar holding only the bias resets the min/max to 100 / 2000. Min/max are the first two uint32 of the property's raw data with no type check: float32 {1.0, 2.0} -> 0x3F800000 / 0x40000000; uint8 {1, 0, 0, 0, 2, 0, 0, 0} -> 1 / 2; a single uint32 7 -> min 7 and max keeps its default 2000 ([choice]: the original reads 4 bytes past the data). Bias 0xFFFFFFF6 is stored as int32 -10; per-resident 0.25; a 4-entry vector gives its 4th entry at difficulty 3.",
  "steps": [
    {"op": "bds_process", "seed": 1},
    {"op": "bds_world", "tuning": "shipped", "difficulty": 1},
    {"op": "bds_create"},
    {"op": "bds_expect", "state": {"cr_min": 100, "cr_max": 2000, "cr_per_resident": 0.5, "bias": 10, "stage_multiplier": []}},
    {"op": "bds_init", "expect": true},
    {"op": "bds_expect", "state": {"cr_min": 8192, "cr_max": 20480, "cr_per_resident": 0.5, "bias": 10, "stage_multiplier": [1.2, 1.1, 1.0]}},
    {"op": "bds_call", "method": "stage_multiplier", "expect": 1.1},
    {"op": "bds_world", "difficulty": 0},
    {"op": "bds_call", "method": "stage_multiplier", "expect": 1.2},
    {"op": "bds_world", "difficulty": 2},
    {"op": "bds_call", "method": "stage_multiplier", "expect": 1.0},
    {"op": "bds_world", "difficulty": 3},
    {"op": "bds_call", "method": "stage_multiplier", "expect": 1.0},
    {"op": "bds_world", "difficulty": 4294967295},
    {"op": "bds_call", "method": "stage_multiplier", "expect": 1.0},

    {"op": "bds_world", "tuning": null, "difficulty": 1},
    {"op": "bds_call", "method": "read_tuning"},
    {"op": "bds_expect", "state": {"cr_min": 100, "cr_max": 2000, "cr_per_resident": 0.5, "bias": 10, "stage_multiplier": []}},
    {"op": "bds_call", "method": "stage_multiplier", "expect": 1.0},

    {"op": "bds_world", "tuning": "shipped"},
    {"op": "bds_call", "method": "read_tuning"},
    {"op": "bds_world", "tuning": {"0x47E2C382": {"u32": 25}}},
    {"op": "bds_call", "method": "read_tuning"},
    {"op": "bds_expect", "state": {"cr_min": 100, "cr_max": 2000, "bias": 25, "stage_multiplier": []}},

    {"op": "bds_world", "tuning": {"0x47E2C380": {"f32": [1.0, 2.0]}, "0x47E2C381": {"f32": 0.25}, "0x47E2C382": {"u32": 4294967286}}},
    {"op": "bds_call", "method": "read_tuning"},
    {"op": "bds_expect", "state": {"cr_min": "0x3F800000", "cr_max": "0x40000000", "cr_per_resident": 0.25, "bias": -10}},
    {"op": "bds_world", "tuning": {"0x47E2C380": {"u8": [1, 0, 0, 0, 2, 0, 0, 0]}}},
    {"op": "bds_call", "method": "read_tuning"},
    {"op": "bds_expect", "state": {"cr_min": 1, "cr_max": 2, "cr_per_resident": 0.5, "bias": 10}},
    {"op": "bds_world", "tuning": {"0x47E2C380": {"u32": 7}}},
    {"op": "bds_call", "method": "read_tuning"},
    {"op": "bds_expect", "state": {"cr_min": 7, "cr_max": 2000}},
    {"op": "bds_world", "tuning": {"0x47E2C383": {"f32": [2.0, 1.5, 1.25, 0.75]}}},
    {"op": "bds_call", "method": "read_tuning"},
    {"op": "bds_world", "difficulty": 3},
    {"op": "bds_call", "method": "stage_multiplier", "expect": 0.75},

    {"op": "bds_process", "seed": 1},
    {"op": "bds_world", "tuning": null},
    {"op": "bds_create"},
    {"op": "bds_init", "expect": true},
    {"op": "bds_expect", "state": {"cr_min": 100, "cr_max": 2000, "cr_per_resident": 0.5, "bias": 10, "stage_multiplier": []}},
    {"op": "bds_call", "method": "stage_multiplier", "expect": 1.0}
  ]
}
