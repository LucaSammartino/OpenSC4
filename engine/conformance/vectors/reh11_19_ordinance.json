{
  "format": 1,
  "name": "reh11_ordinance",
  "spec": ["REH 4.3", "REH 4.6", "REH 11.19"],
  "description": "REH test 19. A school of units 1 over a tract of 100 residents boosts EQ by grade 1.0 x wealth 1.0 x m3: 1.0. An ordinance whose misc properties give the school effect factor 0xA92D9D7A = 110 is enacted: until the next state 0 the effect lists are unchanged (still 1.0). State 0 clears and re-reads them (GetOrdinanceOnArray): the school list has one element with m3 = 110 x 0.01f = 1.1 (0x3F8CCCCD), the health list none; the boost is then 1.1.",
  "steps": [
    {"op": "residential_env", "groups": {"1": ["0x150F"]}, "props": {"1": {"0x8922041B": {"u32": 500}, "0x691B42B3": {"f32": 10}}}, "lots": {"1": [32, 32]}},
    {"op": "residential_create"},
    {"op": "residential_init", "expect": true},
    {"op": "residential_set", "state": {"lists": {"school_groups": [[1]]}}},
    {"op": "residential_tract", "x": 0, "z": 0, "steady": [100, 0, 0], "eq": [0, 0, 0]},
    {"op": "residential_set", "state": {"state": 5}},
    {"op": "residential_run_to", "state": 7, "steps": 2},
    {"op": "residential_expect_tract", "x": 0, "z": 0, "eq": [1, 0, 0]},
    {"op": "residential_env", "ordinances": {"0x10": {"0xA92D9D7A": {"f32": 110}}}},
    {"op": "residential_tract", "x": 0, "z": 0, "eq": [0, 0, 0]},
    {"op": "residential_set", "state": {"state": 5}},
    {"op": "residential_run_to", "state": 7, "steps": 2},
    {"op": "residential_expect_tract", "x": 0, "z": 0, "eq": [1, 0, 0]},
    {"op": "residential_call", "method": "ordinance_modifiers", "args": [true], "expect": [1, 1, 1]},
    {"op": "residential_set", "state": {"state": 0}},
    {"op": "residential_clear_events"},
    {"op": "residential_run_to", "state": 13, "steps": 1},
    {"op": "residential_expect_events", "events": [{"event": "ordinance_effects"}]},
    {"op": "residential_call", "method": "ordinance_modifiers", "args": [true], "bits": true, "expect": ["0x3F800000", "0x3F800000", "0x3F8CCCCD"]},
    {"op": "residential_call", "method": "ordinance_modifiers", "args": [false], "expect": [1, 1, 1]},
    {"op": "residential_expect", "state": {"school_effects": 1, "health_effects": 0}},
    {"op": "residential_tract", "x": 0, "z": 0, "eq": [0, 0, 0]},
    {"op": "residential_set", "state": {"state": 5}},
    {"op": "residential_run_to", "state": 7, "steps": 2},
    {"op": "residential_expect_tract", "x": 0, "z": 0, "bits": true, "eq": ["0x3F8CCCCD", "0x00000000", "0x00000000"]}
  ]
}
