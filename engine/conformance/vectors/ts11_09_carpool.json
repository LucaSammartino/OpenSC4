{
  "format": 1,
  "name": "ts11_09_carpool",
  "spec": [
    "traffic-simulator 4.5",
    "traffic-simulator 11.9"
  ],
  "description": "Conformance test 9 (§11). With the carpool ordinance the car volume of a route is Q = ceil(r24(count x 0.8)) for counts above 3: count 10 -> 8.0; 7 -> 6.0 (r24(5.6) -> ceil); 3 -> 3.0; 1 -> 1.0. The route is test 10's (01 02 03 41 02 0A).",
  "steps": [
    {
      "op": "ts_env",
      "carpool": true,
      "note": "the carpool ordinance is on"
    },
    {
      "op": "ts_init",
      "expect": true,
      "note": "a fresh simulator"
    },
    {
      "op": "ts_street",
      "rect": [
        0,
        3,
        4,
        3
      ],
      "note": "road info {invCapacity 0.0625, Street, 3 connections} at (0,3)...(4,3)"
    },
    {
      "op": "ts_call",
      "method": "apply_route",
      "args": [
        "01020341020a",
        10,
        [
          2,
          2,
          2,
          2
        ],
        [
          4,
          4
        ],
        0,
        0
      ]
    },
    {
      "op": "ts_expect_grid",
      "grid": "volume",
      "values": [
        [
          2,
          3,
          "0x41000000"
        ]
      ],
      "n": 1
    },
    {
      "op": "ts_init",
      "expect": true,
      "note": "a fresh simulator"
    },
    {
      "op": "ts_street",
      "rect": [
        0,
        3,
        4,
        3
      ],
      "note": "road info {invCapacity 0.0625, Street, 3 connections} at (0,3)...(4,3)"
    },
    {
      "op": "ts_call",
      "method": "apply_route",
      "args": [
        "01020341020a",
        7,
        [
          2,
          2,
          2,
          2
        ],
        [
          4,
          4
        ],
        0,
        0
      ]
    },
    {
      "op": "ts_expect_grid",
      "grid": "volume",
      "values": [
        [
          2,
          3,
          "0x40C00000"
        ]
      ],
      "n": 1
    },
    {
      "op": "ts_init",
      "expect": true,
      "note": "a fresh simulator"
    },
    {
      "op": "ts_street",
      "rect": [
        0,
        3,
        4,
        3
      ],
      "note": "road info {invCapacity 0.0625, Street, 3 connections} at (0,3)...(4,3)"
    },
    {
      "op": "ts_call",
      "method": "apply_route",
      "args": [
        "01020341020a",
        3,
        [
          2,
          2,
          2,
          2
        ],
        [
          4,
          4
        ],
        0,
        0
      ]
    },
    {
      "op": "ts_expect_grid",
      "grid": "volume",
      "values": [
        [
          2,
          3,
          "0x40400000"
        ]
      ],
      "n": 1
    },
    {
      "op": "ts_init",
      "expect": true,
      "note": "a fresh simulator"
    },
    {
      "op": "ts_street",
      "rect": [
        0,
        3,
        4,
        3
      ],
      "note": "road info {invCapacity 0.0625, Street, 3 connections} at (0,3)...(4,3)"
    },
    {
      "op": "ts_call",
      "method": "apply_route",
      "args": [
        "01020341020a",
        1,
        [
          2,
          2,
          2,
          2
        ],
        [
          4,
          4
        ],
        0,
        0
      ]
    },
    {
      "op": "ts_expect_grid",
      "grid": "volume",
      "values": [
        [
          2,
          3,
          "0x3F800000"
        ]
      ],
      "n": 1
    }
  ]
}
