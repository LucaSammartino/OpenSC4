{
  "format": 1,
  "name": "residential_december",
  "spec": ["residential 5.5", "residential 15.7", "RS2"],
  "description": "Test 7 with a flat LE = 100 curve (no reset). Month 12, a steady (100, 0, 0) tract at age 40 -> 41; at age 255 -> (255 + 1) & 0xFF = 0. A tract whose new total is 0 -> age 0. RS2: the month is read per tract and only when the new total is non-zero (one get_month event per populated tract, none for the emptied one). Month 11: age 40 stays 40.",
  "steps": [
    {"op": "residential_env", "month": 12, "tuning_props": {"0x6941A67F": {"f32": [0, 100, 200, 100]}}},
    {"op": "residential_create"},
    {"op": "residential_init", "expect": true},
    {"op": "residential_clear_events"},
    {"op": "residential_tract", "x": 0, "z": 0, "steady": [100, 0, 0], "age": 40},
    {"op": "residential_call", "method": "do_population_change", "args": [0, 0]},
    {"op": "residential_expect_tract", "x": 0, "z": 0, "age": 41},
    {"op": "residential_expect_event_count", "filter": {"event": "get_month"}, "count": 1},
    {"op": "residential_clear_events"},
    {"op": "residential_tract", "x": 0, "z": 0, "steady": [100, 0, 0], "age": 255},
    {"op": "residential_call", "method": "do_population_change", "args": [0, 0]},
    {"op": "residential_expect_tract", "x": 0, "z": 0, "age": 0},
    {"op": "residential_tract", "x": 0, "z": 0, "pop": [100, 0, 0], "new": [0, 0, 0], "age": 40},
    {"op": "residential_call", "method": "do_population_change", "args": [0, 0]},
    {"op": "residential_expect_tract", "x": 0, "z": 0, "pop": [0, 0, 0], "age": 0},
    {"op": "residential_expect_event_count", "filter": {"event": "get_month"}, "count": 1},
    {"op": "residential_env", "month": 11},
    {"op": "residential_tract", "x": 0, "z": 0, "steady": [100, 0, 0], "age": 40},
    {"op": "residential_call", "method": "do_population_change", "args": [0, 0]},
    {"op": "residential_expect_tract", "x": 0, "z": 0, "age": 40}
  ]
}
