{
  "format": 1,
  "name": "dispatch_re_answers15",
  "spec": ["dispatch 3", "dispatch 4.2", "dispatch 4.4"],
  "description": "BeginDispatch tracks every new vehicle, kind 0 in occupant group 0x4202 or 0x4303, else kind 1 (here a police car and a type-3 vehicle); a re-targeted vehicle is not tracked again (DP9). ReturnPylonToStation whose unit-state call fails does not place the pylon but still lists it; RevokeDispatchByPylon with no source for the pylon's type does nothing (DP8). A removed station's available pylon that is also the active one is shut down once and loses both references (DP7).",
  "steps": [
    {"op": "dispatch_create"},
    {"op": "dispatch_init", "expect": true},
    {"op": "dispatch_source", "source": "0x500", "types": [1], "stations": [{"station": "0x600", "base": 1, "count": 3}]},
    {"op": "dispatch_source", "source": "0x501", "types": [0, 3], "stations": [{"station": "0x601", "base": 1, "count": 3}]},
    {"op": "dispatch_clear_events"},
    {"op": "dispatch_call", "method": "dispatch", "args": [1, 1, 1], "expect": 1},
    {"op": "dispatch_call", "method": "dispatch", "args": [0, 1, 1], "expect": 2},
    {"op": "dispatch_call", "method": "dispatch", "args": [3, 1, 1], "expect": 3},
    {"op": "dispatch_expect_events", "filter": {"event": "track"}, "events": [{"event": "track", "kind": 0, "handle": 1}, {"event": "track", "kind": 1, "handle": 2}, {"event": "track", "kind": 1, "handle": 3}]},
    {"op": "dispatch_env", "vehicle_group": "0x4303"},
    {"op": "dispatch_call", "method": "dispatch", "args": [0, 2, 2], "expect": 4},
    {"op": "dispatch_env", "vehicle_group": null},
    {"op": "dispatch_expect_events", "filter": {"event": "track"}, "events": [{"event": "track", "kind": 0, "handle": 4}]},
    {"op": "dispatch_call", "method": "revoke_all_dispatches", "args": [0], "expect": true},
    {"op": "dispatch_call", "method": "begin_dispatch_tool", "args": [1], "expect": true},
    {"op": "dispatch_expect", "state": {"available_calls": [1, 2, 3]}},
    {"op": "dispatch_call", "method": "set_active_pylon", "args": ["0x1008"]},
    {"op": "dispatch_call", "method": "dispatch", "args": [1, 10, 10], "expect": 5},
    {"op": "dispatch_clear_events"},
    {"op": "dispatch_call", "method": "dispatch", "args": [1, 30, 40], "expect": 5},
    {"op": "dispatch_expect_event_count", "filter": {"event": "track"}, "count": 0},
    {"op": "dispatch_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "dispatch_type": 1, "id": 5}]},
    {"op": "dispatch_env", "park_fails": true},
    {"op": "dispatch_clear_events"},
    {"op": "dispatch_call", "method": "revoke_dispatch_by_pylon", "args": ["0x1008"], "expect": true},
    {"op": "dispatch_expect_event_count", "filter": {"event": "park_failed"}, "count": 2},
    {"op": "dispatch_expect_event_count", "filter": {"event": "park"}, "count": 0},
    {"op": "dispatch_expect", "state": {"available_calls": [2, 3, 1]}},
    {"op": "dispatch_env", "park_fails": false},
    {"op": "dispatch_source", "source": "0x500", "types": [7]},
    {"op": "dispatch_clear_events"},
    {"op": "dispatch_call", "method": "revoke_dispatch_by_pylon", "args": ["0x1008"], "expect": false},
    {"op": "dispatch_expect_events", "events": []},
    {"op": "dispatch_source", "source": "0x500", "types": [1]},
    {"op": "dispatch_call", "method": "set_active_pylon", "args": ["0x1008"]},
    {"op": "dispatch_expect_refs", "refs": {"0x1008": 2}},
    {"op": "dispatch_clear_events"},
    {"op": "dispatch_message", "type": "RemoveOccupant", "object": "0x600", "expect": true},
    {"op": "dispatch_expect_events", "filter": {"pylon": "0x1008"}, "events": [{"event": "pylon_shutdown", "pylon": "0x1008"}]},
    {"op": "dispatch_expect_refs", "refs": {"0x1008": 0}},
    {"op": "dispatch_expect", "state": {"active_pylon": null, "available_pylons": []}}
  ]
}
