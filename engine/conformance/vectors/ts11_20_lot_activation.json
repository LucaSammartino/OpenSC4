{
  "format": 1,
  "name": "ts11_20_lot_activation",
  "spec": [
    "traffic-simulator 4.1",
    "traffic-simulator 4.2",
    "traffic-simulator 10"
  ],
  "description": "§4.1.3 (TN1): activating a lot stores its destination bits over the lot (stored, not ORed: the stale 0x80 at (1,1) is replaced) from the trip capacity (max[1] = 4, max[3] = 9 -> 0x0A), counts the free destinations, puts the lot in strategy bucket 0. Deactivation clears the bits. A lot without a building stops at once: no draw, no bucket.",
  "steps": [
    {
      "op": "ts_lot",
      "id": 5,
      "rect": [
        1,
        1,
        2,
        2
      ],
      "holder": 50,
      "capacity": [
        0,
        4,
        0,
        9
      ]
    },
    {
      "op": "ts_init",
      "expect": true
    },
    {
      "op": "ts_state",
      "state": {
        "dest": [
          [
            1,
            1,
            "0x80"
          ]
        ]
      }
    },
    {
      "op": "ts_call",
      "method": "do_message",
      "args": [
        "0xE8BDA2E7",
        0,
        3,
        0,
        5
      ],
      "expect": true
    },
    {
      "op": "ts_call",
      "method": "destination_byte",
      "args": [
        1,
        1
      ],
      "expect": "0x0A"
    },
    {
      "op": "ts_call",
      "method": "destination_byte",
      "args": [
        2,
        1
      ],
      "expect": "0x0A"
    },
    {
      "op": "ts_call",
      "method": "destination_byte",
      "args": [
        1,
        2
      ],
      "expect": "0x0A"
    },
    {
      "op": "ts_call",
      "method": "destination_byte",
      "args": [
        2,
        2
      ],
      "expect": "0x0A"
    },
    {
      "op": "ts_call",
      "method": "free_destinations",
      "expect": [
        0,
        1,
        0,
        1
      ]
    },
    {
      "op": "ts_expect_prop",
      "holder": 50,
      "id": "0x691C863C",
      "expect": [
        0
      ]
    },
    {
      "op": "ts_expect_state",
      "state": {
        "strategy_bucket_counter": 1
      }
    },
    {
      "op": "ts_call",
      "method": "do_message",
      "args": [
        "0xE8BDA2E7",
        3,
        0,
        0,
        5
      ],
      "note": "deactivated"
    },
    {
      "op": "ts_call",
      "method": "destination_byte",
      "args": [
        2,
        2
      ],
      "expect": 0
    },
    {
      "op": "ts_lot",
      "id": 6,
      "rect": [
        4,
        4,
        4,
        4
      ],
      "holder": 60,
      "building": null
    },
    {
      "op": "ts_call",
      "method": "do_message",
      "args": [
        "0xE8BDA2E7",
        0,
        3,
        0,
        6
      ]
    },
    {
      "op": "ts_expect_state",
      "state": {
        "strategy_bucket_counter": 1
      }
    },
    {
      "op": "ts_expect_prop",
      "holder": 60,
      "id": "0x4A611773",
      "expect": null
    }
  ]
}
