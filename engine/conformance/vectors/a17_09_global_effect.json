    {"op": "aura_idle", "expect_state": 15},
    {"op": "aura_expect", "state": {"global_effect": 0}},
    {"op": "aura_expect_grid", "grid": "base", "cells": [[0, 0, 2], [1, 0, 10], [2, 0, 10], [3, 0, -125]], "others": -128},
    {"op": "aura_env", "ordinance_offset": -5},
    {"op": "aura_set_grid", "grid": "base", "fill": -128, "cells": [[0, 0, 0], [1, 0, -128], [2, 0, 10], [3, 0, -128]]},
    {"op": "aura_set", "state": {"state": 14, "global_effect": 0}},
    {"op": "aura_idle", "expect_state": 15},
    {"op": "aura_expect", "state": {"global_effect": -5}},
