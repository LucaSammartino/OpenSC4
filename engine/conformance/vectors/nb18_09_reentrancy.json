{
  "format": 1,
  "name": "nb18_09_reentrancy",
  "spec": ["neighbors 5.3", "neighbors 7.2", "neighbors 11.1", "neighbors 18"],
  "description": "Conformance test 9. A deal that is neither Proposed nor Active is cancelled during a run: Cancel's SetFlags posts status 0, its SetAmount(0) sends status 0, delivered at once; the simulation is busy, so the nested call posts 0xEA418D8F with data1 = 8 (no deal) and changes nothing (one run: two UpdateCommodityStats, 16 history records); then UpdateCost posts 0. Delivering the three posted reports runs the simulation again: the first removes the cancelled deal (status 2, then the same sent 0 / retry 8 / posted 0), and the queue drains after 6 deliveries. Status 0 and 8 set statsDirty, the others (1-7) dealsDirty (not ready: no run; SimNewDay pushes and clears both between checks).",
  "steps": [
    {"op": "neighbors_env", "current": 1, "today": 1000},
    {"op": "neighbors_city", "id": 1, "pos": [3, 3], "size": [1, 1]},
    {"op": "neighbors_city", "id": 2, "pos": [1, 3], "size": [2, 2]},
    {"op": "neighbors_create", "ready": true},
    {"op": "neighbors_call", "method": "create_connection", "args": ["power_pole", -1, 5, false], "expect": true},
    {"op": "neighbors_deal", "id": 1, "type": "E1", "other": 2, "flags": 0, "amount": 30, "start": 1000, "expiration": 2000},
    {"op": "neighbors_clear_events"},
    {"op": "neighbors_month"},
    {"op": "neighbors_expect_event_count", "filter": {"event": "history"}, "count": 16},
    {"op": "neighbors_expect_events", "filter": {"event": "status"}, "events": [
      {"deal": 1, "status": 0, "flags": 4, "sent": false},
      {"deal": 1, "status": 0, "flags": 4, "sent": true},
      {"deal": null, "status": 8, "flags": 0, "sent": false},
      {"deal": 1, "status": 0, "flags": 4, "sent": false}
    ]},
    {"op": "neighbors_expect", "deal": 1, "deal_state": {"flags": 4, "amount": 0, "cost": 1, "in_list": true}},
    {"op": "neighbors_expect", "state": {"busy": false, "posted": 3}},
    {"op": "neighbors_clear_events"},
    {"op": "neighbors_deliver", "count": 6},
    {"op": "neighbors_expect", "deals": []},
    {"op": "neighbors_expect_events", "filter": {"event": "status"}, "events": [
      {"deal": 1, "status": 2, "flags": 4, "sent": false},
      {"deal": 1, "status": 0, "flags": 4, "sent": true},
      {"deal": null, "status": 8, "sent": false},
      {"deal": 1, "status": 0, "flags": 4, "sent": false}
    ]},
    {"op": "neighbors_expect", "state": {"posted": 0}},

    {"op": "neighbors_create", "ready": false},
    {"op": "neighbors_expect", "state": {"deals_dirty": false, "stats_dirty": false}},
    {"op": "neighbors_message", "type": "0xEA418D8F", "data1": 0},
    {"op": "neighbors_expect", "state": {"deals_dirty": false, "stats_dirty": true}},
    {"op": "neighbors_message", "type": "0x66956814"},
    {"op": "neighbors_message", "type": "0xEA418D8F", "data1": 1},
    {"op": "neighbors_expect", "state": {"deals_dirty": true, "stats_dirty": false}},
    {"op": "neighbors_message", "type": "0x66956814"},
    {"op": "neighbors_message", "type": "0xEA418D8F", "data1": 2},
    {"op": "neighbors_expect", "state": {"deals_dirty": true, "stats_dirty": false}},
    {"op": "neighbors_message", "type": "0x66956814"},
    {"op": "neighbors_message", "type": "0xEA418D8F", "data1": 3},
    {"op": "neighbors_expect", "state": {"deals_dirty": true, "stats_dirty": false}},
    {"op": "neighbors_message", "type": "0x66956814"},
    {"op": "neighbors_message", "type": "0xEA418D8F", "data1": 4},
    {"op": "neighbors_expect", "state": {"deals_dirty": true, "stats_dirty": false}},
    {"op": "neighbors_message", "type": "0x66956814"},
    {"op": "neighbors_message", "type": "0xEA418D8F", "data1": 5},
    {"op": "neighbors_expect", "state": {"deals_dirty": true, "stats_dirty": false}},
    {"op": "neighbors_message", "type": "0x66956814"},
    {"op": "neighbors_message", "type": "0xEA418D8F", "data1": 6},
    {"op": "neighbors_expect", "state": {"deals_dirty": true, "stats_dirty": false}},
    {"op": "neighbors_message", "type": "0x66956814"},
    {"op": "neighbors_message", "type": "0xEA418D8F", "data1": 7},
    {"op": "neighbors_expect", "state": {"deals_dirty": true, "stats_dirty": false}},
    {"op": "neighbors_message", "type": "0x66956814"},
    {"op": "neighbors_message", "type": "0xEA418D8F", "data1": 8},
    {"op": "neighbors_expect", "state": {"deals_dirty": false, "stats_dirty": true}},
    {"op": "neighbors_message", "type": "0x66956814"},
    {"op": "neighbors_expect", "state": {"deals_dirty": false, "stats_dirty": false}}
  ]
}
