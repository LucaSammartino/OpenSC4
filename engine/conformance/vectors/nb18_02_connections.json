{
  "format": 1,
  "name": "nb18_02_connections",
  "spec": ["neighbors 4.3", "neighbors 6.3", "neighbors 6.4", "neighbors 6.5", "neighbors 13", "neighbors 18"],
  "description": "Conformance test 2. CreateConnection twice creates one object: ChangeSymmetricConnection on the neighbour, one marker prop 0x29F10000 at the inner cell's centre and GetAltitude height with bool property 0xCAA46595, one 0x8A0D15DA. Orientation with flag false W 3 / N 0 / E 1 / S 2, with flag true 1 / 2 / 3 / 0; no prop for Ferry; Pipe adds 0xCAA45670 + 0xCAA45672, Subway 0xCAA45670 + 0xCAA45671; Highway sits 15.5 higher. DeleteOccupantConnection for a network occupant at (0,5) carrying road (0) and rail (1) deletes the Rail connection (-1,5) (every marker prop of the inner cell goes, the road's too; 0xEA0D163E once); a power pole in the corner cell (0,0) deletes two. The simulator record (u16 2, u32 count, references) and the connection record (version 1); a store save/load round trip reproduces the bytes; version 3 is rejected by both records (the store ignores Read's result, foundations 3.5, so a store entry patched to version 3 loads a simulator with no connections).",
  "steps": [
    {"op": "neighbors_env", "current": 1, "altitude": 270},
    {"op": "neighbors_city", "id": 1, "pos": [3, 3], "size": [1, 1]},
    {"op": "neighbors_city", "id": 2, "pos": [1, 3], "size": [2, 2]},
    {"op": "neighbors_city", "id": 3, "pos": [4, 2], "size": [2, 2]},
    {"op": "neighbors_city", "id": 4, "pos": [2, 1], "size": [2, 2]},
    {"op": "neighbors_city", "id": 5, "pos": [3, 4], "size": [2, 2]},
    {"op": "neighbors_create"},
    {"op": "neighbors_clear_events"},

    {"op": "neighbors_call", "method": "create_connection", "args": ["road", -1, 5, false], "expect": true},
    {"op": "neighbors_call", "method": "create_connection", "args": ["road", -1, 5, false], "expect": false},
    {"op": "neighbors_expect_events", "events": [
      {"event": "symmetric", "city": 2, "type": 2, "x": -1, "z": 5, "add": true},
      {"event": "prop_add", "prop": 256, "pos": [8, 270, 88], "orientation": 3, "props": ["0xCAA46595"]},
      {"event": "connection_created", "type": 2, "x": -1, "z": 5}
    ]},
    {"op": "neighbors_expect", "state": {"connections": 1, "props": 1}},
    {"op": "neighbors_expect", "connection": ["road", -1, 5], "connection_state": {"other_region_cell": [2, 3], "active": true, "visited": false, "flags": 0}},
    {"op": "neighbors_record", "hex": "0200 01000000 01000000 244F130A"},
    {"op": "neighbors_connection_record", "connection": ["road", -1, 5], "hex": "0100 02000000 FFFFFFFF 05000000 02000000 03000000 00 0200 00000000"},

    {"op": "neighbors_call", "method": "create_connection", "args": ["rail", 5, -1, false], "expect": true},
    {"op": "neighbors_call", "method": "create_connection", "args": ["rail", 64, 5, false], "expect": true},
    {"op": "neighbors_call", "method": "create_connection", "args": ["rail", 5, 64, false], "expect": true},
    {"op": "neighbors_call", "method": "create_connection", "args": ["dirt_road", -1, 6, true], "expect": true},
    {"op": "neighbors_call", "method": "create_connection", "args": ["dirt_road", 6, -1, true], "expect": true},
    {"op": "neighbors_call", "method": "create_connection", "args": ["dirt_road", 64, 6, true], "expect": true},
    {"op": "neighbors_call", "method": "create_connection", "args": ["dirt_road", 6, 64, true], "expect": true},
    {"op": "neighbors_expect_events", "filter": {"event": "prop_add"}, "events": [
      {"orientation": 0, "pos": [88, 270, 8]},
      {"orientation": 1, "pos": [1016, 270, 88]},
      {"orientation": 2, "pos": [88, 270, 1016]},
      {"orientation": 1},
      {"orientation": 2},
      {"orientation": 3},
      {"orientation": 0}
    ]},

    {"op": "neighbors_call", "method": "create_connection", "args": ["ferry", -1, 20, false], "expect": true},
    {"op": "neighbors_expect_event_count", "filter": {"event": "prop_add"}, "count": 0},
    {"op": "neighbors_expect_event_count", "filter": {"event": "connection_created", "type": 9, "x": -1, "z": 20}, "count": 1},
    {"op": "neighbors_clear_events"},
    {"op": "neighbors_call", "method": "create_connection", "args": ["pipe", -1, 30, false], "expect": true},
    {"op": "neighbors_call", "method": "create_connection", "args": ["subway", -1, 31, false], "expect": true},
    {"op": "neighbors_call", "method": "create_connection", "args": ["highway", -1, 40, false], "expect": true},
    {"op": "neighbors_expect_events", "filter": {"event": "prop_add"}, "events": [
      {"pos": [8, 270, 488], "props": ["0xCAA46595", "0xCAA45670", "0xCAA45672"]},
      {"pos": [8, 270, 504], "props": ["0xCAA46595", "0xCAA45670", "0xCAA45671"]},
      {"pos": [8, 285.5, 648], "props": ["0xCAA46595"]}
    ]},

    {"op": "neighbors_call", "method": "create_connection", "args": ["rail", -1, 5, false], "expect": true},
    {"op": "neighbors_occupant", "id": 7, "kind": "network", "networks": [0, 1], "cell": [0, 5]},
    {"op": "neighbors_clear_events"},
    {"op": "neighbors_call", "method": "delete_occupant_connection", "args": [7]},
    {"op": "neighbors_expect_events", "events": [
      {"event": "symmetric", "city": 2, "type": 1, "x": -1, "z": 5, "add": false},
      {"event": "prop_remove", "prop": 256},
      {"event": "prop_remove", "prop": 267},
      {"event": "connection_deleted", "type": 1, "x": -1, "z": 5}
    ]},
    {"op": "neighbors_call", "method": "has_connection", "args": ["road", -1, 5], "expect": true},
    {"op": "neighbors_call", "method": "has_connection", "args": ["rail", -1, 5], "expect": false},

    {"op": "neighbors_call", "method": "create_connection", "args": ["power_pole", -1, 0, false], "expect": true},
    {"op": "neighbors_call", "method": "create_connection", "args": ["power_pole", 0, -1, false], "expect": true},
    {"op": "neighbors_occupant", "id": 8, "kind": "power_pole", "cell": [0, 0]},
    {"op": "neighbors_clear_events"},
    {"op": "neighbors_call", "method": "delete_occupant_connection", "args": [8]},
    {"op": "neighbors_expect_events", "filter": {"event": "connection_deleted"}, "events": [
      {"type": 4, "x": -1, "z": 0},
      {"type": 4, "x": 0, "z": -1}
    ]},
    {"op": "neighbors_call", "method": "connections_of_type", "args": ["power_pole"], "expect": []},
    {"op": "neighbors_occupant", "id": 9, "kind": "network", "networks": [3], "cell": [0, 5]},
    {"op": "neighbors_call", "method": "delete_occupant_connection", "args": [9]},
    {"op": "neighbors_call", "method": "delete_occupant_connection", "args": [10]},
    {"op": "neighbors_expect_events", "events": []},

    {"op": "neighbors_expect", "state": {"connections": 12}},
    {"op": "neighbors_connection_set", "connection": ["rail", 64, 5], "active": false, "visited": true},
    {"op": "neighbors_save", "slot": "a"},
    {"op": "neighbors_load", "slot": "a"},
    {"op": "neighbors_expect", "state": {"connections": 12, "initialized": false}},
    {"op": "neighbors_expect", "connection": ["rail", 64, 5], "connection_state": {"other_region_cell": [4, 3], "active": false, "visited": true, "flags": 3}},
    {"op": "neighbors_expect", "connection": ["highway", -1, 40], "connection_state": {"other_region_cell": [2, 3], "active": true, "flags": 0}},
    {"op": "neighbors_call", "method": "connections", "expect": [
      [2, -1, 5], [1, 5, -1], [1, 64, 5], [1, 5, 64], [10, -1, 6], [10, 6, -1], [10, 64, 6], [10, 6, 64],
      [9, -1, 20], [5, -1, 30], [6, -1, 31], [3, -1, 40]
    ]},
    {"op": "neighbors_expect_save", "slot": "a"},

    {"op": "neighbors_record", "read": "0200 02000000 01000000 244F130A 02000000 244F130A", "expect": true, "connections": 2},
    {"op": "neighbors_record", "read": "0300 01000000 01000000 244F130A", "expect": false, "connections": 0},
    {"op": "neighbors_record", "read": "0100 00000000", "expect": false},
    {"op": "neighbors_patch", "slot": "a", "class": "simulator", "offset": 0, "hex": "0300"},
    {"op": "neighbors_load", "slot": "a", "expect": true},
    {"op": "neighbors_expect", "state": {"connections": 0}},
    {"op": "neighbors_connection_record", "read": "0100 02000000 FFFFFFFF 05000000 02000000 03000000 03 0200 00000000", "expect": true, "rewrite": true, "connection_state": {"type": 2, "cell": [-1, 5], "other_region_cell": [2, 3], "active": false, "visited": true}},
    {"op": "neighbors_connection_record", "read": "0300 02000000 FFFFFFFF 05000000 02000000 03000000 00 0200 00000000", "expect": false},
    {"op": "neighbors_connection_record", "read": "0200 02000000 FFFFFFFF 05000000 02000000 03000000 00 0200 00000000", "expect": false}
  ]
}
