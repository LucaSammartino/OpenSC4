{
  "format": 1,
  "name": "citysit_no_city_end",
  "spec": ["city-situation 0", "city-situation 12.7"],
  "description": "Funds forced below -100,000 with a mission active, then failed: the component posts no 0xAA5CF1E3 and makes no close or region request; its posts are only its own popup message.",
  "steps": [
    {"op": "citysit_env", "funds": -150000},
    {"op": "citysit_create"},
    {"op": "citysit_add_ref", "expect": 1},
    {"op": "citysit_advice", "advice": "0x500", "guid": "0x8C151EFD", "failure_money": -3000},
    {"op": "citysit_automaton", "automaton": "0x700", "position": [100, 200]},
    {"op": "citysit_init", "expect": true},
    {"op": "citysit_call", "method": "initiate_situation", "args": ["0x500", "0x700", false], "expect": true},
    {"op": "citysit_call", "method": "activate_situation", "args": []},
    {"op": "citysit_ticks", "count": 1, "ms": 16},
    {"op": "citysit_ticks", "count": 1, "ms": 4000},
    {"op": "citysit_expect", "state": {"status": 3, "countdown": 0}},
    {"op": "citysit_clear_events"},
    {"op": "citysit_ticks", "count": 100, "ms": 100},
    {"op": "citysit_env", "status": 2},
    {"op": "citysit_ticks", "count": 20, "ms": 100},
    {"op": "citysit_expect_event_count", "filter": {"event": "post", "type": "0xAA5CF1E3"}, "count": 0},
    {"op": "citysit_expect_event_count", "filter": {"event": "post"}, "count": 1},
    {"op": "citysit_expect_event_count", "filter": {"event": "post", "type": "0xEBB67EF7"}, "count": 1},
    {"op": "citysit_expect_world", "state": {"funds": -150000}}
  ]
}
