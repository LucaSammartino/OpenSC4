{
  "format": 1,
  "name": "demolition_reparcel",
  "spec": ["demolition 4.6", "demolition 4.10", "demolition 12.7"],
  "description": "Committing over a 2x2 zone-8 lot with flags 1 deletes it and creates four 1x1 lots with its facing (x outer, z inner). With 0x801 the lot stays, in state 1. Worked example 4: only the cells that still hold zone 7 are re-parcelled.",
  "steps": [
    {"op": "demolition_create"},
    {"op": "demolition_init", "expect": true},
    {"op": "demolition_clear_events"},
    {"op": "demolition_lot", "lot": "0x50", "rect": [20, 30, 21, 31], "zone": 8, "facing": 2},
    {"op": "demolition_region", "do_it": true, "rect": [20, 30, 21, 31], "privilege": 1, "flags": 1, "expect": {"ok": true, "cost": 0}},
    {"op": "demolition_expect_events", "events": [{"event": "queue", "on": true}, {"event": "start", "lot": "0x50"}, {"event": "end", "lot": "0x50"}, {"event": "delete", "lot": "0x50"}, {"event": "create", "x": 20, "z": 30, "facing": 2}, {"event": "create", "x": 20, "z": 31, "facing": 2}, {"event": "create", "x": 21, "z": 30, "facing": 2}, {"event": "create", "x": 21, "z": 31, "facing": 2}, {"event": "queue", "on": false}]},
    {"op": "demolition_expect_lot", "lot": "0x50", "absent": true},
    {"op": "demolition_expect_zones", "lot_count": 4},
    {"op": "demolition_lot", "lot": "0x60", "rect": [40, 40, 41, 41], "zone": 8},
    {"op": "demolition_region", "do_it": true, "rect": [40, 40, 41, 41], "privilege": 1, "flags": "0x801", "expect": {"ok": true, "cost": 0}},
    {"op": "demolition_expect_event_count", "filter": {"event": "delete"}, "count": 0},
    {"op": "demolition_expect_event_count", "filter": {"event": "create"}, "count": 0},
    {"op": "demolition_expect_lot", "lot": "0x60", "state": {"state": 1}},
    {"op": "demolition_lot", "lot": "0x70", "rect": [50, 50, 52, 50], "zone": 7},
    {"op": "demolition_env", "zones": [[50, 50, 50, 50, 1]]},
    {"op": "demolition_clear_events"},
    {"op": "demolition_lots", "do_it": true, "lots": ["0x70"], "privilege": 0, "flags": "0x2000"},
    {"op": "demolition_expect_events", "filter": {"event": "create"}, "events": [{"event": "create", "x": 51, "z": 50, "facing": 0}, {"event": "create", "x": 52, "z": 50, "facing": 0}]}
  ]
}
