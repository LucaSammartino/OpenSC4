{
  "format": 1,
  "name": "advisor_trigger_values",
  "spec": ["advisors 6.1", "advisors 17.5"],
  "description": "Trigger results: true and 1 are true, 0 false, NaN true, the string \"1\" false, nil false, a Lua error false. The forced-trigger flag 0x400 makes it true, the no-text flag 0x80 false. A trigger that fails to compile is false; a missing trigger compiles \"0\".",
  "steps": [
    {"op": "adv_advisor", "class": "Advisor", "id": 23},
    {"op": "adv_advice", "guid": 1, "trigger": "x"},
    {"op": "adv_advice", "guid": 2, "trigger": "bad"},
    {"op": "adv_advice", "guid": 3, "trigger": null},
    {"op": "adv_advice", "guid": 4, "trigger": "0/0"},
    {"op": "adv_trigger", "text": "bad", "bad": true},
    {"op": "adv_create"},
    {"op": "adv_init", "expect": true},
    {"op": "adv_trigger", "text": "x", "result": true},
    {"op": "adv_get_trigger", "advice": {"advice": 1}, "expect": true},
    {"op": "adv_trigger", "text": "x", "result": 1},
    {"op": "adv_get_trigger", "advice": {"advice": 1}, "expect": true},
    {"op": "adv_trigger", "text": "x", "result": 0},
    {"op": "adv_get_trigger", "advice": {"advice": 1}, "expect": false},
    {"op": "adv_trigger", "text": "x", "result": "nan"},
    {"op": "adv_get_trigger", "advice": {"advice": 1}, "expect": true},
    {"op": "adv_trigger", "text": "x", "result": {"str": "1"}},
    {"op": "adv_get_trigger", "advice": {"advice": 1}, "expect": false},
    {"op": "adv_trigger", "text": "x", "result": "nil"},
    {"op": "adv_get_trigger", "advice": {"advice": 1}, "expect": false},
    {"op": "adv_trigger", "text": "x", "result": "error"},
    {"op": "adv_get_trigger", "advice": {"advice": 1}, "expect": false},
    {"op": "adv_trigger", "text": "x", "result": false},
    {"op": "adv_flags", "advice": {"advice": 1}, "mask": "0x400", "on": true},
    {"op": "adv_get_trigger", "advice": {"advice": 1}, "expect": true, "note": "forced trigger"},
    {"op": "adv_flags", "advice": {"advice": 1}, "mask": "0x400", "on": false},
    {"op": "adv_trigger", "text": "x", "result": true},
    {"op": "adv_flags", "advice": {"advice": 1}, "mask": "0x80", "on": true},
    {"op": "adv_get_trigger", "advice": {"advice": 1}, "expect": false, "note": "no-text flag"},
    {"op": "adv_expect", "object": {"advice": 2}, "state": {"has_trigger": false}},
    {"op": "adv_get_trigger", "advice": {"advice": 2}, "expect": false, "note": "a trigger that did not compile"},
    {"op": "adv_expect", "object": {"advice": 3}, "state": {"trigger_source": "0", "has_trigger": true}},
    {"op": "adv_get_trigger", "advice": {"advice": 3}, "expect": false, "note": "a missing trigger compiles \"0\""},
    {"op": "adv_get_trigger", "advice": {"advice": 4}, "expect": true, "note": "0/0 (NaN) is true"}
  ]
}
