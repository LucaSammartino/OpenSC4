{
  "format": 1,
  "name": "port_developers_empty_records",
  "spec": ["port-developers 1", "port-developers 7", "port-developers 12"],
  "description": "Section 12 test 1 and the identity of section 1. A fresh airport writes the 12-byte empty record (subclass version 2, port version 1, tuning instance 0xCA270E9D, zone type 11, no ports); a fresh seaport writes instance 0xEA29AD92 and zone type 12. A subclass version 1 or 3, a port version other than 1, or a short record is rejected; reading loads the tuning (read before Init). QueryInterface: the subclass IID answers +0; 1 and cISC4PortDeveloper answer +4 [compat]; the message target +8; the serializable +0xC; the other subclass's IID nothing.",
  "steps": [
    {"op": "pd_create", "kind": "airport"},
    {"op": "pd_write", "hex": "0200 0100 9D0E27CA 0B00 0000", "expect": true},
    {"op": "pd_expect", "state": {"tuning_loaded": false, "zone_type": 11, "tuning_instance": "0xCA270E9D", "ports": 0}},
    {"op": "pd_identity", "kind": "airport", "iids": {"0xEA20548D": 0, "0x00000001": 4, "0x4A2C4E69": 4, "0x452294AA": 8, "0xE4FDA3D4": 12, "0xCA22FE3E": false, "0x12345678": false}},
    {"op": "pd_read", "hex": "0100 0100 9D0E27CA 0B00 0000", "fresh": true, "expect": false},
    {"op": "pd_read", "hex": "0300 0100 9D0E27CA 0B00 0000", "fresh": true, "expect": false},
    {"op": "pd_read", "hex": "0200 0200 9D0E27CA 0B00 0000", "fresh": true, "expect": false},
    {"op": "pd_read", "hex": "0200 0100 9D0E27CA 0B00", "fresh": true, "expect": false},
    {"op": "pd_read", "hex": "0200 0100 9D0E27CA 0B00 0000", "fresh": true, "expect": true},
    {"op": "pd_expect", "state": {"tuning_loaded": true, "types": 3, "type_count": 3, "ports": 0}},

    {"op": "pd_create", "kind": "seaport"},
    {"op": "pd_write", "hex": "0200 0100 92AD29EA 0C00 0000"},
    {"op": "pd_identity", "kind": "seaport", "iids": {"0xCA22FE3E": 0, "0x00000001": 4, "0x4A2C4E69": 4, "0x452294AA": 8, "0xE4FDA3D4": 12, "0xEA20548D": false}},
    {"op": "pd_read", "hex": "0200 0100 92AD29EA 0C00 0000", "fresh": true, "expect": true},
    {"op": "pd_expect", "state": {"zone_type": 12, "types": 1, "type_count": 1}}
  ]
}
