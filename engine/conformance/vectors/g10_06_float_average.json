{
  "format": 1,
  "name": "grid_float_average",
  "spec": ["simgrid 4.1", "simgrid 10.6"],
  "description": "Float grids sum truncated values but return the fractional quotient (quirk).",
  "steps": [
    {"op": "grid_city", "cells": [4, 4], "width": [16, 16]},
    {"op": "grid_create", "name": "f", "type": "f32", "tract_size": 1},
    {"op": "grid_set", "grid": "f", "cells": [[0, 0, 1.9], [1, 0, 2.9]]},
    {"op": "grid_call", "grid": "f", "method": "average_in_tract_rect", "args": [0, 0, 2, 1], "expect": 1.5},
    {"op": "grid_call", "grid": "f", "method": "average_in_cell_rect", "args": [0, 0, 2, 1], "expect": 1.5},
    {"op": "grid_call", "grid": "f", "method": "average_in_cell_rect", "args": [0, 0, 1, 1], "expect": 1.9},
    {"op": "grid_create", "name": "d", "type": "f64", "tract_size": 1},
    {"op": "grid_set", "grid": "d", "cells": [[0, 0, -1.5], [0, 1, 0.5], [0, 2, 2.0]]},
    {"op": "grid_call", "grid": "d", "method": "average_in_tract_rect", "args": [0, 0, 1, 3], "expect": 0.3333333333333333}
  ]
}
