{
  "format": 1,
  "name": "citysit_mission_clock",
  "spec": ["city-situation 4.3", "city-situation 4.4"],
  "description": "InitiateSituation with a briefing holds the advice, binds the script and posts the briefing popup; the same advice again answers false. ActivateSituation: status 3, the start script, the time limit (60 s), 0xABBBCA64 data1 = 1, the player-drive mode. The first tick freezes the four automata managers and starts the 4000 ms countdown; the mission clock does not run during it; the tick that ends it unfreezes them and runs the clock. The 30-second warning sound plays once, in the tick that starts with 30 s elapsed (CS4: it compares the elapsed time before the tick's clock step); the time limit fails the mission (status 2) in the tick that brings the clock to 60 s. DeactivateSituation clears the mission state, sends 0xABBBCA64 data1 = 0 and releases the advice (CS6).",
  "steps": [
    {"op": "citysit_create"},
    {"op": "citysit_add_ref", "expect": 1},
    {"op": "citysit_advice", "advice": "0x500", "guid": "0x8C151EFD", "time_limit": 60},
    {"op": "citysit_automaton", "automaton": "0x700"},
    {"op": "citysit_init", "expect": true},
    {"op": "citysit_clear_events"},
    {"op": "citysit_call", "method": "initiate_situation", "args": ["0x500", "0x700", true], "expect": true},
    {"op": "citysit_call", "method": "initiate_situation", "args": ["0x500", "0x700", true], "expect": false},
    {"op": "citysit_expect_refs", "refs": {"0x500": 1}},
    {"op": "citysit_expect_events", "events": [{"event": "bind", "advice": "0x500", "vehicle": "0x700"}, {"event": "post", "type": "0xEBB67EF7", "advice": "0x500", "vehicle": "0x700"}]},
    {"op": "citysit_call", "method": "activate_situation", "args": []},
    {"op": "citysit_expect_events", "events": [{"event": "script", "advice": "0x500", "script": "start"}, {"event": "send", "type": "0xABBBCA64", "advice": "0x500", "data1": 1}, {"event": "drive", "vehicle": "0x700", "on": true}]},
    {"op": "citysit_call", "method": "get_current_time_limit_seconds", "args": [], "expect": 60},
    {"op": "citysit_ticks", "count": 1, "ms": 10},
    {"op": "citysit_expect_events", "events": [{"event": "freeze", "manager": "0x43", "on": true}, {"event": "freeze", "manager": "0x45", "on": true}, {"event": "freeze", "manager": "0x44", "on": true}, {"event": "freeze", "manager": "0x46", "on": true}, {"event": "countdown_start"}]},
    {"op": "citysit_call", "method": "countdown_is_in_progress", "args": [], "expect": true},
    {"op": "citysit_ticks", "count": 1, "ms": 3000},
    {"op": "citysit_expect_events", "events": []},
    {"op": "citysit_call", "method": "get_current_situation_time", "args": [], "expect": 0},
    {"op": "citysit_ticks", "count": 1, "ms": 1000},
    {"op": "citysit_expect_events", "events": [{"event": "countdown_end"}, {"event": "freeze", "manager": "0x43", "on": false}, {"event": "freeze", "manager": "0x45", "on": false}, {"event": "freeze", "manager": "0x44", "on": false}, {"event": "freeze", "manager": "0x46", "on": false}]},
    {"op": "citysit_call", "method": "get_current_situation_time", "args": [], "expect": 1},
    {"op": "citysit_ticks", "count": 29, "ms": 1000},
    {"op": "citysit_expect_events", "events": []},
    {"op": "citysit_ticks", "count": 1, "ms": 1000},
    {"op": "citysit_expect_events", "events": [{"event": "sound", "automaton": "0x700", "sound": "0x6C32871F"}]},
    {"op": "citysit_ticks", "count": 28, "ms": 1000},
    {"op": "citysit_call", "method": "get_current_status", "args": [], "expect": 3},
    {"op": "citysit_ticks", "count": 1, "ms": 1000},
    {"op": "citysit_call", "method": "get_current_status", "args": [], "expect": 2},
    {"op": "citysit_call", "method": "get_current_time_remaining_seconds", "args": [], "expect": 0},
    {"op": "citysit_expect", "state": {"end_delay": 1.0}},
    {"op": "citysit_clear_events"},
    {"op": "citysit_call", "method": "deactivate_situation", "args": []},
    {"op": "citysit_expect_events", "events": [{"event": "clear_mission_state", "advice": "0x500"}, {"event": "send", "type": "0xABBBCA64", "advice": "0x500", "data1": 0}]},
    {"op": "citysit_expect_refs", "refs": {"0x500": 0}},
    {"op": "citysit_expect", "state": {"status": 4, "active_situation": null, "active_automaton": null}}
  ]
}
