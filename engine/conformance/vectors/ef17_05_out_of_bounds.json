{
  "format": 1,
  "name": "effects_out_of_bounds",
  "spec": ["effects 8.2", "effects 17"],
  "description": "A stroke whose previous point is outside the city (64 x 64 cells) applies nothing and keeps the previous point, though the accumulator still drains; only a Start (prev := cur) brings it back, after which 100000 us at rate 130 applies 13 times.",
  "steps": [
    {"op": "ef_create", "directory": {"effects": [{"name": "stroke", "components": [{"type": "brush", "index": 10}]}]}},
    {"op": "ef_effect", "name": "stroke", "as": "S", "expect": true},
    {"op": "ef_call", "method": "set_position", "effect": "S", "args": [-50, 0, 100], "expect": true},
    {"op": "ef_call", "method": "start", "effect": "S", "expect": true},
    {"op": "ef_call", "method": "set_position", "effect": "S", "args": [100, 0, 100]},
    {"op": "ef_call", "method": "tick", "args": [100000], "repeat": 3},
    {"op": "ef_expect_event_count", "filter": {"event": "brush"}, "count": 0},
    {"op": "ef_expect_brush", "effect": "S", "state": {"prev": [-50, 100], "cur": [100, 100]}},
    {"op": "ef_call", "method": "start", "effect": "S"},
    {"op": "ef_clear_events"},
    {"op": "ef_call", "method": "tick", "args": [100000]},
    {"op": "ef_expect_event_count", "filter": {"event": "brush"}, "count": 13},
    {"op": "ef_expect_brush", "effect": "S", "state": {"prev": [100, 100]}}
  ]
}
