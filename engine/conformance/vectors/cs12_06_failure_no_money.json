{
  "format": 1,
  "name": "citysit_failure_penalty_no_money",
  "spec": ["city-situation 4.5", "city-situation 12.6"],
  "description": "Funds 1,000 and failure_money -3000: DepositFunds(-3000) is called and the budget refuses the withdrawal (funds stay 1,000); the failure script runs and the result popup is still posted. No success is counted.",
  "steps": [
    {"op": "citysit_env", "funds": 1000},
    {"op": "citysit_create"},
    {"op": "citysit_add_ref", "expect": 1},
    {"op": "citysit_advice", "advice": "0x500", "guid": "0x8C151EFD", "failure_money": -3000},
    {"op": "citysit_automaton", "automaton": "0x700", "position": [100, 200]},
    {"op": "citysit_init", "expect": true},
    {"op": "citysit_call", "method": "initiate_situation", "args": ["0x500", "0x700", false], "expect": true},
    {"op": "citysit_call", "method": "activate_situation", "args": []},
    {"op": "citysit_ticks", "count": 1, "ms": 16},
    {"op": "citysit_ticks", "count": 1, "ms": 4000},
    {"op": "citysit_expect", "state": {"status": 3, "countdown": 0}},
    {"op": "citysit_clear_events"},
    {"op": "citysit_env", "status": 2},
    {"op": "citysit_ticks", "count": 1, "ms": 16},
    {"op": "citysit_ticks", "count": 4, "ms": 250},
    {"op": "citysit_expect_events", "events": [{"event": "outcome_effect", "advice": "0x500", "success": false}, {"event": "deposit", "amount": -3000, "accepted": false}, {"event": "script", "advice": "0x500", "script": "failure"}, {"event": "post", "type": "0xEBB67EF7", "advice": "0x500", "vehicle": "0x700"}]},
    {"op": "citysit_expect_world", "state": {"funds": 1000, "retired": []}},
    {"op": "citysit_expect", "state": {"success_counts": {}}}
  ]
}
