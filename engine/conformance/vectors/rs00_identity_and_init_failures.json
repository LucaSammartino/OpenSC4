{
  "format": 1,
  "name": "residential_identity_and_init_failures",
  "spec": ["residential 1", "residential 4.1", "residential 10.2"],
  "description": "Section 4.1: Init fails without the demand node (stopping right after it), without the message server (no subscription) or without the simulator (after subscribing both messages). A message server taken by a failed Init stays held, so the next Init neither takes it again nor subscribes again. Section 1: AddRef / Release count from 0; the Release that would drop the count to 0 shuts the object down, destroys it and returns 0. QueryInterface answers IGZUnknown (1), cISC4ResidentialSimulator (0x077AC1EE), cIGZMessageTarget2 (0x452294AA) and cIGZSerializable (0xE4FDA3D4) only. The class ID is 0x4990C013.",
  "steps": [
    {"op": "residential_env", "cells": [4, 4], "demand_node": false},
    {"op": "residential_create"},
    {"op": "residential_init", "expect": false},
    {"op": "residential_expect_events", "events": [{"event": "acquire_services"}, {"event": "acquire_developers"}, {"event": "demand_node"}]},
    {"op": "residential_env", "demand_node": true, "message_server": false},
    {"op": "residential_init", "expect": false},
    {"op": "residential_expect_event_count", "filter": {"event": "subscribe"}, "count": 0},
    {"op": "residential_clear_events"},
    {"op": "residential_env", "message_server": true, "simulator": false},
    {"op": "residential_init", "expect": false},
    {"op": "residential_expect_event_count", "filter": {"event": "subscribe"}, "count": 2},
    {"op": "residential_expect_event_count", "filter": {"event": "add_agent"}, "count": 0},
    {"op": "residential_expect", "state": {"initialized": false, "message_server_held": true}},
    {"op": "residential_clear_events"},
    {"op": "residential_env", "simulator": true},
    {"op": "residential_init", "expect": true},
    {"op": "residential_expect_event_count", "filter": {"event": "message_server"}, "count": 0},
    {"op": "residential_expect_event_count", "filter": {"event": "subscribe"}, "count": 0},
    {"op": "residential_expect", "state": {"initialized": true, "ref_count": 0}},
    {"op": "residential_clear_events"},

    {"op": "residential_call", "method": "add_ref", "expect": 1},
    {"op": "residential_call", "method": "add_ref", "expect": 2},
    {"op": "residential_call", "method": "release", "expect": 1},
    {"op": "residential_expect", "state": {"destroyed": false, "ref_count": 1}},
    {"op": "residential_expect_events", "events": []},
    {"op": "residential_call", "method": "release", "expect": 0},
    {"op": "residential_expect", "state": {"destroyed": true, "initialized": false, "ref_count": 0}},
    {"op": "residential_expect_event_count", "filter": {"event": "remove_agent"}, "count": 1},
    {"op": "residential_call", "method": "query_interface", "args": [1], "expect": true},
    {"op": "residential_call", "method": "query_interface", "args": ["0x077AC1EE"], "expect": true},
    {"op": "residential_call", "method": "query_interface", "args": ["0x452294AA"], "expect": true},
    {"op": "residential_call", "method": "query_interface", "args": ["0xE4FDA3D4"], "expect": true},
    {"op": "residential_call", "method": "query_interface", "args": ["0x12345678"], "expect": false},
    {"op": "residential_call", "method": "class_id", "expect": "0x4990C013"}
  ]
}
