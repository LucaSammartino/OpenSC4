    {"op": "residential_expect", "state": {"school_covered": 60}},
    {"op": "residential_set", "state": {"state": 5, "lists": {"school_groups": [[3], [4]]}}},
    {"op": "residential_run_to", "state": 6, "steps": 1},
    {"op": "residential_expect", "state": {"school_covered": 30}},
    {"op": "residential_expect_grid", "grid": "school_coverage0", "cells": [[0, 0, 1]], "others": 0},
    {"op": "residential_expect_grid", "grid": "school_coverage1", "all": 0},
    {"op": "residential_set", "state": {"state": 7, "lists": {"hospital_groups": [[5]]}}},
    {"op": "residential_run_to", "state": 8, "steps": 1},
    {"op": "residential_expect", "state": {"hospital_covered": 30}}
  ]
