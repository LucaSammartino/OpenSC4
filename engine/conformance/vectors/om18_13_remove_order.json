{
  "format": 1,
  "name": "om18_13_remove_order",
  "spec": ["occupant-manager 5.2", "occupant-manager 15", "occupant-manager 18.13"],
  "description": "Remove with shutdown = true, data4 = 3: Remove (data4 3, flag 1 still set when posted) then Destroy (from Shutdown). Flag 1 clear, the manager's reference gone, the cells empty and their holders freed. Not inserted: false, but Shutdown still posts Destroy [quirk 6]. Inserted but no stored box: false, nothing posted, flag 1 stays, the reference stays.",
  "steps": [
    {"op": "om_create"},
    {"op": "om_call", "method": "set_city_size", "args": [1024, 1024], "expect": true},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_occupant", "occupant": "0x1", "min": [100, 0, 0], "max": [164, 10, 64]},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 0, "expect": true},
    {"op": "om_trace", "refs": true},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "remove", "occupant": "0x1", "shutdown": true, "data4": 3, "expect": true},
    {"op": "om_expect_events", "events": [{"event": "add_ref", "occupant": "0x1"}, {"event": "post", "type": "0x99EF1143", "occupant": "0x1", "data4": 3, "inserted": true}, {"event": "release", "occupant": "0x1"}, {"event": "post", "type": "0x99EF1141", "occupant": "0x1", "data4": 0, "inserted": false}, {"event": "release", "occupant": "0x1"}]},
    {"op": "om_expect_occupant", "occupant": "0x1", "state": {"flags": 0, "initialized": false}},
    {"op": "om_expect_refs", "refs": {"0x1": 0}},
    {"op": "om_call", "method": "is_cell_empty", "args": [65, 64], "expect": true},
    {"op": "om_call", "method": "is_cell_empty", "args": [66, 64], "expect": true},
    {"op": "om_expect_cell", "cell": [65, 64], "null": true},
    {"op": "om_expect_cell", "cell": [66, 64], "null": true},
    {"op": "om_trace", "refs": false},
    {"op": "om_occupant", "occupant": "0x1", "initialized": true},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "remove", "occupant": "0x1", "shutdown": true, "data4": 3, "expect": false},
    {"op": "om_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x99EF1141", "occupant": "0x1"}]},
    {"op": "om_expect_refs", "refs": {"0x1": 0}},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 0, "expect": true},
    {"op": "om_occupant", "occupant": "0x1", "om_box": null},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "remove", "occupant": "0x1", "shutdown": false, "data4": 3, "expect": false},
    {"op": "om_expect_events", "filter": {"event": "post"}, "events": []},
    {"op": "om_expect_occupant", "occupant": "0x1", "state": {"flags": 1}},
    {"op": "om_expect_refs", "refs": {"0x1": 1}},
    {"op": "om_call", "method": "remove", "occupant": 0, "shutdown": true, "expect": false},
    {"op": "om_call", "method": "is_cell_empty", "args": [-1, 0], "expect": true},
    {"op": "om_call", "method": "is_cell_empty", "args": [0, 192], "expect": true}
  ]
}
