{
  "format": 1,
  "name": "flammability_single_value_curve",
  "spec": ["flammability 6.8", "flammability 8", "flammability 16.17", "foundations 4.1", "foundations 4.3"],
  "description": "Test 17: the hotspot curve 0x29B4013D is deleted and rebuilt at each read with count / 2 points; a single value (a one-element array [12.0] or a scalar 12.0) or an empty array gives no points, which crashes the original at the first evaluation; [choice] FreeCity4 treats it as absent: with hotspot (3,3,50), r = 50 (not below the random probability 5, and no random lot) there is no fire and no shuffle rand() call. Two values [0, 12] make one point, the constant 12 (foundations 4.3): one hotspot of weight 1, r = 11 -> curve(1) = 12 > 11 -> hotspot fire at tract (3,3) x 1 + 0 (useProbability false, teleport false, IID 0, then SetCause(5)); r = 12 -> 12 > 12 fails, no fire. A one-element list is shuffled with no rand() call. Hand-derived.",
  "steps": [
    {"op": "flam_env", "cells": [8, 8]},
    {"op": "flam_tuning", "shipped": true, "props": {"0x29B4013D": {"f32": [12.0]}}},
    {"op": "flam_create", "rng": {"r": [50]}},
    {"op": "flam_init"},
    {"op": "flam_expect", "state": {"has_curve": false}},
    {"op": "flam_set", "state": {"hotspots": [[3, 3, 50]]}},
    {"op": "flam_clear_events"},
    {"op": "flam_call", "method": "fire_roll"},
    {"op": "flam_expect_events", "events": [{"event": "rng", "value": 50.0}]},
    {"op": "flam_expect_rand", "calls": 0},
    {"op": "flam_tuning", "shipped": true, "props": {"0x29B4013D": {"f32": 12.0}}},
    {"op": "flam_create", "rng": {"r": [50]}},
    {"op": "flam_init"},
    {"op": "flam_expect", "state": {"has_curve": false}},
    {"op": "flam_set", "state": {"hotspots": [[3, 3, 50]]}},
    {"op": "flam_clear_events"},
    {"op": "flam_call", "method": "fire_roll"},
    {"op": "flam_expect_events", "events": [{"event": "rng", "value": 50.0}]},
    {"op": "flam_expect_rand", "calls": 0},
    {"op": "flam_tuning", "shipped": true, "props": {"0x29B4013D": {"f32": []}}},
    {"op": "flam_create", "rng": {"r": [50]}},
    {"op": "flam_init"},
    {"op": "flam_expect", "state": {"has_curve": false}},
    {"op": "flam_set", "state": {"hotspots": [[3, 3, 50]]}},
    {"op": "flam_clear_events"},
    {"op": "flam_call", "method": "fire_roll"},
    {"op": "flam_expect_events", "events": [{"event": "rng", "value": 50.0}]},
    {"op": "flam_expect_rand", "calls": 0},
    {"op": "flam_tuning", "shipped": true, "props": {"0x29B4013D": {"f32": [0, 12]}}},
    {"op": "flam_create", "rng": {"r": [11, 12]}},
    {"op": "flam_init"},
    {"op": "flam_expect", "state": {"has_curve": true}},
    {"op": "flam_call", "method": "curve", "args": [1], "expect": 12},
    {"op": "flam_call", "method": "curve", "args": [1000], "expect": 12},
    {"op": "flam_set", "state": {"hotspots": [[3, 3, 1]]}},
    {"op": "flam_clear_events"},
    {"op": "flam_call", "method": "fire_roll"},
    {"op": "flam_expect_events", "events": [{"event": "rng", "value": 11.0}, {"event": "ignite", "x": 3, "z": 3, "use_probability": false, "teleport": false, "fire_iid": 0}, {"event": "cause", "cause": 5}]},
    {"op": "flam_call", "method": "fire_roll"},
    {"op": "flam_expect_events", "events": [{"event": "rng", "value": 12.0}]},
    {"op": "flam_expect_rand", "calls": 0}
  ]
}
