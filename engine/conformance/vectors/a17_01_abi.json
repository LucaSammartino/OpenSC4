{
  "format": 1,
  "name": "aura_abi",
  "spec": ["aura 1", "aura 8", "aura 12", "aura 17.1"],
  "description": "Slot 6 (AddTransientEffect(x, z, type)) pops 12 and slot 7 (4 floats) pops 16; slot 6 with type 2 (civic, shipped {25, 128}) equals slot 7 with (128 m, 25): radius 128 / 64 = 2 tracts, values from simgrid 7.1 with f32 steps (k = 12.5; centre 25, distance 1 -> 12.5 -> 12 half-even, 1.414 -> 7.325 -> 7); type 3 (network, shipped 0/0) and types >= 4 [choice] change nothing; GetMaxMayorRating / GetMinMayorRating return the rating with the location; GetMayorRating is the low 8 bits (300 -> 44); GetAuraValue reads by cell; class 0x0990BDD8; QueryInterface per 1. Cone values from an independent Python model of simgrid 7.1.",
  "steps": [
    {"op": "aura_create"},
    {"op": "aura_init", "expect": true},
    {"op": "aura_clear_events"},
    {"op": "aura_call", "method": "slot_pops", "args": [6], "expect": 12},
    {"op": "aura_call", "method": "slot_pops", "args": [7], "expect": 16},
    {"op": "aura_call", "method": "class_id", "expect": "0x0990BDD8"},
    {"op": "aura_call", "method": "query_interface", "args": ["0xC773E880"], "expect": "primary"},
    {"op": "aura_call", "method": "query_interface", "args": [1], "expect": "primary"},
    {"op": "aura_call", "method": "query_interface", "args": ["0x452294AA"], "expect": "message_target"},
    {"op": "aura_call", "method": "query_interface", "args": ["0xE4FDA3D4"], "expect": "serializable"},
    {"op": "aura_call", "method": "query_interface", "args": ["0x12345678"], "expect": false},
    {"op": "aura_call", "method": "add_transient_effect_type", "args": [352.0, 352.0, 2]},
    {"op": "aura_call", "method": "add_transient_effect", "args": [352.0, 864.0, 128.0, 25.0]},
    {"op": "aura_expect_grid", "grid": "transient", "cells": [[4, 4, 7], [4, 5, 12], [4, 6, 7], [5, 4, 12], [5, 5, 25], [5, 6, 12], [6, 4, 7], [6, 5, 12], [6, 6, 7], [4, 12, 7], [4, 13, 12], [4, 14, 7], [5, 12, 12], [5, 13, 25], [5, 14, 12], [6, 12, 7], [6, 13, 12], [6, 14, 7]], "others": 0},
    {"op": "aura_call", "method": "add_transient_effect_type", "args": [352.0, 352.0, 3]},
    {"op": "aura_call", "method": "add_transient_effect_type", "args": [352.0, 352.0, 4]},
    {"op": "aura_call", "method": "add_transient_effect_type", "args": [352.0, 352.0, 7]},
    {"op": "aura_expect_grid", "grid": "transient", "cells": [[4, 4, 7], [4, 5, 12], [4, 6, 7], [5, 4, 12], [5, 5, 25], [5, 6, 12], [6, 4, 7], [6, 5, 12], [6, 6, 7], [4, 12, 7], [4, 13, 12], [4, 14, 7], [5, 12, 12], [5, 13, 25], [5, 14, 12], [6, 12, 7], [6, 13, 12], [6, 14, 7]], "others": 0},
    {"op": "aura_set", "state": {"max_rating": 37, "max_location": [14, 22], "min_rating": -60, "min_location": [26, 26], "mayor_rating": 300}},
    {"op": "aura_call", "method": "max_mayor_rating", "expect": [37, 14, 22]},
    {"op": "aura_call", "method": "min_mayor_rating", "expect": [-60, 26, 26]},
    {"op": "aura_call", "method": "mayor_rating", "expect": 44},
    {"op": "aura_set", "state": {"mayor_rating": -12}},
    {"op": "aura_call", "method": "mayor_rating", "expect": -12},
    {"op": "aura_set_grid", "grid": "aura", "cells": [[3, 5, -9]]},
    {"op": "aura_call", "method": "aura_value", "args": [14, 22], "expect": -9},
    {"op": "aura_call", "method": "aura_value", "args": [12, 20], "expect": -9},
    {"op": "aura_call", "method": "aura_value", "args": [16, 22], "expect": 0}
  ]
}
