{
  "format": 1,
  "name": "aura_work_stamping",
  "spec": ["aura 6.4", "aura 6.5", "aura 6.13", "aura 17.6"],
  "description": "Lots stamp work = max(work, LotBaseAura) over their inclusive rectangles: A (-4) and B (3) overlap at (2, 2) -> 3; a lot without a building stamps -128 (no change); cells outside every lot stay -128 through every later stage (crime fill 0 adds curve(0) = 10 only to lot cells: -4 -> 6, 3 -> 13), and base tract (0, 0) is trunc(average of its 12 valid cells) (old -128 -> the average). The time slice: with step 1 and an expired timer, one lot per call (3 calls for 3 lots, then a call that finds the end -> state 6); each call with fewer than 5 x 1024 lots lowers the miss counter and at -4 the step doubles [inferred detail of 6.5]; a running timer lets one call do every lot. Hand-derived.",
  "steps": [
    {"op": "aura_env", "cells": [16, 16]},
    {"op": "aura_create"},
    {"op": "aura_init", "expect": true},
    {"op": "aura_clear_events"},
    {"op": "aura_env", "lots": [{"rect": [0, 0, 2, 2], "pops": [[4112, 10]]}, {"rect": [2, 2, 3, 3], "pops": [[4128, 5]]}, {"rect": [5, 5, 5, 5], "building": null, "pops": [[4112, 1]]}], "grids": {"crime": {"fill": 0}}},
    {"op": "aura_set", "state": {"base_aura": [-4, 3, 0], "slice_step": [1, 0]}},
    {"op": "aura_idle", "count": 3, "expect_state": 4},
    {"op": "aura_clear_events"},
    {"op": "aura_idle", "expect_state": 5},
    {"op": "aura_expect_events", "events": [{"event": "lot_iterator"}]},
    {"op": "aura_expect", "state": {"effective_base_aura": [-4, 3, 0], "lot_iterator": true}},
    {"op": "aura_expect_grid", "grid": "work", "others": -128},
    {"op": "aura_idle", "count": 3, "expect_state": 5},
    {"op": "aura_expect", "state": {"slice_step": [1, -3]}},
    {"op": "aura_expect_event_count", "filter": {"event": "timer_start", "ms": 5}, "count": 3},
    {"op": "aura_expect_grid", "grid": "work", "cells": [[0, 0, -4], [0, 1, -4], [0, 2, -4], [1, 0, -4], [1, 1, -4], [1, 2, -4], [2, 0, -4], [2, 1, -4], [2, 2, 3], [2, 3, 3], [3, 2, 3], [3, 3, 3]], "others": -128},
    {"op": "aura_idle", "expect_state": 6},
    {"op": "aura_expect", "state": {"slice_step": [2, 0], "lot_iterator": false}},
    {"op": "aura_run", "expect_calls": 12},
    {"op": "aura_expect_grid", "grid": "work", "cells": [[0, 0, 6], [0, 1, 6], [0, 2, 6], [1, 0, 6], [1, 1, 6], [1, 2, 6], [2, 0, 6], [2, 1, 6], [2, 2, 13], [2, 3, 13], [3, 2, 13], [3, 3, 13]], "others": -128},
    {"op": "aura_expect_grid", "grid": "base", "cells": [[0, 0, 8]], "others": -128},
    {"op": "aura_expect_grid", "grid": "aura", "cells": [[0, 0, 8]], "others": 0},
    {"op": "aura_message", "type": "SimNewMonth", "expect": true},
    {"op": "aura_env", "timer_expired": false},
    {"op": "aura_idle", "count": 4, "expect_state": 5},
    {"op": "aura_idle", "expect_state": 6},
    {"op": "aura_expect", "state": {"slice_step": [2, -1]}},
    {"op": "aura_expect_grid", "grid": "work", "cells": [[0, 0, -4], [0, 1, -4], [0, 2, -4], [1, 0, -4], [1, 1, -4], [1, 2, -4], [2, 0, -4], [2, 1, -4], [2, 2, 3], [2, 3, 3], [3, 2, 3], [3, 3, 3]], "others": -128}
  ]
}
