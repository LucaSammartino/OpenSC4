{
  "format": 1,
  "name": "dispatch_revoke_all_ignores_type",
  "spec": ["dispatch 4.5", "dispatch 12.8"],
  "description": "RevokeAllDispatches(1) also removes type-0 records (the type argument is ignored).",
  "steps": [
    {"op": "dispatch_create"},
    {"op": "dispatch_init", "expect": true},
    {"op": "dispatch_source", "source": "0x500", "types": [1], "stations": [{"station": "0x600", "base": 1, "count": 3}]},
    {"op": "dispatch_clear_events"},
    {"op": "dispatch_source", "source": "0x501", "types": [0], "stations": [{"station": "0x601", "base": 1, "count": 2}]},
    {"op": "dispatch_call", "method": "dispatch", "args": [1, 1, 1], "expect": 1},
    {"op": "dispatch_call", "method": "dispatch", "args": [0, 2, 2], "expect": 2},
    {"op": "dispatch_call", "method": "dispatch", "args": [0, 3, 3], "expect": 3},
    {"op": "dispatch_call", "method": "get_dispatch_count", "args": [0], "expect": 2},
    {"op": "dispatch_call", "method": "get_dispatch_count", "args": [1], "expect": 1},
    {"op": "dispatch_call", "method": "get_dispatch_id_array", "args": [0, 0], "expect": [2, 3]},
    {"op": "dispatch_call", "method": "get_dispatch_id_array", "args": [0, 1], "expect": [2]},
    {"op": "dispatch_call", "method": "revoke_all_dispatches", "args": [1], "expect": true},
    {"op": "dispatch_expect", "state": {"record_count": 0}}
  ]
}
