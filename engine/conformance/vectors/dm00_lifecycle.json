{
  "format": 1,
  "name": "demolition_lifecycle",
  "spec": ["demolition 1", "demolition 3", "demolition 4.1", "demolition 6"],
  "description": "Identity, Init / Shutdown and the tuning: QueryInterface answers 1 and 0x26DDE2EA at +0, 0x452294AA at +4 and 0xE4FDA3D4 at +8, nothing else. Init subscribes the three messages, holds city, occupant manager, lot developer and terrain, reads the city size and the shipped tuning (20, 64, 20, 100, 2); a second Init does nothing; Release at 1 shuts down in reverse order. Without exemplars the code defaults (64, 128, 20, 100, 3) apply; any ExemplarChanged re-reads them [quirk].",
  "steps": [
    {"op": "demolition_identity", "iids": {"0x1": 0, "0x26DDE2EA": 0, "0x452294AA": 4, "0xE4FDA3D4": 8, "0xE98B2F57": null}, "class": "0x0990C38A"},
    {"op": "demolition_create"},
    {"op": "demolition_shutdown", "expect": true},
    {"op": "demolition_expect_events", "events": []},
    {"op": "demolition_init", "expect": true},
    {"op": "demolition_expect_events", "events": [{"event": "subscribe", "type": "0xC53D10AA"}, {"event": "subscribe", "type": "0x26D31EC1"}, {"event": "subscribe", "type": "0xA9DED179"}, {"event": "acquire", "service": "city"}, {"event": "acquire", "service": "occupant_manager"}, {"event": "acquire", "service": "lot_developer"}, {"event": "acquire", "service": "terrain"}]},
    {"op": "demolition_expect", "state": {"initialized": true, "cells": [64, 64], "tuning": [20, 64, 20, 100, 2]}},
    {"op": "demolition_init", "expect": true},
    {"op": "demolition_expect_events", "events": []},
    {"op": "demolition_add_ref", "expect": 1},
    {"op": "demolition_add_ref", "expect": 2},
    {"op": "demolition_release", "expect": 1},
    {"op": "demolition_release", "expect": 0},
    {"op": "demolition_expect_events", "events": [{"event": "release_service", "service": "terrain"}, {"event": "release_service", "service": "lot_developer"}, {"event": "release_service", "service": "occupant_manager"}, {"event": "release_service", "service": "city"}, {"event": "unsubscribe", "type": "0xC53D10AA"}, {"event": "unsubscribe", "type": "0x26D31EC1"}, {"event": "unsubscribe", "type": "0xA9DED179"}]},
    {"op": "demolition_expect", "state": {"initialized": false, "destroyed": true}},
    {"op": "demolition_env", "thresholds": null, "building_development": null},
    {"op": "demolition_create"},
    {"op": "demolition_init", "expect": true},
    {"op": "demolition_expect", "state": {"tuning": [64, 128, 20, 100, 3]}},
    {"op": "demolition_env", "building_development": "shipped"},
    {"op": "demolition_message", "type": "ExemplarChanged", "data1": 1, "data2": 2, "expect": true},
    {"op": "demolition_expect", "state": {"tuning": [64, 128, 20, 100, 2]}},
    {"op": "demolition_message", "type": "PostCityInit", "expect": true}
  ]
}
