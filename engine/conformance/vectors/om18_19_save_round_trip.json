{
  "format": 1,
  "name": "om18_19_save_round_trip",
  "spec": ["occupant-manager 13", "occupant-manager 2.2", "occupant-manager 18.19"],
  "description": "K (single cell) and L (two cells) are written: 01 00, the two sizes, the four counts, 192 rows, each 192 cells, each a count and the references in list order (L twice). 2 + 8 + 16 + 4 + 192 * (4 + 192 * 4) = 148254 bytes plus 8 per reference (3). Read into a fresh manager: equal lists in order (appended at the back), one manager reference each (L's second reference released), bit 0 from the stored box, 'was read' set, not initialised. Init then initialises each loaded occupant once (Create). Re-writing gives the same bytes. Version 2: false. [choice] A truncated record changes nothing and gives its references back.",
  "steps": [
    {"op": "om_create"},
    {"op": "om_call", "method": "set_city_size", "args": [1024, 1024], "expect": true},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_occupant", "occupant": "0x1", "min": [10, 0, 10], "max": [20, 10, 20]},
    {"op": "om_occupant", "occupant": "0x2", "min": [10, 0, 10], "max": [100, 10, 20]},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x2", "data4": 0, "expect": true},
    {"op": "om_write", "slot": "a", "expect": true, "length": 148278},
    {"op": "om_expect_record", "slot": "a", "at": [{"offset": 0, "hex": "01000000804400008044"}], "u32s": [{"offset": 10, "values": [16, 16, 64, 64, 192, 192, 0, 0]}]},
    {"op": "om_read", "slot": "a", "expect": true},
    {"op": "om_expect", "state": {"was_read": true, "initialized": false, "counts": [16, 16, 64, 64], "size": [1024, 1024], "rows": 192, "holders": 2, "nodes": 3, "filter_type": null}},
    {"op": "om_expect_cell", "cell": [64, 64], "occupants": ["0x2", "0x1"], "single": [false, true]},
    {"op": "om_expect_cell", "cell": [65, 64], "occupants": ["0x2"], "single": [false]},
    {"op": "om_expect_refs", "refs": {"0x1": 2, "0x2": 2}},
    {"op": "om_occupant", "occupant": "0x1", "initialized": false},
    {"op": "om_occupant", "occupant": "0x2", "initialized": false},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x99EF1140", "occupant": "0x2"}, {"event": "post", "type": "0x99EF1140", "occupant": "0x1"}]},
    {"op": "om_write", "slot": "b", "expect": true},
    {"op": "om_expect_record", "slot": "b", "same_as": "a"},
    {"op": "om_read", "slot": "a", "version": 2, "expect": false},
    {"op": "om_expect", "state": {"was_read": true, "rows": 0}},
    {"op": "om_read", "slot": "a", "length": 148274, "expect": false},
    {"op": "om_expect", "state": {"rows": 0, "counts": [0, 0, 0, 0]}},
    {"op": "om_expect_refs", "refs": {"0x1": 2, "0x2": 2}}
  ]
}
