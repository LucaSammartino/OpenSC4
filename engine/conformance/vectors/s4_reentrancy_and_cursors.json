{
  "format": 1,
  "name": "reentrancy_and_cursors",
  "spec": ["4", "5.3"],
  "description": "Agents may call back into the simulator from inside their delivery. Removing the agent under the cursor moves the cursor to the next agent; removals before/after the cursor keep it on the same agent; [choice] agents appended during a walk are reached in the same walk (registration order). The clock stays at 0 so the frame budget never runs out and each simulate_agents call walks every level.",
  "clock": {"start_ms": 0, "auto_step_ms": 0},
  "agents": {
    "A": {"on_call": {"1": [{"op": "remove_agent", "agent": "A", "level": 4, "expect": true}]}},
    "B": {"on_call": {"1": [{"op": "add_agent", "agent": "C", "level": 4}]}},
    "C": {},
    "E": {"on_call": {"1": [{"op": "remove_agent", "agent": "F", "level": 6}, {"op": "remove_agent", "agent": "G", "level": 6}]}},
    "F": {},
    "G": {},
    "H": {},
    "K": {"finish_after": 2, "on_call": {"1": [{"op": "remove_all_agents", "level": 7}]}},
    "L": {},
    "P": {"on_call": {"1": [{"op": "pause"}, {"op": "set_speed", "speed": 1}]}}
  },
  "steps": [
    {"op": "add_agent", "agent": "A", "level": 4},
    {"op": "add_agent", "agent": "B", "level": 4},
    {"op": "add_agent", "agent": "F", "level": 6},
    {"op": "add_agent", "agent": "E", "level": 6},
    {"op": "add_agent", "agent": "G", "level": 6},
    {"op": "add_agent", "agent": "H", "level": 6},
    {"op": "add_agent", "agent": "K", "level": 7},
    {"op": "add_agent", "agent": "L", "level": 7},
    {"op": "add_agent", "agent": "P", "level": 9},
    {"op": "init"},
    {"op": "clear_events"},
    {"op": "simulate_agents"},
    {"op": "expect_events", "events": [
      {"event": "deliver", "agent": "A", "type": "SimNewDay"},
      {"event": "release", "agent": "A"},
      {"event": "deliver", "agent": "B", "type": "SimNewDay"},
      {"event": "add_ref", "agent": "C"},
      {"event": "deliver", "agent": "C", "type": "SimNewDay"},
      {"event": "deliver", "agent": "F", "type": "SimNewMonth"},
      {"event": "deliver", "agent": "E", "type": "SimNewMonth"},
      {"event": "release", "agent": "F"},
      {"event": "release", "agent": "G"},
      {"event": "deliver", "agent": "H", "type": "SimNewMonth"},
      {"event": "deliver", "agent": "K", "type": "SimNewYear"},
      {"event": "release", "agent": "K"},
      {"event": "release", "agent": "L"},
      {"event": "deliver", "agent": "P", "type": "0x66956819"},
      {"event": "post", "type": "PauseChanged", "data1": 1},
      {"event": "post", "type": "SpeedChanged", "data1": 1}
    ]},
    {"op": "expect_state", "state": {"agent_counts": [0, 0, 0, 0, 2, 0, 2, 0, 0, 1, 0], "cursors": [null, null, null, null, null, null, null, null, null, null, null], "pause_count": 1, "sim_speed": 1}},
    {"op": "expect_agent_names", "names": ["B", "C", "E", "H", "P"]},
    {"op": "simulate_agents"},
    {"op": "expect_events", "events": []}
  ]
}
