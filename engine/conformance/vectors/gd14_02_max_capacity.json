{
  "format": 1,
  "name": "growth_developer_max_capacity",
  "spec": ["growth-developer 6.1", "growth-developer 14.2"],
  "description": "Test 2, UpdateMaxCapacity on ZoningChange (S = 4, shift 2). Tract (0,0): 10 cells of zone 1 (fit code 1), 6 of zone 0x0B (do not fit) -> 10 x GetMaxCapacity(1, purpose 1, wealth 1) = 7.3f summed at float32 = 73.0 (Python model) -> zoned 10, max 73. Tract (1,0): 5 cells of zone 2 x 0.5 -> 2.5 -> rhe 2. Cells are visited z outer, x inner; the whole tract is recomputed whatever part of it the rectangle covers; a negative lower bound is clamped to 0 ([choice], 16 zone queries); an empty tract range does nothing; rezoning to 0 clears the tract.",
  "steps": [
    {"op": "gdev_env", "cells": [16, 16], "max_capacity": {"1": 7.3, "2": 0.5, "11": 9.0}, "zones": [{"x": 0, "z": 0, "w": 4, "d": 2, "zone": 1}, {"x": 0, "z": 2, "w": 2, "d": 1, "zone": 1}, {"x": 2, "z": 2, "w": 2, "d": 1, "zone": 11}, {"x": 0, "z": 3, "w": 4, "d": 1, "zone": 11}, {"x": 4, "z": 0, "w": 4, "d": 1, "zone": 2}, {"x": 4, "z": 1, "w": 1, "d": 1, "zone": 2}], "log_zone": true},
    {"op": "gdev_create"},
    {"op": "gdev_init", "props": {"0x00000021": {"u32": "0x1010"}, "0x87CD6300": {"u8": 1}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 1}, "0x87CD6332": {"u8": 1}}, "expect": true},
    {"op": "gdev_clear_events"},
    {"op": "gdev_message", "type": "ZoningChange", "rect": [0, 0, 7, 3], "data3": 1, "expect": true},
    {"op": "gdev_expect_grid", "grid": "zoned", "tracts": [[0, 0, 10], [1, 0, 5], [2, 0, 0], [0, 1, 0]], "nonzero": 2},
    {"op": "gdev_expect_grid", "grid": "max_capacity", "tracts": [[0, 0, 73], [1, 0, 2], [2, 0, 0]], "nonzero": 2},
    {"op": "gdev_expect_event_count", "filter": {"event": "max_capacity"}, "count": 15},
    {"op": "gdev_expect_event_count", "filter": {"event": "max_capacity", "zone": 1, "purpose": 1, "wealth": 1}, "count": 10},
    {"op": "gdev_expect_event_count", "filter": {"event": "max_capacity", "zone": 2, "purpose": 1, "wealth": 1}, "count": 5},
    {"op": "gdev_expect_event_count", "filter": {"event": "zone_type"}, "count": 32},
    {"op": "gdev_clear_events"},
    {"op": "gdev_message", "type": "ZoningChange", "rect": [2, 2, 2, 2]},
    {"op": "gdev_expect_events", "filter": {"event": "zone_type"}, "events": [{"event": "zone_type", "x": 0, "z": 0}, {"event": "zone_type", "x": 1, "z": 0}, {"event": "zone_type", "x": 2, "z": 0}, {"event": "zone_type", "x": 3, "z": 0}, {"event": "zone_type", "x": 0, "z": 1}, {"event": "zone_type", "x": 1, "z": 1}, {"event": "zone_type", "x": 2, "z": 1}, {"event": "zone_type", "x": 3, "z": 1}, {"event": "zone_type", "x": 0, "z": 2}, {"event": "zone_type", "x": 1, "z": 2}, {"event": "zone_type", "x": 2, "z": 2}, {"event": "zone_type", "x": 3, "z": 2}, {"event": "zone_type", "x": 0, "z": 3}, {"event": "zone_type", "x": 1, "z": 3}, {"event": "zone_type", "x": 2, "z": 3}, {"event": "zone_type", "x": 3, "z": 3}]},
    {"op": "gdev_expect_grid", "grid": "max_capacity", "tracts": [[0, 0, 73]]},
    {"op": "gdev_message", "type": "ZoningChange", "rect": [-9, -9, 1, 1]},
    {"op": "gdev_expect_event_count", "filter": {"event": "zone_type"}, "count": 16},
    {"op": "gdev_expect_grid", "grid": "zoned", "tracts": [[0, 0, 10]]},
    {"op": "gdev_clear_events"},
    {"op": "gdev_message", "type": "ZoningChange", "rect": [20, 20, 30, 30]},
    {"op": "gdev_expect_events", "events": []},
    {"op": "gdev_env", "zones": [{"x": 0, "z": 0, "w": 4, "d": 4, "zone": 0}]},
    {"op": "gdev_message", "type": "ZoningChange", "rect": [3, 3, 3, 3]},
    {"op": "gdev_expect_grid", "grid": "zoned", "tracts": [[0, 0, 0], [1, 0, 5]]},
    {"op": "gdev_expect_grid", "grid": "max_capacity", "tracts": [[0, 0, 0], [1, 0, 2]]},
    {"op": "gdev_call", "method": "round_capacity", "args": [73.0], "expect": 73},
    {"op": "gdev_call", "method": "round_capacity", "args": [2.5], "expect": 2},
    {"op": "gdev_call", "method": "round_capacity", "args": [3.5], "expect": 4},
    {"op": "gdev_call", "method": "round_capacity", "args": [65536.0], "expect": 0}
  ]
}
