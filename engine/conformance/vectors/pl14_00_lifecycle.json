{
  "format": 1,
  "name": "plumbing_lifecycle",
  "spec": ["plumbing 1", "plumbing 3", "plumbing 4.1", "plumbing 4.2", "plumbing 6"],
  "description": "Identity and lifecycle (hand-derived from the spec). QueryInterface answers 0x47782CCC, 1, 0x452294AA and 0xE4FDA3D4 and nothing else (1). The constructor state is idle (state 9, no generator). The first Init registers the agents at levels 6, 4, 10 with flags 2, subscribes the six notifications in the order of 4.1 step 3, creates department 0xAA4014B4 / 0x4A357EAF, names it 0x6A3FF01C / 0x2A4937D3, sets its max funding to the shipped SC4Percentage 120 x 0.01f = f32 1.1999999 (bits 0x3F999999, not 1.2 = 0x3F99999A: 0.01f is a float, 8 PL6), creates line item 2 (not locally funded) named 0x8A75F61E, then creates the two grids 0x49D5BB8C and 0x49D5BBA1 with tract size 1; counts 64 x 64, a 4096-byte flag map, a 64-side bitmap, the iterator over [0,63]^2 at (0,0) fresh, state 0, recompute set. The generator is seeded from the wall clock (the host's seed 1, so its LCG state is 1). Before ConnectionsReady DoIdle returns true and changes nothing. A second Init without Shutdown is a no-op (4.2, PL2): no events, and step 2 finds the generator held, so a generator reseeded with 77 keeps its LCG state 77. Shutdown removes the notifications and the agent, shuts both grids down, releases the department, frees the flag map and deletes the scanning iterator (4.2 step 5); the enabled flag survives [compat]; FreeCity4 also clears the grids-initialized flag [choice] (4.2, PL2; re-Init is pl14_27_reinit). Release from a count of 1 shuts down and returns 0 (1).",
  "steps": [
    {"op": "plumbing_create"},
    {"op": "plumbing_call", "method": "query_interface", "args": ["0x47782CCC"], "expect": true},
    {"op": "plumbing_call", "method": "query_interface", "args": [1], "expect": true},
    {"op": "plumbing_call", "method": "query_interface", "args": ["0x452294AA"], "expect": true},
    {"op": "plumbing_call", "method": "query_interface", "args": ["0xE4FDA3D4"], "expect": true},
    {"op": "plumbing_call", "method": "query_interface", "args": ["0x0990C075"], "expect": false},
    {"op": "plumbing_expect", "state": {"state": 9, "recompute": false, "enabled": false, "initialized": false,
      "has_rng": false, "flag_map_size": 0, "working_grid": null, "published_grid": null, "department": null}},
    {"op": "plumbing_init", "expect": true},
    {"op": "plumbing_expect_events", "events": [
      {"event": "agent", "level": 6, "name": "cSC4PlumbingSimulator", "flags": 2},
      {"event": "agent", "level": 4, "name": "cSC4PlumbingSimulator", "flags": 2},
      {"event": "agent", "level": 10, "name": "cSC4PlumbingSimulator", "flags": 2},
      {"event": "subscribe", "types": ["0x99EF1142", "0x99EF1143", "0xCA1B151C", "0xEA1F0DCD", "0xEA418D8F", "0x6AC284F3"]},
      {"event": "create_department", "id": "0xAA4014B4", "group": "0x4A357EAF"},
      {"event": "department_name", "group": "0x6A3FF01C", "instance": "0x2A4937D3"},
      {"event": "max_funding", "value": 1.1999999, "bits": "0x3F999999"},
      {"event": "create_line_item", "line": 2, "locally_funded": false},
      {"event": "line_item_name", "line": 2, "group": "0x6A3FF01C", "instance": "0x8A75F61E"},
      {"event": "create_grid", "instance": "0x49D5BB8C", "size": 1},
      {"event": "create_grid", "instance": "0x49D5BBA1", "size": 1}
    ]},
    {"op": "plumbing_expect", "state": {"initialized": true, "grids_initialized": true, "state": 0, "recompute": true,
      "enabled": false, "count_x": 64, "count_z": 64, "flag_map_size": 4096, "bitmap_side": 64,
      "iterator": {"state": 0, "x": 0, "z": 0, "rect": [0, 0, 63, 63]}, "has_rng": true, "rng_lcg": 1,
      "working_grid": "0x49D5BB8C", "published_grid": "0x49D5BBA1", "department": "department"}},
    {"op": "plumbing_expect_refs", "refs": {"department": 1}},
    {"op": "plumbing_expect_line_item", "line": 2, "expenses": 0, "display": false},
    {"op": "plumbing_idle", "count": 3, "expect": true},
    {"op": "plumbing_expect", "state": {"state": 0, "pass_counter": 0}},
    {"op": "plumbing_rng", "seed": 77},
    {"op": "plumbing_init", "expect": true},
    {"op": "plumbing_expect_events", "events": []},
    {"op": "plumbing_expect", "state": {"rng_lcg": 77, "state": 0, "recompute": true, "working_grid": "0x49D5BB8C"}},
    {"op": "plumbing_message", "type": "ConnectionsReady", "expect": true},
    {"op": "plumbing_expect", "state": {"enabled": true}},
    {"op": "plumbing_shutdown", "expect": true},
    {"op": "plumbing_expect_events", "events": [
      {"event": "unsubscribe", "types": ["0x99EF1142", "0x99EF1143", "0xCA1B151C", "0xEA1F0DCD", "0xEA418D8F", "0x6AC284F3"]},
      {"event": "remove_agent"},
      {"event": "grid_shutdown", "grid": "0x49D5BB8C"},
      {"event": "grid_shutdown", "grid": "0x49D5BBA1"}
    ]},
    {"op": "plumbing_expect", "state": {"initialized": false, "enabled": true, "has_rng": false, "flag_map_size": 0,
      "department": null, "working_grid": null, "published_grid": null, "num_pipes": 0, "iterator": null,
      "grids_initialized": false, "count_x": 64, "state": 0, "recompute": true}},
    {"op": "plumbing_expect_refs", "refs": {"department": 0}},
    {"op": "plumbing_shutdown", "expect": true},
    {"op": "plumbing_expect_events", "events": []},
    {"op": "plumbing_call", "method": "add_ref", "expect": 1},
    {"op": "plumbing_call", "method": "add_ref", "expect": 2},
    {"op": "plumbing_call", "method": "release", "expect": 1},
    {"op": "plumbing_expect", "state": {"destroyed": false}},
    {"op": "plumbing_call", "method": "release", "expect": 0},
    {"op": "plumbing_expect", "state": {"destroyed": true}}
  ]
}
