{
  "format": 1,
  "name": "civic_monthly_condition",
  "spec": ["civic-buildings 4.6", "civic-buildings 12.6"],
  "description": "Each month, for every maintained building in list order (null entries skipped): department funding below 0.5 turns condition 0 into 2 (other conditions stay: 1 stays 1); funding at 0.5 or above turns condition 2 into 0. NaN behaves like >= 0.5 (never runs down, restores). Without a Disease Research Center nothing is drawn.",
  "steps": [
    {"op": "civic_create"},
    {"op": "civic_init", "expect": true},
    {"op": "civic_building", "occupant": "0x60", "type": "0x05000000"},
    {"op": "civic_building", "occupant": "0x62", "type": "0x05000001", "condition": 1},
    {"op": "civic_item", "occupant": "0x60", "purpose": "maintenance", "department": "0xEA59717A", "line": 1, "cost": 10},
    {"op": "civic_item", "occupant": "0x62", "purpose": "maintenance", "department": "0xEA59717A", "line": 1, "cost": 10},
    {"op": "civic_set", "maintained": ["0x60", null, "0x62"]},
    {"op": "civic_env", "funding": {"0xEA59717A": 0.49}},
    {"op": "civic_message", "type": "SimNewMonth", "expect": true},
    {"op": "civic_expect_conditions", "conditions": {"0x61": 2, "0x63": 1}},
    {"op": "civic_env", "funding": {"0xEA59717A": 0.5}},
    {"op": "civic_call", "method": "monthly"},
    {"op": "civic_expect_conditions", "conditions": {"0x61": 0, "0x63": 1}},
    {"op": "civic_lot", "lot": "0x61", "building": "0x60", "condition": 2},
    {"op": "civic_env", "funding": {"0xEA59717A": "nan"}},
    {"op": "civic_call", "method": "monthly"},
    {"op": "civic_expect_conditions", "conditions": {"0x61": 0}},
    {"op": "civic_call", "method": "monthly"},
    {"op": "civic_expect_conditions", "conditions": {"0x61": 0}},
    {"op": "civic_expect_event_count", "filter": {"event": "seed"}, "count": 0},
    {"op": "civic_expect_event_count", "filter": {"event": "double"}, "count": 0},
    {"op": "civic_expect", "state": {"temporaries": 0}}
  ]
}
