{
  "format": 1,
  "name": "om18_15_move",
  "spec": ["occupant-manager 5.4", "occupant-manager 18.15"],
  "description": "An occupant moves from cells (65, 64)..(66, 64) to (66, 64)..(67, 64) with post = true: cell 65 no longer holds it (and is freed); in 66 it keeps its place behind a newer occupant; in 67 it goes to the front. Move (data4 0) is sent synchronously (occupant +0x30 set). A Move without a box change still posts; post = false posts nothing. Shrinking to one cell rewrites bit 0 in the common cell. A non-inserted occupant: false.",
  "steps": [
    {"op": "om_create"},
    {"op": "om_call", "method": "set_city_size", "args": [1024, 1024], "expect": true},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_occupant", "occupant": "0x1", "min": [100, 0, 0], "max": [164, 10, 64]},
    {"op": "om_occupant", "occupant": "0x2", "min": [140, 0, 10], "max": [150, 10, 20]},
    {"op": "om_occupant", "occupant": "0x3", "min": [200, 0, 10], "max": [210, 10, 20]},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x2", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x3", "data4": 0, "expect": true},
    {"op": "om_expect_cell", "cell": [66, 64], "occupants": ["0x2", "0x1"]},
    {"op": "om_expect_cell", "cell": [67, 64], "occupants": ["0x3"]},
    {"op": "om_occupant", "occupant": "0x1", "min": [150, 0, 0], "max": [230, 10, 64], "sync": true},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "move", "occupant": "0x1", "post": true, "expect": true},
    {"op": "om_expect_occupant", "occupant": "0x1", "state": {"om_box": [66, 64, 67, 64]}},
    {"op": "om_expect_cell", "cell": [65, 64], "null": true},
    {"op": "om_expect_cell", "cell": [66, 64], "occupants": ["0x2", "0x1"], "single": [true, false]},
    {"op": "om_expect_cell", "cell": [67, 64], "occupants": ["0x1", "0x3"], "single": [false, true]},
    {"op": "om_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x99EF1146", "occupant": "0x1", "data4": 0, "sync": true}]},
    {"op": "om_call", "method": "move", "occupant": "0x1", "post": true, "expect": true},
    {"op": "om_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x99EF1146", "occupant": "0x1", "data4": 0}]},
    {"op": "om_call", "method": "move", "occupant": "0x1", "post": false, "expect": true},
    {"op": "om_expect_events", "filter": {"event": "post"}, "events": []},
    {"op": "om_occupant", "occupant": "0x1", "max": [160, 10, 64]},
    {"op": "om_call", "method": "move", "occupant": "0x1", "post": false, "expect": true},
    {"op": "om_expect_cell", "cell": [66, 64], "occupants": ["0x2", "0x1"], "single": [true, true]},
    {"op": "om_expect_cell", "cell": [67, 64], "occupants": ["0x3"]},
    {"op": "om_occupant", "occupant": "0x4", "min": [0, 0, 0], "max": [1, 10, 1]},
    {"op": "om_call", "method": "move", "occupant": "0x4", "post": true, "expect": false},
    {"op": "om_expect_events", "filter": {"event": "post"}, "events": []},
    {"op": "om_expect_refs", "refs": {"0x1": 1, "0x2": 1, "0x3": 1, "0x4": 0}}
  ]
}
