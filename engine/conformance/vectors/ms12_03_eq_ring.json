    {"op": "mysim_building", "token": "0x900", "position": [100, 0, 100], "lot": {"cell": [6, 6], "wealth": 2, "condition": 1}},
    {"op": "mysim_env", "eq": 87.5, "hq": 60.0},
    {"op": "mysim_call", "sim": 0, "method": "move_in"},
    {"op": "mysim_call", "sim": 0, "method": "set_residence", "building": "0x900", "expect": true},
    {"op": "mysim_expect", "sim": 0, "state": {"eq_ring": [87.5, 87.5, 87.5, 87.5, 87.5, 87.5], "eq_index": 0, "eq_delta": 0.0}},
    {"op": "mysim_env", "eq": 90.0},
    {"op": "mysim_simulate", "sim": 0, "kind": 1},
    {"op": "mysim_env", "eq": 95.0},
    {"op": "mysim_simulate", "sim": 0, "kind": 1},
    {"op": "mysim_env", "eq": 100.0},
    {"op": "mysim_simulate", "sim": 0, "kind": 1},
    {"op": "mysim_env", "eq": 100.0},
    {"op": "mysim_simulate", "sim": 0, "kind": 1},
    {"op": "mysim_env", "eq": 100.0},
    {"op": "mysim_simulate", "sim": 0, "kind": 1},
    {"op": "mysim_env", "eq": 110.0},
    {"op": "mysim_simulate", "sim": 0, "kind": 1},
    {"op": "mysim_expect", "sim": 0, "state": {"eq_delta": 22.5, "eq_index": 0}},
    {"op": "mysim_expect_fields", "sim": 0, "fields": {"delta_eq": 12}, "note": "UpdateVariables (step 3) runs before the ring moves (step 4): step 5's delta"},
    {"op": "mysim_env", "eq": 110.0},
    {"op": "mysim_simulate", "sim": 0, "kind": 1},
    {"op": "mysim_expect", "sim": 0, "state": {"eq_delta": 20.0, "eq_index": 1, "eq_ring": [110.0, 95.0, 100.0, 100.0, 100.0, 110.0]}},
    {"op": "mysim_expect_fields", "sim": 0, "fields": {"delta_eq": 22}},
