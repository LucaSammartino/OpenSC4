{
  "format": 1,
  "name": "nr15_06_transmogrify_diagonal",
  "spec": ["network-rules 4"],
  "description": "The north-west diagonal 0x00000301 gives four unflipped rules; its mirror is turn 1's pattern and is dropped. noflip gives the same; notrans keeps the source rule alone.",
  "steps": [
    {"op": "nr_tiles", "text": ["#Transmogrify", "1,1,3,0,0", "3,0,0x200,0,0"], "expect": {"rules": 4}},
    {"op": "nr_expect_rules", "rules": [{"key": "0x00000301", "outputs": [["0x200", 0, 0]]}, {"key": "0x00030100", "outputs": [["0x200", 0, 1]]}, {"key": "0x01000003", "outputs": [["0x200", 0, 3]]}, {"key": "0x03010000", "outputs": [["0x200", 0, 2]]}]},
    {"op": "nr_mirror_edges", "edges": "0x00000301", "expect": "0x00030100"},
    {"op": "nr_tiles", "text": ["#Transmogrify", "noflip", "1,1,3,0,0", "3,0,0x200,0,0"], "expect": {"rules": 4}},
    {"op": "nr_expect_rules", "rules": [{"key": "0x00000301", "outputs": [["0x200", 0, 0]]}, {"key": "0x00030100", "outputs": [["0x200", 0, 1]]}, {"key": "0x01000003", "outputs": [["0x200", 0, 3]]}, {"key": "0x03010000", "outputs": [["0x200", 0, 2]]}]},
    {"op": "nr_tiles", "text": ["#Transmogrify", "notrans", "1,1,3,0,0", "3,0,0x200,0,0"], "expect": {"rules": 1}},
    {"op": "nr_expect_rules", "rules": [{"key": "0x00000301", "outputs": [["0x200", 0, 0]]}]}
  ]
}
