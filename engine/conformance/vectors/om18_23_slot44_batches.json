{
  "format": 1,
  "name": "om18_23_slot44_batches",
  "spec": ["occupant-manager 9.2", "occupant-manager 14", "occupant-manager 16 OM7", "occupant-manager 18.23"],
  "description": "Slot 44 collects an AddRef'd batch per cell under the inner hold and calls back after dropping it, inside the outer lock (OM7). A callback that removes the occupant it was given (slot 21), in a cell with three occupants, is called three times; the walk then continues with the next cell. A single-cell walk lists the cell in order with no duplicate check; a multi-cell walk calls an occupant spanning two cells once (the duplicate check, skipped for bit-0 nodes).",
  "steps": [
    {"op": "om_create"},
    {"op": "om_call", "method": "set_city_size", "args": [1024, 1024], "expect": true},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_occupant", "occupant": "0x1", "min": [10, 0, 10], "max": [20, 10, 20]},
    {"op": "om_occupant", "occupant": "0x2", "min": [10, 0, 10], "max": [20, 10, 20]},
    {"op": "om_occupant", "occupant": "0x3", "min": [10, 0, 10], "max": [20, 10, 20]},
    {"op": "om_occupant", "occupant": "0x4", "min": [10, 0, 70], "max": [20, 10, 80]},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x2", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x3", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x4", "data4": 0, "expect": true},
    {"op": "om_trace", "locks": true},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "iterate", "expect": true, "actions": {"0x1": [{"method": "remove", "occupant": "0x1", "expect": true}], "0x2": [{"method": "remove", "occupant": "0x2", "expect": true}], "0x3": [{"method": "remove", "occupant": "0x3", "expect": true}]}},
    {"op": "om_expect_events", "filter": {"event": "callback"}, "events": [{"event": "callback", "occupant": "0x3", "depth": 1}, {"event": "callback", "occupant": "0x2", "depth": 1}, {"event": "callback", "occupant": "0x1", "depth": 1}, {"event": "callback", "occupant": "0x4", "depth": 1}]},
    {"op": "om_expect_event_count", "filter": {"event": "action_error"}, "count": 0},
    {"op": "om_trace", "locks": false},
    {"op": "om_expect_cell", "cell": [64, 64], "null": true},
    {"op": "om_expect_refs", "refs": {"0x1": 0, "0x2": 0, "0x3": 0, "0x4": 1}},
    {"op": "om_occupant", "occupant": "0x5", "min": [10, 0, 10], "max": [20, 10, 80]},
    {"op": "om_call", "method": "insert", "occupant": "0x5", "data4": 0, "expect": true},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "iterate", "min": [64, 0, 64], "max": [64, 0, 65], "expect": true},
    {"op": "om_expect_events", "filter": {"event": "callback"}, "events": [{"event": "callback", "occupant": "0x5"}, {"event": "callback", "occupant": "0x4"}]},
    {"op": "om_call", "method": "iterate", "min": [64, 0, 65], "max": [64, 0, 65], "expect": true},
    {"op": "om_expect_events", "filter": {"event": "callback"}, "events": [{"event": "callback", "occupant": "0x5"}, {"event": "callback", "occupant": "0x4"}]},
    {"op": "om_expect_refs", "refs": {"0x4": 1, "0x5": 1}}
  ]
}
