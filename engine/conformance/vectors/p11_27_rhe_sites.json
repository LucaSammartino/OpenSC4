    {"op": "pollution_expect", "state": {"garbage_supply": 4194652}},
    {"op": "pollution_env", "landfill_tiles": 838},
    {"op": "pollution_set", "state": {"garbage_supply": 0}},
    {"op": "pollution_call", "method": "dispose", "args": [6000000], "expect": {"taken": 4190000, "remaining": {"wtp": 0, "inc": 0, "wte": 0}}},
    {"op": "pollution_expect", "state": {"garbage_supply": 4190000}},
