{
  "format": 1,
  "name": "advisor_city_planning_record",
  "spec": ["advisors 11.5", "advisors 17.17"],
  "description": "CityPlanning with counters 10, 2, 2 and landmarks {0x1234: 1} writes the version-3 record of section 11.5 (u16 3, the advisor record, the counters, the landmark map); a version-2 record reads the counters and keeps the current landmark map.",
  "steps": [
