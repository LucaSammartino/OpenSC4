{
  "format": 1,
  "name": "net_compatibility_pattern",
  "spec": ["network-manager 8.4", "network-manager 16.16"],
  "description": "Period n = 2, mask rows 01 02 00 00: (4, 6) is row 0, col 0, bit 1: compatible; (5, 6) is col 1: not; (5, 7) is row 1, col 1: compatible. A configuration with no zone list is never compatible. Slope 3.0 with min 0, max 2: not compatible (2.0 is); a NaN slope is not. Rotation bits, the flip rule (1: must be flipped, 2: must not be, 3: any) and the wealth list are checked too.",
  "steps": [
    {"op": "net_config", "id": 1, "piece": "0x100", "period": 2, "mask": [1, 2, 0, 0]},
    {"op": "net_config", "id": 2, "piece": "0x100", "period": 2, "mask": [1, 2, 0, 0], "zones": []},
    {"op": "net_config", "id": 3, "piece": "0x100", "period": 2, "mask": [1, 2, 0, 0], "max_slope": 2.0},
    {"op": "net_config", "id": 4, "piece": "0x100", "rotations": 2, "flip_rule": 1, "wealths": [0, 1, 3]},
    {"op": "net_create"},
    {"op": "net_call", "method": "is_lot_compatible", "args": [1, 4, 6, 1, 1, 0, 0], "expect": true},
    {"op": "net_call", "method": "is_lot_compatible", "args": [1, 5, 6, 1, 1, 0, 0], "expect": false},
    {"op": "net_call", "method": "is_lot_compatible", "args": [1, 5, 7, 1, 1, 0, 0], "expect": true},
    {"op": "net_call", "method": "is_lot_compatible", "args": [2, 4, 6, 1, 1, 0, 0], "expect": false},
    {"op": "net_env", "slope": 3.0},
    {"op": "net_call", "method": "is_lot_compatible", "args": [3, 4, 6, 1, 1, 0, 0], "expect": false},
    {"op": "net_env", "slope": 2.0},
    {"op": "net_call", "method": "is_lot_compatible", "args": [3, 4, 6, 1, 1, 0, 0], "expect": true},
    {"op": "net_env", "slope": "nan"},
    {"op": "net_call", "method": "is_lot_compatible", "args": [3, 4, 6, 1, 1, 0, 0], "expect": false},
    {"op": "net_env", "slope": 0.0},
    {"op": "net_call", "method": "is_lot_compatible", "args": [4, 0, 0, 0, 0, 0, 1], "expect": false, "note": "rotation 0 not allowed"},
    {"op": "net_call", "method": "is_lot_compatible", "args": [4, 0, 0, 0, 0, 1, 0], "expect": false, "note": "must be flipped"},
    {"op": "net_call", "method": "is_lot_compatible", "args": [4, 0, 0, 0, 0, 1, 1], "expect": true},
    {"op": "net_call", "method": "is_lot_compatible", "args": [4, 0, 0, 0, 2, 1, 1], "expect": false, "note": "wealth 2 not listed"}
  ]
}
