{
  "format": 1,
  "name": "om18_16_find_occupant",
  "spec": ["occupant-manager 6.3", "occupant-manager 15", "occupant-manager 18.16"],
  "description": "An occupant with stored box (70, 70, 71, 70) and x = z = -1 before the call: slot 27 returns true without writing x, z [quirk 7]. With the stored box overwritten to (0, 0, 0, 0) (nodes not moved): false without searchAll; with searchAll the x-major scan writes (70, 70). With no stored box the guess comes from the real box (x shrink only).",
  "steps": [
    {"op": "om_create"},
    {"op": "om_call", "method": "set_city_size", "args": [1024, 1024], "expect": true},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_occupant", "occupant": "0x1", "min": [384, 0, 384], "max": [512, 10, 448]},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 0, "expect": true},
    {"op": "om_expect_occupant", "occupant": "0x1", "state": {"om_box": [70, 70, 71, 70]}},
    {"op": "om_call", "method": "find_occupant", "occupant": "0x1", "search_all": false, "xz": [-1, -1], "expect": true, "expect_xz": [-1, -1]},
    {"op": "om_occupant", "occupant": "0x1", "om_box": [0, 0, 0, 0]},
    {"op": "om_call", "method": "find_occupant", "occupant": "0x1", "search_all": false, "xz": [-1, -1], "expect": false, "expect_xz": [-1, -1]},
    {"op": "om_call", "method": "find_occupant", "occupant": "0x1", "search_all": true, "xz": [-1, -1], "expect": true, "expect_xz": [70, 70]},
    {"op": "om_occupant", "occupant": "0x1", "om_box": null},
    {"op": "om_call", "method": "find_occupant", "occupant": "0x1", "search_all": false, "xz": [-1, -1], "expect": true, "expect_xz": [-1, -1]},
    {"op": "om_occupant", "occupant": "0x2", "min": [0, 0, 0], "max": [1, 10, 1]},
    {"op": "om_call", "method": "find_occupant", "occupant": "0x2", "search_all": true, "xz": [-1, -1], "expect": false, "expect_xz": [-1, -1]}
  ]
}
