{
  "format": 1,
  "name": "flora_type_queries",
  "spec": ["flora 11.1", "flora 3.2"],
  "description": "Derived by hand from flora 11.1 slots 8-14 and 3.2 (test 29 of 16). Seven types registered in the order 0x70, 0x10, 0x60, 0x20, 0x50, 0x30, 0x40 (the type array keeps that order; the map is ascending and also holds key 0 after Init). GetAllFloraTypes(null, count) sets count := 7 and returns 7; with count 3 it copies the first three (0x70, 0x10, 0x60) and returns 3; with count 10 it copies seven, sets count := 7 and returns 7. The vector form returns the whole array. Families: 0x10 and 0x20 are in family 0xF1, 0x20 also in 0xF2; GetAllFloraFamilyTypes -> [0xF1, 0xF2]; IsFloraFamilyTypeValid accepts a family or a registered type (also 0, the default record); GetFloraTypesByFilter inserts every map key the filter accepts (all 8 without a filter, counting key 0) and returns the number inserted; GetFloraTypesByFamily returns the family's types (0 for an unknown family); AddStaticFloraData of an already registered type returns false; slot 22 always returns 0.",
  "steps": [
    {"op": "flora_types", "types": [{"type": "0x70"}, {"type": "0x10", "families": ["0xF1"]}, {"type": "0x60"}, {"type": "0x20", "families": ["0xF1", "0xF2"]},
      {"type": "0x50"}, {"type": "0x30"}, {"type": "0x40"}]},
    {"op": "flora_create"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_call", "method": "all_types_into", "args": [null, 0], "expect": {"ret": 7, "count": 7, "copied": []}},
    {"op": "flora_call", "method": "all_types_into", "args": [3, 3], "expect": {"ret": 3, "count": 3, "copied": ["0x70", "0x10", "0x60"]}},
    {"op": "flora_call", "method": "all_types_into", "args": [10, 10],
      "expect": {"ret": 7, "count": 7, "copied": ["0x70", "0x10", "0x60", "0x20", "0x50", "0x30", "0x40"]}},
    {"op": "flora_call", "method": "all_types_into", "args": [2, 5], "expect": {"ret": 2, "count": 2, "copied": ["0x70", "0x10"]}, "note": "[choice] limited to the buffer"},
    {"op": "flora_call", "method": "all_types", "expect": ["0x70", "0x10", "0x60", "0x20", "0x50", "0x30", "0x40"]},
    {"op": "flora_expect_registry", "keys": [0, "0x10", "0x20", "0x30", "0x40", "0x50", "0x60", "0x70"], "families": ["0xF1", "0xF2"],
      "family": {"0xF1": ["0x10", "0x20"], "0xF2": ["0x20"]}},
    {"op": "flora_call", "method": "family_types", "expect": ["0xF1", "0xF2"]},
    {"op": "flora_call", "method": "is_family_valid", "args": ["0xF1"], "expect": true},
    {"op": "flora_call", "method": "is_family_valid", "args": ["0x30"], "expect": true},
    {"op": "flora_call", "method": "is_family_valid", "args": [0], "expect": true},
    {"op": "flora_call", "method": "is_family_valid", "args": ["0xF3"], "expect": false},
    {"op": "flora_call", "method": "is_valid", "args": ["0x30"], "expect": true},
    {"op": "flora_call", "method": "is_valid", "args": ["0xF1"], "expect": false},
    {"op": "flora_call", "method": "types_by_filter", "args": [null],
      "expect": {"ret": 8, "set": [0, "0x10", "0x20", "0x30", "0x40", "0x50", "0x60", "0x70"]}},
    {"op": "flora_call", "method": "types_by_filter", "args": [["0x20", "0x40", "0x99"]], "expect": {"ret": 2, "set": ["0x20", "0x40"]}},
    {"op": "flora_call", "method": "types_by_family", "args": ["0xF1"], "expect": {"ret": 2, "set": ["0x10", "0x20"]}},
    {"op": "flora_call", "method": "types_by_family", "args": ["0xF9"], "expect": {"ret": 0, "set": []}},
    {"op": "flora_call", "method": "add_static", "args": [{"type": "0x30"}], "expect": false},
    {"op": "flora_call", "method": "add_static", "args": [{"type": "0x80", "families": ["0xF2"]}], "expect": true},
    {"op": "flora_call", "method": "add_static", "args": [null], "expect": false},
    {"op": "flora_expect_registry", "family": {"0xF1": ["0x10", "0x20"], "0xF2": ["0x20", "0x80"]}},
    {"op": "flora_call", "method": "all_types_into", "args": [null, 0], "expect": {"ret": 8, "count": 8, "copied": []}},
    {"op": "flora_call", "method": "cost", "args": [5], "expect": 0},
    {"op": "flora_registry", "app_shutdown": true},
    {"op": "flora_expect_registry", "types": [], "keys": [], "families": ["0xF1", "0xF2"]}
  ]
}
