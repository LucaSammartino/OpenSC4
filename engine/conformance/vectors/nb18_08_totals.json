  "spec": ["neighbors 5.2", "neighbors 10.1", "neighbors 18"],
  "description": "Conformance test 8. Buy deals (E0, E2, E4: costs 10, 20, 40) count as expense (70), sell deals (E1, E3, E5: 100, 200, 400) as income (700). Any of the flags 0x01, 0x04, 0x08, 0x10, 0x20 on the E0 and E1 deals excludes them (60 / 600); 0x40, 0x80, 0x100, 0x200 do not (70 / 700).",
  "steps": [
    {"op": "neighbors_env", "current": 1},
    {"op": "neighbors_city", "id": 1, "pos": [3, 3], "size": [1, 1]},
    {"op": "neighbors_city", "id": 2, "pos": [1, 3], "size": [2, 2]},
    {"op": "neighbors_create"},
    {"op": "neighbors_deal", "id": 1, "type": "E0", "other": 2, "cost": 10, "flags": 2},
    {"op": "neighbors_deal", "id": 2, "type": "E2", "other": 2, "cost": 20, "flags": 2},
    {"op": "neighbors_deal", "id": 3, "type": "E4", "other": 2, "cost": 40, "flags": 2},
    {"op": "neighbors_deal", "id": 4, "type": "E1", "other": 2, "cost": 100, "flags": 2},
    {"op": "neighbors_deal", "id": 5, "type": "E3", "other": 2, "cost": 200, "flags": 2},
    {"op": "neighbors_deal", "id": 6, "type": "E5", "other": 2, "cost": 400, "flags": 2},
    {"op": "neighbors_call", "method": "total_monthly_expense", "expect": 70},
    {"op": "neighbors_call", "method": "total_monthly_income", "expect": 700},

    {"op": "neighbors_deal_set", "deal": 1, "flags": "0x003"},
    {"op": "neighbors_deal_set", "deal": 4, "flags": "0x003"},
