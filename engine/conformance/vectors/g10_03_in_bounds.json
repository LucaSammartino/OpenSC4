{
  "format": 1,
  "name": "grid_in_bounds",
  "spec": ["simgrid 4", "simgrid 10.3"],
  "description": "TractIsInBounds compares unsigned: negative indices are out of bounds.",
  "steps": [
    {"op": "grid_city", "cells": [256, 256], "width": [16, 16]},
    {"op": "grid_create", "name": "a", "type": "u8", "tract_size": 2},
    {"op": "grid_call", "grid": "a", "method": "tract_in_bounds", "args": [-1, 0], "expect": false},
    {"op": "grid_call", "grid": "a", "method": "tract_in_bounds", "args": [127, 127], "expect": true},
    {"op": "grid_call", "grid": "a", "method": "tract_in_bounds", "args": [128, 0], "expect": false},
    {"op": "grid_call", "grid": "a", "method": "tract_in_bounds", "args": [0, 128], "expect": false},
    {"op": "grid_call", "grid": "a", "method": "tract_in_bounds", "args": [0, -2147483648], "expect": false}
  ]
}
