      "args": [
        [
          1,
          1,
          3,
          3
        ]
      ],
      "expect": [
        [
          1,
          1
        ],
        [
          2,
          1
        ],
        [
          3,
          1
        ],
        [
          1,
          2
        ],
        [
          3,
          2
        ],
        [
          1,
          3
        ],
        [
          2,
          3
        ],
        [
          3,
          3
        ]
      ]
    },
    {
      "op": "pf_eval",
      "fn": "boundary_cells",
      "args": [
        [
          4,
          0,
          4,
          2
        ]
      ],
      "expect": [
