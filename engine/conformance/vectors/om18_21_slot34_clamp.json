{
  "format": 1,
  "name": "om18_21_slot34_clamp",
  "spec": ["occupant-manager 7", "occupant-manager 15", "occupant-manager 16 OM5", "occupant-manager 18.21"],
  "description": "Slot 34 (OM5): a non-null corner is clamped to 0..count-1 on each axis, a null max becomes (count X, count Z), unclamped. M (x 1000..1020, z 0..16) on a 1024 m city: min (63, 0), max (70, 0) clamps max to (63, 0), so the box is x 1008.1..1023.9 and M is found, N (x 1030..1035) is not. After M is removed, min (63, 0) with a null max reaches 65 * 16 - 0.1 = 1039.9 and finds N. A min of (99, -5) is clamped to (63, 0). The typed thunk (slot 35) uses the same conversion.",
  "steps": [
    {"op": "om_create"},
    {"op": "om_call", "method": "set_city_size", "args": [1024, 1024], "expect": true},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_occupant", "occupant": "0x1", "min": [1000, 0, 0], "max": [1020, 10, 16]},
    {"op": "om_occupant", "occupant": "0x2", "min": [1030, 0, 0], "max": [1035, 10, 16]},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x2", "data4": 0, "expect": true},
    {"op": "om_expect_occupant", "occupant": "0x2", "state": {"om_box": [80, 64, 80, 64]}},
    {"op": "om_call", "method": "first_by_standard_cells", "min": [63, 0], "max": [70, 0], "expect": "0x1"},
    {"op": "om_call", "method": "remove", "occupant": "0x1", "expect": true},
    {"op": "om_call", "method": "first_by_standard_cells", "min": [63, 0], "max": [70, 0], "expect": null, "note": "N lies past 1023.9"},
    {"op": "om_call", "method": "first_by_standard_cells", "min": [63, 0], "expect": "0x2", "note": "null max = (64, 64): x up to 1039.9"},
    {"op": "om_call", "method": "first_by_standard_cells_typed", "min": [63, 0], "type": "0x100", "expect": "0x2"},
    {"op": "om_call", "method": "first_by_standard_cells", "min": [99, -5], "max": [99, -5], "expect": null},
    {"op": "om_occupant", "occupant": "0x3", "min": [1010, 0, 0], "max": [1012, 10, 16]},
    {"op": "om_call", "method": "insert", "occupant": "0x3", "data4": 0, "expect": true},
    {"op": "om_call", "method": "first_by_standard_cells", "min": [99, -5], "max": [99, -5], "expect": "0x3", "note": "(99, -5) is clamped to (63, 0)"},
    {"op": "om_expect_refs", "refs": {"0x1": 0, "0x2": 1, "0x3": 1}}
  ]
}
