{
  "format": 1,
  "name": "protection_rehabilitation",
  "spec": ["protection 9.5", "protection 18.9"],
  "description": "Test 9: police DoMonthly step 1, k = roundHalfEven(jailed x rate), jailed = max(0, jailed - k): rate pct(10) = 0.1: 600 -> 540; 125 -> 113 (12.5 -> 12); 135 -> 121 (13.5 -> 14). Code default rate 0.01: 600 -> 594. A rate of 2 floors at 0. Hand-derived (Python round is half-even).",
  "steps": [
    {"op": "protection_create", "kind": "police"},
    {"op": "protection_env", "tuning": "shipped"},
    {"op": "protection_init"},
    {"op": "protection_set", "state": {"jailed": 600}},
    {"op": "protection_message", "type": "SimNewMonth"},
    {"op": "protection_expect", "state": {"jailed": 540}},
    {"op": "protection_set", "state": {"jailed": 125}},
    {"op": "protection_message", "type": "SimNewMonth"},
    {"op": "protection_expect", "state": {"jailed": 113}},
    {"op": "protection_set", "state": {"jailed": 135}},
    {"op": "protection_message", "type": "SimNewMonth"},
    {"op": "protection_expect", "state": {"jailed": 121}},
    {"op": "protection_eval", "fn": "rehabilitation", "args": [125, 0.1], "expect": [113, 12]},
    {"op": "protection_eval", "fn": "rehabilitation", "args": [3, 2.0], "expect": [0, 6]},
    {"op": "protection_env", "tuning": "empty"},
    {"op": "protection_call", "method": "read_tuning"},
    {"op": "protection_set", "state": {"jailed": 600}},
    {"op": "protection_message", "type": "SimNewMonth"},
    {"op": "protection_expect", "state": {"jailed": 594}}
  ]
}
