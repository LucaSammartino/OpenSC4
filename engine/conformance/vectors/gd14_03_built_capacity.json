{
  "format": 1,
  "name": "growth_developer_built_capacity",
  "spec": ["growth-developer 6.3", "growth-developer 14.3"],
  "description": "Test 3, UpdatePopulationCount (hand-derived): shift 2, lot rect x 3..4, z 0..2, size 2 x 3, location (3,0), capacity 40 -> q = 40/6 = 6, r = 4: tract (0,0) = 3 x 6 + 4 = 22, (1,0) = 18, total +40. Remove: q = -6, r = -4 -> both 0, total 0. Remove again: negative sums store 0, total -40. Calls: GetBuildingProfile(type).purpose, then GetCapacity(devType, true), GetSize, GetBoundingRect, GetLocation. A purpose mismatch stops after the profile; a lot of area 0 is skipped after GetSize ([choice], quirk 7); a reversed rectangle is normalised; values wrap mod 65536 (65535 + 65535 -> 65534) while the int32 total does not.",
  "steps": [
    {"op": "gdev_env", "cells": [16, 16], "purposes": {"0x1234": 1, "0x5678": 2}},
    {"op": "gdev_lot", "label": "lot", "building_type": "0x1234", "capacity": 40, "size": [2, 3], "rect": [3, 0, 4, 2], "location": [3, 0]},
    {"op": "gdev_lot", "label": "rev", "capacity": 40, "size": [2, 3], "rect": [4, 2, 3, 0], "location": [3, 0]},
    {"op": "gdev_lot", "label": "flat", "capacity": 40, "size": [0, 3], "rect": [3, 0, 4, 2], "location": [3, 0]},
    {"op": "gdev_lot", "label": "big", "capacity": 65535, "size": [1, 1], "rect": [12, 12, 12, 12], "location": [12, 12]},
    {"op": "gdev_create"},
    {"op": "gdev_init", "props": {"0x00000021": {"u32": "0x1010"}, "0x87CD6300": {"u8": 1}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 1}, "0x87CD6332": {"u8": 1}}, "expect": true},
    {"op": "gdev_clear_events"},
    {"op": "gdev_call", "method": "update_population_count", "args": ["lot", "0x1234", true]},
    {"op": "gdev_expect_events", "events": [{"event": "building_purpose", "building_type": "0x00001234"}, {"event": "lot_capacity", "lot": "lot", "developer_type": "0x00001010", "flag": true}, {"event": "lot_size", "lot": "lot"}, {"event": "lot_rect", "lot": "lot"}, {"event": "lot_location", "lot": "lot"}]},
    {"op": "gdev_expect_grid", "grid": "capacity", "tracts": [[0, 0, 22], [1, 0, 18]], "nonzero": 2},
    {"op": "gdev_call", "method": "total_capacity", "expect": 40},
    {"op": "gdev_call", "method": "update_population_count", "args": ["lot", "0x1234", false]},
    {"op": "gdev_expect_grid", "grid": "capacity", "tracts": [[0, 0, 0], [1, 0, 0]], "nonzero": 0},
    {"op": "gdev_call", "method": "total_capacity", "expect": 0},
    {"op": "gdev_call", "method": "update_population_count", "args": ["lot", "0x1234", false]},
    {"op": "gdev_expect_grid", "grid": "capacity", "nonzero": 0},
    {"op": "gdev_call", "method": "total_capacity", "expect": -40},
    {"op": "gdev_clear_events"},
    {"op": "gdev_call", "method": "update_population_count", "args": ["lot", "0x5678", true]},
    {"op": "gdev_expect_events", "events": [{"event": "building_purpose", "building_type": "0x00005678"}]},
    {"op": "gdev_call", "method": "total_capacity", "expect": -40},
    {"op": "gdev_call", "method": "update_population_count", "args": ["flat", "0x1234", true]},
    {"op": "gdev_expect_events", "events": [{"event": "building_purpose"}, {"event": "lot_capacity", "lot": "flat"}, {"event": "lot_size", "lot": "flat"}]},
    {"op": "gdev_call", "method": "total_capacity", "expect": -40},
    {"op": "gdev_call", "method": "update_population_count", "args": ["rev", "0x1234", true]},
    {"op": "gdev_expect_grid", "grid": "capacity", "tracts": [[0, 0, 22], [1, 0, 18]], "nonzero": 2},
    {"op": "gdev_call", "method": "total_capacity", "expect": 0},
    {"op": "gdev_call", "method": "update_population_count", "args": ["big", "0x1234", true]},
    {"op": "gdev_expect_grid", "grid": "capacity", "tracts": [[3, 3, 65535]]},
    {"op": "gdev_call", "method": "update_population_count", "args": ["big", "0x1234", true]},
    {"op": "gdev_expect_grid", "grid": "capacity", "tracts": [[3, 3, 65534]]},
    {"op": "gdev_call", "method": "total_capacity", "expect": 131070},
    {"op": "gdev_call", "method": "split_capacity", "args": [-40, 6], "expect": [-6, -4]},
    {"op": "gdev_call", "method": "split_capacity", "args": [40, 0], "expect": null}
  ]
}
