{
  "format": 1,
  "name": "weather_accessors",
  "spec": ["weather 2", "weather 4", "weather 14.8"],
  "description": "cISC4WeatherSimulator accessors: CellWidth = 16, CellCount = trunc(size * 0.0625); PositionToCell truncates (returns 0 [choice]); CellToPosition multiplies; CellToStandardCityCell(cx, cz) = (cx * f, cx * f) [quirk: z uses x]; StandardCityCellToCell divides (a zero factor gives 0 [choice]); GetMoistureValue is 0 before Init and clamps world positions to [0, size) before floor(/16); GetMoistureType = value >> 4; GetHumidity = base + (1 - base) * 0.5 (0.6 shipped, position ignored); GetAmbientWind returns the speed and dir * speed; GetWindAtCell ignores the cell; the moisture map reads back the grid x-major.",
  "steps": [
    {"op": "weather_env", "size": [16, 16], "month": 1},
    {"op": "weather_tuning", "shipped": true},
    {"op": "weather_create", "rng": {"stub": {"uniform": [0.5], "gaussian": [0], "int": [0]}}},
    {"op": "weather_call", "method": "moisture_value", "args": [10, 10], "expect": 0},
    {"op": "weather_call", "method": "moisture_type", "args": [10, 10], "expect": 0},
    {"op": "weather_call", "method": "cell_count_x", "expect": 0},
    {"op": "weather_call", "method": "cell_width_x", "expect": 0},
    {"op": "weather_call", "method": "position_to_cell", "args": [100, 37]},
    {"op": "weather_init", "expect": true},
    {"op": "weather_call", "method": "cell_width_x", "expect": 16},
    {"op": "weather_call", "method": "cell_width_z", "expect": 16},
    {"op": "weather_call", "method": "cell_count_x", "expect": 16},
    {"op": "weather_call", "method": "cell_count_z", "expect": 16},
    {"op": "weather_call", "method": "position_to_cell", "args": [100, 37], "expect": [0, 6, 2]},
    {"op": "weather_call", "method": "position_to_cell", "args": [-17, -1], "expect": [0, -1, 0]},
    {"op": "weather_call", "method": "position_to_cell", "args": [5000, 255.9], "expect": [0, 312, 15]},
    {"op": "weather_call", "method": "cell_to_position", "args": [3, 7], "expect": [48, 112]},
    {"op": "weather_call", "method": "cell_to_position", "args": [-2, 300], "expect": [-32, 4800]},
    {"op": "weather_call", "method": "cell_to_standard_city_cell", "args": [3, 7], "expect": [3, 3]},
    {"op": "weather_call", "method": "standard_city_cell_to_cell", "args": [3, 7], "expect": [3, 7]},

    {"op": "weather_set", "state": {"moisture_cells": [{"x": 3, "z": 5, "v": 171}, {"x": 15, "z": 15, "v": 200}, {"x": 0, "z": 0, "v": 15},
      {"x": 15, "z": 0, "v": 16}, {"x": 0, "z": 15, "v": 255}]}},
    {"op": "weather_call", "method": "moisture_value", "args": [48, 80], "expect": 171},
    {"op": "weather_call", "method": "moisture_value", "args": [63.9, 95.9], "expect": 171},
    {"op": "weather_call", "method": "moisture_value", "args": [64, 80], "expect": 64},
    {"op": "weather_call", "method": "moisture_type", "args": [48, 80], "expect": 10},
    {"op": "weather_call", "method": "moisture_value", "args": [-5, -500], "expect": 15},
    {"op": "weather_call", "method": "moisture_type", "args": [-5, -500], "expect": 0},
    {"op": "weather_call", "method": "moisture_value", "args": [1000, 1e9], "expect": 200},
    {"op": "weather_call", "method": "moisture_type", "args": [256, 256], "expect": 12},
    {"op": "weather_call", "method": "moisture_value", "args": [255.99, 0], "expect": 16},
    {"op": "weather_call", "method": "moisture_type", "args": [256, -1], "expect": 1},
    {"op": "weather_call", "method": "moisture_type", "args": [0, 300], "expect": 15},

    {"op": "weather_call", "method": "humidity", "args": [0, 0], "expect": 0.6},
    {"op": "weather_call", "method": "humidity", "args": [-1000, 99999], "expect": 0.6},
    {"op": "weather_set", "state": {"base_moisture": 0.5}},
    {"op": "weather_call", "method": "humidity", "args": [0, 0], "expect": 0.75},
    {"op": "weather_env", "month": 7},
    {"op": "weather_call", "method": "humidity", "args": [0, 0], "expect": 0.75},

    {"op": "weather_set", "state": {"wind_speed": 2, "wind_dir": [0.6, 0.8]}},
    {"op": "weather_call", "method": "ambient_wind", "expect": {"speed": 2, "v": [1.2, 1.6]}},
    {"op": "weather_call", "method": "wind_at_cell", "args": [5, 9], "expect": {"speed": 2, "v": [1.2, 1.6]}},
    {"op": "weather_call", "method": "wind_at_cell", "args": [-100, 100000], "expect": {"speed": 2, "v": [1.2, 1.6]}},

    {"op": "weather_shutdown", "expect": true},
    {"op": "weather_call", "method": "moisture_value", "args": [48, 80], "expect": 0},

    {"op": "weather_env", "size": [4, 4], "cell_width": [8, 8]},
    {"op": "weather_create", "rng": {"stub": {"uniform": [0.5], "gaussian": [0], "int": [0]}}},
    {"op": "weather_init", "expect": true},
    {"op": "weather_expect", "state": {"city_cells_per_cell_x": 2, "city_cells_per_cell_z": 2, "cell_width_x": 16}},
    {"op": "weather_call", "method": "cell_to_standard_city_cell", "args": [3, 7], "expect": [6, 6]},
    {"op": "weather_call", "method": "standard_city_cell_to_cell", "args": [7, 9], "expect": [3, 4]},
    {"op": "weather_call", "method": "standard_city_cell_to_cell", "args": [-7, 9], "expect": [-3, 4]},
    {"op": "weather_set", "state": {"moisture_cells": [{"x": 0, "z": 1, "v": 1}, {"x": 1, "z": 0, "v": 2}, {"x": 3, "z": 0, "w": 1, "d": 4, "v": 99}]}},
    {"op": "weather_call", "method": "moisture_map", "expect": [[64, 1, 64, 64], [2, 64, 64, 64], [64, 64, 64, 64], [99, 99, 99, 99]]},

    {"op": "weather_env", "cell_width": [32, 32]},
    {"op": "weather_create", "rng": {"stub": {"uniform": [0.5], "gaussian": [0], "int": [0]}}},
    {"op": "weather_init", "expect": true},
    {"op": "weather_expect", "state": {"city_cells_per_cell_x": 0}},
    {"op": "weather_call", "method": "cell_to_standard_city_cell", "args": [3, 7], "expect": [0, 0]},
    {"op": "weather_call", "method": "standard_city_cell_to_cell", "args": [3, 7], "expect": [0, 0]}
  ]
}
