{
  "format": 1,
  "name": "lot_developer_lifecycle_tuning",
  "spec": ["lot-developer 1.1", "lot-developer 1.3", "lot-developer 1.4", "lot-developer 3.1", "lot-developer 3.2", "lot-developer 3.5"],
  "description": "Lifecycle and QueryInterface (§1.1, §1.3, §1.4, §3). QueryInterface answers 1, 0x4818E5D2, 0x452294AA, 0xE4FDA3D4 and nothing else. Init: tuning, services, cell counts from the city, terrain extents (vertsX = terrain cell count X + 1 = 65, extentX/Z = 64 * 16 = 1024), daily state 0, AddAgent at levels 0/4/6 with the messages 0x66956810/0x66956814/0x66956816, the message server, the nine subscriptions in the order of §1.3 step 9, the animation-tick registration, the boundary rules, and the forced base-texture refresh (a flip and a restore, §1.3 step 12; no lots exist so nothing walks). A second Init returns true with no call. DoMessage returns true for an unknown type, for the subscribed-but-ignored 0x278E6003 (quirk 15) and for the level-0/level-6 agent messages (default branch). CityEstablished sets noZotUntilDay = date + 31; TrafficMapChanged sets canCheckCommute from the jobs demand (positive yes, zero no, NaN no, missing node no). Init failures: no services, no simulator, no message server. Shutdown: release the buildings of the night deque, remove the agent, unregister the tick, unsubscribe the nine, release the server and the services, clear the boundary rules, free the iterator; a second Shutdown returns true with no call.",
  "steps": [
    {"op": "ldev_eval", "fn": "answers_iid", "args": [1], "expect": true},
    {"op": "ldev_eval", "fn": "answers_iid", "args": ["0x4818E5D2"], "expect": true},
    {"op": "ldev_eval", "fn": "answers_iid", "args": ["0x452294AA"], "expect": true},
    {"op": "ldev_eval", "fn": "answers_iid", "args": ["0xE4FDA3D4"], "expect": true},
    {"op": "ldev_eval", "fn": "answers_iid", "args": ["0xA990BFE0"], "expect": false},
    {"op": "ldev_eval", "fn": "answers_iid", "args": [0], "expect": false},

    {"op": "ldev_world", "terrain_cells": [64, 64], "terrain_width": 16, "city": [64, 64]},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_expect", "initialised": false, "daily_state": 3, "net_changed": true, "unit_changed": true,
      "night_acc": 200, "night_batch": 8, "verts_x": 0},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_expect_events", "events": [
      {"event": "acquire_services"},
      {"event": "add_agent", "level": 0, "message": "0x66956810"},
      {"event": "add_agent", "level": 4, "message": "0x66956814"},
      {"event": "add_agent", "level": 6, "message": "0x66956816"},
      {"event": "acquire_message_server"},
      {"event": "subscribe", "message": "0x44778234"},
      {"event": "subscribe", "message": "0x99EF1142"},
      {"event": "subscribe", "message": "0x99EF1143"},
      {"event": "subscribe", "message": "0xE8BDA2E7"},
      {"event": "subscribe", "message": "0xE99B3D4D"},
      {"event": "subscribe", "message": "0x278E6003"},
      {"event": "subscribe", "message": "0x8A07AE00"},
      {"event": "subscribe", "message": "0x26D31EC4"},
      {"event": "subscribe", "message": "0x69247DC7"},
      {"event": "register_tick"}],
      "note": "the boundary rules (step 11) are the lot developer's own map (§17.7), not a host call"},
    {"op": "ldev_expect", "initialised": true, "daily_state": 0, "verts_x": 65,
      "extent_x": 1024, "extent_z": 1024, "cell_counts": [64, 64],
      "can_check_commute": false, "no_zot_until_day": 0,
      "tuning": {"stay_new_time": 90, "thresholds": [0.3, 0.45, 0.5]}},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_expect_events", "events": []},

    {"op": "ldev_message", "msg": "0x12345678", "expect": true},
    {"op": "ldev_message", "msg": "0x278E6003", "expect": true},
    {"op": "ldev_message", "msg": "0x66956810", "expect": true},
    {"op": "ldev_message", "msg": "0x66956816", "expect": true},
    {"op": "ldev_expect_events", "events": []},

    {"op": "ldev_world", "sim_date": 1000},
    {"op": "ldev_message", "msg": "0x26D31EC4", "expect": true},
    {"op": "ldev_expect", "no_zot_until_day": 1031},
    {"op": "ldev_world", "jobs_demand": 1.5},
    {"op": "ldev_message", "msg": "0x69247DC7", "expect": true},
    {"op": "ldev_expect", "can_check_commute": true},
    {"op": "ldev_world", "jobs_demand": 0},
    {"op": "ldev_message", "msg": "0x69247DC7", "expect": true},
    {"op": "ldev_expect", "can_check_commute": false},
    {"op": "ldev_world", "jobs_demand": "nan"},
    {"op": "ldev_message", "msg": "0x69247DC7", "expect": true},
    {"op": "ldev_expect", "can_check_commute": false},
    {"op": "ldev_world", "jobs_demand": null},
    {"op": "ldev_message", "msg": "0x69247DC7", "expect": true},
    {"op": "ldev_expect", "can_check_commute": false},

    {"op": "ldev_shutdown", "expect": true},
    {"op": "ldev_expect_events", "events": [
      {"event": "remove_agent"},
      {"event": "unregister_tick"},
      {"event": "unsubscribe", "message": "0x44778234"},
      {"event": "unsubscribe", "message": "0x99EF1142"},
      {"event": "unsubscribe", "message": "0x99EF1143"},
      {"event": "unsubscribe", "message": "0xE8BDA2E7"},
      {"event": "unsubscribe", "message": "0xE99B3D4D"},
      {"event": "unsubscribe", "message": "0x278E6003"},
      {"event": "unsubscribe", "message": "0x8A07AE00"},
      {"event": "unsubscribe", "message": "0x26D31EC4"},
      {"event": "unsubscribe", "message": "0x69247DC7"},
      {"event": "release_message_server"},
      {"event": "release_services"}]},
    {"op": "ldev_expect", "initialised": false},
    {"op": "ldev_shutdown", "expect": true},
    {"op": "ldev_expect_events", "events": []},

    {"op": "ldev_world", "no_services": true},
    {"op": "ldev_init", "expect": false},
    {"op": "ldev_expect_events", "events": [{"event": "acquire_services"}]},
    {"op": "ldev_expect", "initialised": false},
    {"op": "ldev_world", "no_services": false, "no_simulator": true},
    {"op": "ldev_init", "expect": false},
    {"op": "ldev_expect_events", "events": [{"event": "acquire_services"}]},
    {"op": "ldev_world", "no_simulator": false, "no_message_server": true},
    {"op": "ldev_init", "expect": false},
    {"op": "ldev_expect_events", "events": [
      {"event": "acquire_services"},
      {"event": "add_agent", "level": 0},
      {"event": "add_agent", "level": 4},
      {"event": "add_agent", "level": 6},
      {"event": "acquire_message_server"}]},
    {"op": "ldev_world", "no_message_server": false},

    {"op": "ldev_tuning", "none": true},
    {"op": "ldev_create", "seed": 1},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_expect", "tuning": {"stay_new_time": 90, "thresholds": [0.2, 0.4, 0.6]},
      "night_acc": 200, "night_batch": 8},
    {"op": "ldev_tuning", "shipped": true},
    {"op": "ldev_create", "seed": 1},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_expect", "tuning": {"stay_new_time": 90, "thresholds": [0.3, 0.45, 0.5],
      "max_slope_for_flatness": 1, "max_area_slope_for_levelling": 40,
      "default_lot_foundation_type": "0x890B7312",
      "attempt_lot_levelling": true, "attempt_internal_lot_levelling": true},
      "night_acc": 100, "night_batch": 10},
    {"op": "ldev_tuning", "stay_new": 40, "thresholds": [0.5, 0.25, 0.75], "night_acc": 7, "night_batch": 3},
    {"op": "ldev_create", "seed": 1},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_expect", "tuning": {"stay_new_time": 40, "thresholds": [0.5, 0.25, 0.75]},
      "night_acc": 7, "night_batch": 3}
  ]
}
