{
  "format": 1,
  "name": "ck12_08_pause_counters",
  "spec": ["clock24 4.7", "clock24 12"],
  "description": "Test 8. Pause(true) twice posts one PauseChanged (1) and stops the timer at its elapsed time (300,000 us); Pause(false) twice posts one PauseChanged (0) and restarts it with the elapsed time kept (+200,000 = 500,000); Pause(false) at 0 posts nothing. The same for HiddenPause and HiddenPauseChanged. The timer runs only while both counters are 0. All return true.",
  "steps": [
    {"op": "ck_create"},
    {"op": "ck_call", "method": "init"},
    {"op": "ck_clear_events"},
    {"op": "ck_idle", "advance": 300000, "expect": true},
    {"op": "ck_call", "method": "pause", "args": [true], "expect": true},
    {"op": "ck_call", "method": "pause", "args": [true], "expect": true},
    {"op": "ck_expect_events", "events": [{"event": "post", "name": "PauseChanged", "data2": 1, "data3": 0}]},
    {"op": "ck_call", "method": "is_paused", "expect": true},
    {"op": "ck_idle", "advance": 5000000},
    {"op": "ck_expect", "state": {"pause_count": 2, "timer_running": false, "timer_elapsed": 300000}},
    {"op": "ck_call", "method": "pause", "args": [false], "expect": true},
    {"op": "ck_expect_event_count", "count": 0},
    {"op": "ck_call", "method": "pause", "args": [false], "expect": true},
    {"op": "ck_expect_events", "events": [{"event": "post", "name": "PauseChanged", "data2": 0, "data3": 0}]},
    {"op": "ck_env", "now": 6500000},
    {"op": "ck_expect", "state": {"pause_count": 0, "timer_running": true, "timer_elapsed": 500000}},
    {"op": "ck_call", "method": "pause", "args": [false], "expect": true},
    {"op": "ck_expect", "state": {"pause_count": 0}},
    {"op": "ck_expect_event_count", "count": 0},
    {"op": "ck_call", "method": "hidden_pause", "args": [true], "expect": true},
    {"op": "ck_call", "method": "hidden_pause", "args": [true], "expect": true},
    {"op": "ck_expect_events", "events": [{"event": "post", "name": "HiddenPauseChanged", "data2": 1, "data3": 0}]},
    {"op": "ck_call", "method": "is_hidden_paused", "expect": true},
    {"op": "ck_idle", "advance": 5000000},
    {"op": "ck_expect", "state": {"hidden_pause_count": 2, "timer_running": false, "timer_elapsed": 500000}},
    {"op": "ck_call", "method": "hidden_pause", "args": [false]},
    {"op": "ck_call", "method": "hidden_pause", "args": [false]},
    {"op": "ck_call", "method": "hidden_pause", "args": [false]},
    {"op": "ck_expect_events", "events": [{"event": "post", "name": "HiddenPauseChanged", "data2": 0, "data3": 0}]},
    {"op": "ck_expect", "state": {"hidden_pause_count": 0, "timer_running": true, "timer_elapsed": 500000}},
    {"op": "ck_call", "method": "pause", "args": [true]},
    {"op": "ck_call", "method": "hidden_pause", "args": [true]},
    {"op": "ck_call", "method": "pause", "args": [false]},
    {"op": "ck_expect", "state": {"timer_running": false}},
    {"op": "ck_call", "method": "hidden_pause", "args": [false]},
    {"op": "ck_expect", "state": {"timer_running": true}},
    {"op": "ck_expect_events", "events": [{"event": "post", "name": "PauseChanged", "data2": 1, "data3": 0}, {"event": "post", "name": "HiddenPauseChanged", "data2": 1, "data3": 0}, {"event": "post", "name": "PauseChanged", "data2": 0, "data3": 0}, {"event": "post", "name": "HiddenPauseChanged", "data2": 0, "data3": 0}]}
  ]
}
