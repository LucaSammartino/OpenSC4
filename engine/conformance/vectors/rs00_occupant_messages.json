{
  "format": 1,
  "name": "residential_occupant_messages",
  "spec": ["residential 4.3", "REH 4.1"],
  "description": "Section 4.3: OccupantInserted / OccupantRemoved with data3 = 0x278128A0 (a building occupant type) and a void1 that is a cISC4BuildingOccupant reach DoBuildingChanged(building, inserted). Occupant 8 is a school recognised by its group 0x1503 (no budget item, REH 4.1): inserted, it is appended to the pending school list with one reference, its served population becomes 0xFFFFFFFF (not graded), its grade and staff ratio 1.0 and its effective capacity its capacity (1500), and dirty is set; removed, it is erased from the pending list and released, and dirty is set. Another occupant type, an occupant that is not a building, or no occupant: nothing. A building that is no service only runs the slot-11 test: dirty is set when slot 11 returns 1. Every message returns true.",
  "steps": [
    {"op": "residential_env", "groups": {"8": ["0x1503"], "10": ["0x9999"]}, "props": {"8": {"0x8922041B": {"u32": 1500}}}},
    {"op": "residential_create"},
    {"op": "residential_init", "expect": true},
    {"op": "residential_set", "state": {"dirty": false}},
    {"op": "residential_clear_events"},
    {"op": "residential_message", "type": "OccupantInserted", "occupant": 8, "expect": true},
    {"op": "residential_expect_events", "events": [{"event": "add_ref", "id": 8}]},
    {"op": "residential_expect", "state": {"dirty": true, "lists": {"pending_school": [8], "pending_hospital": []}}},
    {"op": "residential_expect_refs", "refs": {"8": 1}},
    {"op": "residential_expect_props", "occupant": 8, "props": {"0x09220161": "0xFFFFFFFF", "0xE9244B2E": 1500, "0x292453C5": 1.0, "0x2A976C20": 1.0}},
    {"op": "residential_set", "state": {"dirty": false}},
    {"op": "residential_message", "type": "OccupantRemoved", "occupant": 8, "expect": true},
    {"op": "residential_expect_events", "events": [{"event": "release", "id": 8}]},
    {"op": "residential_expect", "state": {"dirty": true, "lists": {"pending_school": []}}},
    {"op": "residential_expect_refs", "refs": {"8": 0}},
    {"op": "residential_set", "state": {"dirty": false}},
    {"op": "residential_message", "type": "OccupantInserted", "occupant": 8, "data3": "0x1234", "expect": true},
    {"op": "residential_message", "type": "OccupantInserted", "occupant": 9, "expect": true},
    {"op": "residential_message", "type": "OccupantRemoved", "expect": true},
    {"op": "residential_expect_events", "events": []},
    {"op": "residential_expect", "state": {"dirty": false}},
    {"op": "residential_message", "type": "OccupantInserted", "occupant": 10, "expect": true},
    {"op": "residential_expect", "state": {"dirty": false}},
    {"op": "residential_env", "slot11": {"10": 1}},
    {"op": "residential_message", "type": "OccupantInserted", "occupant": 10, "expect": true},
    {"op": "residential_expect", "state": {"dirty": true}},
    {"op": "residential_expect_events", "events": []}
  ]
}
