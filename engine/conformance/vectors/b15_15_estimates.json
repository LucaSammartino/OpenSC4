{
  "format": 1,
  "name": "budget_estimates",
  "spec": ["budget 6", "budget 15.15"],
  "description": "GetEstIncome / GetEstExpenses = YTD + the live monthly total x (13 - current month). The live totals include GetTaxIncome(t) at the current rate, the ordinance and neighbour stubs, department income and current expenses and bond payments. The four total setters only store (and return) their value; GetFunding is always 0.",
  "steps": [
    {"op": "budget_env", "difficulty": 2, "year": 2000, "month": 1, "ordinance_income": 50, "ordinance_expense": 20},
    {"op": "budget_create"},
    {"op": "budget_init", "tuning": {"0x6A9C7718": [500000, 200000, 100000], "0x0C032488": [9, 9, 9],
      "0xEBFF69E7": [1.2, 1.1, 1.0]}},
    {"op": "budget_lots", "lots": [{"purpose": 1, "building_wealth": 1, "lot_wealth": 1, "value": 10000}]},
    {"op": "budget_call", "method": "create_department_budget", "args": [4096, 8192], "expect": 4096},
    {"op": "budget_dept", "dept": 4096, "method": "create_line_item", "args": [1, false], "expect": 1},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "set_full_expenses", "args": [100]},
    {"op": "budget_call", "method": "total_monthly_income", "expect": 50, "note": "no assessed value yet"},
    {"op": "budget_call", "method": "est_income", "expect": 600, "note": "0 + 50 x 12"},
    {"op": "budget_call", "method": "est_expenses", "expect": 1440, "note": "0 + 120 x 12"},

    {"op": "budget_env", "month": 2},
    {"op": "budget_call", "method": "settle_month"},
    {"op": "budget_expect", "state": {"ytd_income": 125, "ytd_expense": 120}},
    {"op": "budget_env", "month": 3},
    {"op": "budget_call", "method": "total_monthly_income", "expect": 125},
    {"op": "budget_call", "method": "est_income", "expect": 1375, "note": "125 + 125 x 10"},
    {"op": "budget_call", "method": "est_expenses", "expect": 1320, "note": "120 + 120 x 10"},
    {"op": "budget_call", "method": "set_tax_rate", "args": [0, 12]},
    {"op": "budget_call", "method": "total_monthly_income", "expect": 150},
    {"op": "budget_call", "method": "est_income", "expect": 1625},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "add_to_income", "args": [10]},
    {"op": "budget_call", "method": "est_income", "expect": 1725},
    {"op": "budget_env", "month": 12, "neighbor_expense": 5},
    {"op": "budget_call", "method": "est_expenses", "expect": 245, "note": "120 + 125 x 1"},
    {"op": "budget_call", "method": "issue_bond", "args": [1000], "expect": true},
    {"op": "budget_call", "method": "total_monthly_expense", "expect": 137, "note": "20 + 5 + 100 + 12"},

    {"op": "budget_call", "method": "set_total_monthly_expense", "args": [5], "expect": 5},
    {"op": "budget_call", "method": "set_total_monthly_income", "args": [6], "expect": 6},
    {"op": "budget_call", "method": "set_total_yearly_expense", "args": [7], "expect": 7},
    {"op": "budget_call", "method": "set_total_yearly_income", "args": [8], "expect": 8},
    {"op": "budget_expect", "state": {"last_month_expense": 5, "last_month_income": 6, "yearly_expense": 7,
      "yearly_income": 8, "ytd_income": 125, "ytd_expense": 120}},
    {"op": "budget_call", "method": "total_yearly_expense", "expect": 7},
    {"op": "budget_call", "method": "total_yearly_income", "expect": 8},
    {"op": "budget_call", "method": "total_monthly_expense", "expect": 137, "note": "live, not the stored value"},
    {"op": "budget_call", "method": "funding", "expect": 0},
    {"op": "budget_call", "method": "show_budget_window", "expect": true}
  ]
}
