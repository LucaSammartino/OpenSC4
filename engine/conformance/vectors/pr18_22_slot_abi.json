    {"op": "protection_call", "method": "slot", "args": [19], "expect": {"name": "GetAverageCoverage", "pops": 0, "ret": "st0"}},
    {"op": "protection_call", "method": "slot", "args": [21], "expect": {"name": "GetOccupantCoverage", "pops": 16, "ret": "al"}},
    {"op": "protection_call", "method": "slot", "args": [26], "expect": false},
    {"op": "protection_call", "method": "class_id", "expect": "0x2990C05A"},
