    {"op": "protection_call", "method": "slot", "args": [44], "expect": {"name": "GetPoliceStationCrimeCount", "pops": 4, "ret": "eax"}},
    {"op": "protection_call", "method": "class_id", "expect": "0x6990C04F"},
