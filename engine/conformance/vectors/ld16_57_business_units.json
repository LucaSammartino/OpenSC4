{
  "format": 1,
  "name": "lot_developer_business_units",
  "spec": ["lot-developer 5.7", "lot-developer 4.2"],
  "description": "The business-unit helpers (§5.7). UpdateTravelDesignates with an anchor (the first member with road access and a building): every other member's designate is re-pointed to the anchor when it is null or points at a member, kept when it points at a non-member WITH road access, and re-pointed when it points at a non-member WITHOUT road access; the anchor itself gets no designate. Without an anchor the unit is dissolved: each member in turn is removed and offered to PickUnitToJoin (which may draw R2); as soon as one joins a new unit u', every other lot of the copy moves into u' and the reference becomes u'. UpdateTravelPopulations resets every member's travel population and then has each member add its population to its designate (or to itself). RemoveLotFromItsBusinessUnit removes the lot from its unit and sets unitChanged.",
  "steps": [
    {"op": "ldev_world", "terrain_cells": [64, 64]},
    {"op": "ldev_tuning", "shipped": true},
    {"op": "ldev_profile", "building": "0x6000", "purpose": 6, "wealth": 1},
    {"op": "ldev_occ", "id": 40, "is_building": true},
    {"op": "ldev_occ", "id": 41, "is_building": true},
    {"op": "ldev_occ", "id": 42, "is_building": true},

    {"op": "ldev_lot", "id": 1, "x": 0, "z": 0, "state": 3, "building_type": "0x6000", "building": 40, "road": true,
      "note": "the anchor: road access and a building, and the first member"},
    {"op": "ldev_lot", "id": 2, "x": 1, "z": 0, "state": 3, "building_type": "0x6000", "building": 41, "road": false,
      "note": "no designate -> re-pointed to the anchor"},
    {"op": "ldev_lot", "id": 3, "x": 2, "z": 0, "state": 3, "building_type": "0x6000", "building": 42, "road": false,
      "designate": 1, "note": "designate is a member -> re-pointed to the anchor"},
    {"op": "ldev_unit", "id": 90, "members": [1, 2, 3]},

    {"op": "ldev_lot", "id": 4, "x": 3, "z": 0, "state": 3, "road": true, "note": "a non-member WITH road access"},
    {"op": "ldev_lot", "id": 5, "x": 4, "z": 0, "state": 3, "road": false, "note": "a non-member WITHOUT road access"},
    {"op": "ldev_lot", "id": 6, "x": 5, "z": 0, "state": 3, "building_type": "0x6000", "building": 41, "road": false,
      "designate": 4, "note": "points at non-member 4 which has road access -> kept"},
    {"op": "ldev_lot", "id": 7, "x": 6, "z": 0, "state": 3, "building_type": "0x6000", "building": 41, "road": false,
      "designate": 5, "note": "points at non-member 5 without road access -> re-pointed"},
    {"op": "ldev_unit", "id": 90, "members": [1, 2, 3, 6, 7]},

    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_clear_events"},
    {"op": "ldev_update_designates", "unit": 90},
    {"op": "ldev_expect_lot", "lot": 1, "designate": null, "note": "the anchor itself gets no designate"},
    {"op": "ldev_expect_lot", "lot": 2, "designate": 1},
    {"op": "ldev_expect_lot", "lot": 3, "designate": 1},
    {"op": "ldev_expect_lot", "lot": 6, "designate": 4, "note": "kept: a non-member with road access"},
    {"op": "ldev_expect_lot", "lot": 7, "designate": 1, "note": "re-pointed: a non-member without road access"},
    {"op": "ldev_expect_draws", "draws": [], "note": "with an anchor no PickUnitToJoin runs, so no draw"},

    {"op": "ldev_clear_events"},
    {"op": "ldev_update_populations", "unit": 90},
    {"op": "ldev_expect_events", "note": "every member is reset, then each adds its population to its designate (or itself)",
      "events": [
        {"event": "reset_travel_pop", "lot": 1},
        {"event": "reset_travel_pop", "lot": 2},
        {"event": "reset_travel_pop", "lot": 3},
        {"event": "reset_travel_pop", "lot": 6},
        {"event": "reset_travel_pop", "lot": 7},
        {"event": "add_travel_pop", "lot": 1, "from": 1},
        {"event": "add_travel_pop", "lot": 1, "from": 2},
        {"event": "add_travel_pop", "lot": 1, "from": 3},
        {"event": "add_travel_pop", "lot": 4, "from": 6},
        {"event": "add_travel_pop", "lot": 1, "from": 7}]},

    {"op": "ldev_clear_events"},
    {"op": "ldev_remove_from_unit", "lot": 2, "expect": true},
    {"op": "ldev_expect_lot", "lot": 2, "unit": null},
    {"op": "ldev_expect", "unit_changed": true},

    {"op": "ldev_clear_lots", "note": "dissolution: no member has road access, so there is no anchor"},
    {"op": "ldev_lot", "id": 10, "x": 0, "z": 0, "state": 3, "building_type": "0x6000", "building": 40, "road": false},
    {"op": "ldev_lot", "id": 11, "x": 1, "z": 0, "state": 3, "building_type": "0x6000", "building": 41, "road": false},
    {"op": "ldev_unit", "id": 91, "members": [10, 11]},
    {"op": "ldev_lot", "id": 12, "x": 2, "z": 0, "state": 3, "building_type": "0x6000", "building": 42, "road": true,
      "note": "a surrounding neighbour that qualifies, so PickUnitToJoin(10) finds a candidate and draws R2"},
    {"op": "ldev_surrounding", "lot": {"10": [12]}},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_clear_events"},
    {"op": "ldev_update_designates", "unit": 91, "note": "member 10 joins 12's new unit, so the reference becomes that unit"},
    {"op": "ldev_expect_draws", "draws": [["R2", 1, 0]], "note": "one candidate -> Uniform(1) = 0"},
    {"op": "ldev_expect_lot", "lot": 10, "note": "10 joined the new unit"},
    {"op": "ldev_expect_events", "filter": {"event": "unit_create"}, "events": [{"event": "unit_create"}]}
  ]
}
