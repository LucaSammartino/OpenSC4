{
  "format": 1,
  "name": "residential_version3_running_population",
  "spec": ["residential 9.2", "residential 9.3", "RS17"],
  "description": "RS17 with residential 9.3's example: four tracts of total 100 and a flat LE of 60, saved in state 4 with running population 200. After the load Init resets the iterator and leSum but not the running population, so the restarted pass counts on top of it: version >= 4 reads 200 -> population 600, average-LE history 24000 / 600 = 40; version 3 has no running-population field and keeps the constructor's 0 -> 400 and 60, as without the load.",
  "steps": [
    {"op": "residential_env", "cells": [8, 8], "tuning_props": {"0x6941A67F": {"f32": [0, 60, 200, 60]}, "0xC929C433": {"f32": 0}, "0x0929C439": {"f32": 0}}},
    {"op": "residential_create"},
    {"op": "residential_init", "expect": true},
    {"op": "residential_set", "state": {"state": 4, "running_population": 200, "le_sum": 12000}},
    {"op": "residential_write", "slot": "a", "expect": true, "length": 452},

    {"op": "residential_read", "slot": "a", "version": 7, "length": 452, "expect": true},
    {"op": "residential_expect", "state": {"state": 4, "running_population": 200, "le_sum": 12000}},
    {"op": "residential_init", "expect": true},
    {"op": "residential_expect", "state": {"le_sum": 0}},
    {"op": "residential_tract", "x": 0, "z": 0, "steady": [100, 0, 0], "age": 30},
    {"op": "residential_tract", "x": 1, "z": 0, "steady": [100, 0, 0], "age": 30},
    {"op": "residential_tract", "x": 0, "z": 1, "steady": [100, 0, 0], "age": 30},
    {"op": "residential_tract", "x": 1, "z": 1, "steady": [100, 0, 0], "age": 30},
    {"op": "residential_clear_events"},
    {"op": "residential_run_to", "state": 12, "steps": 1},
    {"op": "residential_expect", "state": {"running_population": 600}},
    {"op": "residential_run_to", "state": 5, "steps": 1},
    {"op": "residential_expect", "state": {"population": 600}},
    {"op": "residential_expect_events", "events": [{"value": 40}], "filter": {"event": "history", "series": "0x2A5E7009"}},

    {"op": "residential_read", "slot": "a", "version": 4, "length": 450, "expect": true},
    {"op": "residential_expect", "state": {"state": 4, "running_population": 200, "le_sum": 12000}},
    {"op": "residential_init", "expect": true},
    {"op": "residential_expect", "state": {"le_sum": 0}},
    {"op": "residential_tract", "x": 0, "z": 0, "steady": [100, 0, 0], "age": 30},
    {"op": "residential_tract", "x": 1, "z": 0, "steady": [100, 0, 0], "age": 30},
    {"op": "residential_tract", "x": 0, "z": 1, "steady": [100, 0, 0], "age": 30},
    {"op": "residential_tract", "x": 1, "z": 1, "steady": [100, 0, 0], "age": 30},
    {"op": "residential_clear_events"},
    {"op": "residential_run_to", "state": 12, "steps": 1},
    {"op": "residential_expect", "state": {"running_population": 600}},
    {"op": "residential_run_to", "state": 5, "steps": 1},
    {"op": "residential_expect", "state": {"population": 600}},
    {"op": "residential_expect_events", "events": [{"value": 40}], "filter": {"event": "history", "series": "0x2A5E7009"}},

    {"op": "residential_read", "slot": "a", "version": 3, "length": 446, "expect": true},
    {"op": "residential_expect", "state": {"state": 4, "running_population": 0, "le_sum": 12000}},
    {"op": "residential_init", "expect": true},
    {"op": "residential_expect", "state": {"le_sum": 0}},
    {"op": "residential_tract", "x": 0, "z": 0, "steady": [100, 0, 0], "age": 30},
    {"op": "residential_tract", "x": 1, "z": 0, "steady": [100, 0, 0], "age": 30},
    {"op": "residential_tract", "x": 0, "z": 1, "steady": [100, 0, 0], "age": 30},
    {"op": "residential_tract", "x": 1, "z": 1, "steady": [100, 0, 0], "age": 30},
    {"op": "residential_clear_events"},
    {"op": "residential_run_to", "state": 12, "steps": 1},
    {"op": "residential_expect", "state": {"running_population": 400}},
    {"op": "residential_run_to", "state": 5, "steps": 1},
    {"op": "residential_expect", "state": {"population": 400}},
    {"op": "residential_expect_events", "events": [{"value": 60}], "filter": {"event": "history", "series": "0x2A5E7009"}}
  ]
}
