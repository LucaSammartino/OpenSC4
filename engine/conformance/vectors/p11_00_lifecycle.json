{
  "format": 1,
  "name": "pollution_lifecycle",
  "spec": ["pollution 4.1", "pollution 4.3", "pollution 4.7", "pollution 5", "pollution 7.1"],
  "description": "Init of a new 128 x 128-cell city (64 x 64 tracts, shipped tuning): the new-city part first (eight grids, tractsPerDay = 4096 / 15 = 273, table iterator over [0, 63]^2 with 4096 entries, AddPropRequester), then the initialized part: AddAgent level 6 then 4 ('cSC4PollutionSimulator', flags 2), the five subscriptions in order, the department 0x6A42A8F5 / 0x4A357EAF named (0x6A3FF01C, 0xCA4938F8), max funding 1.2, line items 10, 20, 30 (not locally funded) named 0xCA57FE96, 0x4A57FFF0, 0x0A580005, history queue 0xEA110138 := 2; effect arrays 16 x 16 blocks. The department is AddRef'd and released at Shutdown, which stops (Stop(1)) and releases effects, unsubscribes, removes the agent and the prop requester. Tuning re-read on 0xCA1B151C (max UI levels shipped 1024/1024/32000/1024, code defaults 27000/32000/27000/32000). AddRadiationToCity (radius 1.5 tracts, strength 50 at tract (10,10)): k = 50/1.5 = 33.333332, d = 1 -> 50 - 33.333332 = 16.67 -> 17, d = 1.414 -> 50 - 47.14 = 2.86 -> 3; block (2,2) (cells 16..23) averages (50 + 4*17 + 4*3) * 4 cells / 64 = 520 >> 6 = 8 -> radiation strength curve(8/32767 = 2.4414808e-4) = 0.24414808 > 0.05 -> one radiation effect (kind 3) at the block centre (320, altitude 0 + 3, 320), param 2, Start(0); then RadiationChanged is posted. Radius 0 or strength 0 do nothing. SimBegin (the unreachable handler) sets efficiency from funding 0.5: curve(50) * 0.01 = 0.25. Without a budget department the funding fraction reads 1.0 ([choice]): efficiency curve(100) * 0.01 = 1.",
  "steps": [
    {"op": "pollution_create"},
    {"op": "pollution_expect", "state": {"initialized": false, "loaded": false, "efficiency": 0, "effects_visible": true,
      "grids": [false, false, false, false, false, false, false, false]}},
    {"op": "pollution_init", "expect": true},
    {"op": "pollution_expect_events", "events": [
      {"event": "add_prop_requester"},
      {"event": "add_agent", "level": 6, "name": "cSC4PollutionSimulator", "flags": 2},
      {"event": "add_agent", "level": 4, "name": "cSC4PollutionSimulator", "flags": 2},
      {"event": "subscribe", "types": ["0x99EF1142", "0x99EF1143", "0x26D31EC1", "0xCA1B151C", "0xC6CDBF1A"]},
      {"event": "create_department", "id": "0x6A42A8F5", "group": "0x4A357EAF"},
      {"event": "department_name", "group": "0x6A3FF01C", "instance": "0xCA4938F8"},
      {"event": "max_funding", "value": 1.2},
      {"event": "line_item", "line": 10, "local": false, "group": "0x6A3FF01C", "instance": "0xCA57FE96"},
      {"event": "line_item", "line": 20, "local": false, "group": "0x6A3FF01C", "instance": "0x4A57FFF0"},
      {"event": "line_item", "line": 30, "local": false, "group": "0x6A3FF01C", "instance": "0x0A580005"},
      {"event": "history_queue", "series": "0xEA110138", "length": 2}]},
    {"op": "pollution_expect", "state": {"initialized": true, "loaded": false, "tracts_per_day": 273, "blocks_x": 16, "blocks_z": 16,
      "grids": [true, true, true, true, true, true, true, true], "department": "department", "efficiency": 0,
      "iterator": {"mode": 0, "rect": [0, 0, 63, 63], "table_len": 4096, "exhausted": false},
      "dirty_air": false, "dirty_water": false, "dirty_garbage": false, "dirty_radiation": false}},
    {"op": "pollution_expect_grid", "grid": "air_src", "size": [64, 64], "others": 0},
    {"op": "pollution_expect_grid", "grid": "garbage_val", "size": [128, 128], "others": 0},
    {"op": "pollution_expect_refs", "refs": {"department": 1}},
    {"op": "pollution_call", "method": "max_level_for_ui", "args": [0], "expect": 1024},
    {"op": "pollution_call", "method": "max_level_for_ui", "args": [2], "expect": 32000},
    {"op": "pollution_tuning", "none": true},
    {"op": "pollution_message", "type": "TuningChanged", "expect": true},
    {"op": "pollution_call", "method": "max_level_for_ui", "args": [0], "expect": 27000},
    {"op": "pollution_call", "method": "max_level_for_ui", "args": [1], "expect": 32000},
    {"op": "pollution_call", "method": "max_level_for_ui", "args": [2], "expect": 27000},
    {"op": "pollution_call", "method": "max_level_for_ui", "args": [3], "expect": 32000},
    {"op": "pollution_call", "method": "garbage_scaling_factor", "expect": 0.125},
    {"op": "pollution_call", "method": "landfill_tile_capacity", "expect": 32767},
    {"op": "pollution_tuning", "shipped": true},
    {"op": "pollution_message", "type": "TuningChanged"},
    {"op": "pollution_call", "method": "garbage_scaling_factor", "expect": 0.01},
    {"op": "pollution_call", "method": "landfill_tile_capacity", "expect": 30000},
    {"op": "pollution_call", "method": "requester_satisfaction_id", "expect": "0xE9A4300B"},
    {"op": "pollution_call", "method": "uses_custom_prop_selector", "expect": false},
    {"op": "pollution_call", "method": "select_prop", "expect": 0},

    {"op": "pollution_clear_events"},
    {"op": "pollution_call", "method": "add_radiation_to_city", "args": [336, 0, 336, 50, 0]},
    {"op": "pollution_call", "method": "add_radiation_to_city", "args": [336, 0, 336, 0, 1.5]},
    {"op": "pollution_expect_events", "events": []},
    {"op": "pollution_call", "method": "add_radiation_to_city", "args": [336, 0, 336, 50, 1.5]},
    {"op": "pollution_expect_grid", "grid": "rad_src", "tracts": [{"x": 10, "z": 10, "v": 50},
      {"x": 9, "z": 10, "v": 17}, {"x": 11, "z": 10, "v": 17}, {"x": 10, "z": 9, "v": 17}, {"x": 10, "z": 11, "v": 17},
      {"x": 9, "z": 9, "v": 3}, {"x": 11, "z": 9, "v": 3}, {"x": 9, "z": 11, "v": 3}, {"x": 11, "z": 11, "v": 3}], "others": 0},
    {"op": "pollution_expect_events", "events": [
      {"event": "effect_create", "id": "0x0A78747A", "kind": 3},
      {"event": "effect_position", "position": [320, 3, 320]},
      {"event": "effect_param", "param": 2, "value": 0.24414808},
      {"event": "effect_start", "t": 0},
      {"event": "post", "type": "RadiationChanged", "data1": 0}]},
    {"op": "pollution_expect_effects", "radiation": 1, "water": 0, "air": 0, "garbage": 0, "live": 1},
    {"op": "pollution_call", "method": "is_radioactive", "args": [20, 21], "expect": true},
    {"op": "pollution_call", "method": "is_radioactive", "args": [30, 30], "expect": false},

    {"op": "pollution_env", "funding": 0.5},
    {"op": "pollution_message", "type": "SimBegin", "expect": true},
    {"op": "pollution_expect", "state": {"efficiency": 0.25}},

    {"op": "pollution_clear_events"},
    {"op": "pollution_shutdown", "expect": true},
    {"op": "pollution_expect_events", "events": [
      {"event": "effect_stop", "t": 1},
      {"event": "effect_release"},
      {"event": "unsubscribe", "types": ["0x99EF1142", "0x99EF1143", "0x26D31EC1", "0xCA1B151C", "0xC6CDBF1A"]},
      {"event": "remove_agent"},
      {"event": "remove_prop_requester"}]},
    {"op": "pollution_expect_refs", "refs": {"department": 0}},
    {"op": "pollution_expect", "state": {"initialized": false, "department": null,
      "grids": [false, false, false, false, false, false, false, false]}},

    {"op": "pollution_env", "department": false, "funding": 0.5},
    {"op": "pollution_create"},
    {"op": "pollution_init"},
    {"op": "pollution_expect_event_count", "filter": {"event": "create_department"}, "count": 0},
    {"op": "pollution_expect", "state": {"department": null}},
    {"op": "pollution_call", "method": "end_of_cycle"},
    {"op": "pollution_expect", "state": {"efficiency": 1}}
  ]
}
