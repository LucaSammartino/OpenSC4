    {"op": "tdev_eval", "fn": "hash_order", "args": [["0x100", "0x101", "0x102", "0x2C1", "0x3"]], "expect": ["0x3", "0x100", "0x101", "0x102", "0x2C1"]},
    {"op": "tdev_eval", "fn": "hash_order", "args": [[5, 198, 5, 198]], "expect": [198, 5]}
  ]
}
