    {"op": "grid_set", "grid": "m", "all": 5, "values": [[11, 0, 7]]},
    {"op": "grid_new", "grid": "t2", "type": "u8", "size": 1},
    {"op": "grid_set", "grid": "t2", "all": 100},
    {"op": "grid_distance_effect", "grid": "t2", "mask": "m", "mask_value": 7, "radius": 4, "near": 40, "far": 0},
    {"op": "grid_expect", "grid": "t2", "values": [[11, 0, 100], [10, 0, 130], [9, 0, 120], [8, 0, 110], [7, 0, 100], [0, 0, 100]]}
  ]
