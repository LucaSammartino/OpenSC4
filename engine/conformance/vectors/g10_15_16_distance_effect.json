    {"op": "grid_distance_effect", "grid": "t", "mask": "t", "mask_value": 0, "radius": 3, "near": 30, "far": 0},
    {"op": "grid_expect", "grid": "t", "values": [[0, 0, 0], [1, 0, 30], [2, 0, 20], [3, 0, 10], [4, 0, 10], [5, 0, 10], [6, 0, 10]]},
    {"op": "grid_city", "cells": [12, 1], "cell_width": 16},
    {"op": "grid_new", "grid": "lv", "type": "u8", "size": 1},
    {"op": "grid_set", "grid": "lv", "all": 1, "values": [[0, 0, 0]]},
    {"op": "grid_distance_effect", "grid": "lv", "mask": "lv", "mask_value": 0, "radius": 10, "near": 50, "far": 0},
    {"op": "grid_expect", "grid": "lv", "values": [[0, 0, 0], [1, 0, 46], [2, 0, 41], [3, 0, 36], [4, 0, 31], [5, 0, 26], [6, 0, 21], [7, 0, 16], [8, 0, 11], [9, 0, 6], [10, 0, 1], [11, 0, 1]]},
