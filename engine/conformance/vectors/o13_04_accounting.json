{
  "format": 1,
  "name": "ordinance_accounting",
  "spec": ["ordinance 3.5", "ordinance 4.4", "ordinance 5", "ordinance 13.4"],
  "description": "Enacting (enact -20) puts -20 into pending; the next month-end books pending <= 0 as expense and the on ordinance's Simulate result (-70) as expense: 90. Repealing (repeal -10) adds 10 to the next month's expense. An income ordinance (+100) books as income; a positive pending (enact +30, repeal +5) books as income. SetOn's preview adjustment of `adjusted` (|enact| + adjusted when switching on, adjusted - |repeal| when switching off) is visible until Simulate overwrites it. SimBegin books the current adjusted amounts without pending and without MonthlyDone; other message types are ignored and answered true.",
  "steps": [
    {"op": "ordinance_env", "population": 10000},
    {"op": "ordinance_exemplar", "instance": "0xA2BF1E43", "enact": -20, "repeal": -10, "constant": -20, "factor": -0.005},
    {"op": "ordinance_exemplar", "instance": "0xA0D07129", "enact": 0, "repeal": -20, "constant": 100, "factor": 1, "income": true},
    {"op": "ordinance_exemplar", "instance": "0xE0D0722E", "enact": 30, "repeal": 5, "constant": 0, "factor": 0},
    {"op": "ordinance_create"},
    {"op": "ordinance_init", "expect": true},
    {"op": "ordinance_message", "type": "SimNewMonth", "expect": true},
    {"op": "ordinance_call", "method": "available_count", "expect": 3},
    {"op": "ordinance_expect", "state": {"monthly_expense": 0, "monthly_income": 0, "pending": 0}},
    {"op": "ordinance_clear_events"},

    {"op": "ordinance_call", "method": "set_ordinance_on", "args": ["0xA2BF1E43", true], "expect": true},
    {"op": "ordinance_expect", "state": {"pending": -20}},
    {"op": "ordinance_expect_object", "id": "0xA2BF1E43", "state": {"on": true, "adjusted": 20}},
    {"op": "ordinance_message", "type": "SimNewMonth", "expect": true},
    {"op": "ordinance_expect", "state": {"monthly_expense": 90, "monthly_income": 0, "pending": 0}},
    {"op": "ordinance_call", "method": "monthly_expense", "expect": 90},
    {"op": "ordinance_call", "method": "monthly_income", "expect": 0},
    {"op": "ordinance_expect_object", "id": "0xA2BF1E43", "state": {"adjusted": -70}},

    {"op": "ordinance_call", "method": "set_ordinance_on", "args": ["0xA2BF1E43", false], "expect": true},
    {"op": "ordinance_expect", "state": {"pending": -10, "monthly_expense": 90}},
    {"op": "ordinance_expect_object", "id": "0xA2BF1E43", "state": {"on": false, "adjusted": -80}},
    {"op": "ordinance_message", "type": "SimNewMonth", "expect": true},
    {"op": "ordinance_expect", "state": {"monthly_expense": 10, "monthly_income": 0, "pending": 0}},
    {"op": "ordinance_expect_object", "id": "0xA2BF1E43", "state": {"adjusted": -80}},

    {"op": "ordinance_call", "method": "set_ordinance_on", "args": ["0xA0D07129", true], "expect": true},
    {"op": "ordinance_expect", "state": {"pending": 0}},
    {"op": "ordinance_message", "type": "SimNewMonth", "expect": true},
    {"op": "ordinance_expect", "state": {"monthly_expense": 0, "monthly_income": 100, "pending": 0}},

    {"op": "ordinance_call", "method": "set_ordinance_on", "args": ["0xE0D0722E", true], "expect": true},
    {"op": "ordinance_expect", "state": {"pending": 30}},
    {"op": "ordinance_expect_object", "id": "0xE0D0722E", "state": {"adjusted": 30}},
    {"op": "ordinance_message", "type": "SimNewMonth", "expect": true},
    {"op": "ordinance_expect", "state": {"monthly_expense": 0, "monthly_income": 130, "pending": 0}},
    {"op": "ordinance_call", "method": "set_ordinance_on", "args": ["0xE0D0722E", false], "expect": true},
    {"op": "ordinance_message", "type": "SimNewMonth", "expect": true},
    {"op": "ordinance_expect", "state": {"monthly_expense": 0, "monthly_income": 105, "pending": 0}},

    {"op": "ordinance_call", "method": "set_ordinance_on", "args": ["0xA2BF1E43", true], "expect": true},
    {"op": "ordinance_expect_object", "id": "0xA2BF1E43", "state": {"adjusted": -60}},
    {"op": "ordinance_clear_events"},
    {"op": "ordinance_message", "type": "SimBegin", "expect": true},
    {"op": "ordinance_expect", "state": {"monthly_expense": 60, "monthly_income": 100, "pending": -20}},
    {"op": "ordinance_expect_events", "events": []},
    {"op": "ordinance_call", "method": "simulation_begin"},
    {"op": "ordinance_expect", "state": {"monthly_expense": 60, "monthly_income": 100, "pending": -20}},
    {"op": "ordinance_message", "type": "0x12345678", "expect": true},
    {"op": "ordinance_expect", "state": {"monthly_expense": 60, "monthly_income": 100, "pending": -20}},
    {"op": "ordinance_expect_events", "events": []},
    {"op": "ordinance_message", "type": "SimNewMonth", "expect": true},
    {"op": "ordinance_expect", "state": {"monthly_expense": 90, "monthly_income": 100, "pending": 0}},
    {"op": "ordinance_expect_events", "events": [{"event": "post", "type": "MonthlyDone"}]}
  ]
}
