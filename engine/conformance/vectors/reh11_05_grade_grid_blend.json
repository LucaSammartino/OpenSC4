    {"op": "residential_call", "method": "efficiency_ratings", "args": [2, true, false], "expect": [0.5, 1.0]},
    {"op": "residential_set", "state": {"lists": {"school_groups": [[1], [], [2]]}}},
    {"op": "residential_set", "state": {"state": 5}},
    {"op": "residential_run_to", "state": 7, "steps": 2},
    {"op": "residential_expect_grid", "grid": "school_coverage2", "cells": [[0, 0, 3]]},
