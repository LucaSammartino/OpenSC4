    {"op": "residential_init", "expect": true},
    {"op": "residential_tract", "x": 0, "z": 0, "pop": [3000, 0, 0]},
    {"op": "residential_set", "state": {"lists": {"school_groups": [[1]]}}},
    {"op": "residential_set", "state": {"state": 5}},
    {"op": "residential_run_to", "state": 7, "steps": 2},
    {"op": "residential_expect_props", "occupant": 1, "props": {"0x292453C5": 0.5, "0x09220161": 3000}},
