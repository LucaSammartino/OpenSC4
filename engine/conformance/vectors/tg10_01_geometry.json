{
  "format": 1,
  "name": "tgrid_geometry",
  "spec": ["simgrid 3", "simgrid 4.2", "simgrid 10.1"],
  "description": "Tract geometry from a 256-cell city of 16 m cells: shift = times S halves while > 1, counts = cells >> shift, width = 16 x S (S = 3: counts from the shift, width from S), inverse = 1/width. A fresh grid has S = 0 and no tracts; SetTractSize with the current S changes nothing.",
  "steps": [
    {"op": "tg_city", "cells": [256, 256], "width": [16, 16]},
    {"op": "tg_create", "name": "a", "type": "u8"},
    {"op": "tg_call", "grid": "a", "method": "geometry", "expect": {"size": 0, "shift": 0, "count_x": 0, "count_z": 0, "width_x": 0.0, "width_z": 0.0, "inv_width_x": 0.0, "inv_width_z": 0.0}},
    {"op": "tg_call", "grid": "a", "method": "set_tract_size", "args": [2], "expect": true},
    {"op": "tg_call", "grid": "a", "method": "geometry", "expect": {"size": 2, "shift": 1, "count_x": 128, "count_z": 128, "width_x": 32.0, "width_z": 32.0, "inv_width_x": 0.03125, "inv_width_z": 0.03125}},
    {"op": "tg_call", "grid": "a", "method": "set_tract_size", "args": [8]},
    {"op": "tg_call", "grid": "a", "method": "geometry", "expect": {"size": 8, "shift": 3, "count_x": 32, "count_z": 32, "width_x": 128.0, "width_z": 128.0, "inv_width_x": 0.0078125, "inv_width_z": 0.0078125}},
    {"op": "tg_call", "grid": "a", "method": "set_tract_size", "args": [3]},
    {"op": "tg_call", "grid": "a", "method": "geometry", "expect": {"size": 3, "shift": 1, "count_x": 128, "count_z": 128, "width_x": 48.0, "width_z": 48.0, "inv_width_x": 0.02083333395421505, "inv_width_z": 0.02083333395421505}},
    {"op": "tg_call", "grid": "a", "method": "set_tract_size", "args": [4]},
    {"op": "tg_call", "grid": "a", "method": "shift", "expect": 2},
    {"op": "tg_call", "grid": "a", "method": "set_tract_size", "args": [5]},
    {"op": "tg_call", "grid": "a", "method": "shift", "expect": 2},
    {"op": "tg_call", "grid": "a", "method": "count_x", "expect": 64},
    {"op": "tg_call", "grid": "a", "method": "set_tract_size", "args": [1]},
    {"op": "tg_call", "grid": "a", "method": "geometry", "expect": {"size": 1, "shift": 0, "count_x": 256, "count_z": 256, "width_x": 16.0, "width_z": 16.0, "inv_width_x": 0.0625, "inv_width_z": 0.0625}},
    {"op": "tg_call", "grid": "a", "method": "set_tract_size", "args": [0]},
    {"op": "tg_call", "grid": "a", "method": "shift", "expect": 0},
    {"op": "tg_call", "grid": "a", "method": "count_x", "expect": 256},
    {"op": "tg_call", "grid": "a", "method": "count_z", "expect": 256},
    {"op": "tg_call", "grid": "a", "method": "width_x", "expect": 0.0},
    {"op": "tg_call", "grid": "a", "method": "tract_size", "expect": 0},
    {"op": "tg_city", "cells": [64, 32], "width": [16, 8]},
    {"op": "tg_create", "name": "b", "type": "f32", "tract_size": 2},
    {"op": "tg_call", "grid": "b", "method": "geometry", "expect": {"size": 2, "shift": 1, "count_x": 32, "count_z": 16, "width_x": 32.0, "width_z": 16.0, "inv_width_x": 0.03125, "inv_width_z": 0.0625}}
  ]
}
