{
  "format": 1,
  "name": "simgrid_values_and_averages",
  "spec": ["simgrid 4", "simgrid 4.1", "simgrid 4.2", "simgrid 10.4", "simgrid 10.5", "simgrid 10.6", "simgrid 10.7", "simgrid 10.8"],
  "description": "GetCellValue shifts cell coordinates; averages (one-tract shortcut, cell and tract rectangles, truncation toward zero, float grids sum truncated values but return the fractional quotient, int8 sign extension, an empty rectangle gives 0 [choice]); SetTractSize keeps existing values in place.",
  "steps": [
    {"op": "grid_city", "cells": [256, 256], "cell_width": 16},
    {"op": "grid_new", "grid": "a", "type": "u8", "size": 2},
    {"op": "grid_set", "grid": "a", "values": [[2, 3, 9]]},
    {"op": "grid_call", "grid": "a", "method": "cell_value", "args": [5, 7], "expect": 9},
    {"op": "grid_call", "grid": "a", "method": "cell_value", "args": [4, 6], "expect": 9},
    {"op": "grid_call", "grid": "a", "method": "cell_value", "args": [6, 7], "expect": 0},
    {"op": "grid_new", "grid": "b", "type": "u8", "size": 2},
    {"op": "grid_set", "grid": "b", "values": [[0, 0, 10], [1, 0, 20], [0, 1, 30], [1, 1, 41]]},
    {"op": "grid_call", "grid": "b", "method": "average_cell_rect", "args": [0, 0, 2, 2], "expect": 10},
    {"op": "grid_call", "grid": "b", "method": "average_cell_rect", "args": [0, 0, 4, 4], "expect": 25},
    {"op": "grid_call", "grid": "b", "method": "average_tract_rect", "args": [0, 0, 2, 2], "expect": 25},
    {"op": "grid_call", "grid": "b", "method": "average_tract_rect", "args": [0, 0, 0, 2], "expect": 0},
    {"op": "grid_new", "grid": "f", "type": "f32", "size": 1},
    {"op": "grid_set", "grid": "f", "values": [[0, 0, 1.9], [1, 0, 2.9]]},
    {"op": "grid_call", "grid": "f", "method": "average_tract_rect", "args": [0, 0, 2, 1], "expect": 1.5},
    {"op": "grid_new", "grid": "s", "type": "i8", "size": 1},
    {"op": "grid_set", "grid": "s", "values": [[0, 0, -3], [1, 0, 0]]},
    {"op": "grid_call", "grid": "s", "method": "average_tract_rect", "args": [0, 0, 2, 1], "expect": -1},
    {"op": "grid_new", "grid": "u", "type": "u8", "size": 1},
    {"op": "grid_set", "grid": "u", "values": [[0, 0, 255], [1, 0, 0]]},
    {"op": "grid_call", "grid": "u", "method": "average_tract_rect", "args": [0, 0, 2, 1], "expect": 127},
    {"op": "grid_new", "grid": "r", "type": "u8", "size": 2},
    {"op": "grid_set", "grid": "r", "values": [[1, 1, 7]]},
    {"op": "grid_set_tract_size", "grid": "r", "size": 4},
    {"op": "grid_expect_geometry", "grid": "r", "count_x": 64, "count_z": 64},
    {"op": "grid_expect", "grid": "r", "values": [[1, 1, 7], [0, 0, 0], [63, 63, 0]]}
  ]
}
