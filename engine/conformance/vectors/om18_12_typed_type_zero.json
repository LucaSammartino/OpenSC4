{
  "format": 1,
  "name": "om18_12_typed_type_zero",
  "spec": ["occupant-manager 5.3", "occupant-manager 7", "occupant-manager 8.5", "occupant-manager 9.4", "occupant-manager 10", "occupant-manager 18.12"],
  "description": "Type 0 is a null filter for slots 37-46 (all types) but literal for slots 23 and 29-35 (only occupants whose type is 0). A non-zero type is written into the shared filter and stays there.",
  "steps": [
    {"op": "om_create"},
    {"op": "om_call", "method": "set_city_size", "args": [1024, 1024], "expect": true},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_occupant", "occupant": "0x1", "type": "0xA", "min": [10, 0, 10], "max": [20, 1, 20]},
    {"op": "om_occupant", "occupant": "0x2", "type": "0xB", "min": [10, 0, 10], "max": [20, 1, 20]},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x2", "data4": 0, "expect": true},
    {"op": "om_call", "method": "by_standard_cells_typed", "type": 0, "expect": true, "expect_list": ["0x2", "0x1"]},
    {"op": "om_expect", "state": {"filter_type": 0}},
    {"op": "om_call", "method": "first_in_cell_typed", "args": [64, 64], "type": 0, "expect": null},
    {"op": "om_call", "method": "remove_occupants_typed", "type": 0, "expect": true},
    {"op": "om_expect_cell", "cell": [64, 64], "occupants": ["0x2", "0x1"]},
    {"op": "om_call", "method": "by_standard_cells_typed", "type": "0xA", "expect": true, "expect_list": ["0x1"]},
    {"op": "om_expect", "state": {"filter_type": "0xA"}},
    {"op": "om_call", "method": "first_in_cell_typed", "args": [64, 64], "type": "0xB", "expect": "0x2"},
    {"op": "om_expect", "state": {"filter_type": "0xB"}},
    {"op": "om_call", "method": "by_cells_typed", "type": 0, "expect": true, "expect_list": ["0x2", "0x1"]},
    {"op": "om_call", "method": "by_bbox_typed", "type": "0xA", "expect": true, "expect_list": ["0x1"]},
    {"op": "om_occupant", "occupant": "0x3", "type": 0, "min": [10, 0, 10], "max": [20, 1, 20]},
    {"op": "om_call", "method": "insert", "occupant": "0x3", "data4": 0, "expect": true},
    {"op": "om_call", "method": "first_in_cell_typed", "args": [64, 64], "type": 0, "expect": "0x3"},
    {"op": "om_call", "method": "first_by_position_typed", "args": [15, 15], "type": 0, "expect": "0x3"},
    {"op": "om_call", "method": "first_by_standard_cell_typed", "args": [0, 0], "type": 0, "expect": "0x3"},
    {"op": "om_call", "method": "first_by_standard_cells_typed", "min": [0, 0], "max": [1, 1], "type": "0xA", "expect": "0x1"},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "iterate_typed", "type": 0, "expect": true},
    {"op": "om_expect_events", "filter": {"event": "callback"}, "events": [{"event": "callback", "occupant": "0x3"}, {"event": "callback", "occupant": "0x2"}, {"event": "callback", "occupant": "0x1"}]},
    {"op": "om_call", "method": "iterate_by_bbox_typed", "min": [0, -5, 0], "max": [30, 5, 30], "type": "0xB", "expect": true},
    {"op": "om_expect_events", "filter": {"event": "callback"}, "events": [{"event": "callback", "occupant": "0x2"}]},
    {"op": "om_call", "method": "iterate_by_standard_cells_typed", "type": "0xA", "expect": true},
    {"op": "om_expect_events", "filter": {"event": "callback"}, "events": [{"event": "callback", "occupant": "0x1"}]},
    {"op": "om_call", "method": "remove_occupants_typed", "type": 0, "expect": true},
    {"op": "om_expect_cell", "cell": [64, 64], "occupants": ["0x2", "0x1"]},
    {"op": "om_expect_occupant", "occupant": "0x3", "state": {"flags": 0}}
  ]
}
