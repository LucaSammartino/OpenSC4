{
  "format": 1,
  "name": "effects_one_shot_crater",
  "spec": ["effects 8.2", "effects 17"],
  "description": "meteorcrater_b (one-shot crater brush, rate 2, level 3, strength 6, radius 0.7): the first tick deactivates the brush, then applies it trunc(rate) = 2 times at the same point, data4 3, redisplay on the last call only, with no long terrain operation; nothing on the next tick.",
  "steps": [
    {"op": "ef_create", "directory": "volcano"},
    {"op": "ef_effect", "name": "meteorcrater_b", "as": "M", "expect": true},
    {"op": "ef_call", "method": "set_position", "effect": "M", "args": [320, 0, 480], "expect": true},
    {"op": "ef_call", "method": "start", "effect": "M", "expect": true},
    {"op": "ef_clear_events"},
    {"op": "ef_call", "method": "tick", "args": [33333]},
    {"op": "ef_expect_events", "events": [{"event": "brush", "brush": "0x8A33E17A", "from": [320, 480], "to": [320, 480], "level": 3, "strength": 6.0, "radius": 0.7, "redisplay": false, "data4": 3, "target": 100.0}, {"event": "brush", "brush": "0x8A33E17A", "from": [320, 480], "to": [320, 480], "level": 3, "strength": 6.0, "radius": 0.7, "redisplay": true, "data4": 3, "target": 100.0}]},
    {"op": "ef_expect_brush", "effect": "M", "state": {"active": false, "long_op": false}},
    {"op": "ef_call", "method": "tick", "args": [33333]},
    {"op": "ef_expect_events", "events": []}
  ]
}
