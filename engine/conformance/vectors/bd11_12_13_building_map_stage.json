{
  "format": 1,
  "name": "bds_building_map_and_highest_stage",
  "spec": ["building-development 3.2", "building-development 4.10", "building-development 11.12", "building-development 11.13"],
  "description": "Tests 12 and 13, by hand from 3.2 and 4.10 (cell width 16). Test 12: lot 1 = 2 x 2 at (10, 10)-(11, 11) with building 0x2000 (purpose 3, wealth 2); StateChanged old 1 -> new 3, data4 = 2: the 4 cells become 4*3 + 2 + 1 = 15 (a neighbouring cell stays 0); old 3 -> new 4: 0; old 2 -> new 3 (both occupied): no change. The key uses data4, not the profile wealth: data4 = 1 writes 14. A lot whose building type is 0 is ignored; a building type unknown to the catalogue gets a zero profile (purpose 0) -> key 0 + 2 + 1 = 3 and no stage event. Test 13: building 0x1100 (purpose 1, wealth 2 -> developer type 0x1020) on lot 2 (stage 3, building occupant 50 at (168, 0, 200)): the first occupied lot -> highestStage[0x1020] = 3 and one advisor event (advisor 0x17, event 0x4A64A9CC, null subject); the discarded subject has x = 168/16 = 10.5, z = 200/16 = 12.5, lot 2, data1 = 3 << 24 | 0x1020 = 0x03001020. Lot 3 (stage 3) -> no event; lot 4 (stage 4) -> event, data1 0x04001020, highestStage 4. data4 = 3 != profile wealth 2 -> map key 8, no event. A lot without a growth stage or without a building -> no event and highestStage untouched.",
  "steps": [
    {"op": "bds_process", "seed": 1},
    {"op": "bds_exemplars", "list": [
      {"building": "0x2000", "purpose": 3, "wealth": 2},
      {"building": "0x1100", "purpose": 1, "wealth": 2}]},
    {"op": "bds_create"},
    {"op": "bds_init", "expect": true},
    {"op": "bds_lots", "lots": [
      {"id": 1, "building_type": "0x2000", "rect": [10, 10, 11, 11], "stage": null, "building": null},
      {"id": 2, "building_type": "0x1100", "rect": [20, 20, 20, 20], "stage": 3, "building": 50},
      {"id": 3, "building_type": "0x1100", "rect": [21, 20, 21, 20], "stage": 3, "building": 51},
      {"id": 4, "building_type": "0x1100", "rect": [22, 20, 22, 20], "stage": 4, "building": 52},
      {"id": 5, "building_type": "0x1100", "rect": [23, 20, 23, 20], "stage": 7, "building": null},
      {"id": 6, "building_type": "0x1100", "rect": [24, 20, 24, 20], "stage": null, "building": 53},
      {"id": 7, "building_type": 0, "rect": [25, 20, 25, 20]},
      {"id": 8, "building_type": "0x9999", "rect": [26, 20, 26, 20], "stage": 9, "building": 54}]},
    {"op": "bds_occupants", "list": [
      {"id": 50, "pos": [168, 0, 200]}, {"id": 51, "pos": [16, 0, 16]}, {"id": 52, "pos": [40, 5, 8]}]},
    {"op": "bds_clear_events"},

    {"op": "bds_message", "type": "StateChanged", "lot": 1, "data1": 1, "data2": 3, "data4": 2, "expect": true},
    {"op": "bds_expect_map", "cells": [[10, 10, 15], [11, 10, 15], [10, 11, 15], [11, 11, 15], [12, 11, 0], [9, 10, 0]]},
    {"op": "bds_message", "type": "StateChanged", "lot": 1, "data1": 3, "data2": 4, "data4": 2},
    {"op": "bds_expect_map", "cells": [[10, 10, 0], [11, 10, 0], [10, 11, 0], [11, 11, 0]]},
    {"op": "bds_message", "type": "StateChanged", "lot": 1, "data1": 0, "data2": 2, "data4": 1},
    {"op": "bds_expect_map", "cells": [[10, 10, 14], [11, 11, 14]]},
    {"op": "bds_message", "type": "StateChanged", "lot": 1, "data1": 2, "data2": 3, "data4": 2},
    {"op": "bds_expect_map", "cells": [[10, 10, 14], [11, 11, 14]]},
    {"op": "bds_message", "type": "StateChanged", "lot": 1, "data1": 4, "data2": 1, "data4": 2},
    {"op": "bds_expect_map", "cells": [[10, 10, 14], [11, 11, 14]]},
    {"op": "bds_message", "type": "StateChanged", "data1": 1, "data2": 3, "data4": 2, "expect": true},
    {"op": "bds_message", "type": "StateChanged", "lot": 7, "data1": 1, "data2": 3, "data4": 2},
    {"op": "bds_expect_map", "cells": [[25, 20, 0]]},
    {"op": "bds_message", "type": "StateChanged", "lot": 8, "data1": 1, "data2": 3, "data4": 2},
    {"op": "bds_expect_map", "cells": [[26, 20, 3]]},
    {"op": "bds_call", "method": "profile_ptr", "args": ["0x9999"], "expect": {"purpose": 0, "wealth": 0, "capacity": 0, "size": [0, 0, 0]}},
    {"op": "bds_expect_events", "events": []},
    {"op": "bds_expect", "state": {"highest_stage": {}}},

    {"op": "bds_message", "type": "StateChanged", "lot": 2, "data1": 1, "data2": 3, "data4": 2},
    {"op": "bds_expect_map", "cells": [[20, 20, 7]]},
    {"op": "bds_expect_events", "events": [
      {"event": "advisor_event", "advisor": 23, "id": "0x4A64A9CC", "subject": null,
        "discarded": {"x": 10.5, "z": 12.5, "lot": 2, "data1": "0x03001020"}}]},
    {"op": "bds_expect", "state": {"highest_stage": {"0x1020": 3}}},
    {"op": "bds_clear_events"},
    {"op": "bds_message", "type": "StateChanged", "lot": 3, "data1": 1, "data2": 2, "data4": 2},
    {"op": "bds_expect_events", "events": []},
    {"op": "bds_expect", "state": {"highest_stage": {"0x1020": 3}}},
    {"op": "bds_message", "type": "StateChanged", "lot": 4, "data1": 1, "data2": 3, "data4": 2},
    {"op": "bds_expect_events", "events": [
      {"event": "advisor_event", "advisor": 23, "id": "0x4A64A9CC",
        "discarded": {"x": 2.5, "z": 0.5, "lot": 4, "data1": "0x04001020"}}]},
    {"op": "bds_expect", "state": {"highest_stage": {"0x1020": 4}}},
    {"op": "bds_clear_events"},
    {"op": "bds_lots", "lots": [{"id": 3, "stage": 6}]},
    {"op": "bds_message", "type": "StateChanged", "lot": 3, "data1": 0, "data2": 3, "data4": 3},
    {"op": "bds_expect_map", "cells": [[21, 20, 8]]},
    {"op": "bds_message", "type": "StateChanged", "lot": 5, "data1": 0, "data2": 3, "data4": 2},
    {"op": "bds_message", "type": "StateChanged", "lot": 6, "data1": 0, "data2": 3, "data4": 2},
    {"op": "bds_expect_map", "cells": [[23, 20, 7], [24, 20, 7]]},
    {"op": "bds_expect_events", "events": []},
    {"op": "bds_expect", "state": {"highest_stage": {"0x1020": 4}}},

    {"op": "bds_call", "method": "building_changed", "args": [3, 2, true]},
    {"op": "bds_expect_events", "events": [
      {"event": "advisor_event", "advisor": 23, "discarded": {"x": 1.0, "z": 1.0, "lot": 3, "data1": "0x06001020"}}]},
    {"op": "bds_expect", "state": {"highest_stage": {"0x1020": 6}}},
    {"op": "bds_call", "method": "building_changed", "args": [3, 2, false]},
    {"op": "bds_expect_map", "cells": [[21, 20, 0]]}
  ]
}
