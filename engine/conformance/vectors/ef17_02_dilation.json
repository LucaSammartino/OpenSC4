{
  "format": 1,
  "name": "effects_dilation",
  "spec": ["effects 7", "effects 17"],
  "description": "The tick scales the elapsed microseconds by the simulator's dilation (slot 32) and truncates: with 1.5 the same stroke applies 1, 1, 2, 1, 2 ... and ends on tick 61 after 91 applications; at 100000 us and dilation 1 it applies 3 per tick, 31 ticks, 93 applications. Without a simulator the time is not scaled.",
  "steps": [
    {"op": "ef_env", "dilation": 1.5},
    {"op": "ef_create", "directory": {"effects": [{"name": "stroke", "components": [{"type": "brush", "index": 2}]}]}},
    {"op": "ef_effect", "name": "stroke", "as": "S", "expect": true},
    {"op": "ef_call", "method": "set_position", "effect": "S", "args": [100, 0, 100], "expect": true},
    {"op": "ef_call", "method": "start", "effect": "S", "expect": true},
    {"op": "ef_run_stroke", "effect": "S", "us": 33333, "ticks": 61, "applications": 91, "first": [1, 1, 2, 1, 2]},
    {"op": "ef_env", "dilation": 1.0},
    {"op": "ef_create", "directory": {"effects": [{"name": "stroke", "components": [{"type": "brush", "index": 2}]}]}},
    {"op": "ef_effect", "name": "stroke", "as": "S", "expect": true},
    {"op": "ef_call", "method": "set_position", "effect": "S", "args": [100, 0, 100], "expect": true},
    {"op": "ef_call", "method": "start", "effect": "S", "expect": true},
    {"op": "ef_run_stroke", "effect": "S", "us": 100000, "ticks": 31, "applications": 93, "every": 3},
    {"op": "ef_env", "dilation": 1.5},
    {"op": "ef_create"},
    {"op": "ef_call", "method": "tick", "args": [33333]},
    {"op": "ef_expect_manager", "state": {"total_us": 49999}},
    {"op": "ef_env", "dilation": null},
    {"op": "ef_call", "method": "tick", "args": [10]},
    {"op": "ef_expect_manager", "state": {"total_us": 50009}}
  ]
}
