{
  "format": 1,
  "name": "tn11_02_subnetworks",
  "spec": [
    "traffic-network 4.11",
    "traffic-network 4.12",
    "traffic-network 11.2"
  ],
  "description": "Conformance test 2 (§11) on test 1's network. Labels after DoPostCityInit: A [0,0,1,0], B [1,0,1,0], C [1,0,0,0]; counter 2; working and published vectors of size 2. After a clear, a seed at A with entry 0 labels nothing and does not advance the counter.",
  "steps": [
    {
      "op": "tn_env",
      "cells": [
        4,
        4
      ],
      "tuning": "shipped"
    },
    {
      "op": "tn_init"
    },
    {
      "op": "tn_occupant",
      "id": 1,
      "cell": [
        1,
        1
      ],
      "types": [
        3
      ],
      "turns": [
        2
      ],
      "note": "A: no car connections, turn-around at entry 2"
    },
    {
      "op": "tn_occupant",
      "id": 2,
      "cell": [
        2,
        1
      ],
      "types": [
        3
      ],
      "conns": [
        [
          0,
          2
        ],
        [
          2,
          0
        ]
      ],
      "note": "B: (0 -> 2) and (2 -> 0)"
    },
    {
      "op": "tn_occupant",
      "id": 3,
      "cell": [
        3,
        1
      ],
      "types": [
        3
      ],
      "turns": [
        0
      ],
      "note": "C: turn-around at entry 0"
    },
    {
      "op": "tn_call",
      "method": "occupant_changed",
      "args": [
        1
      ]
    },
    {
      "op": "tn_call",
      "method": "occupant_changed",
      "args": [
        2
      ]
    },
    {
      "op": "tn_call",
      "method": "occupant_changed",
      "args": [
        3
      ]
    },
    {
      "op": "tn_call",
      "method": "do_post_city_init"
    },
    {
      "op": "tn_expect_cell",
      "cell": [
        1,
        1
      ],
      "expect": {
        "car": {
          "subnet": [
            0,
            0,
            1,
            0
          ]
        }
      }
    },
    {
      "op": "tn_expect_cell",
      "cell": [
        2,
        1
      ],
      "expect": {
        "car": {
          "subnet": [
            1,
            0,
            1,
            0
          ]
        }
      }
    },
    {
      "op": "tn_expect_cell",
      "cell": [
        3,
        1
      ],
      "expect": {
        "car": {
          "subnet": [
            1,
            0,
            0,
            0
          ]
        }
      }
    },
    {
      "op": "tn_expect_state",
      "state": {
        "subnet_counter": 2,
        "working_len": 2,
        "published_len": 2
      }
    },
    {
      "op": "tn_call",
      "method": "clear_subnetworks"
    },
    {
      "op": "tn_call",
      "method": "fill",
      "args": [
        1,
        1,
        0
      ],
      "note": "A has no car bit 0..3 (entry 0)"
    },
    {
      "op": "tn_expect_state",
      "state": {
        "subnet_counter": 1
      }
    },
    {
      "op": "tn_expect_cell",
      "cells": [
        [
          1,
          1
        ],
        [
          2,
          1
        ],
        [
          3,
          1
        ]
      ],
      "expect": {
        "car": {
          "subnet": [
            0,
            0,
            0,
            0
          ]
        }
      }
    }
  ]
}
