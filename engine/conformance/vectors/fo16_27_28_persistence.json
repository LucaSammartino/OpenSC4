    {"op": "flora_patch", "slot": "a", "offset": 0, "hex": "0300"},
    {"op": "flora_read", "slot": "a", "expect": false, "consumed": 2},
    {"op": "flora_expect", "state": {"burn_accumulator": 1.5, "today": 0}},
