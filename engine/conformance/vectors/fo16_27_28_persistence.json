      "size": [1024, 1024], "cells": [64, 64], "iterator": {"mode": 0, "count": 1024, "table_len": 1024, "rect": [0, 0, 31, 31]}}},
    {"op": "flora_expect_refs", "refs": {"1": 3, "2": 3}},
