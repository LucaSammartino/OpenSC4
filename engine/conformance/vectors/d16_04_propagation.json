{
  "format": 1,
  "name": "demand_propagation",
  "spec": ["demand 4.1", "demand 4.2", "demand 4.3", "demand 4.4", "demand 16.4"],
  "description": "Graph building and DoDemandIndexLinks on a small graph with one link of each type. Only exemplars with ExemplarType 3 become nodes (any group); property 0x21 overrides the key; two exemplars with one key both apply (later min/max win, links accumulate). Drives/Satisfies/Contributes move pending * factor and drop transfers <= 0.01 (1.0 * 1 % is dropped); Caps sets min(1, demand / max(0.01, supply)) from committed values; Sums converges to the sum of committed values and forwards the change of the sum through its own links; a delta to a lower key settles on a later pass; every node posts once per pass; a link to a missing node is ignored with one warning [choice].",
  "steps": [
    {"op": "demand_exemplar", "instance": "0x0500", "min": -1000, "max": 1000},
    {"op": "demand_exemplar", "instance": "0x0800", "drives": [["0x0900", 1]]},
    {"op": "demand_exemplar", "instance": "0x0900"},
    {"op": "demand_exemplar", "instance": "0x0A00"},
    {"op": "demand_exemplar", "instance": "0x9999", "key": "0x0B00"},
    {"op": "demand_exemplar", "instance": "0x0600", "exemplar_type": 4},
    {"op": "demand_exemplar", "instance": "0x1000", "satisfies": [["0x3000", 200]], "drives": [["0x2000", 50], ["0xDEAD", 10]],
      "contributes": [["0x4000", 100]], "caps": ["0x5000"]},
    {"op": "demand_exemplar", "instance": "0x2000"},
    {"op": "demand_exemplar", "instance": "0x3000"},
    {"op": "demand_exemplar", "instance": "0x4000"},
    {"op": "demand_exemplar", "instance": "0x5000"},
    {"op": "demand_exemplar", "instance": "0x6000", "drives": [["0x0500", 100]], "sums": ["0x2000", "0x3000"]},
    {"op": "demand_exemplar", "group": "0x12345678", "instance": "0x0500", "min": -4000, "max": 4000},
    {"op": "demand_exemplar", "group": "0x12345678", "instance": "0x0800", "satisfies": [["0x0A00", 2]]},

    {"op": "demand_create"},
    {"op": "demand_init", "expect": true},
    {"op": "demand_expect", "state": {"initialized": true, "census_state": 3,
      "node_keys": ["0x500", "0x800", "0x900", "0xA00", "0xB00", "0x1000", "0x2000", "0x3000", "0x4000", "0x5000", "0x6000"],
      "link_count": 10}},
    {"op": "demand_expect_node", "key": "0x0B00", "state": {"id": "0xB00"}},
    {"op": "demand_expect_node", "key": "0x0500", "state": {"active_min": -4000, "active_max": 4000}},
    {"op": "demand_expect_event_count", "filter": {"event": "post"}, "count": 11},
    {"op": "demand_expect_event_count", "filter": {"event": "warn"}, "count": 1},
    {"op": "demand_clear_events"},

    {"op": "demand_node", "key": "0x1000", "method": "add_to_supply", "args": [1000]},
    {"op": "demand_node", "key": "0x1000", "method": "add_to_demand", "args": [300]},
    {"op": "demand_call", "method": "propagate"},
    {"op": "demand_expect_event_count", "filter": {"event": "post"}, "count": 33},
    {"op": "demand_expect_event_count", "filter": {"event": "warn"}, "count": 0},
    {"op": "demand_expect_events", "filter": {"event": "post", "key": "0x0500"}, "events": [{"data2": 0}, {"data2": 0}, {"data2": 500}]},
    {"op": "demand_expect_node", "key": "0x1000", "state": {"supply": 1000, "demand": 300, "new_supply": 0, "new_demand": 0}},
    {"op": "demand_expect_node", "key": "0x2000", "state": {"supply": 0, "demand": 500}},
    {"op": "demand_expect_node", "key": "0x3000", "state": {"supply": 2000, "demand": 0}},
    {"op": "demand_expect_node", "key": "0x4000", "state": {"supply": 0, "demand": 300}},
    {"op": "demand_expect_node", "key": "0x5000", "state": {"demand_cap": 0.3}},
    {"op": "demand_expect_node", "key": "0x6000", "state": {"supply": 2000, "demand": 500, "new_supply": 0, "new_demand": 0}},
    {"op": "demand_expect_node", "key": "0x0500", "state": {"demand": 2000, "active_demand": 2000}},

    {"op": "demand_node", "key": "0x0800", "method": "add_to_supply", "args": [1]},
    {"op": "demand_node", "key": "0x1000", "method": "add_to_demand", "args": [800]},
    {"op": "demand_call", "method": "propagate"},
    {"op": "demand_expect_event_count", "filter": {"event": "post"}, "count": 22},
    {"op": "demand_expect_event_count", "filter": {"event": "warn"}, "count": 0},
    {"op": "demand_clear_events"},
    {"op": "demand_expect_node", "key": "0x0800", "state": {"supply": 1}},
    {"op": "demand_expect_node", "key": "0x0900", "state": {"demand": 0}},
    {"op": "demand_expect_node", "key": "0x0A00", "state": {"supply": 0.02}},
    {"op": "demand_expect_node", "key": "0x4000", "state": {"demand": 1100}},
    {"op": "demand_expect_node", "key": "0x5000", "state": {"demand_cap": 1.0}},
    {"op": "demand_expect_node", "key": "0x6000", "state": {"supply": 2000, "demand": 500}},

    {"op": "demand_node", "key": "0x3000", "method": "add_to_supply", "args": [-500]},
    {"op": "demand_call", "method": "propagate"},
    {"op": "demand_expect_node", "key": "0x6000", "state": {"supply": 1500, "demand": 500}},
    {"op": "demand_expect_node", "key": "0x0500", "state": {"demand": 1500}},

    {"op": "demand_call", "method": "get_demand", "args": ["0x1000", 0], "expect": true},
    {"op": "demand_call", "method": "get_demand", "args": ["0x1000", "0x10000"], "expect": false},
    {"op": "demand_call", "method": "get_demand", "args": ["0x0600", 0], "expect": false},
    {"op": "demand_call", "method": "simulator_type", "expect": "0x279681D7"}
  ]
}
