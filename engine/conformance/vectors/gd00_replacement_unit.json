{
  "format": 1,
  "name": "growth_developer_replacement_unit",
  "spec": ["growth-developer 1.1", "growth-developer 10.1", "growth-developer 12", "building-development 1.5"],
  "description": "The operations the BDS's developer creation uses, one method each (module docs, 'Replacement unit'): creation takes the BDS's reference (constructor + AddRef, count 1) and Init with the developer exemplar; GetSubType and GetPurpose; GrowthAndDeclineListsAreValid; the lists as owned copies equal to the in-place lists; GetSourceDemand().QueryActiveDemandValue() (none without a source node, the node's value otherwise); StartMapUpdate and IsMapUpdateFinished; a save reference that loads back as a growth developer (class 0x0990C138, count 0, not initialised). Same world as gd14_08 (hand-derived lists from that vector).",
  "steps": [
    {"op": "gdev_env", "cells": [8, 8], "zones": [{"x": 0, "z": 0, "w": 8, "d": 8, "zone": 1}], "max_capacity": {"1": 1.0}, "demand": [{"id": "0x1010", "index": "0x20000", "label": "src", "active": 12.5}]},
    {"op": "gdev_source", "map": "park", "size": 4, "tracts": [[0, 0, 60], [0, 1, 70], [1, 0, 60], [1, 1, 40]]},
    {"op": "gdev_create", "label": "bare"},
    {"op": "gdev_expect", "dev": "bare", "state": {"ref_count": 1, "initialized": false}},
    {"op": "gdev_call", "dev": "bare", "method": "source_active_demand", "expect": null},
    {"op": "gdev_create", "label": "dev"},
    {"op": "gdev_init", "dev": "dev", "props": {"0x00000021": {"u32": "0x1010"}, "0x87CD6300": {"u8": 1}, "0x87CD6301": {"u32": "0x1010"}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 1}, "0x87CD6332": {"u8": 1}, "0x87CD6357": {"i32": 0}, "0x87CD6355": {"i32": 50}, "0x87CD6354": {"i32": 50}, "0x87CD6341": {"f32": [-40000, -40000, 40000, 40000]}, "0x87CD6360": {"u8": 2}, "0x87CD6361": {"f32": [0, 50]}, "0x87CD6362": {"f32": [0, 40]}}, "expect": true},
    {"op": "gdev_expect", "dev": "dev", "state": {"ref_count": 1, "initialized": true}},
    {"op": "gdev_call", "dev": "dev", "method": "sub_type", "expect": "0x1010"},
    {"op": "gdev_call", "dev": "dev", "method": "purpose", "expect": 1},
    {"op": "gdev_call", "dev": "dev", "method": "source_demand", "expect": "src"},
    {"op": "gdev_clear_events"},
    {"op": "gdev_call", "dev": "dev", "method": "source_active_demand", "expect": 12.5},
    {"op": "gdev_expect_events", "filter": {"event": "active_demand"}, "events": [{"event": "active_demand", "node": "src"}]},
    {"op": "gdev_message", "dev": "dev", "type": "ZoningChange", "rect": [0, 0, 7, 7]},
    {"op": "gdev_call", "dev": "dev", "method": "lists_valid", "expect": true},
    {"op": "gdev_call", "dev": "dev", "method": "is_map_update_finished", "expect": true},
    {"op": "gdev_call", "dev": "dev", "method": "start_map_update"},
    {"op": "gdev_call", "dev": "dev", "method": "is_map_update_finished", "expect": false},
    {"op": "gdev_idle", "dev": "dev", "count": 20},
    {"op": "gdev_call", "dev": "dev", "method": "is_map_update_finished", "expect": true},
    {"op": "gdev_call", "dev": "dev", "method": "lists_valid", "expect": true},
    {"op": "gdev_call", "dev": "dev", "method": "growth_items", "expect": [[0, 1, 2], [0, 0, 2], [1, 0, 1]]},
    {"op": "gdev_call", "dev": "dev", "method": "decline_items", "expect": [[1, 1, 1]]},
    {"op": "gdev_call", "dev": "dev", "method": "growth_list", "expect": [[0, 1, 2], [0, 0, 2], [1, 0, 1]]},
    {"op": "gdev_call", "dev": "dev", "method": "decline_list", "expect": [[1, 1, 1]]},
    {"op": "gdev_save", "dev": "dev", "slot": "s"},
    {"op": "gdev_load", "slot": "s", "label": "loaded"},
    {"op": "gdev_expect", "dev": "loaded", "state": {"ref_count": 0, "initialized": false}}
  ]
}
