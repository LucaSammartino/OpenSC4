{
  "format": 1,
  "name": "protection_crime_event",
  "spec": ["protection 9.2", "protection 9.3", "protection 18.13"],
  "description": "Test 13 (police, shipped arrest threshold 20): a crime message whose IGZUnknown is a lot at cell (2,2) reads the adjusted grid there (tract (1,1)); the nearest station to the cell centre (40, 40) m is station 1. Value 21 > 20: arrest (arrestsThisMonth 1, station vector [0,0,1,1]); a lot at cell (32,32) near station 2 with value 20: unarrested (+1, station 2 [0,0,1,0]); crimesThisMonth 2. A message whose unknown is not a lot is ignored [choice]. ProcessMonthlyCrimeStats with 3 arrests this month and jailed 10: jailed 13, arrestsLast 3, crimesLast 2, history 0x0A5CC155 = 2 then 0x0A5CC156 = 3, vectors shifted to [1,1,0,0] and [1,0,0,0]; slots 43/44 read [1] and [0]; returns true [choice]. Hand-derived.",
  "steps": [
    {"op": "protection_create", "kind": "police"},
    {"op": "protection_env", "tuning": "shipped", "lots": {"500": [2, 2], "501": [32, 32]}},
    {"op": "protection_init"},
    {"op": "protection_occupants", "1": {"station": ["police", 50, 10, 64, 1], "pos": [40, 0, 40]}, "2": {"station": ["police", 50, 10, 64, 1], "pos": [520, 0, 520]}},
    {"op": "protection_message", "type": "OccupantInserted", "occupant": 1},
    {"op": "protection_message", "type": "OccupantInserted", "occupant": 2},
    {"op": "protection_grid_set", "grid": "adjusted", "cells": [[1, 1, 21], [16, 16, 20]]},
    {"op": "protection_clear_events"},
    {"op": "protection_message", "type": "Crime", "unknown": 500, "expect": true},
    {"op": "protection_expect", "state": {"arrests_this": 1, "unarrested_this": 0, "crimes_this": 1}},
    {"op": "protection_expect_occupant", "id": 1, "props": {"0x8A70A0B9": [0, 0, 1, 1]}},
    {"op": "protection_message", "type": "Crime", "unknown": 501},
    {"op": "protection_expect", "state": {"arrests_this": 1, "unarrested_this": 1, "crimes_this": 2}},
    {"op": "protection_expect_occupant", "id": 2, "props": {"0x8A70A0B9": [0, 0, 1, 0]}},
    {"op": "protection_message", "type": "Crime", "unknown": 999},
    {"op": "protection_expect", "state": {"crimes_this": 2}},
    {"op": "protection_expect_events", "events": []},
    {"op": "protection_set", "state": {"arrests_this": 3, "jailed": 10}},
    {"op": "protection_call", "method": "process_monthly_crime_stats", "expect": true},
    {"op": "protection_expect", "state": {"jailed": 13, "arrests_last": 3, "arrests_this": 0, "crimes_last": 2, "crimes_this": 0}},
    {"op": "protection_expect_events", "events": [{"event": "history", "series": "0x0A5CC155", "value": 2}, {"event": "history", "series": "0x0A5CC156", "value": 3}]},
    {"op": "protection_expect_occupant", "id": 1, "props": {"0x8A70A0B9": [1, 1, 0, 0]}},
    {"op": "protection_expect_occupant", "id": 2, "props": {"0x8A70A0B9": [1, 0, 0, 0]}},
    {"op": "protection_call", "method": "station_arrest_count", "args": [1], "expect": 1},
    {"op": "protection_call", "method": "station_crime_count", "args": [1], "expect": 1},
    {"op": "protection_call", "method": "station_arrest_count", "args": [2], "expect": 0},
    {"op": "protection_call", "method": "arrest_count", "expect": 3},
    {"op": "protection_call", "method": "criminal_count", "expect": 13}
  ]
}
