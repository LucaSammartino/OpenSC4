    {"op": "residential_expect", "state": {"city_started": false, "state": 0, "population_size": 4, "departments": [null, null, null, null]}},
    {"op": "residential_expect_refs", "refs": {"900": 0, "901": 0, "902": 0, "903": 0}},
    {"op": "residential_read", "slot": "a", "patch": [{"offset": 230, "hex": "0F000000"}], "expect": true},
    {"op": "residential_expect", "state": {"state": 15, "city_started": true}},
    {"op": "residential_read", "slot": "a", "patch": [{"offset": 30, "hex": "00010000"}], "expect": true},
