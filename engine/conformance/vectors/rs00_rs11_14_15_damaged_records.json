    {"op": "residential_read", "slot": "a", "patch": [{"offset": 66, "hex": "06000000"}], "expect": false},
    {"op": "residential_expect", "state": {"city_started": false, "state": 0, "population_size": 4, "departments": [null, null, null, null]}},
    {"op": "residential_read", "slot": "a", "patch": [{"offset": 66, "hex": "08000000"}], "expect": false},
    {"op": "residential_expect", "state": {"city_started": false, "state": 0, "population_size": 4, "departments": [null, null, null, null]}},
    {"op": "residential_read", "slot": "a", "patch": [{"offset": 126, "hex": "04000000"}], "expect": false},
    {"op": "residential_expect", "state": {"city_started": false, "state": 0, "population_size": 4, "departments": [null, null, null, null]}},
    {"op": "residential_read", "slot": "a", "patch": [{"offset": 357, "hex": "06000000"}], "expect": false},
    {"op": "residential_expect", "state": {"city_started": false, "state": 0, "population_size": 4, "departments": [null, null, null, null]}},
    {"op": "residential_read", "slot": "a", "patch": [{"offset": 389, "hex": "02000000"}], "expect": false},
    {"op": "residential_expect", "state": {"city_started": false, "state": 0, "population_size": 4, "departments": [null, null, null, null]}},
    {"op": "residential_read", "slot": "a", "patch": [{"offset": 230, "hex": "10000000"}], "expect": false},
    {"op": "residential_expect", "state": {"city_started": false, "state": 0, "population_size": 4, "departments": [null, null, null, null]}},
    {"op": "residential_read", "slot": "a", "patch": [{"offset": 30, "hex": "00000000"}], "expect": false},
