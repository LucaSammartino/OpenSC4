{
  "format": 1,
  "name": "effects_select_draw",
  "spec": ["effects 5.3", "effects 10.1", "effects 17"],
  "description": "The select generator is seeded with 0x1105 (first word 0xAAE64AC3); RandomUint32Uniform(0x10000) gives 43750, 24188, 47502, 45072, 37594, 53135, which over the volcano weights (7281 x 8, 7287) pick creators 7, 4, 7, 7, 6, 8: a fresh manager's first volcano_control builds only volcanocreator4a (and its attractor; rate 65, length 3, radius 1), and the next five follow the draws.",
  "steps": [
    {"op": "ef_select", "first_word": "0xAAE64AC3"},
    {"op": "ef_select", "draws": [43750, 24188, 47502, 45072, 37594, 53135], "weights": [7281, 7281, 7281, 7281, 7281, 7281, 7281, 7281, 7287], "members": [7, 4, 7, 7, 6, 8]},
    {"op": "ef_create", "directory": "volcano"},
    {"op": "ef_effect", "name": "volcano_control", "as": "V", "expect": true},
    {"op": "ef_expect", "effect": "V", "state": {"components": 2}},
    {"op": "ef_child", "effect": "V", "name": "volcanocreator4a", "as": "C"},
    {"op": "ef_expect_brush", "effect": "C", "state": {"rate": 65.0, "length": 3.0, "radius": 1.0}},
    {"op": "ef_expect_manager", "state": {"select_draws": 1}},
    {"op": "ef_effect", "name": "volcano_control", "as": "V0"},
    {"op": "ef_child", "effect": "V0", "name": "volcanocreator2b"},
    {"op": "ef_effect", "name": "volcano_control", "as": "V1"},
    {"op": "ef_child", "effect": "V1", "name": "volcanocreator4a"},
    {"op": "ef_effect", "name": "volcano_control", "as": "V2"},
    {"op": "ef_child", "effect": "V2", "name": "volcanocreator4a"},
    {"op": "ef_effect", "name": "volcano_control", "as": "V3"},
    {"op": "ef_child", "effect": "V3", "name": "volcanocreator3b"},
    {"op": "ef_effect", "name": "volcano_control", "as": "V4"},
    {"op": "ef_child", "effect": "V4", "name": "volcanocreator4b"},
    {"op": "ef_expect_manager", "state": {"select_draws": 6}}
  ]
}
