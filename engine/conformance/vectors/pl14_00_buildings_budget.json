{
  "format": 1,
  "name": "plumbing_buildings_budget",
  "spec": ["plumbing 5.3", "plumbing 6.7", "plumbing 10.1"],
  "description": "Buildings (5.3) and the end-of-pass costs (6.7), hand-derived. A producer with a budget item (department 0xAA4014B4, line 0, cost 100, index 3) and building type 0x5000: the line is changed to the building type and re-read; the department has no line 0x5000, so it is created for the building type (not locally funded) and gets display flag 2; expenses +100, secondary info 0 + 1 = 1; base cost 0x2A58D350 := 100 (int64); a producer record (push_front) with its lot rect, flags 0x20 over the lot, condition 0. A second building on the same line finds the line item (no creation): +40, secondary 2. A consumer with consumption 300 sets 0x40 and demand 300; a second consumer in the same cell adds 50, and removing it clears 0x40 for the whole cell [quirk] (demand 300); re-inserting the house sets it again (demand 600: demand is a running sum, the pass reads the cell's occupants, so the annex's consumption is then set to 0 in the world). End of pass: totalWaterCost += trunc(used 300 x 0.5) = 150; maintenance curve (0,1)(100,2) at condition 0 -> 1 x 100 = 100 = the item cost -> nothing; at condition 50 -> trunc(1.5 x 100) = 150 -> AddToFullExpenses(150 - 100 = 50) and ChangeBudgetItemCost(index 3, 150); totalWaterCost 300. Removal: expenses -150, secondary 1, base cost 150, the producer released and its 0x20 cleared (the pipe bit stays: 0x10). A budget item of an unknown department skips the line-item steps but still writes the base cost ([choice]). A producer whose anchor has no lot leaks its reference and record [quirk]: listed as leaked, not a water source, recompute not set.",
  "steps": [
    {"op": "plumbing_env", "water": [[0, 0]]},
    {"op": "plumbing_create"},
    {"op": "plumbing_init"},
    {"op": "plumbing_message", "type": "ConnectionsReady"},
    {"op": "plumbing_pipe", "label": "p", "x": 10, "z": 10},
    {"op": "plumbing_idle", "count": 20},
    {"op": "plumbing_clear_events"},
    {"op": "plumbing_building", "label": "pump", "x": 10, "z": 10, "w": 2, "building_type": "0x5000",
      "budget": {"department": "0xAA4014B4", "line": 0, "cost": 100, "index": 3},
      "props": {"0x88ED3303": {"u32": 1000}, "0x0911E2E7": {"f32": [0, 1, 100, 2]}, "0xEA1E3C53": {"f32": 0.5}}},
    {"op": "plumbing_expect_events", "events": [
      {"event": "change_budget_line", "occupant": "pump", "index": 3, "line": "0x5000"},
      {"event": "create_building_line_item", "line": "0x5000", "locally_funded": false},
      {"event": "display_flag", "line": "0x5000", "flag": 2, "on": true},
      {"event": "add_expenses", "line": "0x5000", "delta": 100},
      {"event": "set_secondary", "line": "0x5000", "value": 1}]},
    {"op": "plumbing_expect_line_item", "line": "0x5000", "expenses": 100, "secondary": 1, "display": true},
    {"op": "plumbing_expect_occupant", "occupant": "pump", "props": {"0x2A58D350": 100, "0xC910B4CF": 0}},
    {"op": "plumbing_expect", "state": {"producers": [{"occupant": "pump", "seed": [10, 10], "rect": [10, 10, 11, 10], "max_capacity": 1000}],
      "recompute": true}},
    {"op": "plumbing_expect_flags", "cells": [{"x": 10, "z": 10, "v": "0x30"}, {"x": 11, "z": 10, "v": "0x20"}]},
    {"op": "plumbing_expect_refs", "refs": {"pump": 1}},
    {"op": "plumbing_building", "label": "shop", "x": 40, "z": 40, "building_type": "0x5000",
      "budget": {"department": "0xAA4014B4", "line": "0x5000", "cost": 40, "index": 0}},
    {"op": "plumbing_expect_event_count", "filter": {"event": "create_building_line_item"}, "count": 0},
    {"op": "plumbing_expect_line_item", "line": "0x5000", "expenses": 140, "secondary": 2},
    {"op": "plumbing_building", "label": "house", "x": 12, "z": 10, "props": {"0xC8ED2D84": {"i32": 300}}},
    {"op": "plumbing_building", "label": "annex", "x": 12, "z": 10, "lot": false, "props": {"0xC8ED2D84": {"i32": 50}}},
    {"op": "plumbing_expect", "state": {"demand": 350}},
    {"op": "plumbing_remove", "occupant": "annex"},
    {"op": "plumbing_expect", "state": {"demand": 300}},
    {"op": "plumbing_expect_flags", "cells": [{"x": 12, "z": 10, "v": 0}]},
    {"op": "plumbing_insert", "occupant": "house"},
    {"op": "plumbing_expect", "state": {"demand": 600}},
    {"op": "plumbing_expect_flags", "cells": [{"x": 12, "z": 10, "v": "0x40"}]},
    {"op": "plumbing_occupant", "occupant": "annex", "props": {"0xC8ED2D84": {"u32": 0}}},

    {"op": "plumbing_clear_events"},
    {"op": "plumbing_pass"},
    {"op": "plumbing_expect_occupant", "occupant": "pump", "props": {"0x08D9763D": 300}},
    {"op": "plumbing_expect", "state": {"total_water_cost": 150}},
    {"op": "plumbing_expect_event_count", "filter": {"event": "change_budget_cost"}, "count": 0},
    {"op": "plumbing_occupant", "occupant": "pump", "props": {"0xC910B4CF": {"f32": 50}}},
    {"op": "plumbing_clear_events"},
    {"op": "plumbing_pass"},
    {"op": "plumbing_expect_events", "filter": {"event": "change_budget_cost"}, "events": [
      {"event": "change_budget_cost", "occupant": "pump", "index": 3, "cost": 150}]},
    {"op": "plumbing_expect_line_item", "line": "0x5000", "expenses": 190},
    {"op": "plumbing_expect_occupant", "occupant": "pump", "budget_cost": 150},
    {"op": "plumbing_expect", "state": {"total_water_cost": 300}},
    {"op": "plumbing_call", "method": "occupant_monthly_upkeep_cost", "args": ["pump"], "expect": 150},

    {"op": "plumbing_clear_events"},
    {"op": "plumbing_remove", "occupant": "pump"},
    {"op": "plumbing_expect_events", "events": [
      {"event": "add_expenses", "line": "0x5000", "delta": -150},
      {"event": "set_secondary", "line": "0x5000", "value": 1}]},
    {"op": "plumbing_expect_occupant", "occupant": "pump", "props": {"0x2A58D350": 150}},
    {"op": "plumbing_expect_refs", "refs": {"pump": 0}},
    {"op": "plumbing_expect", "state": {"producers": []}},
    {"op": "plumbing_expect_flags", "cells": [{"x": 10, "z": 10, "v": "0x10"}, {"x": 11, "z": 10, "v": 0}]},

    {"op": "plumbing_building", "label": "odd", "x": 44, "z": 44,
      "budget": {"department": "0x11111111", "line": 7, "cost": 33}},
    {"op": "plumbing_expect_event_count", "filter": {"event": "add_expenses"}, "count": 0},
    {"op": "plumbing_expect_occupant", "occupant": "odd", "props": {"0x2A58D350": 33}},

    {"op": "plumbing_set", "state": {"recompute": false}},
    {"op": "plumbing_building", "label": "orphan", "x": 50, "z": 50, "lot": false, "props": {"0x88ED3303": {"u32": 10}}},
    {"op": "plumbing_expect", "state": {"leaked": ["orphan"], "producers": [], "recompute": false}},
    {"op": "plumbing_expect_refs", "refs": {"orphan": 1}},
    {"op": "plumbing_expect_occupant", "occupant": "orphan", "props": {"0xC910B4CF": null}}
  ]
}
