      {"id": 19, "name": "TPing", "severity": 40, "weight": 4, "zone": 1, "wealth": 6, "purpose": 1, "condition": "0xFFFFFFFF"}]}},

    {"op": "crime_env", "ltext": [{"key": ["0x2026960B", "0x6A231EAA", "0x1234"], "text": "Jaywalking"}]},
    {"op": "crime_types", "shipped": false, "types": [
      {"id": "0x40", "props": {"0x8A416B2E": {"u32": ["0x2026960B", "0x6A231EAA", "0x1234"]}, "0xAA12FCB0": {"str": "Fallback"},
        "0xAA12FCB2": {"u8": []}, "0xAA12FCB3": {"u8": [1, 3]}, "0xAA12FCB4": {"u8": [9]}}},
