      {"id": 5, "name": "Arson", "severity": 100, "weight": 0.5, "arson": true, "wealth": 3, "purpose": "0x1EF", "condition": 4},
      {"id": 6, "name": "Money Snatcher", "severity": 60, "weight": 3, "purpose": "0xA"},
      {"id": 7, "name": "Stickup", "severity": 80, "weight": 2, "purpose": 6},
