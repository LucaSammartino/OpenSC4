{
  "format": 1,
  "name": "zones_t27_depth_rule",
  "spec": ["zones 7.6.3", "zones 15.27"],
  "description": "Conformance test 27 (DepthRule, §7.6.3): results for rem = 1..12, as (a) farRoad/front, (b) farRoad/back == nearRoad/front, (c) nearRoad/back. Rows: Ld 2 min 1 max 3 (ps 1 and ps 0), Ld 3 min 2 max 4 ps 1, Ld 4 min 3 max 5 (ps 1 and ps 0). Every compare is unsigned; a result equal to Ld means no change. Args are [front, far, min, max, ld, ps].",
  "steps": [
    {"op": "zone_eval", "fn": "depth_rule_row", "args": [true, true, 1, 3, 2, 1],
     "expect": [1, 2, 3, 2, 2, 2, 2, 2, 2, 2, 2, 2]},
    {"op": "zone_eval", "fn": "depth_rule_row", "args": [false, true, 1, 3, 2, 1],
     "expect": [1, 2, 3, 2, 2, 2, 2, 2, 2, 2, 2, 2]},
    {"op": "zone_eval", "fn": "depth_rule_row", "args": [true, false, 1, 3, 2, 1],
     "expect": [1, 2, 3, 2, 2, 2, 2, 2, 2, 2, 2, 2]},
    {"op": "zone_eval", "fn": "depth_rule_row", "args": [false, false, 1, 3, 2, 1],
     "expect": [2, 1, 2, 3, 2, 2, 2, 2, 2, 2, 2, 2]},
    {"op": "zone_eval", "fn": "depth_rule_row", "args": [false, false, 1, 3, 2, 0],
     "expect": [2, 1, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2]},

    {"op": "zone_eval", "fn": "depth_rule_row", "args": [true, true, 2, 4, 3, 1],
     "expect": [1, 2, 3, 4, 3, 3, 2, 3, 3, 3, 3, 3]},
    {"op": "zone_eval", "fn": "depth_rule_row", "args": [false, true, 2, 4, 3, 1],
     "expect": [1, 2, 3, 4, 2, 3, 3, 3, 3, 3, 3, 3]},
    {"op": "zone_eval", "fn": "depth_rule_row", "args": [false, false, 2, 4, 3, 1],
     "expect": [3, 1, 2, 3, 4, 3, 3, 3, 3, 3, 3, 3]},

    {"op": "zone_eval", "fn": "depth_rule_row", "args": [true, true, 3, 5, 4, 1],
     "expect": [1, 2, 3, 4, 5, 3, 4, 4, 5, 3, 4, 4]},
    {"op": "zone_eval", "fn": "depth_rule_row", "args": [false, true, 3, 5, 4, 1],
     "expect": [1, 2, 3, 4, 5, 6, 3, 4, 4, 4, 4, 4]},
    {"op": "zone_eval", "fn": "depth_rule_row", "args": [false, false, 3, 5, 4, 1],
     "expect": [4, 1, 2, 3, 4, 5, 3, 4, 4, 4, 4, 4]},
    {"op": "zone_eval", "fn": "depth_rule_row", "args": [true, true, 3, 5, 4, 0],
     "expect": [1, 2, 3, 4, 5, 3, 4, 4, 3, 3, 4, 4]},
    {"op": "zone_eval", "fn": "depth_rule_row", "args": [false, true, 3, 5, 4, 0],
     "expect": [1, 2, 3, 4, 5, 3, 3, 4, 4, 4, 4, 4]},
    {"op": "zone_eval", "fn": "depth_rule_row", "args": [false, false, 3, 5, 4, 0],
     "expect": [4, 1, 2, 3, 4, 5, 3, 4, 4, 4, 4, 4]}
  ]
}
