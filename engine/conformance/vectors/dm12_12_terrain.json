{
  "format": 1,
  "name": "demolition_terrain_height",
  "spec": ["demolition 4.7", "demolition 12.12"],
  "description": "ModifyTerrainHeight(true, true, ...) leaves a vertex alone when its 29 m square touches an immovable building's bounding box or a locked lot, when it is water or already within 0.05 of the height, and returns the number of changed vertices; the redisplay rectangle is the vertex rectangle grown by one. A dry run counts and redisplays; the exempt lot does not lock; a movable building does not block. Area mode (per_vertex false): one SetAltitude over the rectangle (clamped to the city), counted as the vertices that differ; a locked lot or an immovable occupant in the grown rectangle stops it.",
  "steps": [
    {"op": "demolition_create"},
    {"op": "demolition_init", "expect": true},
    {"op": "demolition_clear_events"},
    {"op": "demolition_occupant", "occupant": "0x10", "type": "building", "bounds": [70, 70, 75, 75]},
    {"op": "demolition_lot", "lot": "0x50", "rect": [8, 5, 8, 5], "zone": 1, "locked": true},
    {"op": "demolition_env", "water": [[6, 5]], "altitudes": [[7, 5, 10.04]]},
    {"op": "demolition_terrain", "do_it": true, "per_vertex": true, "rect": [5, 5, 9, 5], "altitude": 10, "expect": 0},
    {"op": "demolition_expect_events", "events": []},
    {"op": "demolition_terrain", "do_it": true, "per_vertex": true, "rect": [5, 5, 9, 6], "altitude": 10, "expect": 3},
    {"op": "demolition_expect_events", "events": [{"event": "set_vertex", "x": 5, "z": 6, "height": 10}, {"event": "set_vertex", "x": 6, "z": 6, "height": 10}, {"event": "set_vertex", "x": 7, "z": 6, "height": 10}, {"event": "redisplay", "rect": [4, 4, 10, 7], "reason": 5}]},
    {"op": "demolition_terrain", "do_it": false, "per_vertex": true, "rect": [8, 5, 8, 5], "altitude": 10, "exempt": "0x50", "expect": 1},
    {"op": "demolition_expect_events", "events": [{"event": "redisplay", "rect": [7, 4, 9, 6], "reason": 5}]},
    {"op": "demolition_occupant", "occupant": "0x10", "props": {"0x29F013E6": true}},
    {"op": "demolition_terrain", "do_it": false, "per_vertex": true, "rect": [5, 5, 5, 5], "altitude": 10, "expect": 1},
    {"op": "demolition_occupant", "occupant": "0x10", "bounds": [-100, -100, -99, -99]},
    {"op": "demolition_env", "altitudes": [[2, 2, 3]]},
    {"op": "demolition_clear_events"},
    {"op": "demolition_terrain", "do_it": true, "per_vertex": false, "rect": [1, 1, 3, 3], "altitude": 3, "expect": 8},
    {"op": "demolition_expect_events", "events": [{"event": "set_rect", "rect": [1, 1, 3, 3], "height": 3, "reason": 5}, {"event": "redisplay", "rect": [1, 1, 3, 3], "reason": 5}]},
    {"op": "demolition_terrain", "do_it": true, "per_vertex": false, "rect": [2, 2, 2, 2], "altitude": 3, "expect": 0},
    {"op": "demolition_lot", "lot": "0x51", "rect": [0, 0, 0, 0], "zone": 1, "locked": true},
    {"op": "demolition_clear_events"},
    {"op": "demolition_terrain", "do_it": true, "per_vertex": false, "rect": [1, 1, 1, 1], "altitude": 3, "expect": 1},
    {"op": "demolition_expect_events", "events": []},
    {"op": "demolition_occupant", "occupant": "0x11", "type": "prop", "cell": [0, 1]},
    {"op": "demolition_terrain", "do_it": true, "per_vertex": false, "rect": [1, 1, 1, 1], "altitude": 3, "exempt": "0x51", "expect": 0},
    {"op": "demolition_expect_events", "events": []},
    {"op": "demolition_occupant", "occupant": "0x11", "bounds": [-100, -100, -99, -99]},
    {"op": "demolition_terrain", "do_it": true, "per_vertex": false, "rect": [62, 62, 70, 64], "altitude": 3, "exempt": "0x51", "expect": 27},
    {"op": "demolition_expect_events", "events": [{"event": "set_rect", "rect": [62, 62, 64, 64], "height": 3, "reason": 5}, {"event": "redisplay", "rect": [62, 62, 64, 64], "reason": 5}]}
  ]
}
