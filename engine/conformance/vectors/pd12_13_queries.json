{
  "format": 1,
  "name": "port_developers_queries",
  "spec": ["port-developers 4.3", "port-developers 4.7"],
  "description": "Queries with several ports. [choice] GetLeastEfficientPort returns the minimum efficiency and its location, the first port on ties (the original loops forever with two or more ports). GetAllPortLots lists the lots in list order; GetNumAirports(2) counts the medium airports. A port whose lot is in condition 1 is skipped by the month and keeps its efficiency; the history value is the mean of all ports, skipped ones included: round((0.5 + 1 + 1) / 3 x 100) = 83.",
  "steps": [
    {"op": "pd_create", "kind": "airport"},
    {"op": "pd_init"},
    {"op": "pd_lot", "lot": "0x10", "config": ["0xCA2436C0", 1], "x": 3, "z": 4, "rect": [3, 4, 7, 6]},
    {"op": "pd_occupant", "occupant": "0x100", "lot": "0x10"},
    {"op": "pd_message", "msg": "0x99EF1142", "data": "0x100"},
    {"op": "pd_query", "query": "least_efficient", "expect": [1.0, 3, 4]},
    {"op": "pd_lot", "lot": "0x11", "config": ["0x6A5126D0", 1], "x": 30, "z": 4, "rect": [30, 4, 34, 6]},
    {"op": "pd_occupant", "occupant": "0x101", "lot": "0x11"},
    {"op": "pd_message", "msg": "0x99EF1142", "data": "0x101"},
    {"op": "pd_lot", "lot": "0x12", "config": ["0x0A512810", 1], "x": 60, "z": 4, "rect": [60, 4, 64, 6]},
    {"op": "pd_occupant", "occupant": "0x102", "lot": "0x12"},
    {"op": "pd_message", "msg": "0x99EF1142", "data": "0x102"},
    {"op": "pd_set_port", "index": 0, "efficiency": 0.5},
    {"op": "pd_set_port", "index": 1, "efficiency": 0.25},
    {"op": "pd_set_port", "index": 2, "efficiency": 0.25},
    {"op": "pd_query", "query": "least_efficient", "expect": [0.25, 30, 4]},
    {"op": "pd_query", "query": "avg_efficiency", "expect": 0.33333334},
    {"op": "pd_query", "query": "all_port_lots", "expect": ["0x10", "0x11", "0x12"]},
    {"op": "pd_query", "query": "num_airports", "args": [2], "expect": 1},
    {"op": "pd_query", "query": "num_airports", "args": [3], "expect": 1},
    {"op": "pd_query", "query": "num_ports", "args": ["0x0C", 1], "expect": 2},
    {"op": "pd_query", "query": "required_budget", "expect": 3900},
    {"op": "pd_lot", "lot": "0x10", "condition": 1},
    {"op": "pd_env", "offices": [[0], [0]]},
    {"op": "pd_clear_events"},
    {"op": "pd_month"},
    {"op": "pd_expect", "state": {"skipped": 1, "history": 83}},
    {"op": "pd_expect_port", "index": 0, "state": {"efficiency": 0.5}},
    {"op": "pd_expect_event_count", "filter": {"lot": "0x10"}, "count": 0}
  ]
}
