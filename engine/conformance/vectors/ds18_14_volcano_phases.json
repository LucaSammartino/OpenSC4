{
  "format": 1,
  "name": "disaster_volcano_phases",
  "spec": ["disasters 10", "disasters 18.14"],
  "description": "The volcano's GetPhase maps its state: 0 -> 0, 1 -> 2, 2 and 3 -> 1, 4 -> 3, 5 to 8 -> 2. Started with lava enabled (the shipped exemplar) it is in state 5 right after the start call, GetPhase 2, not counted as active. After T = 50 s of ticks (strictly more than T) the lava ends: DisasterHasEnded once, state 3, phase 1. It waits there for its control effect's completion (0xCA493C1D with data1 = the instance), which removes it. Without the exemplar the lava is disabled: the volcano starts in state 3.",
  "steps": [
    {"op": "dis_env", "tuning": {"volcano": "shipped"}},
    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_clear_events"},
    {"op": "dis_call", "method": "attempt_start", "args": ["volcano", 100, 100], "expect": 1},
    {"op": "dis_expect_volcano", "instance": 1, "state": {"state": 5, "phase": 2, "lava_flowing": true, "lava_has_run": false}},
    {"op": "dis_expect_instance", "instance": 1, "state": {"phase": 2}},
    {"op": "dis_call", "method": "active_count", "args": ["volcano"], "expect": 0},
    {"op": "dis_expect_event_count", "filter": {"event": "emergency_pause"}, "count": 1},
    {"op": "dis_tick", "instance": 1, "us": 1000000, "count": 50},
    {"op": "dis_expect_volcano", "instance": 1, "state": {"state": 5, "phase": 2}},
    {"op": "dis_expect_event_count", "filter": {"event": "post", "type": "0xAA1B2002"}, "count": 0},
    {"op": "dis_tick", "instance": 1, "us": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "post", "type": "0xAA1B2002"}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "lava_end"}, "count": 1},
    {"op": "dis_expect_volcano", "instance": 1, "state": {"state": 3, "phase": 1, "lava_flowing": false, "lava_has_run": true}},
    {"op": "dis_call", "method": "active_count", "args": ["volcano"], "expect": 1},
    {"op": "dis_tick", "instance": 1, "us": 50000000},
    {"op": "dis_expect_volcano", "instance": 1, "state": {"state": 3}},
    {"op": "dis_message", "target": {"instance": 1}, "type": "VolcanoMessage", "data1": 2, "expect": false, "note": "another instance's completion"},
    {"op": "dis_expect_volcano", "instance": 1, "state": {"state": 3}},
    {"op": "dis_message", "target": {"instance": 1}, "type": "VolcanoMessage", "data1": 1, "expect": true},
    {"op": "dis_expect_volcano", "instance": 1, "absent": true},
    {"op": "dis_call", "method": "manager_instances", "args": ["volcano"], "expect": []},
    {"op": "dis_expect_event_count", "filter": {"event": "post", "type": "0xAA1B2002"}, "count": 1},

    {"op": "dis_env", "tuning": {"volcano": null}},
    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_clear_events"},
    {"op": "dis_call", "method": "attempt_start", "args": ["volcano", 100, 100], "expect": 1},
    {"op": "dis_expect_volcano", "instance": 1, "state": {"state": 3, "phase": 1, "lava_flowing": false}},
    {"op": "dis_expect_event_count", "filter": {"event": "lava"}, "count": 0},
    {"op": "dis_call", "method": "is_disaster_ongoing", "expect": true},
    {"op": "dis_call", "method": "volcano_request_end", "args": [1], "expect": true},
    {"op": "dis_expect_volcano", "instance": 1, "absent": true},
    {"op": "dis_call", "method": "is_disaster_ongoing", "expect": false}
  ]
}
