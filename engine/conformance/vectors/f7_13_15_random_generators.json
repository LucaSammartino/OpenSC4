{
  "format": 1,
  "name": "random_generators",
  "spec": [
    "foundations 6.1",
    "foundations 7.13",
    "foundations 7.14",
    "foundations 7.15",
    "foundations 7.16"
  ],
  "description": "cRZRandom (integer LCG and double multiplicative paths, with state words) and cRZRandomSuper (MT19937 with the game's seeding) vectors from foundations 7, weighted choice, clock-seed injection. The double methods are 24-bit (6.1 precision table): test 13 values, RangeUniform(0, 100) and RangeGaussianFast(0, 10) after seed 1, and test 16 (uniform rounding to 1.0 and 1 - 2^-24, the clamped Gaussian 5.9999 -> 9.999833106994629). The cRZRandomSuper vectors were computed from 6.1 and await confirmation against the original (foundations open question 6).",
  "steps": [
    {
      "op": "rng",
      "generator": "RzRandom",
      "seed": 1,
      "calls": [
        {
          "method": "next_raw",
          "expect": "0x000041C6",
          "lcg": "0x41C67EA6"
        },
        {
          "method": "next_raw",
          "expect": "0x59D4967E",
          "lcg": "0x967EB0E7"
        },
        {
          "method": "next_raw",
          "expect": "0xBF022781",
          "lcg": "0x2781E494"
        },
        {
          "method": "uniform_u32",
          "args": [
            0
          ],
          "expect": 0,
          "lcg": "0x2781E494"
        }
      ]
    },
    {
      "op": "rng",
      "generator": "RzRandom",
      "seed": 1,
      "calls": [
        {
          "method": "uniform_f64",
          "expect": 0.6545084714889526,
          "mul": "0x278DDE6D"
        },
        {
          "method": "uniform_f64",
          "expect": 0.48173871636390686,
          "mul": "0xFB533A69"
        },
        {
          "method": "uniform_f64",
          "expect": 0.8512561321258545,
          "mul": "0x59EBECB5"
        }
      ]
    },
    {
      "op": "rng",
      "generator": "RzRandom",
      "seed": 1,
      "calls": [
        {
          "method": "range_f64",
          "args": [
            0,
            100
          ],
          "expect": 65.45084381103516,
          "mul": "0x278DDE6D"
        }
      ]
    },
    {
      "op": "rng",
      "generator": "RzRandom",
      "seed": 1,
      "calls": [
        {
          "method": "range_gaussian_fast",
          "args": [
            0,
            10
          ],
          "expect": 6.625010967254639,
          "mul": "0x59EBECB5"
        }
      ]
    },
    {
      "op": "rng",
      "generator": "RzRandom",
      "seed": 1,
      "calls": [
        {
          "method": "uniform_of",
          "args": [
            "0x7FFFFF41"
          ],
          "expect": 1.0
        },
        {
          "method": "uniform_of",
          "args": [
            "0x7FFFFF40"
          ],
          "expect": 0.9999999403953552
        },
        {
          "method": "uniform_of",
          "args": [
            "0x80000000"
          ],
          "expect": 0.0
        },
        {
          "method": "gaussian_to_range",
          "args": [
            3.5,
            0,
            10
          ],
          "expect": 9.999833106994629
        }
      ],
      "note": "test 16: pure mappings of one draw i (uniform_of) and of a Gaussian value 3.5 (g = 6.5 >= 6 -> 5.9999); no state change"
    },
    {
      "op": "rng",
      "generator": "RzRandom",
      "seed": "0xFFFFFFFF",
      "wall_clock_seed": 1,
      "calls": [
        {
          "method": "next_raw",
          "expect": "0x000041C6"
        }
      ],
      "note": "Seed(0xFFFFFFFF) takes the (injected) wall-clock seed"
    },
    {
      "op": "rng",
      "generator": "RzRandomSuper",
      "seed": 1,
      "calls": [
        {
          "method": "next_u32",
          "expect": "0xD3F6B9E5"
        },
        {
          "method": "next_u32",
          "expect": "0xEF284157"
        },
        {
          "method": "next_u32",
          "expect": "0x0D3639C7"
        }
      ]
    },
    {
      "op": "rng",
      "generator": "RzRandomSuper",
      "seed": 4357,
      "calls": [
        {
          "method": "next_u32",
          "expect": "0xAAE64AC3"
        },
        {
          "method": "next_u32",
          "expect": "0x5E7C47DA"
        },
        {
          "method": "next_u32",
          "expect": "0xB98E8121"
        }
      ]
    },
    {
      "op": "rng",
      "generator": "RzRandomSuper",
      "seed": 99,
      "calls": [
        {
          "method": "weighted_choice",
          "weights": [
            0,
            1,
            0
          ],
          "expect": 1
        },
        {
          "method": "weighted_choice",
          "weights": [
            0,
            1,
            0
          ],
          "expect": 1
        },
        {
          "method": "weighted_choice",
          "weights": [
            0,
            1,
            0
          ],
          "expect": 1
        },
        {
          "method": "weighted_choice",
          "weights": [
            5
          ],
          "expect": 0
        }
      ]
    }
  ]
}
