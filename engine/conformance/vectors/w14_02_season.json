{
  "format": 1,
  "name": "weather_season",
  "spec": ["weather 4", "weather 5.3", "weather 14.2"],
  "description": "GetCurrentSeason = (season month - 1) / 3: months 1-3 -> 0 (winter) ... 10-12 -> 3 (fall). A hemisphere value other than 1 shifts by six months ((m + 5) mod 12 + 1), so January is season month 7 (summer). The month-end posts SeasonChanged 0x6716A4E5 (data2 = season) only when the season differs from lastSeason (always on a new city's first month, lastSeason = -1), and then resets the current wind to the defaults (3, (0, 1)); within a season the current wind is kept.",
  "steps": [
    {"op": "weather_env", "size": [4, 4], "month": 1},
    {"op": "weather_tuning", "shipped": true},
    {"op": "weather_create", "rng": {"stub": {"uniform": [0.5], "gaussian": [0], "int": [0]}}},
    {"op": "weather_init", "expect": true},
    {"op": "weather_call", "method": "current_season_month", "expect": 1},
    {"op": "weather_call", "method": "current_season", "expect": 0},
    {"op": "weather_env", "month": 3},
    {"op": "weather_call", "method": "current_season", "expect": 0},
    {"op": "weather_env", "month": 4},
    {"op": "weather_call", "method": "current_season", "expect": 1},
    {"op": "weather_env", "month": 6},
    {"op": "weather_call", "method": "current_season", "expect": 1},
    {"op": "weather_env", "month": 7},
    {"op": "weather_call", "method": "current_season", "expect": 2},
    {"op": "weather_env", "month": 9},
    {"op": "weather_call", "method": "current_season", "expect": 2},
    {"op": "weather_env", "month": 10},
    {"op": "weather_call", "method": "current_season", "expect": 3},
    {"op": "weather_env", "month": 12},
    {"op": "weather_call", "method": "current_season", "expect": 3},

    {"op": "weather_env", "hemisphere": 0, "month": 1},
    {"op": "weather_call", "method": "current_season_month", "expect": 7},
    {"op": "weather_call", "method": "current_season", "expect": 2},
    {"op": "weather_env", "month": 7},
    {"op": "weather_call", "method": "current_season_month", "expect": 1},
    {"op": "weather_call", "method": "current_season", "expect": 0},
    {"op": "weather_env", "month": 12},
    {"op": "weather_call", "method": "current_season_month", "expect": 6},
    {"op": "weather_env", "hemisphere": 1},

    {"op": "weather_env", "month": 1},
    {"op": "weather_set", "state": {"wind_speed": 7, "wind_dir": [0.6, 0.8]}},
    {"op": "weather_clear_events"},
    {"op": "weather_message", "type": "SimNewMonth", "data3": 1, "expect": true},
    {"op": "weather_expect_events", "filter": {"event": "post"}, "events": [{"type": "SeasonChanged", "data2": 0}]},
    {"op": "weather_expect", "state": {"last_season": 0, "wind_speed": 3, "wind_dir": [0, 1]}},
    {"op": "weather_set", "state": {"wind_speed": 7, "wind_dir": [0.6, 0.8]}},
    {"op": "weather_env", "month": 2},
    {"op": "weather_message", "type": "SimNewMonth", "data3": 2, "expect": true},
    {"op": "weather_env", "month": 3},
    {"op": "weather_message", "type": "SimNewMonth", "data3": 3, "expect": true},
    {"op": "weather_expect_events", "filter": {"event": "post"}, "events": []},
    {"op": "weather_expect", "state": {"last_season": 0, "wind_speed": 7, "wind_dir": [0.6, 0.8]}},
    {"op": "weather_env", "month": 4},
    {"op": "weather_message", "type": "SimNewMonth", "data3": 4, "expect": true},
    {"op": "weather_expect_events", "filter": {"event": "post"}, "events": [{"type": "SeasonChanged", "data2": 1}]},
    {"op": "weather_expect", "state": {"last_season": 1, "wind_speed": 3, "wind_dir": [0, 1]}},
    {"op": "weather_env", "month": 10},
    {"op": "weather_message", "type": "SimNewMonth", "data3": 10, "expect": true},
    {"op": "weather_expect_events", "filter": {"event": "post"}, "events": [{"type": "SeasonChanged", "data2": 3}]},
    {"op": "weather_env", "hemisphere": 0, "month": 11},
    {"op": "weather_message", "type": "SimNewMonth", "data3": 11, "expect": true},
    {"op": "weather_expect_events", "filter": {"event": "post"}, "events": [{"type": "SeasonChanged", "data2": 1}]},
    {"op": "weather_expect", "state": {"last_season": 1, "wind_month": 5}}
  ]
}
