{
  "format": 1,
  "name": "residential_state_order",
  "spec": ["residential 5.1"],
  "description": "Section 5.1: one state per NewDay, in the cycle order 0, 13, 1, 14, 2, 15, 3, 11, 4, 12, 5, 6, 7, 8, 9, 10; state 10 waits for NewMonth (NewDay returns true and stays). [choice] An unknown state (a hostile save) waits too.",
  "steps": [
    {"op": "residential_env", "cells": [8, 8]},
    {"op": "residential_create"},
    {"op": "residential_init", "expect": true},
    {"op": "residential_expect", "state": {"state": 0}},
    {"op": "residential_run_to", "state": 13, "steps": 1},
    {"op": "residential_run_to", "state": 1, "steps": 1},
    {"op": "residential_run_to", "state": 14, "steps": 1},
    {"op": "residential_run_to", "state": 2, "steps": 1},
    {"op": "residential_run_to", "state": 15, "steps": 1},
    {"op": "residential_run_to", "state": 3, "steps": 1},
    {"op": "residential_run_to", "state": 11, "steps": 1},
    {"op": "residential_run_to", "state": 4, "steps": 1},
    {"op": "residential_run_to", "state": 12, "steps": 1},
    {"op": "residential_run_to", "state": 5, "steps": 1},
    {"op": "residential_run_to", "state": 6, "steps": 1},
    {"op": "residential_run_to", "state": 7, "steps": 1},
    {"op": "residential_run_to", "state": 8, "steps": 1},
    {"op": "residential_run_to", "state": 9, "steps": 1},
    {"op": "residential_run_to", "state": 10, "steps": 1},
    {"op": "residential_message", "type": "SimNewDay", "count": 3, "expect": true},
    {"op": "residential_expect", "state": {"state": 10}},
    {"op": "residential_message", "type": "SimNewMonth", "expect": true},
    {"op": "residential_run_to", "state": 10, "steps": 15},
    {"op": "residential_set", "state": {"state": 99}},
    {"op": "residential_message", "type": "SimNewDay", "expect": true},
    {"op": "residential_expect", "state": {"state": 99}}
  ]
}
