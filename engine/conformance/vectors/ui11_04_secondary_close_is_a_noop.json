{
  "format": 1,
  "name": "ui11_04_secondary_close_is_a_noop",
  "spec": [
    "ui-windows 4.2",
    "ui-windows 11"
  ],
  "description": "Conformance test 4: with +0x1F8 == 0, CloseSecondaryMenu must not call CloseTertiaryMenu, HideWindow, Release or ChildDelete, and must leave +0x200 alone.",
  "steps": [
    {
      "op": "uiw_create"
    },
    {
      "op": "uiw_set_catalog_state",
      "present": true,
      "field0": 5,
      "field1": 6
    },
    {
      "op": "uiw_clear_ops"
    },
    {
      "op": "uiw_close_secondary"
    },
    {
      "op": "uiw_expect",
      "state": {
        "secondary_kind": 0,
        "catalog_field0": 5,
        "catalog_field1": 6
      }
    },
    {
      "op": "uiw_expect_ops",
      "ops": []
    }
  ]
}
