{
  "format": 1,
  "name": "weather_temperature",
  "spec": ["weather 6.3", "weather 6.6", "weather 5.3", "weather 14.4"],
  "description": "SimulateCellTemperature: T = ambient + 273 (+ (baseTemp - ambient) * seaWeight on a sea-mask cell) - altitude * heightFactor - wind * windFactor - 273; T < -15 -> 0, else min(T, 45) + 15; byte = roundHalfEven(T * 4.25). With blendRadius 0 the byte is written; with radius r every cell of [x - r, x + r) x [z - r, z + r) inside the grid becomes (old + value) / 2 (integer division). The January step finds water rectangles (altitude <= sea level, runs >= 3 cells, shorter side >= 3 and longer >= 5), keeps those touching the city edge, and marks the sea mask within seaRadius of them (inclusive, clamped).",
  "steps": [
    {"op": "weather_env", "size": [8, 8], "month": 2, "heights": [
      {"x": 1, "z": 1, "h": 400}, {"x": 2, "z": 2, "h": 0}, {"x": 3, "z": 3, "h": 1000}, {"x": 4, "z": 4, "h": 400},
      {"x": 5, "z": 5, "h": 400}, {"x": 0, "z": 0, "h": 400}]},
    {"op": "weather_tuning", "shipped": true},
    {"op": "weather_create", "rng": {"stub": {"uniform": [0.5], "gaussian": [0], "int": [0]}}},
    {"op": "weather_init", "expect": true},
    {"op": "weather_set", "state": {"blend_radius": 0, "ambient_temp": 48.75, "wind_speed": 3, "wind_dir": [0, 1],
      "temperature_fill": 7, "sea_mask_fill": 0, "sea_mask_cells": [{"x": 4, "z": 4}]}},
    {"op": "weather_call", "method": "simulate_cell_temperature", "args": [1, 1]},
    {"op": "weather_call", "method": "simulate_cell_temperature", "args": [2, 2]},
    {"op": "weather_call", "method": "simulate_cell_temperature", "args": [3, 3]},
    {"op": "weather_call", "method": "simulate_cell_temperature", "args": [4, 4]},
    {"op": "weather_expect_grid", "grid": "temperature", "cells": [
      {"x": 1, "z": 1, "v": 128}, {"x": 2, "z": 2, "v": 255}, {"x": 3, "z": 3, "v": 0}, {"x": 4, "z": 4, "v": 191},
      {"x": 0, "z": 0, "w": 1, "d": 8, "v": 7}, {"x": 5, "z": 5, "v": 7}, {"x": 1, "z": 2, "v": 7}]},
    {"op": "weather_set", "state": {"wind_speed": 0}},
    {"op": "weather_call", "method": "simulate_cell_temperature", "args": [1, 1]},
    {"op": "weather_expect_grid", "grid": "temperature", "cells": [{"x": 1, "z": 1, "v": 132}]},
    {"op": "weather_call", "method": "simulate_cell_temperature", "args": [-1, 9]},
    {"op": "weather_call", "method": "simulate_cell_temperature", "args": [8, 0]},

    {"op": "weather_set", "state": {"blend_radius": 1, "wind_speed": 3, "temperature_fill": 100}},
    {"op": "weather_call", "method": "simulate_cell_temperature", "args": [5, 5]},
    {"op": "weather_expect_grid", "grid": "temperature", "cells": [
      {"x": 4, "z": 4, "w": 2, "d": 2, "v": 114}, {"x": 6, "z": 4, "d": 3, "v": 100}, {"x": 4, "z": 6, "w": 2, "v": 100},
      {"x": 3, "z": 3, "w": 3, "v": 100}], "min": 100, "max": 114},
    {"op": "weather_call", "method": "simulate_cell_temperature", "args": [5, 5]},
    {"op": "weather_expect_grid", "grid": "temperature", "cells": [{"x": 4, "z": 4, "w": 2, "d": 2, "v": 121}]},
    {"op": "weather_call", "method": "simulate_cell_temperature", "args": [0, 0]},
    {"op": "weather_expect_grid", "grid": "temperature", "cells": [{"x": 0, "z": 0, "v": 114}, {"x": 1, "z": 0, "v": 100},
      {"x": 0, "z": 1, "v": 100}]},
    {"op": "weather_set", "state": {"blend_radius": 2, "temperature_fill": 0}},
    {"op": "weather_call", "method": "simulate_cell_temperature", "args": [2, 2]},
    {"op": "weather_expect_grid", "grid": "temperature", "rect": [0, 0, 4, 4], "inside": 127, "outside": 0},

    {"op": "weather_env", "size": [16, 16], "sea_level": -1, "flat": 0, "heights": [
      {"x": 0, "z": 0, "w": 4, "d": 8, "h": -5},
      {"x": 7, "z": 6, "w": 5, "d": 3, "h": -5},
      {"x": 10, "z": 12, "w": 2, "d": 4, "h": -5},
      {"x": 13, "z": 12, "w": 3, "d": 4, "h": -5}]},
    {"op": "weather_create", "rng": {"stub": {"uniform": [0.5], "gaussian": [0], "int": [0]}}},
    {"op": "weather_init", "expect": true},
    {"op": "weather_call", "method": "rebuild_water"},
    {"op": "weather_expect", "state": {"water_rects": [[0, 0, 4, 8]]}},
    {"op": "weather_expect_grid", "grid": "sea_mask", "rect": [0, 0, 15, 16], "inside": 1, "outside": 0},
    {"op": "weather_env", "heights": [{"x": 13, "z": 11, "w": 3, "d": 1, "h": -5}]},
    {"op": "weather_set", "state": {"sea_mask_fill": 0}},
    {"op": "weather_message", "type": "SimNewMonth", "data3": 2, "expect": true},
    {"op": "weather_expect_grid", "grid": "sea_mask", "all": 0},
    {"op": "weather_message", "type": "SimNewMonth", "data3": 1, "expect": true},
    {"op": "weather_expect", "state": {"water_rects": [[0, 0, 4, 8], [13, 11, 16, 16]]}},
    {"op": "weather_expect_grid", "grid": "sea_mask", "cells": [{"x": 15, "z": 0, "v": 0}, {"x": 15, "z": 1, "d": 15, "v": 1}, {"x": 0, "z": 0, "w": 15, "d": 16, "v": 1}]},
    {"op": "weather_env", "flat": 0, "heights": [{"x": 6, "z": 6, "w": 5, "d": 3, "h": -5}]},
    {"op": "weather_message", "type": "SimNewMonth", "data3": 1, "expect": true},
    {"op": "weather_expect", "state": {"water_rects": []}},
    {"op": "weather_expect_grid", "grid": "sea_mask", "all": 0}
  ]
}
