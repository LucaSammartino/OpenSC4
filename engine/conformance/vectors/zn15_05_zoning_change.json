{
  "format": 1,
  "name": "zn15_05_zoning_change",
  "spec": [
    "zones 5.3",
    "zones 6",
    "zones 15.5"
  ],
  "description": "Conformance test 5 (ZoningChange, \u00a75.3). After test 3's first call (a 3 \u00d7 2 rect of type 1, committed, all six cells accepted), exactly one ZoningChange is posted: data3 = the new zone type 1, data4 = the checkSlope argument (false), and void2 is a new SC4CellRegion whose rect is the request rect with the six accepted bits set. The developer is not created, so nothing else consumes the change.",
  "steps": [
    {
      "op": "zone_env",
      "cells": [
        64,
        64
      ],
      "funds": 1000
    },
    {
      "op": "zone_create",
      "session": 0,
      "manager": true,
      "developer": false
    },
    {
      "op": "zone_init"
    },
    {
      "op": "zone_clear_events"
    },
    {
      "op": "zone_place_zone",
      "region": {
        "rect": [
          0,
          0,
          2,
          1
        ]
      },
      "type": 1,
      "commit": true,
      "skip_funds": false,
      "check_slope": false,
      "skip_size": true,
      "check_lot_inside": true,
      "expect": {
        "ok": true,
        "cost": 60,
        "error": 0
      }
    },
    {
      "op": "zone_expect",
      "zoning_changes": [
        {
          "zone": 1,
          "check_slope": false,
          "rect": [
            0,
            0,
            2,
            1
          ],
          "cells": [
            [
              0,
              0
            ],
            [
              0,
              1
            ],
            [
              1,
              0
            ],
            [
              1,
              1
            ],
            [
              2,
              0
            ],
            [
              2,
              1
            ]
          ]
        }
      ]
    },
    {
      "op": "zone_expect_log",
      "filter": {
        "event": "zoning_change"
      },
      "events": [
        {
          "event": "zoning_change",
          "zone": 1,
          "check_slope": false
        }
      ]
    }
  ]
}
