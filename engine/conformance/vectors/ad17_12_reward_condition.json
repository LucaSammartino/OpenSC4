{
  "format": 1,
  "name": "advisor_reward_condition",
  "spec": ["advisors 6.6", "advisors 17.12"],
  "description": "A reward advice's condition: 1 with status 0 -> status 6, the subject set, trigger true; 0 with status 6 -> status 5; a string with status 6 -> status 4 and the (detokenized) tooltip set; anything else writes the status back unchanged.",
  "steps": [
    {"op": "adv_advisor", "class": "CityPlanning", "id": 23},
    {"op": "adv_advice", "guid": "0xAB", "class": "RewardAdvice", "trigger": "x"},
    {"op": "adv_create"},
    {"op": "adv_init", "expect": true},
    {"op": "adv_expect", "object": {"advice": "0xAB"}, "state": {"kind": "Reward"}},
    {"op": "adv_reward_subject", "guid": "0xAB", "location": [5.0, 6.0]},
    {"op": "adv_condition", "index": 1, "result": 1},
    {"op": "adv_get_trigger", "advice": {"advice": "0xAB"}, "expect": true},
    {"op": "adv_expect_status", "guid": "0xAB", "state": {"status": 6}},
    {"op": "adv_expect", "object": {"advice": "0xAB"}, "state": {"subject": {"location": [5.0, 6.0], "object": null, "data1": 0, "data2": 0}}},
    {"op": "adv_get_trigger", "advice": {"advice": "0xAB"}, "expect": false, "note": "1 again with the event bit: no new trigger"},
    {"op": "adv_condition", "index": 1, "result": 0},
    {"op": "adv_get_trigger", "advice": {"advice": "0xAB"}, "expect": false},
    {"op": "adv_expect_status", "guid": "0xAB", "state": {"status": 5}},
    {"op": "adv_status", "guid": "0xAB", "status": 6},
    {"op": "adv_condition", "index": 1, "result": {"str": "need 5k"}},
    {"op": "adv_get_trigger", "advice": {"advice": "0xAB"}, "expect": false},
    {"op": "adv_expect_status", "guid": "0xAB", "state": {"status": 4, "tooltip": "detok:need 5k"}},
    {"op": "adv_condition", "index": 1, "result": "nil"},
    {"op": "adv_get_trigger", "advice": {"advice": "0xAB"}, "expect": false},
    {"op": "adv_expect_status", "guid": "0xAB", "state": {"status": 4}, "note": "anything else: written back unchanged"}
  ]
}
