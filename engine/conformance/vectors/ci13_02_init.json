{
  "format": 1,
  "name": "commercial_init",
  "spec": ["commercial-industrial 2.1", "commercial-industrial 3", "commercial-industrial 4.1", "commercial-industrial 4.2", "commercial-industrial 13.2"],
  "description": "Init on a demand simulator without node 0x3000 returns false after asking for 0x3000 only (short-circuit) and creates no grid; without 0x3800 the node found is held and released by Shutdown. With both nodes Init registers the agent at levels 0, 10, 4, 6 (flags 2, in that order), subscribes 0x99EF1142 and 0x99EF1143, holds the city and the building development simulator, then creates CO$$$ (0x89D5B6EF) before CO$$ (0x89D5B788), both uint8 with tract size 1 and all 0. A second Init does nothing. Shutdown shuts both grids down, releases everything in the order of 4.2 and removes the agent; Release at count 1 runs Shutdown and returns 0 without decrementing.",
  "steps": [
    {"op": "commercial_env", "cells": 8, "nodes": ["0x3800"]},
    {"op": "commercial_create"},
    {"op": "commercial_init", "expect": false},
    {"op": "commercial_expect_events", "filter": {"event": "demand_node"}, "events": [{"id": "0x3000"}]},
    {"op": "commercial_expect", "state": {"initialized": true, "nodes": [null, null], "co2": null, "co3": null}},
    {"op": "commercial_proximity_map", "developer": "0x3320", "expect": null},

    {"op": "commercial_env", "nodes": ["0x3000"]},
    {"op": "commercial_create"},
    {"op": "commercial_init", "expect": false},
    {"op": "commercial_expect", "state": {"nodes": ["0x3000", null], "co2": null, "co3": null}},
    {"op": "commercial_clear_events"},
    {"op": "commercial_shutdown", "expect": true},
    {"op": "commercial_expect_events", "filter": {"event": "release_demand_node"}, "events": [{"node": "0x3000"}]},

    {"op": "commercial_env", "demand": false, "nodes": ["0x3000", "0x3800"]},
    {"op": "commercial_create"},
    {"op": "commercial_init", "expect": false},
    {"op": "commercial_expect_event_count", "filter": {"event": "demand_node"}, "count": 0},
    {"op": "commercial_clear_events"},

    {"op": "commercial_env", "demand": true},
    {"op": "commercial_create"},
    {"op": "commercial_init", "expect": true},
    {"op": "commercial_expect_events", "events": [
      {"event": "agent", "level": 0, "name": "cSC4CommercialSimulator", "flags": 2},
      {"event": "agent", "level": 10, "name": "cSC4CommercialSimulator", "flags": 2},
      {"event": "agent", "level": 4, "name": "cSC4CommercialSimulator", "flags": 2},
      {"event": "agent", "level": 6, "name": "cSC4CommercialSimulator", "flags": 2},
      {"event": "acquire_message_server"},
      {"event": "subscribe", "type": "0x99EF1142"},
      {"event": "subscribe", "type": "0x99EF1143"},
      {"event": "acquire_city"},
      {"event": "acquire_bds"},
      {"event": "demand_node", "id": "0x3000"},
      {"event": "demand_node", "id": "0x3800"},
      {"event": "create_grid", "instance": "0x89D5B6EF", "tract_size": 1},
      {"event": "create_grid", "instance": "0x89D5B788", "tract_size": 1}
    ]},
    {"op": "commercial_expect", "state": {"initialized": true, "nodes": ["0x3000", "0x3800"], "co2": "0x89D5B788",
      "co3": "0x89D5B6EF", "tract_size": 1, "dirty": true, "state": 3, "city_held": true, "bds_held": true,
      "message_server_held": true}},
    {"op": "commercial_expect_grid", "grid": "CO2", "count": {"0": 64}},
    {"op": "commercial_expect_grid", "grid": "CO3", "count": {"0": 64}},
    {"op": "commercial_init", "expect": true},
    {"op": "commercial_expect_events", "events": []},

    {"op": "commercial_shutdown", "expect": true},
    {"op": "commercial_expect_events", "events": [
      {"event": "shutdown_grid", "instance": "0x89D5B788"},
      {"event": "shutdown_grid", "instance": "0x89D5B6EF"},
      {"event": "release_city"},
      {"event": "release_bds"},
      {"event": "unsubscribe", "type": "0x99EF1142"},
      {"event": "unsubscribe", "type": "0x99EF1143"},
      {"event": "release_message_server"},
      {"event": "release_demand_node", "node": "0x3000"},
      {"event": "release_demand_node", "node": "0x3800"},
      {"event": "remove_agent"}
    ]},
    {"op": "commercial_expect", "state": {"initialized": false, "co2": null, "co3": null, "nodes": [null, null]}},
    {"op": "commercial_shutdown", "expect": true},
    {"op": "commercial_expect_events", "events": []},

    {"op": "commercial_create"},
    {"op": "commercial_init", "expect": true},
    {"op": "commercial_add_ref", "expect": 1},
    {"op": "commercial_add_ref", "expect": 2},
    {"op": "commercial_release", "expect": 1},
    {"op": "commercial_expect", "state": {"destroyed": false}},
    {"op": "commercial_clear_events"},
    {"op": "commercial_release", "expect": 0},
    {"op": "commercial_expect", "state": {"destroyed": true, "ref_count": 1, "initialized": false}},
    {"op": "commercial_expect_event_count", "filter": {"event": "remove_agent"}, "count": 1}
  ]
}
