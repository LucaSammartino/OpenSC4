{
  "format": 1,
  "name": "citysit_time_limit",
  "spec": ["city-situation 4.4", "city-situation 12"],
  "description": "Section 12 test 9 (CS4). A running mission with time_limit 0.5 never reaches status 2 by time (the limit counts only from 1.0 s). With 40 s the warning sound plays once, on the first tick whose pre-increment elapsed is >= 10.0f, and status 2 comes on the tick where elapsed (accumulated in f32 as elapsed + t x 0.001f) reaches 40.0f. The tick that ends the countdown also runs step 4 (its 4000 ms count on the clock).",
  "steps": [
    {"op": "citysit_create"},
    {"op": "citysit_add_ref", "expect": 1},
    {"op": "citysit_advice", "advice": "0x500", "guid": "0x8C151EFD", "time_limit": 0.5},
    {"op": "citysit_automaton", "automaton": "0x700"},
    {"op": "citysit_init", "expect": true},
    {"op": "citysit_call", "method": "initiate_situation", "args": ["0x500", "0x700", false], "expect": true},
    {"op": "citysit_call", "method": "activate_situation", "args": []},
    {"op": "citysit_ticks", "count": 1, "ms": 16},
    {"op": "citysit_ticks", "count": 1, "ms": 4000},
    {"op": "citysit_expect", "state": {"status": 3, "elapsed": 4.0, "time_limit": 0.5}},
    {"op": "citysit_ticks", "count": 100, "ms": 1000},
    {"op": "citysit_expect", "state": {"status": 3, "elapsed": 104.0}},
    {"op": "citysit_expect_event_count", "filter": {"event": "sound"}, "count": 0},
    {"op": "citysit_call", "method": "end_situation", "args": []},
    {"op": "citysit_ticks", "count": 1, "ms": 1000},
    {"op": "citysit_advice", "advice": "0x500", "time_limit": 40},
    {"op": "citysit_call", "method": "initiate_situation", "args": ["0x500", "0x700", false], "expect": true},
    {"op": "citysit_call", "method": "activate_situation", "args": []},
    {"op": "citysit_ticks", "count": 1, "ms": 16},
    {"op": "citysit_ticks", "count": 1, "ms": 4000},
    {"op": "citysit_expect", "state": {"status": 3, "elapsed": 4.0, "time_limit": 40.0, "warning_given": false}},
    {"op": "citysit_clear_events"},
    {"op": "citysit_ticks", "count": 6, "ms": 1000},
    {"op": "citysit_expect_event_count", "filter": {"event": "sound"}, "count": 0},
    {"op": "citysit_expect", "state": {"elapsed": 10.0, "warning_given": false}},
    {"op": "citysit_ticks", "count": 1, "ms": 1000},
    {"op": "citysit_expect_events", "filter": {"event": "sound"}, "events": [{"event": "sound", "automaton": "0x700", "sound": "0x6C32871F"}]},
    {"op": "citysit_expect", "state": {"elapsed": 11.0, "warning_given": true}},
    {"op": "citysit_ticks", "count": 28, "ms": 1000},
    {"op": "citysit_expect", "state": {"status": 3, "elapsed": 39.0}},
    {"op": "citysit_ticks", "count": 1, "ms": 1000},
    {"op": "citysit_expect", "state": {"status": 2, "elapsed": 40.0, "end_delay": 1.0}},
    {"op": "citysit_expect_event_count", "filter": {"event": "sound"}, "count": 0}
  ]
}
