{
  "format": 1,
  "name": "pollution_cycle",
  "spec": ["pollution 4.1", "pollution 4.5", "pollution 4.8", "pollution 11.17", "pollution 11.18"],
  "description": "Test 17: a 256 x 256-cell city has 128 x 128 tracts -> tractsPerDay = 16384 / 15 = 1092; Init resets the 16384-entry table with 16383 rand() calls (random_shuffle, foundations 12.6) and takes the first entry. 15 days visit 15 x 1092 = 16380 tracts (no end of cycle: no DealStatus post); the 16384th visit, on day 16, ends the cycle (DealStatus posted once) and resets the table (16383 more rand() calls). Test 18: airSum 50,000 with 100 developed tracts -> avgAir 500, history 0x0A1100E8 = 500; radiationSum 2 -> radPct = 2 x 100 / 100 = 2, 0xEA110137 = 2 (raw), 0xEA110138 = 500 + 2 = 502; waterSumTreated 3000 -> avgWater 30; totalUncollected 1000 -> avgGarbage 10 and the uncollected flag; lastWaterSum / lastTreatedSum take waterSum / treatedSum; the dirty air flag posts AirChanged, then DealStatus with data1 8; sums and flags are zeroed. With no developed tract all averages and radPct are 0.",
  "steps": [
    {"op": "pollution_env", "cells": [256, 256]},
    {"op": "pollution_create"},
    {"op": "pollution_crt", "mark": true},
    {"op": "pollution_init"},
    {"op": "pollution_crt", "rand_calls": 16383, "mark": true},
    {"op": "pollution_expect", "state": {"tracts_per_day": 1092, "iterator": {"rect": [0, 0, 127, 127], "table_len": 16384, "index": 1}}},
    {"op": "pollution_clear_events"},
    {"op": "pollution_message", "type": "SimNewDay", "count": 15},
    {"op": "pollution_expect_event_count", "filter": {"event": "post", "type": "DealStatus"}, "count": 0},
    {"op": "pollution_crt", "rand_calls": 0},
    {"op": "pollution_message", "type": "SimNewDay"},
    {"op": "pollution_expect_event_count", "filter": {"event": "post", "type": "DealStatus"}, "count": 1},
    {"op": "pollution_expect_event_count", "filter": {"event": "post", "type": "DealStatus", "data1": 8}, "count": 1},
    {"op": "pollution_crt", "rand_calls": 16383},

    {"op": "pollution_env", "cells": [128, 128]},
    {"op": "pollution_create"},
    {"op": "pollution_init"},
    {"op": "pollution_set", "state": {"air_sum": 50000, "developed_tracts": 100, "radiation_sum": 2, "water_sum_treated": 3000,
      "water_sum": 4000, "treated_sum": 1000, "total_uncollected": 1000, "dirty_air": true}},
    {"op": "pollution_clear_events"},
    {"op": "pollution_call", "method": "end_of_cycle"},
    {"op": "pollution_expect_events", "events": [
      {"event": "history", "series": "0x0A1100E8", "value": 500},
      {"event": "history", "series": "0xEA110130", "value": 30},
      {"event": "history", "series": "0xEA110134", "value": 10},
      {"event": "history", "series": "0xEA110137", "value": 2},
      {"event": "history", "series": "0xEA110138", "value": 502},
      {"event": "post", "type": "AirChanged", "data1": 0},
      {"event": "post", "type": "DealStatus", "data1": 8}]},
    {"op": "pollution_expect", "state": {"avg_air": 500, "avg_water": 30, "avg_garbage": 10, "garbage_uncollected": true,
      "last_water_sum": 4000, "last_treated_sum": 1000, "air_sum": 0, "water_sum": 0, "water_sum_treated": 0, "treated_sum": 0,
      "radiation_sum": 0, "developed_tracts": 0, "dirty_air": false, "total_uncollected": 1000}},
    {"op": "pollution_call", "method": "average_air_value", "expect": 500},
    {"op": "pollution_call", "method": "average_water_value", "expect": 30},
    {"op": "pollution_call", "method": "average_garbage_value", "expect": 10},
    {"op": "pollution_call", "method": "is_garbage_uncollected", "expect": true},
    {"op": "pollution_set", "state": {"air_sum": 7, "radiation_sum": 3, "total_uncollected": 0,
      "dirty_radiation": true, "dirty_water": true, "dirty_garbage": true}},
    {"op": "pollution_call", "method": "end_of_cycle"},
    {"op": "pollution_expect_events", "events": [
      {"event": "history", "series": "0x0A1100E8", "value": 0},
      {"event": "history", "series": "0xEA110130", "value": 0},
      {"event": "history", "series": "0xEA110134", "value": 0},
      {"event": "history", "series": "0xEA110137", "value": 3},
      {"event": "history", "series": "0xEA110138", "value": 0},
      {"event": "post", "type": "RadiationChanged"},
      {"event": "post", "type": "WaterChanged"},
      {"event": "post", "type": "GarbageChanged"},
      {"event": "post", "type": "DealStatus", "data1": 8}]},
    {"op": "pollution_expect", "state": {"avg_air": 0, "garbage_uncollected": false}}
  ]
}
