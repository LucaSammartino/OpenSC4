{
  "format": 1,
  "name": "net_lot_state_ring",
  "spec": ["network-manager 6.2", "network-manager 16.23"],
  "description": "NM10/NM11: the lot-state boundary walk starts at (0,0), visits row 0, columns 9 and 12 through row 22, then row 23. Pending drains in SGI hash order. Both corner streets are styled; the interior is untouched. City clipping retains the origin.",
  "steps": [
    {"op": "net_create"},
    {"op": "net_lot", "lot": "0x9999", "rect": [10, 20, 11, 22]},
    {"op": "net_call", "method": "add_border_to_pending", "args": [[9, 19, 12, 23]]},
    {"op": "net_expect", "of": "lots", "state": {"pending_count": 61}},
    {"op": "net_call", "method": "process_update_list"},
    {"op": "net_occupant", "occupant": "0x60", "flags": ["street", "usable"], "cell": [9, 19]},
    {"op": "net_occupant", "occupant": "0x61", "flags": ["street", "usable"], "cell": [10, 20]},
    {"op": "net_occupant", "occupant": "0x62", "flags": ["street", "usable"], "cell": [12, 23]},
    {"op": "net_clear_events"},
    {"op": "net_message", "of": "lots", "type": "LotStateChanged", "unknown": "0x9999", "expect": true},
    {"op": "net_expect_events", "filter": {"event": "texture"}, "events": [
      {"occupant": "0x62"}, {"occupant": "0x60"}
    ]},
    {"op": "net_expect", "of": "lots", "state": {"pending": []}},
    {"op": "net_expect_refs", "refs": {"0x9999": 0}},
    {"op": "net_call", "method": "add_border_to_pending", "args": [[-1, -1, 1, 1]]},
    {"op": "net_expect", "of": "lots", "state": {"pending": [[0, 0], [0, 1], [1, 0], [1, 1]]}}
  ]
}
