{
  "format": 1,
  "name": "flora_obliteration",
  "spec": ["flora 10.3", "flora 4.1"],
  "description": "Derived by hand from flora 10.3 and 4.1 step 12 (test 30 of 16). SaveObliterated(segment 7) with three flora in the occupant manager (and one building, not listed) writes record (0xC9BB3FC6, 0xC9BB3FC7, 1) = u32 3, then for each occupant i in list order: clear flag 1, write the occupant into (0xC9BB3FC6, 0x4A664F83, i) (so it is saved with the flag clear), set flag 1 again. The replacement city's Init finds the segment in the new-city specification: for each i < 3 it creates and reads a flora occupant, Init()s it, inserts it and releases its own reference (the occupant manager keeps one). Without an occupant manager the restore returns false; without the count record it restores nothing and returns true.",
  "steps": [
    {"op": "flora_types", "types": [{"type": "0x1000", "table": 0.6}, {"type": "0x2000", "table": 0.6}]},
    {"op": "flora_env", "occupants": [
      {"id": 1, "type": "flora", "flora_type": "0x1000", "pos": [100, 260, 100], "state": 2},
      {"id": 2, "type": "flora", "flora_type": "0x2000", "pos": [200, 260, 100], "state": 1},
      {"id": 3, "type": "flora", "flora_type": "0x1000", "pos": [300, 260, 100], "state": 0},
      {"id": 4, "type": "building", "pos": [400, 260, 100]}]},
    {"op": "flora_create"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_clear_events"},
    {"op": "flora_call", "method": "save_obliterated", "args": [7], "expect": true},
    {"op": "flora_expect_events", "events": [
      {"event": "seg_write", "segment": 7, "key": ["0xC9BB3FC6", "0xC9BB3FC7", 1], "value": 3},
      {"event": "set_flag", "occupant": 1, "on": false},
      {"event": "seg_write", "segment": 7, "key": ["0xC9BB3FC6", "0x4A664F83", 0], "occupant": 1, "in_manager": false},
      {"event": "set_flag", "occupant": 1, "on": true},
      {"event": "set_flag", "occupant": 2, "on": false},
      {"event": "seg_write", "segment": 7, "key": ["0xC9BB3FC6", "0x4A664F83", 1], "occupant": 2, "in_manager": false},
      {"event": "set_flag", "occupant": 2, "on": true},
      {"event": "set_flag", "occupant": 3, "on": false},
      {"event": "seg_write", "segment": 7, "key": ["0xC9BB3FC6", "0x4A664F83", 2], "occupant": 3, "in_manager": false},
      {"event": "set_flag", "occupant": 3, "on": true}]},
    {"op": "flora_expect_segment", "segment": 7, "count": 4, "records": [
      {"key": ["0xC9BB3FC6", "0xC9BB3FC7", 1], "u32": 3},
      {"key": ["0xC9BB3FC6", "0x4A664F83", 0], "flora_type": "0x1000"},
      {"key": ["0xC9BB3FC6", "0x4A664F83", 1], "flora_type": "0x2000"},
      {"key": ["0xC9BB3FC6", "0x4A664F83", 2], "flora_type": "0x1000"}]},
    {"op": "flora_expect_occupant", "occupant": 1, "in_manager": true},

    {"op": "flora_env", "segment": 7, "forget": [1, 2, 3, 4]},
    {"op": "flora_create"},
    {"op": "flora_clear_events"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_expect_events", "filter": {"event": "read_occupant"}, "events": [
      {"event": "read_occupant", "occupant": 1000, "key": ["0xC9BB3FC6", "0x4A664F83", 0]},
      {"event": "read_occupant", "occupant": 1001, "key": ["0xC9BB3FC6", "0x4A664F83", 1]},
      {"event": "read_occupant", "occupant": 1002, "key": ["0xC9BB3FC6", "0x4A664F83", 2]}]},
    {"op": "flora_expect_occupant", "occupant": 1000, "in_manager": true, "flora_type": "0x1000", "state": 2, "pos": [100, 260, 100]},
    {"op": "flora_expect_occupant", "occupant": 1001, "in_manager": true, "flora_type": "0x2000", "state": 1},
    {"op": "flora_expect_occupant", "occupant": 1002, "in_manager": true, "flora_type": "0x1000", "state": 0},
    {"op": "flora_expect_refs", "refs": {"1000": 1, "1001": 1, "1002": 1}},
    {"op": "flora_create"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_clear_events"},
    {"op": "flora_call", "method": "restore_obliterated", "args": [7], "expect": true},
    {"op": "flora_expect_events", "events": [
      {"event": "read_occupant", "occupant": 1006}, {"event": "init", "occupant": 1006}, {"event": "insert", "occupant": 1006},
      {"event": "read_occupant", "occupant": 1007}, {"event": "init", "occupant": 1007}, {"event": "insert", "occupant": 1007},
      {"event": "read_occupant", "occupant": 1008}, {"event": "init", "occupant": 1008}, {"event": "insert", "occupant": 1008}]},
    {"op": "flora_call", "method": "restore_obliterated", "args": [8], "expect": true},
    {"op": "flora_expect_events", "events": []},
    {"op": "flora_env", "manager": false},
    {"op": "flora_call", "method": "restore_obliterated", "args": [7], "expect": false},
    {"op": "flora_expect_events", "events": []}
  ]
}
