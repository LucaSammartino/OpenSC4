{
  "format": 1,
  "name": "flora_obliteration",
  "spec": ["flora 10.3", "flora 4.1", "FQ3"],
  "description": "Derived by hand from flora 10.3 and 4.1 step 12 (test 30 of 16; FQ3). Every record starts with a u16 record version 0 written by the record helper; a stream whose GetError() is set after it is closed again and the record counts as not open. SaveObliterated(segment 7) with three flora in the occupant manager (and one building, not listed) writes the count record (0xC9BB3FC6, 0xC9BB3FC7, 1) = 00 00 03 00 00 00 (u16 0, u32 3), then for each occupant i in list order record (0xC9BB3FC6, 0x4A664F83, i) = 00 00 followed by the occupant's own record (the test host's stand-in starts with its u16 version 3; flag 1 is cleared around the Write, so it is saved clear, then set again). With record 1 failing, occupant 1001's flag is not touched (AQ4: the flag is toggled only when the record opens) and occupant 1002 still goes to record 2 (i advances for every occupant); the count is still 3. The replacement city's Init finds the segment in the new-city specification: the count is read (u16 then u32), then for each i < count whose record opens: create a flora occupant, Read it from the record (u16 first, never checked), Init, InsertOccupant, release our reference (the occupant manager keeps one), then close the record (AQ5: the record helper lives for the whole iteration). A count record whose u16 is 7 restores the same; without the count record nothing is restored (true); a count record whose GetUint32 fails leaves the count 0 (AQ6); a count record whose stream reports an error is not open. Without an occupant manager the restore reads the count first, then returns false.",
  "steps": [
    {"op": "flora_types", "types": [{"type": "0x1000", "table": 0.6}, {"type": "0x2000", "table": 0.6}]},
    {"op": "flora_env", "occupants": [
      {"id": 1, "type": "flora", "flora_type": "0x1000", "pos": [100, 260, 100], "state": 2},
      {"id": 2, "type": "flora", "flora_type": "0x2000", "pos": [200, 260, 100], "state": 1},
      {"id": 3, "type": "flora", "flora_type": "0x1000", "pos": [300, 260, 100], "state": 0},
      {"id": 4, "type": "building", "pos": [400, 260, 100]}]},
    {"op": "flora_create"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_clear_events"},
    {"op": "flora_call", "method": "save_obliterated", "args": [7], "expect": true},
    {"op": "flora_expect_events", "events": [
      {"event": "seg_open", "segment": 7, "key": ["0xC9BB3FC6", "0xC9BB3FC7", 1], "write": true, "stream": 1},
      {"event": "seg_close", "stream": 1},
      {"event": "seg_open", "segment": 7, "key": ["0xC9BB3FC6", "0x4A664F83", 0], "write": true, "stream": 2},
      {"event": "set_flag", "occupant": 1, "on": false},
      {"event": "write_occupant", "occupant": 1, "in_manager": false},
      {"event": "set_flag", "occupant": 1, "on": true},
      {"event": "seg_close", "stream": 2},
      {"event": "seg_open", "segment": 7, "key": ["0xC9BB3FC6", "0x4A664F83", 1], "write": true, "stream": 3},
      {"event": "set_flag", "occupant": 2, "on": false},
      {"event": "write_occupant", "occupant": 2, "in_manager": false},
      {"event": "set_flag", "occupant": 2, "on": true},
      {"event": "seg_close", "stream": 3},
      {"event": "seg_open", "segment": 7, "key": ["0xC9BB3FC6", "0x4A664F83", 2], "write": true, "stream": 4},
      {"event": "set_flag", "occupant": 3, "on": false},
      {"event": "write_occupant", "occupant": 3, "in_manager": false},
      {"event": "set_flag", "occupant": 3, "on": true},
      {"event": "seg_close", "stream": 4}]},
    {"op": "flora_expect_segment", "segment": 7, "count": 4, "records": [
      {"key": ["0xC9BB3FC6", "0xC9BB3FC7", 1], "hex": "0000 03000000"},
      {"key": ["0xC9BB3FC6", "0x4A664F83", 0], "hex": "0000030000100000000000000000000002000000c842000082430000c84200"},
      {"key": ["0xC9BB3FC6", "0x4A664F83", 1], "hex": "00000300002000000000000000000000010000004843000082430000c84200"},
      {"key": ["0xC9BB3FC6", "0x4A664F83", 2], "hex": "00000300001000000000000000000000000000009643000082430000c84200"}]},
    {"op": "flora_expect_occupant", "occupant": 1, "in_manager": true},

    {"op": "flora_env", "segment": 7, "forget": [1, 2, 3, 4]},
    {"op": "flora_create"},
    {"op": "flora_clear_events"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_expect_events", "filter": {"event": "read_occupant"}, "events": [
      {"event": "read_occupant", "occupant": 1000, "key": ["0xC9BB3FC6", "0x4A664F83", 0]},
      {"event": "read_occupant", "occupant": 1001, "key": ["0xC9BB3FC6", "0x4A664F83", 1]},
      {"event": "read_occupant", "occupant": 1002, "key": ["0xC9BB3FC6", "0x4A664F83", 2]}]},
    {"op": "flora_expect_occupant", "occupant": 1000, "in_manager": true, "flora_type": "0x1000", "state": 2, "pos": [100, 260, 100]},
    {"op": "flora_expect_occupant", "occupant": 1001, "in_manager": true, "flora_type": "0x2000", "state": 1},
    {"op": "flora_expect_occupant", "occupant": 1002, "in_manager": true, "flora_type": "0x1000", "state": 0},
    {"op": "flora_expect_refs", "refs": {"1000": 1, "1001": 1, "1002": 1}},

    {"op": "flora_env", "segment": null, "segment_error_keys": [["0xC9BB3FC6", "0x4A664F83", 1]]},
    {"op": "flora_create"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_clear_events"},
    {"op": "flora_call", "method": "save_obliterated", "args": [9], "expect": true},
    {"op": "flora_expect_events", "filter": {"event": "set_flag"}, "events": [
      {"event": "set_flag", "occupant": 1000, "on": false}, {"event": "set_flag", "occupant": 1000, "on": true},
      {"event": "set_flag", "occupant": 1002, "on": false}, {"event": "set_flag", "occupant": 1002, "on": true}]},
    {"op": "flora_expect_segment", "segment": 9, "count": 3, "records": [
      {"key": ["0xC9BB3FC6", "0xC9BB3FC7", 1], "hex": "0000 03000000"},
      {"key": ["0xC9BB3FC6", "0x4A664F83", 0], "hex": "0000030000100000000000000000000002000000c842000082430000c84200"},
      {"key": ["0xC9BB3FC6", "0x4A664F83", 2], "hex": "00000300001000000000000000000000000000009643000082430000c84200"}], "absent": [["0xC9BB3FC6", "0x4A664F83", 1]]},
    {"op": "flora_env", "segment_error_keys": []},

    {"op": "flora_clear_events"},
    {"op": "flora_call", "method": "restore_obliterated", "args": [7], "expect": true},
    {"op": "flora_expect_events", "events": [
      {"event": "seg_open", "key": ["0xC9BB3FC6", "0xC9BB3FC7", 1], "write": false},
      {"event": "seg_close"},
      {"event": "seg_open", "key": ["0xC9BB3FC6", "0x4A664F83", 0], "write": false},
      {"event": "create", "occupant": 1003},
      {"event": "read_occupant", "occupant": 1003, "key": ["0xC9BB3FC6", "0x4A664F83", 0]},
      {"event": "init", "occupant": 1003},
      {"event": "insert", "occupant": 1003},
      {"event": "seg_close"},
      {"event": "seg_open", "key": ["0xC9BB3FC6", "0x4A664F83", 1], "write": false},
      {"event": "create", "occupant": 1004},
      {"event": "read_occupant", "occupant": 1004, "key": ["0xC9BB3FC6", "0x4A664F83", 1]},
      {"event": "init", "occupant": 1004},
      {"event": "insert", "occupant": 1004},
      {"event": "seg_close"},
      {"event": "seg_open", "key": ["0xC9BB3FC6", "0x4A664F83", 2], "write": false},
      {"event": "create", "occupant": 1005},
      {"event": "read_occupant", "occupant": 1005, "key": ["0xC9BB3FC6", "0x4A664F83", 2]},
      {"event": "init", "occupant": 1005},
      {"event": "insert", "occupant": 1005},
      {"event": "seg_close"}]},
    {"op": "flora_expect_occupant", "occupant": 1004, "in_manager": true, "flora_type": "0x2000", "state": 1, "pos": [200, 260, 100]},
    {"op": "flora_expect_refs", "refs": {"1003": 1, "1004": 1, "1005": 1}},

    {"op": "flora_env", "segment_records": [{"segment": 7, "key": ["0xC9BB3FC6", "0xC9BB3FC7", 1], "hex": "0700 02000000"}]},
    {"op": "flora_call", "method": "restore_obliterated", "args": [7], "expect": true},
    {"op": "flora_expect_event_count", "filter": {"event": "insert"}, "count": 2},
    {"op": "flora_clear_events"},
    {"op": "flora_env", "segment_records": [{"segment": 7, "key": ["0xC9BB3FC6", "0xC9BB3FC7", 1], "hex": null}]},
    {"op": "flora_call", "method": "restore_obliterated", "args": [7], "expect": true},
    {"op": "flora_expect_events", "events": [{"event": "seg_open", "key": ["0xC9BB3FC6", "0xC9BB3FC7", 1], "write": false, "stream": null}]},
    {"op": "flora_env", "segment_records": [{"segment": 7, "key": ["0xC9BB3FC6", "0xC9BB3FC7", 1], "hex": "0000"}]},
    {"op": "flora_call", "method": "restore_obliterated", "args": [7], "expect": true},
    {"op": "flora_expect_events", "events": [{"event": "seg_open", "key": ["0xC9BB3FC6", "0xC9BB3FC7", 1]}, {"event": "seg_close"}]},
    {"op": "flora_env", "segment_records": [{"segment": 7, "key": ["0xC9BB3FC6", "0xC9BB3FC7", 1], "hex": "0000 03000000"}], "segment_error_keys": [["0xC9BB3FC6", "0xC9BB3FC7", 1]]},
    {"op": "flora_call", "method": "restore_obliterated", "args": [7], "expect": true},
    {"op": "flora_expect_events", "events": [{"event": "seg_open", "key": ["0xC9BB3FC6", "0xC9BB3FC7", 1]}, {"event": "seg_close"}]},
    {"op": "flora_env", "segment_error_keys": [], "manager": false},
    {"op": "flora_call", "method": "restore_obliterated", "args": [7], "expect": false},
    {"op": "flora_expect_events", "events": [{"event": "seg_open", "key": ["0xC9BB3FC6", "0xC9BB3FC7", 1]}, {"event": "seg_close"}]}
  ]
}
