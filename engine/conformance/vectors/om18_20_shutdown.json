{
  "format": 1,
  "name": "om18_20_shutdown",
  "spec": ["occupant-manager 2.3", "occupant-manager 2.4", "occupant-manager 18.20"],
  "description": "Shutdown posts Remove and Destroy for every occupant (x-major, per occupant), returns true, clears the initialised flag and nulls the shared filter; the rows are kept. A second Shutdown is a no-op. [choice] Slot 23 with the null filter does nothing (the original crashes). Release of the last reference shuts down and destroys.",
  "steps": [
    {"op": "om_create"},
    {"op": "om_call", "method": "set_city_size", "args": [1024, 1024], "expect": true},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_occupant", "occupant": "0x1", "min": [10, 0, 10], "max": [20, 10, 20]},
    {"op": "om_occupant", "occupant": "0x2", "min": [10, 0, 10], "max": [100, 10, 20]},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x2", "data4": 0, "expect": true},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "shutdown", "expect": true},
    {"op": "om_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x99EF1143", "occupant": "0x2"}, {"event": "post", "type": "0x99EF1141", "occupant": "0x2"}, {"event": "post", "type": "0x99EF1143", "occupant": "0x1"}, {"event": "post", "type": "0x99EF1141", "occupant": "0x1"}]},
    {"op": "om_expect", "state": {"initialized": false, "filter_type": null, "rows": 192, "holders": 0}},
    {"op": "om_expect_refs", "refs": {"0x1": 0, "0x2": 0}},
    {"op": "om_call", "method": "shutdown", "expect": true},
    {"op": "om_expect_events", "events": []},
    {"op": "om_call", "method": "remove_occupants_typed", "type": 5, "shutdown": true, "expect": true},
    {"op": "om_call", "method": "by_cells", "expect": false},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_expect", "state": {"initialized": true, "filter_type": 0, "rows": 192}},
    {"op": "om_call", "method": "add_ref", "expect": 1},
    {"op": "om_call", "method": "add_ref", "expect": 2},
    {"op": "om_call", "method": "release", "expect": 1},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 0, "expect": true},
    {"op": "om_call", "method": "release", "expect": 0},
    {"op": "om_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x99EF1140", "occupant": "0x1"}, {"event": "post", "type": "0x99EF1142", "occupant": "0x1"}, {"event": "post", "type": "0x99EF1143", "occupant": "0x1"}, {"event": "post", "type": "0x99EF1141", "occupant": "0x1"}]},
    {"op": "om_expect", "state": {"destroyed": true, "initialized": false}}
  ]
}
