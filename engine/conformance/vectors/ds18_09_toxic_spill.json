{
  "format": 1,
  "name": "disaster_toxic_spill",
  "spec": ["disasters 9", "disasters 18.9"],
  "description": "AttemptDisasterStart spills 120 units: the toxic instance begins an episode and ticks at priority 0xFF, one update a second. Unattended each update takes 1: after 119 updates 1 is left; at the 120th the occupant is removed and DisasterHasEnded runs (0xAA1B2002). With one hose each update takes 4: 30 updates.",
  "steps": [
    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_clear_events"},
    {"op": "dis_call", "method": "attempt_start", "args": ["toxic", 3, 4], "expect": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "emergency_pause"}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "register_tick", "instance": 1, "priority": "0xFF"}, "count": 1},
    {"op": "dis_expect_events", "filter": {"event": "toxic"}, "events": [
      {"event": "toxic", "instance": 1, "occupant": "0xC000", "x": 3, "z": 4, "amount": 120}
    ]},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000, "count": 119},
    {"op": "dis_expect", "state": {"toxic_instance": 1, "toxic_amounts": [1]}},
    {"op": "dis_clear_events"},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000},
    {"op": "dis_expect_event_count", "filter": {"event": "remove_toxic", "occupant": "0xC000"}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "post", "type": "0xAA1B2002"}, "count": 1},
    {"op": "dis_expect", "state": {"toxic_instance": null, "ongoing": 0}},

    {"op": "dis_call", "method": "spill_toxic_waste", "args": [3, 4, 120], "expect": 2},
    {"op": "dis_call", "method": "toxic_set_hosed", "args": ["0xC001", 1], "expect": true},
    {"op": "dis_tick", "instance": 2, "advance_ms": 1000, "count": 29},
    {"op": "dis_expect", "state": {"toxic_amounts": [4]}},
    {"op": "dis_tick", "instance": 2, "advance_ms": 1000},
    {"op": "dis_expect", "state": {"toxic_instance": null}}
  ]
}
