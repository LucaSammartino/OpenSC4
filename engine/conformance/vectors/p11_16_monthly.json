        "0xEA1CF222": {"f32": 20}}},
    {"op": "pollution_occupant", "occupant": "wte", "props": {"0x48EBD0B1": {"u32": 1000}, "0x27812852": {"u32": 40}}},
    {"op": "pollution_message", "type": "OccupantInserted", "occupant": "inc"},
    {"op": "pollution_message", "type": "OccupantInserted", "occupant": "wte"},
    {"op": "pollution_occupant", "occupant": "inc", "tract": [5, 5],
      "props": {"0xA8EBCF0C": {"u32": 1000}, "0xC910B4CF": {"f32": 0}, "0xEA1CF220": {"f32": 10}, "0xEA1CF221": {"f32": 5},
        "0xEA1CF222": {"f32": 20}, "0xE8ECF641": {"u32": 500}}},
    {"op": "pollution_occupant", "occupant": "wte",
