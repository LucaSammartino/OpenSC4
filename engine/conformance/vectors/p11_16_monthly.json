    {"op": "pollution_set", "state": {"incinerated": 1000, "wte": 0, "landfilled": 3000, "produced": 0, "decomposed": 123,
      "export_capacity": 77, "efficiency": 1}},
    {"op": "pollution_clear_events"},
    {"op": "pollution_message", "type": "SimNewMonth", "expect": true},
    {"op": "pollution_expect_event_count", "filter": {"event": "deal_used", "deal": "imp", "used": 0}, "count": 1},
    {"op": "pollution_expect_event_count", "filter": {"event": "deal_used", "deal": "exp", "used": 0}, "count": 1},
    {"op": "pollution_expect_event_count", "filter": {"event": "lot_condition"}, "count": 0},
    {"op": "pollution_expect_event_count", "filter": {"event": "mark_deals_dirty"}, "count": 1},
    {"op": "pollution_expect_events", "filter": {"event": "full_expenses"}, "events": [{"event": "full_expenses", "line": 20, "value": 25}]},
    {"op": "pollution_expect", "state": {"last_month_cost": 25, "last_incinerated": 1000, "last_landfilled": 3000, "incinerated": 0,
      "landfilled": 0, "decomposed_last_month": 123, "decomposed": 0, "export_capacity": 0}},
    {"op": "pollution_expect_occupant", "occupant": "inc", "props": {"0xC910B4CF": 4.5, "0xA8FCDBA8": 500, "0xE8ECF641": 0}},
    {"op": "pollution_expect_occupant", "occupant": "wte", "props": {"0x27812852": 10, "0x28FCDBB0": 250, "0x88ECF76C": 0}},
    {"op": "pollution_call", "method": "garbage_incinerated_last_month", "expect": 1000},
    {"op": "pollution_call", "method": "garbage_landfilled_last_month", "expect": 3000},
    {"op": "pollution_call", "method": "garbage_abducted_prev_month", "expect": 123},

    {"op": "pollution_message", "type": "SimNewMonth"},
    {"op": "pollution_expect_events", "filter": {"event": "lot_condition"}, "events": [
      {"event": "lot_condition", "x": 11, "z": 11, "condition": 2}]},
    {"op": "pollution_expect_occupant", "occupant": "inc", "props": {"0xC910B4CF": 5.5, "0xA8FCDBA8": 0}},
    {"op": "pollution_expect", "state": {"last_month_cost": 5, "last_incinerated": 0}},

