      {"event": "history", "series": "0x8AB2F258", "value": 0},
      {"event": "history", "series": "0x6AB2F260", "value": 0},
      {"event": "history", "series": "0xEA11016F", "value": 0},
      {"event": "history", "series": "0xEA110197", "value": 1000},
