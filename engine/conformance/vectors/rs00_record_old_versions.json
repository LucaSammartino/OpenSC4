{
  "format": 1,
  "name": "residential_record_old_versions",
  "spec": ["residential 9.2", "RS1"],
  "description": "Section 9.2: department blocks of records older than version 5 hold percentages, converted with the float32 0.01f (RS1): f0 60 -> 0x3F199999, max funding 120 -> 0x3F999999, strike efficiency 20 -> 0x3E4CCCCC, min grade 90 -> 0x3F666666, initial funding 25 -> 0.25; the 100.0 field stays. Version 5 converts only the min grade; version 6 converts nothing. Reading a record also releases what it replaces [choice]: the departments the reader created at its own Init (with the department release Shutdown uses) and the occupants of its lists (one Release each).",
  "steps": [
    {"op": "residential_create"},
    {"op": "residential_init", "expect": true},
    {"op": "residential_set", "state": {
      "health": {"f0": 60, "max_funding": 120, "strike_efficiency": 20, "min_grade": 90, "init_funding": 25},
      "education": {"f0": 60, "max_funding": 120, "strike_efficiency": 20, "min_grade": 90, "init_funding": 25}
    }},
    {"op": "residential_write", "slot": "a", "expect": true},
    {"op": "residential_read", "slot": "a", "version": 4, "length": 450, "expect": true},
    {"op": "residential_expect", "bits": true, "state": {
      "health": {"f0": "0x3F199999", "max_funding": "0x3F999999", "strike_efficiency": "0x3E4CCCCC", "min_grade": "0x3F666666", "init_funding": "0x3E800000", "hundred": "0x42C80000"},
      "education": {"f0": "0x3F199999", "max_funding": "0x3F999999", "strike_efficiency": "0x3E4CCCCC", "min_grade": "0x3F666666", "init_funding": "0x3E800000", "hundred": "0x42C80000"}
    }},
    {"op": "residential_read", "slot": "a", "version": 5, "length": 450, "expect": true},
    {"op": "residential_expect", "bits": true, "state": {
      "health": {"f0": "0x42700000", "max_funding": "0x42F00000", "init_funding": "0x41C80000", "strike_efficiency": "0x41A00000", "min_grade": "0x3F666666"}
    }},
    {"op": "residential_read", "slot": "a", "version": 6, "length": 450, "expect": true},
    {"op": "residential_expect", "bits": true, "state": {
      "education": {"min_grade": "0x42B40000", "strike_efficiency": "0x41A00000"}
    }},

    {"op": "residential_create"},
    {"op": "residential_init", "expect": true},
    {"op": "residential_set", "state": {"lists": {"pending_school": [11]}}},
    {"op": "residential_write", "slot": "b", "expect": true},
    {"op": "residential_create"},
    {"op": "residential_init", "expect": true},
    {"op": "residential_expect", "state": {"departments": [908, 909, 910, 911]}},
    {"op": "residential_set", "state": {"lists": {"other": [77, null]}}},
    {"op": "residential_clear_events"},
    {"op": "residential_read", "slot": "b", "reuse": true, "expect": true},
    {"op": "residential_expect_event_count", "filter": {"event": "release", "id": 77}, "count": 1},
    {"op": "residential_expect_event_count", "filter": {"event": "release"}, "count": 1},
    {"op": "residential_expect_events", "filter": {"event": "release_department"}, "events": [{"token": 908}, {"token": 909}, {"token": 910}, {"token": 911}]},
    {"op": "residential_expect", "state": {"departments": [904, 905, 906, 907], "lists": {"pending_school": [11], "other": []}}}
  ]
}
