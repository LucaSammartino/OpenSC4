{
  "format": 1,
  "name": "power_flood_wire_centre",
  "spec": ["power 2.1", "power 2.2", "power 5.1", "power 5.2", "power 6.3", "power 15.8", "power 15.9", "power 15.10"],
  "description": "Tests 8, 9 and 10, by hand from 2.1, 2.2 and 5.1. Test 8: wire bits (0,0), (1,0), (1,1), (2,2); the flood from (0,0) with rowMin 0, rowMax 1 marks (1,0) in the first horizontal pass and (1,1) in the vertical pass (4-connectivity); (2,2) touches the marked set only diagonally and stays unmarked; rows 0 and 1 changed, so the band and rowMax widen to 2: (rowMin, rowMax) = (0, 2). A seed on an unwired cell stays marked alone. Test 9: Expand with R = 2: x1 > R ? x1 - R : 0, x2 + R clamped to 255: building (10,10)-(11,11) -> (8,8)-(13,13); (0,0)-(1,1) -> (0,0)-(3,3); (254,254)-(255,255) -> (252,252)-(255,255); a conducting network piece (flag 0x40000) wires only its cell (100,100); a pole and a line wire their cell's neighbourhood ((50,50) -> 48..52, (70,70) -> 68..72); an ignored pole (slot 13), a preview line, a network piece with 0x80000000, one without 0x40000 and a pole whose QueryInterface fails wire nothing. The kept pole adds its cost 1 to costBase and counts in poleCount. Test 10: bounding box x 32..64, z 16..48 -> centre trunc((32 + 64) x 0.5 / 16) = 3, trunc(32 / 16) = 2: requirement 300 stored at (3, 2); 40000 stored as int16 -25536 (at (61, 2) for box x 960..992); requirement sums the u32 values (40300); a flood from (61, 2) sees no positive consumption: demand 0, and with avail 0 no block is powered. Removing that consumer subtracts (int16)40000 again (cell back to 0), consumers 1, requirement 300, and marks its cells expanded by R dirty: (58, 0)-(63, 4).",
  "steps": [
    {"op": "power_create"},
    {"op": "power_init"},
    {"op": "power_set", "wire": [[0, 0], [1, 0], [1, 1], [2, 2]]},
    {"op": "power_call", "method": "flood", "args": [0, 0], "expect": [0, 2]},
    {"op": "power_expect_bitmap", "bitmap": "mark", "cells": [[0, 0], [1, 0], [1, 1]], "unset": [[2, 2]], "exact": true},
    {"op": "power_call", "method": "flood", "args": [10, 10]},
    {"op": "power_expect_bitmap", "bitmap": "mark", "cells": [[10, 10]], "exact": true},

    {"op": "power_env", "occupants": [
      {"id": 61, "type": "building", "cells": [10, 10, 11, 11]},
      {"id": 62, "type": "building", "cells": [0, 0, 1, 1]},
      {"id": 63, "type": "building", "cells": [254, 254, 255, 255]},
      {"id": 64, "type": "network", "cell": [100, 100], "flags": "0x40000"},
      {"id": 65, "type": "pole", "cell": [50, 50], "props": {"0x09132DE8": {"i64": 1}}},
      {"id": 66, "type": "line", "cell": [70, 70]},
      {"id": 67, "type": "pole", "cell": [150, 150], "ignored": true, "props": {"0x09132DE8": {"i64": 1}}},
      {"id": 68, "type": "line", "cell": [160, 160], "preview": true},
      {"id": 69, "type": "network", "cell": [170, 170], "flags": "0x80040000"},
      {"id": 70, "type": "network", "cell": [180, 180], "flags": 0},
      {"id": 71, "type": "pole", "cell": [190, 190], "qi": false}]},
    {"op": "power_create"},
    {"op": "power_init"},
    {"op": "power_call", "method": "expand", "args": [[10, 10, 11, 11]], "expect": [8, 8, 13, 13]},
    {"op": "power_call", "method": "expand", "args": [[0, 0, 1, 1]], "expect": [0, 0, 3, 3]},
    {"op": "power_call", "method": "expand", "args": [[254, 254, 255, 255]], "expect": [252, 252, 255, 255]},
    {"op": "power_message", "type": "OccupantInserted", "occupant": 61},
    {"op": "power_expect_bitmap", "bitmap": "wire", "rects": [[8, 8, 13, 13]], "exact": true},
    {"op": "power_expect", "state": {"recompute": false, "consumers": 0, "plant_count": 0}},
    {"op": "power_message", "type": "OccupantInserted", "occupants": [62, 63, 64, 65, 66, 67, 68, 69, 70, 71]},
    {"op": "power_expect_bitmap", "bitmap": "wire", "cells": [[100, 100]],
      "rects": [[8, 8, 13, 13], [0, 0, 3, 3], [252, 252, 255, 255], [48, 48, 52, 52], [68, 68, 72, 72]], "exact": true},
    {"op": "power_expect", "state": {"pole_count": 1, "poles": [65], "cost_base": 1, "recompute": true}},
    {"op": "power_call", "method": "is_wired", "args": [100, 100], "expect": true},
    {"op": "power_call", "method": "is_wired", "args": [101, 100], "expect": false},
    {"op": "power_call", "method": "power_pole_count", "expect": 1},

    {"op": "power_env", "occupants": [
      {"id": 72, "type": "building", "cells": [2, 1, 3, 2], "bbox": [[32, 0, 16], [64, 0, 48]], "props": {"0x27812854": {"u32": 300}}},
      {"id": 73, "type": "building", "cells": [60, 1, 61, 2], "bbox": [[960, 0, 16], [992, 0, 48]], "props": {"0x27812854": {"u32": 40000}}}]},
    {"op": "power_create"},
    {"op": "power_init"},
    {"op": "power_message", "type": "OccupantInserted", "occupants": [72, 73]},
    {"op": "power_call", "method": "monthly_consumption_at", "args": [3, 2], "expect": 300},
    {"op": "power_call", "method": "monthly_consumption_at", "args": [61, 2], "expect": -25536},
    {"op": "power_call", "method": "monthly_requirement", "expect": 40300},
    {"op": "power_expect", "state": {"consumers": 2, "requirement": 40300}},
    {"op": "power_call", "method": "update_power_grid", "args": [61, 2]},
    {"op": "power_expect", "state": {"demand": 0, "powered": 0, "consumption": 0}},
    {"op": "power_expect_bitmap", "bitmap": "next", "count": 0},
    {"op": "power_message", "type": "OccupantRemoved", "occupant": 73},
    {"op": "power_call", "method": "monthly_consumption_at", "args": [61, 2], "expect": 0},
    {"op": "power_expect", "state": {"consumers": 1, "requirement": 300, "wire_dirty": true, "dirty_rect": [58, 0, 63, 4], "recompute": true}}
  ]
}
