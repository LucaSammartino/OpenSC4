{
  "format": 1,
  "name": "civic_init",
  "spec": ["civic-buildings 1", "civic-buildings 3", "civic-buildings 4.1", "civic-buildings 4.2", "civic-buildings 12.1"],
  "description": "QueryInterface answers 1, 0x8A41322F, 0x452294AA and 0xE4FDA3D4; GetGZCLSID is 0x0A413481. On an empty budget Init creates Landmarks (0x8A416368, group 0x6A357B96, name 0x6A3FF01C/0xCA491DD2), Building Maintenance (0xEA59717A, 0xEA597195, 0x4A59726D) and Business Deals (0x2A5A723F, 0x0A5A72D1, 0x8A5A7330), each with maximum funding 1.0, holds only Landmarks, subscribes 0xE8BDA2E7, 0x99EF1142, 0x99EF1143, registers one agent at level 6 with flags 2 and the Lua table. A second Init does nothing. A Landmarks department loaded from a save is reused, existing departments are not recreated. Shutdown unregisters Lua, releases the list entries, removes the agent, releases Landmarks and unsubscribes; Release at count 1 runs Shutdown and returns 0.",
  "steps": [
    {"op": "civic_create"},
    {"op": "civic_identity", "class": "0x0A413481",
      "iids": {"0x1": true, "0x8A41322F": true, "0x452294AA": true, "0xE4FDA3D4": true, "0x0": false, "0x077ABEB2": false, "0xAA3FE6BC": false}},
    {"op": "civic_init", "expect": true},
    {"op": "civic_expect_events", "events": [
      {"event": "create_department", "id": "0x8A416368", "group": "0x6A357B96"},
      {"event": "add_ref", "token": "0x8A416368"},
      {"event": "department_name", "department": "0x8A416368", "group": "0x6A3FF01C", "instance": "0xCA491DD2"},
      {"event": "max_funding", "department": "0x8A416368", "max": 1.0},
      {"event": "create_department", "id": "0xEA59717A", "group": "0xEA597195"},
      {"event": "department_name", "department": "0xEA59717A", "group": "0x6A3FF01C", "instance": "0x4A59726D"},
      {"event": "max_funding", "department": "0xEA59717A", "max": 1.0},
      {"event": "create_department", "id": "0x2A5A723F", "group": "0x0A5A72D1"},
      {"event": "department_name", "department": "0x2A5A723F", "group": "0x6A3FF01C", "instance": "0x8A5A7330"},
      {"event": "max_funding", "department": "0x2A5A723F", "max": 1.0},
      {"event": "subscribe", "type": "0xE8BDA2E7"},
      {"event": "subscribe", "type": "0x99EF1142"},
      {"event": "subscribe", "type": "0x99EF1143"},
      {"event": "agent", "level": 6, "name": "cSC4CivicBuildingSimulator", "flags": 2},
      {"event": "register_lua"}
    ]},
    {"op": "civic_expect", "state": {"initialized": true, "landmarks": "0x8A416368"}},
    {"op": "civic_expect_refs", "refs": {"0x8A416368": 1, "0xEA59717A": 0, "0x2A5A723F": 0}},
    {"op": "civic_init", "expect": true},
    {"op": "civic_expect_events", "events": []},

    {"op": "civic_write", "slot": "a", "expect": true},
    {"op": "civic_read", "slot": "a", "expect": true},
    {"op": "civic_clear_events"},
    {"op": "civic_init", "expect": true},
    {"op": "civic_expect_event_count", "filter": {"event": "create_department"}, "count": 0},
    {"op": "civic_expect_event_count", "filter": {"event": "add_ref"}, "count": 0},
    {"op": "civic_expect", "state": {"landmarks": "0x8A416368"}},
    {"op": "civic_expect_refs", "refs": {"0x8A416368": 2}},

    {"op": "civic_building", "occupant": "0x11", "type": "0x03000001"},
    {"op": "civic_building", "occupant": "0x12", "type": "0x03000002"},
    {"op": "civic_set", "disease_centers": ["0x11", null], "maintained": ["0x12", "0x12"], "exclusions": [5]},
    {"op": "civic_call", "method": "update_status", "args": [7, 0, 0, ""], "expect": true},
    {"op": "civic_clear_events"},
    {"op": "civic_shutdown", "expect": true},
    {"op": "civic_expect_events", "events": [
      {"event": "unregister_lua"},
      {"event": "release", "token": "0x11"},
      {"event": "release", "token": "0x12"},
      {"event": "release", "token": "0x12"},
      {"event": "remove_agent"},
      {"event": "release", "token": "0x8A416368"},
      {"event": "unsubscribe", "type": "0xE8BDA2E7"},
      {"event": "unsubscribe", "type": "0x99EF1142"},
      {"event": "unsubscribe", "type": "0x99EF1143"}
    ]},
    {"op": "civic_expect", "state": {"initialized": false, "landmarks": null, "disease_centers": [], "maintained": [],
      "exclusions": [5], "status_keys": [7]}},
    {"op": "civic_shutdown", "expect": true},
    {"op": "civic_expect_events", "events": []},

    {"op": "civic_create"},
    {"op": "civic_init", "expect": true},
    {"op": "civic_add_ref", "expect": 1},
    {"op": "civic_add_ref", "expect": 2},
    {"op": "civic_release", "expect": 1},
    {"op": "civic_clear_events"},
    {"op": "civic_release", "expect": 0},
    {"op": "civic_expect", "state": {"destroyed": true, "initialized": false}},
    {"op": "civic_expect_event_count", "filter": {"event": "remove_agent"}, "count": 1}
  ]
}
