{
  "format": 1,
  "name": "protection_chance_of_strike",
  "spec": ["protection 6.4", "protection 18.5"],
  "description": "Test 5: GetChanceOfStrike over two stations with local funding 0.5 and 0.2 (in that list order; c = 10 x 0.01f = 0.099999994 and 40 x 0.01f = 0.39999998 under protection 6.2 PR3): p := (p + c) - p c from 0, each step float32 -> 0.45999998 (0x3EEB851E; this vector expected 0.46 within tolerance before PR3, now bit-exact); with the city strike flag set 1.0; with no stations 0 (both classes). A station without an item counts f = 1.0 (c = 0). Hand-derived; bit pattern from an independent numpy float32 model.",
  "steps": [
    {"op": "protection_create", "kind": "police"},
    {"op": "protection_env", "tuning": "shipped"},
    {"op": "protection_init"},
    {"op": "protection_call", "method": "chance_of_strike", "expect": 0.0},
    {"op": "protection_occupants", "1": {"station": ["police", 50, 10, 64, 1], "pos": [100, 0, 100], "items": {"0x0A567BAA": {"local": 0.5}}}, "2": {"station": ["police", 50, 10, 64, 1], "pos": [300, 0, 300], "items": {"0x0A567BAA": {"local": 0.2}}}, "3": {"station": ["police", 50, 10, 64, 1], "pos": [500, 0, 500]}},
    {"op": "protection_message", "type": "OccupantInserted", "occupant": 1},
    {"op": "protection_message", "type": "OccupantInserted", "occupant": 2},
    {"op": "protection_message", "type": "OccupantInserted", "occupant": 3},
    {"op": "protection_expect", "state": {"stations": [1, 2, 3]}},
    {"op": "protection_call", "method": "chance_of_strike", "bits": true, "expect": "0x3EEB851E"},
    {"op": "protection_set", "state": {"strike_flag": true}},
    {"op": "protection_call", "method": "chance_of_strike", "expect": 1.0},
    {"op": "protection_create", "kind": "fire"},
    {"op": "protection_env", "tuning": "shipped"},
    {"op": "protection_init"},
    {"op": "protection_call", "method": "chance_of_strike", "expect": 0.0},
    {"op": "protection_occupants", "1": {"station": ["fire", 50, 10, 64, 1], "pos": [100, 0, 100], "items": {"0xEA567BC3": {"local": 0.5}}}, "2": {"station": ["fire", 50, 10, 64, 1], "pos": [300, 0, 300], "items": {"0xEA567BC3": {"local": 0.2}}}},
    {"op": "protection_message", "type": "OccupantInserted", "occupant": 1},
    {"op": "protection_message", "type": "OccupantInserted", "occupant": 2},
    {"op": "protection_call", "method": "chance_of_strike", "bits": true, "expect": "0x3EEB851E"}
  ]
