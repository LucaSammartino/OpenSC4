    {"op": "demand_node", "node": "D", "method": "set_demand", "args": [1000000]},
    {"op": "demand_node", "node": "D", "method": "calculate_active_demand"},
    {"op": "demand_node", "node": "D", "method": "active_demand", "expect": 1000000},
    {"op": "demand_expect_events", "events": [{"event": "post", "key": 7, "data2": 0}]},

    {"op": "demand_new_node", "node": "S"},
    {"op": "demand_node", "node": "S", "method": "set_active_min", "args": [-1000]},
    {"op": "demand_node", "node": "S", "method": "set_active_max", "args": [1000]},
    {"op": "demand_node", "node": "S", "method": "set_supply", "args": [200]},
    {"op": "demand_node", "node": "S", "method": "calculate_active_demand", "args": [false]},
    {"op": "demand_node", "node": "S", "method": "active_demand", "expect": -200},
    {"op": "demand_node", "node": "S", "method": "set_supply", "args": [0]},
