    {"op": "demand_node", "node": "N", "method": "active_demand", "expect": -6000},
    {"op": "demand_expect_events", "events": [{"event": "post", "data2": -98}, {"event": "post", "data2": -100}, {"event": "post", "data2": -1000}]},

    {"op": "demand_node", "node": "N", "method": "set_supply", "args": [0]},
    {"op": "demand_node", "node": "N", "method": "set_demand", "args": [3]},
    {"op": "demand_node", "node": "N", "method": "calculate_active_demand"},
    {"op": "demand_node", "node": "N", "method": "set_demand", "args": [9]},
