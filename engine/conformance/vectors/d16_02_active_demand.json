    {"op": "demand_node", "node": "N", "method": "set_demand", "args": [400]},
    {"op": "demand_node", "node": "N", "method": "set_supply", "args": [1000]},
    {"op": "demand_node", "node": "N", "method": "calculate_active_demand"},
    {"op": "demand_node", "node": "N", "method": "active_demand", "expect": -588},
    {"op": "demand_node", "node": "N", "method": "set_economy_modifier", "args": [0]},
