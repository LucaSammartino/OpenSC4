    {"op": "demand_node", "node": "S", "method": "calculate_active_demand", "args": [true]},
    {"op": "demand_node", "node": "S", "method": "active_demand", "expect": 0},
    {"op": "demand_node", "node": "S", "method": "calculate_active_demand", "args": [true]},
    {"op": "demand_node", "node": "S", "method": "active_demand", "expect": 140},
    {"op": "demand_node", "node": "S", "method": "calculate_active_demand", "args": [true]},
    {"op": "demand_node", "node": "S", "method": "active_demand", "expect": 280},
    {"op": "demand_node", "node": "S", "method": "calculate_active_demand", "args": [true]},
    {"op": "demand_node", "node": "S", "method": "calculate_active_demand", "args": [true]},
    {"op": "demand_node", "node": "S", "method": "active_demand", "expect": 500},
    {"op": "demand_expect_events", "events": [{"data2": -200}, {"data2": 0}, {"data2": 140}, {"data2": 280}, {"data2": 420}, {"data2": 500}]}
  ]
}
