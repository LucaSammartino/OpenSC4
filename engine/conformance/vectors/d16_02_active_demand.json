    {"op": "demand_node", "node": "N", "method": "set_id", "args": ["0x21010"]},
    {"op": "demand_node", "node": "N", "method": "set_active_min", "args": [-6000]},
    {"op": "demand_node", "node": "N", "method": "set_active_max", "args": [6000]},
    {"op": "demand_node", "node": "N", "method": "set_demand", "args": [1000]},
    {"op": "demand_node", "node": "N", "method": "set_supply", "args": [400]},
    {"op": "demand_node", "node": "N", "method": "calculate_active_demand"},
    {"op": "demand_node", "node": "N", "method": "active_demand", "expect": 600},
    {"op": "demand_expect_events", "events": [{"event": "post", "key": "0x21010", "data2": 100}]},

    {"op": "demand_node", "node": "N", "method": "set_economy_modifier", "args": [0.03], "expect": true},
    {"op": "demand_node", "node": "N", "method": "economy_modifier", "expect": 0.03},
    {"op": "demand_node", "node": "N", "method": "active_demand", "expect": 600},
    {"op": "demand_node", "node": "N", "method": "calculate_active_demand"},
    {"op": "demand_node", "node": "N", "method": "active_demand", "expect": 630},
    {"op": "demand_expect_events", "events": [{"event": "post", "data2": 105}]},

    {"op": "demand_node", "node": "N", "method": "set_tax_modifier", "args": [-0.05], "expect": true},
