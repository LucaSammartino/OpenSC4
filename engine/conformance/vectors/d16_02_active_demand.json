    {"op": "demand_node", "node": "N", "method": "calculate_active_demand"},
    {"op": "demand_node", "node": "N", "method": "active_demand", "expect": 480},
    {"op": "demand_node", "node": "N", "method": "set_tax_modifier", "args": [0]},

    {"op": "demand_node", "node": "N", "method": "set_demand_cap", "args": [0.95], "expect": true},
