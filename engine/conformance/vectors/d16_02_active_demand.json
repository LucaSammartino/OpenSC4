    {"op": "demand_node", "node": "N", "method": "simulation_begin", "expect": true},
    {"op": "demand_expect_events", "events": [{"event": "post", "key": "0x21010", "data2": -2}, {"event": "post", "key": "0x21010", "data2": -1}]},
    {"op": "demand_node", "node": "N", "method": "set_supply", "args": [0]},
    {"op": "demand_node", "node": "N", "method": "set_demand", "args": [9]},
    {"op": "demand_node", "node": "N", "method": "simulation_begin", "expect": true},
    {"op": "demand_expect_events", "events": [{"event": "post", "data2": 2}, {"event": "post", "data2": 1}]},

