{
  "format": 1,
  "name": "bds_lifecycle",
  "spec": ["building-development 1.1", "building-development 1.3", "building-development 1.4", "building-development 1.5", "building-development 3.1"],
  "description": "Init, Shutdown, Release and QueryInterface, by hand from 1.1 and 1.3-1.5. Exemplars in key-list order: building 0x100, foundation 0x500, retaining wall 0x600, developer 0x3110, developer 0x1010, a type-4 exemplar without property 0x21 (ignored), an exemplar of type 7 (ignored). Init (day 1000, IDs from 256: BDS 256): register the static cleanup, post BuildingTypesUpdated with data2 = 1 building, create + Init developer 0x3110 (257) then 0x1010 (258) in exemplar order, acquire the services, create the building map (instance 0x49D5B678, tract size 1, ID 259), create the construction node (260: supply 100, demand 0), subscribe [StateChanged, TerrainChanged, OccupantInserted, OccupantRemoved, PlaceBuilding], register command 0x0B99AE81 'PlaceBuilding', add the agent at levels 0, 4, 6, 10 (name cSC4BuildingDevelopmentSimulator, flags 2), register the cheats HowDryIAm, FightThePower, Barstuck. The developer map is ordered by type; highestStage 0 and lastSuccessfulBuild = today for both. A second Init does nothing. Shutdown: unregister the 3 cheats, remove the agent, unsubscribe the same 5 types, unregister the command, then Shutdown + Release each developer in ascending type (258 = 0x1010 first), release the services; everything cleared. A second Shutdown does nothing. Re-Init in the same process does not rebuild the catalogue (no cleanup registration, no post) but creates new developers, map and node; a second BDS in the same process shares the catalogue. AddRef / Release: Release above 1 decrements; the last Release runs Shutdown and destroys (returns 0). QueryInterface: 1 and 0x07813EAE -> primary, 0xE98B2F57 -> message target, 0x452294AA -> message target 2, 0xE4FDA3D4 -> serializable, anything else (e.g. 0xC9BD939A) -> none. GetGZCLSID = 0x8990BE7A. DoMessage returns true for every message, including unknown types.",
  "steps": [
    {"op": "bds_process", "seed": 1},
    {"op": "bds_world", "tuning": "shipped"},
    {"op": "bds_exemplars", "list": [
      {"building": "0x100", "purpose": 1, "wealth": 1},
      {"foundation": "0x500"},
      {"wall": "0x600"},
      {"developer": "0x3110"},
      {"developer": "0x1010"},
      {"developer": 0},
      {"instance": "0x700", "group": "0x1234", "props": {"0x10": {"u32": 7}, "0x21": {"u32": "0x1020"}}}]},
    {"op": "bds_create"},
    {"op": "bds_expect", "state": {"initialized": false, "ref_count": 1, "developers": {}, "has_map": false, "node_id": null, "catalogue_loaded": false}},
    {"op": "bds_init", "expect": true},
    {"op": "bds_expect_events", "events": [
      {"event": "static_cleanup"},
      {"event": "post", "type": "0xA783EBC8", "data2": 1},
      {"event": "create_developer", "dev": 257},
      {"event": "developer_init", "dev": 257, "type": "0x3110"},
      {"event": "create_developer", "dev": 258},
      {"event": "developer_init", "dev": 258, "type": "0x1010"},
      {"event": "acquire_services"},
      {"event": "create_grid", "instance": "0x49D5B678", "tract_size": 1, "id": 259},
      {"event": "create_node", "id": 260},
      {"event": "subscribe", "types": ["0xE8BDA2E7", "0x278E6003", "0x99EF1142", "0x99EF1143", "0x0B99AE81"]},
      {"event": "register_command", "id": "0x0B99AE81", "name": "PlaceBuilding"},
      {"event": "add_agent", "level": 0, "name": "cSC4BuildingDevelopmentSimulator", "flags": 2},
      {"event": "add_agent", "level": 4, "name": "cSC4BuildingDevelopmentSimulator", "flags": 2},
      {"event": "add_agent", "level": 6, "name": "cSC4BuildingDevelopmentSimulator", "flags": 2},
      {"event": "add_agent", "level": 10, "name": "cSC4BuildingDevelopmentSimulator", "flags": 2},
      {"event": "register_cheat", "id": "0x491865E1", "name": "HowDryIAm"},
      {"event": "register_cheat", "id": "0x08DAD89A", "name": "FightThePower"},
      {"event": "register_cheat", "id": "0x6AB6A2D7", "name": "Barstuck"}]},
    {"op": "bds_expect", "state": {"initialized": true, "developers": {"0x1010": 258, "0x3110": 257},
      "highest_stage": {"0x1010": 0, "0x3110": 0}, "last_build": {"0x1010": 1000, "0x3110": 1000},
      "has_map": true, "map_id": 259, "node_id": 260, "supply": 100.0, "demand": 0.0, "state": 0,
      "cell_counts": [64, 64], "catalogue_loaded": true, "building_count": 1, "cr_min": 8192}},
    {"op": "bds_call", "method": "all_foundation_types", "expect": {"count": 1, "vector": [1280]}},
    {"op": "bds_call", "method": "all_wall_types", "expect": {"count": 1, "vector": [1536]}},
    {"op": "bds_call", "method": "developer", "args": ["0x1010"], "expect": 258},
    {"op": "bds_call", "method": "developer", "args": ["0x1020"], "expect": null},
    {"op": "bds_call", "method": "developer_by", "args": [2, 1], "expect": 257},
    {"op": "bds_clear_events"},
    {"op": "bds_init", "expect": true},
    {"op": "bds_expect_events", "events": []},

    {"op": "bds_shutdown", "expect": true},
    {"op": "bds_expect_events", "events": [
      {"event": "unregister_cheat", "id": "0x491865E1"},
      {"event": "unregister_cheat", "id": "0x08DAD89A"},
      {"event": "unregister_cheat", "id": "0x6AB6A2D7"},
      {"event": "remove_agent"},
      {"event": "unsubscribe", "types": ["0xE8BDA2E7", "0x278E6003", "0x99EF1142", "0x99EF1143", "0x0B99AE81"]},
      {"event": "unregister_command", "id": "0x0B99AE81"},
      {"event": "developer_shutdown", "dev": 258},
      {"event": "developer_release", "dev": 258},
      {"event": "developer_shutdown", "dev": 257},
      {"event": "developer_release", "dev": 257},
      {"event": "release_services"}]},
    {"op": "bds_expect", "state": {"initialized": false, "developers": {}, "highest_stage": {}, "has_map": false,
      "node_id": null, "decline_plan": [], "special_buildings": [], "catalogue_loaded": true, "building_count": 1}},
    {"op": "bds_expect_refs", "developers": {"257": 0, "258": 0}},
    {"op": "bds_shutdown", "expect": true},
    {"op": "bds_expect_events", "events": []},

    {"op": "bds_init", "expect": true},
    {"op": "bds_expect_event_count", "filter": {"event": "static_cleanup"}, "count": 0},
    {"op": "bds_expect_event_count", "filter": {"event": "post"}, "count": 0},
    {"op": "bds_expect_event_count", "filter": {"event": "create_developer"}, "count": 2},
    {"op": "bds_expect", "state": {"developers": {"0x1010": 262, "0x3110": 261}, "map_id": 263, "node_id": 264}},

    {"op": "bds_create"},
    {"op": "bds_clear_events"},
    {"op": "bds_init", "expect": true},
    {"op": "bds_expect_event_count", "filter": {"event": "static_cleanup"}, "count": 0},
    {"op": "bds_expect", "state": {"developers": {"0x1010": 267, "0x3110": 266}, "building_count": 1}},

    {"op": "bds_add_ref", "expect": 2},
    {"op": "bds_add_ref", "expect": 3},
    {"op": "bds_release", "expect": 2},
    {"op": "bds_release", "expect": 1},
    {"op": "bds_expect", "state": {"initialized": true, "destroyed": false, "ref_count": 1}},
    {"op": "bds_clear_events"},
    {"op": "bds_release", "expect": 0},
    {"op": "bds_expect_event_count", "filter": {"event": "remove_agent"}, "count": 1},
    {"op": "bds_expect", "state": {"initialized": false, "destroyed": true, "ref_count": 0, "developers": {}}},

    {"op": "bds_call", "method": "query_interface", "args": [1], "expect": "primary"},
    {"op": "bds_call", "method": "query_interface", "args": ["0x07813EAE"], "expect": "primary"},
    {"op": "bds_call", "method": "query_interface", "args": ["0xE98B2F57"], "expect": "message_target"},
    {"op": "bds_call", "method": "query_interface", "args": ["0x452294AA"], "expect": "message_target2"},
    {"op": "bds_call", "method": "query_interface", "args": ["0xE4FDA3D4"], "expect": "serializable"},
    {"op": "bds_call", "method": "query_interface", "args": ["0xC9BD939A"], "expect": null},
    {"op": "bds_call", "method": "query_interface", "args": [0], "expect": null},
    {"op": "bds_call", "method": "class_id", "expect": "0x8990BE7A"},
    {"op": "bds_message", "type": "0x12345678", "expect": true}
  ]
}
