{
  "format": 1,
  "name": "prop_developer_wealth_selection",
  "spec": ["prop-developer 4.1", "prop-developer 5", "prop-developer 12"],
  "description": "Section 12 test 9: the wealth requester's SelectProp keeps the IDs whose profile wealth equals the lot's occupant wealth and draws U(n) from the wealth file generator. Candidates of wealth (1, 2, 3, 2) on a lot of wealth 2: one draw U(2), result the second or fourth ID. A lot of wealth 3 at a cell of zone type 12 (seaport; also 11 airport and 15 plopped) counts as wealth 2: the same. No candidate: 0 and no draw. Without a lot at the cell the network lot manager's wealth for the cell is used.",
  "steps": [
    {"op": "pv_requester", "token": "0x13B42BB8", "share": 0, "satisfaction": "0x49A1E996", "custom": true},
    {"op": "pv_requester", "token": "0x11347690", "share": 0, "satisfaction": "0xE9A4300B", "custom": false},
    {"op": "pv_create"},
    {"op": "pv_init", "expect": true},
    {"op": "pv_add_requester", "token": "0x13B42BB8", "class": "0x8990C09A"},
    {"op": "pv_add_requester", "token": "0x11347690", "class": "0x8990C065"},
    {"op": "pv_clear_events"},
    {"op": "pv_env", "profiles": [[1, "0x49A1E995", 1], [2, "0x49A1E995", 2], [3, "0x49A1E995", 3], [4, "0x49A1E995", 2]]},
    {"op": "pv_lot", "lot": "0x10", "x": 5, "z": 5, "wealth": 2},
    {"op": "pv_script", "wealth": [1, 0, 1]},
    {"op": "pv_wealth_select", "ids": [1, 2, 3, 4], "x": 5, "z": 5, "expect": 4},
    {"op": "pv_expect_events", "filter": {"event": "draw"}, "events": [{"gen": "wealth", "call": "U", "n": 2, "value": 1}]},
    {"op": "pv_wealth_select", "ids": [1, 2, 3, 4], "x": 5, "z": 5, "expect": 2},
    {"op": "pv_lot", "lot": "0x10", "wealth": 3},
    {"op": "pv_env", "zones": [[5, 5, 12]]},
    {"op": "pv_wealth_select", "ids": [1, 2, 3, 4], "x": 5, "z": 5, "expect": 4},
    {"op": "pv_expect_events", "filter": {"event": "draw"}, "events": [{"n": 2, "value": 0}, {"n": 2, "value": 1}]},
    {"op": "pv_env", "zones": [[5, 5, 0]]},
    {"op": "pv_wealth_select", "ids": [1, 2, 4], "x": 5, "z": 5, "expect": 0},
    {"op": "pv_expect_events", "filter": {"event": "draw"}, "events": []},
    {"op": "pv_network_lot", "token": "0x50", "cell": [40, 40], "wealth": 1},
    {"op": "pv_script", "wealth": [0]},
    {"op": "pv_wealth_select", "ids": [1, 2], "x": 40, "z": 40, "expect": 1}
  ]
}
