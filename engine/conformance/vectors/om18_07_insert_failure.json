{
  "format": 1,
  "name": "om18_07_insert_failure",
  "spec": ["occupant-manager 5.1", "occupant-manager 15", "occupant-manager 18.7"],
  "description": "An occupant without a property holder: Insert returns false, but its Init already ran, so Create is posted [quirk 5]. The reference taken is released (net 0), flag 1 stays clear, no box is stored, the cell stays empty. A null occupant returns false.",
  "steps": [
    {"op": "om_create"},
    {"op": "om_call", "method": "set_city_size", "args": [1024, 1024], "expect": true},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_occupant", "occupant": "0x1", "min": [10, 0, 10], "max": [20, 10, 20], "holder": false},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 0, "expect": false},
    {"op": "om_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x99EF1140", "occupant": "0x1", "data4": 0}]},
    {"op": "om_expect_refs", "refs": {"0x1": 0}},
    {"op": "om_expect_occupant", "occupant": "0x1", "state": {"flags": 0, "om_box": null}},
    {"op": "om_call", "method": "is_cell_empty", "args": [64, 64], "expect": true},
    {"op": "om_call", "method": "insert", "occupant": 0, "expect": false}
  ]
}
