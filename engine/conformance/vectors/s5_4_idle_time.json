{
  "format": 1,
  "name": "idle_time",
  "spec": ["5.1", "5.4"],
  "description": "Idle agents share leftover frame time: SimIdle data1 = Julian day, data2 = 1 while paused, data3 = min(budget - elapsed, budget / 3). SimulateIdleTime walks the idle cursor to the end; OnTick keeps calling it (restarting from the first idle agent) until the budget is used. Frame budget = max(15, target - frame elapsed) with target 1000/targetFps, or 33 when paused. Hidden pause stops OnTick before any work. Frozen clock; each idle call costs 10 ms.",
  "clock": {"start_ms": 0, "auto_step_ms": 0},
  "agents": {
    "I1": {"cost_ms": 10},
    "I2": {"cost_ms": 10}
  },
  "steps": [
    {"op": "add_agent", "agent": "I1", "level": 10},
    {"op": "add_agent", "agent": "I2", "level": 10},
    {"op": "init"},
    {"op": "hidden_resume"},
    {"op": "clear_events"},

    {"op": "tick", "note": "elapsed 0, target 1000/30 = 33"},
    {"op": "expect_state", "state": {"frame_budget_ms": 33, "in_tick": false}},
    {"op": "expect_events", "filter": {"event": "deliver"}, "events": [
      {"agent": "I1", "type": "SimIdle", "data1": 2451545, "data2": 0, "data3": 11, "t": 0},
      {"agent": "I2", "type": "SimIdle", "data1": 2451545, "data2": 0, "data3": 11, "t": 10},
      {"agent": "I1", "type": "SimIdle", "data1": 2451545, "data2": 0, "data3": 11, "t": 20},
      {"agent": "I2", "type": "SimIdle", "data1": 2451545, "data2": 0, "data3": 3, "t": 30}
    ]},

    {"op": "pause"},
    {"op": "set_clock", "now_ms": 1000},
    {"op": "tick", "note": "frame elapsed 1000 -> max(15, 33 - 1000) = 15"},
    {"op": "expect_state", "state": {"frame_budget_ms": 15}},
    {"op": "expect_events", "filter": {"event": "deliver"}, "events": [
      {"agent": "I1", "type": "SimIdle", "data1": 2451545, "data2": 1, "data3": 5, "t": 1000},
      {"agent": "I2", "type": "SimIdle", "data1": 2451545, "data2": 1, "data3": 5, "t": 1010}
    ]},
    {"op": "tick", "note": "frame elapsed 20 -> max(15, 13) = 15"},
    {"op": "expect_events", "filter": {"event": "deliver"}, "events": [
      {"agent": "I1", "data2": 1, "data3": 5, "t": 1020},
      {"agent": "I2", "data2": 1, "data3": 5, "t": 1030}
    ]},
    {"op": "simulate_idle_time", "note": "slice elapsed 20 >= 15: nothing"},
    {"op": "expect_events", "events": []},

    {"op": "set_agent_enabled", "name": "I1", "enabled": false},
    {"op": "set_clock", "now_ms": 1020},
    {"op": "simulate_idle_time", "note": "slice elapsed 0: I1 skipped, I2 delivered"},
    {"op": "expect_events", "events": [
      {"event": "deliver", "agent": "I2", "data2": 1, "data3": 5, "t": 1020}
    ]},
    {"op": "expect_state", "state": {"idle_cursor": -1}},

    {"op": "hidden_pause"},
    {"op": "clear_events"},
    {"op": "tick", "count": 3},
    {"op": "simulate_idle_time"},
    {"op": "expect_events", "events": []},
    {"op": "expect_state", "state": {"frame_budget_ms": 33}}
  ]
}
