    {"op": "residential_call", "method": "get_cell_eq", "args": [0, 0], "bits": true, "expect": "0x42855555"},
    {"op": "residential_call", "method": "tract_quotient", "args": ["eq", 0, 0], "bits": true, "expect": "0x42855555"},
