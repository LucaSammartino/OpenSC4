{
  "format": 1,
  "name": "hw12_01_init",
  "spec": ["history 3", "history 1", "history 12"],
  "description": "Test 1. Init subscribes the record (0x89EFA536) and queue-length (0x89EFA537) messages and registers the day (4) and year (7) agents named cSC4HistoryWarehouse with flags 3; passState 0. QueryInterface answers 1, 0x69F4A803 and 0xE4FDA3D4 and nothing else (not cIGZMessageTarget2 0x452294AA, [quirk]). Init has no 'already initialised' test: a second call registers again. Shutdown unsubscribes both, removes the agents and keeps the series.",
  "steps": [
    {"op": "hw_create"},
    {"op": "hw_call", "method": "init", "expect": true},
    {"op": "hw_expect_events", "events": [{"event": "subscribe", "msg": "0x89EFA536"}, {"event": "subscribe", "msg": "0x89EFA537"}, {"event": "add_agent", "level": 4, "name": "cSC4HistoryWarehouse", "flags": 3}, {"event": "add_agent", "level": 7, "name": "cSC4HistoryWarehouse", "flags": 3}]},
    {"op": "hw_expect", "state": {"initialized": true, "pass_state": 0, "series_count": 0}},
    {"op": "hw_call", "method": "query_interface", "args": [1], "expect": true},
    {"op": "hw_call", "method": "query_interface", "args": ["0x69F4A803"], "expect": true},
    {"op": "hw_call", "method": "query_interface", "args": ["0xE4FDA3D4"], "expect": true},
    {"op": "hw_call", "method": "query_interface", "args": ["0x452294AA"], "expect": false},
    {"op": "hw_call", "method": "query_interface", "args": ["0x89EFA536"], "expect": false},
    {"op": "hw_call", "method": "query_interface", "args": [0], "expect": false},
    {"op": "hw_call", "method": "init", "expect": true},
    {"op": "hw_expect_event_count", "count": 4},
    {"op": "hw_clear_events"},
    {"op": "hw_call", "method": "record", "args": ["0xAA11F837", 5], "expect": true},
    {"op": "hw_clear_events"},
    {"op": "hw_call", "method": "shutdown", "expect": true},
    {"op": "hw_expect_events", "events": [{"event": "unsubscribe", "msg": "0x89EFA536"}, {"event": "unsubscribe", "msg": "0x89EFA537"}, {"event": "remove_agent"}]},
    {"op": "hw_expect", "state": {"initialized": false}, "series": "0xAA11F837", "points": [["2000-01-01", 5]]}
  ]
}
