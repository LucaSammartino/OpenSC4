{
  "format": 1,
  "name": "weather_wind",
  "spec": ["weather 5.1", "weather 6.2", "weather 7", "weather 14.3"],
  "description": "Monthly wind target: the previous target moves to prev; speed = RandomDoubleRangeUniform(2, 4) (stub uniform 0.5 -> 3); the base direction points from the edge with the most CellHasWater cells into the city (W edge -> (1,0), N (z = 0) -> (0,1), E -> (-1,0), S -> (0,-1)), ties broken by the largest (count, dirX, dirZ), so no water gives (1,0); the Gaussian draw is repeated while |spread * g| > 1 (spread 0.2887: g = 4 is redrawn) and the base is rotated by asin(s). SimNewDay in the wind month interpolates linearly with t = (day - 1)/30 (day 16 -> halfway: speed 3, direction (1,2)/sqrt 5); another month leaves the wind alone, which in a hemisphere-shifted city is every calendar month [quirk].",
  "steps": [
    {"op": "weather_env", "size": [8, 8], "month": 1},
    {"op": "weather_tuning", "shipped": true},
    {"op": "weather_create", "rng": {"stub": {"uniform": [0.5], "gaussian": [0], "int": [0]}}},
    {"op": "weather_init", "expect": true},
    {"op": "weather_expect", "state": {"target_wind_speed": 3, "target_wind_dir": [1, 0]}},
    {"op": "weather_call", "method": "onshore_direction", "expect": [1, 0]},
    {"op": "weather_env", "water": [{"x": 1, "z": 0, "w": 5}]},
    {"op": "weather_call", "method": "onshore_direction", "expect": [0, 1]},
    {"op": "weather_clear_events"},
    {"op": "weather_call", "method": "new_current_ambient_values", "args": [3]},
    {"op": "weather_expect_events", "filter": {"event": "rng"}, "events": [
      {"kind": "uniform", "value": 0.5}, {"kind": "gaussian", "value": 0}]},
    {"op": "weather_expect", "state": {"prev_wind_speed": 3, "prev_wind_dir": [1, 0], "target_wind_speed": 3, "target_wind_dir": [0, 1], "wind_month": 3}},

    {"op": "weather_env", "water": [{"x": 0, "z": 1, "d": 6}]},
    {"op": "weather_call", "method": "onshore_direction", "expect": [1, 0]},
    {"op": "weather_env", "water": [{"x": 7, "z": 1, "d": 6}]},
    {"op": "weather_call", "method": "onshore_direction", "expect": [-1, 0]},
    {"op": "weather_env", "water": [{"x": 2, "z": 7, "w": 3}]},
    {"op": "weather_call", "method": "onshore_direction", "expect": [0, -1]},
    {"op": "weather_env", "water": [{"x": 2, "z": 7, "w": 3}, {"x": 2, "z": 0, "w": 3}]},
    {"op": "weather_call", "method": "onshore_direction", "expect": [0, 1]},
    {"op": "weather_env", "water": [{"x": 2, "z": 7, "w": 3}, {"x": 7, "z": 2, "d": 3}]},
    {"op": "weather_call", "method": "onshore_direction", "expect": [0, -1]},
    {"op": "weather_env", "water": [{"x": 0, "z": 2, "d": 3}, {"x": 2, "z": 0, "w": 3}]},
    {"op": "weather_call", "method": "onshore_direction", "expect": [1, 0]},
    {"op": "weather_env", "water": null},
    {"op": "weather_call", "method": "onshore_direction", "expect": [1, 0]},

    {"op": "weather_rng", "stub": {"uniform": [0.25], "gaussian": [4, 0.5]}},
    {"op": "weather_clear_events"},
    {"op": "weather_call", "method": "new_current_ambient_values", "args": [3]},
    {"op": "weather_expect_events", "filter": {"event": "rng"}, "events": [
      {"kind": "uniform", "value": 0.25}, {"kind": "gaussian", "value": 4}, {"kind": "gaussian", "value": 0.5}]},
    {"op": "weather_expect", "state": {"prev_wind_speed": 3, "prev_wind_dir": [0, 1], "target_wind_speed": 2.5,
      "target_wind_dir": [0.98952851, 0.14433757]}},
    {"op": "weather_rng", "stub": {"gaussian": [-3.4]}},
    {"op": "weather_call", "method": "new_current_ambient_values", "args": [3]},
    {"op": "weather_expect", "state": {"target_wind_dir": [0.19148551, -0.98149544]}},

    {"op": "weather_set", "state": {"prev_wind_speed": 2, "prev_wind_dir": [1, 0], "target_wind_speed": 4, "target_wind_dir": [0, 1],
      "wind_month": 3, "wind_speed": 9, "wind_dir": [0, -1]}},
    {"op": "weather_message", "type": "SimNewDay", "date": {"year": 2001, "month": 4, "day": 16}, "expect": true},
    {"op": "weather_expect", "state": {"wind_speed": 9, "wind_dir": [0, -1]}},
    {"op": "weather_message", "type": "SimNewDay", "date": {"year": 2001, "month": 3, "day": 16}, "expect": true},
    {"op": "weather_expect", "state": {"wind_speed": 3, "wind_dir": [0.4472136, 0.8944272]}},
    {"op": "weather_call", "method": "ambient_wind", "expect": {"speed": 3, "v": [1.3416408, 2.6832816]}},
    {"op": "weather_message", "type": "SimNewDay", "date": {"year": 2001, "month": 3, "day": 1}, "expect": true},
    {"op": "weather_expect", "state": {"wind_speed": 2, "wind_dir": [1, 0]}},
    {"op": "weather_message", "type": "SimNewDay", "date": {"year": 2001, "month": 3, "day": 31}, "expect": true},
    {"op": "weather_expect", "state": {"wind_speed": 4, "wind_dir": [0, 1]}},
    {"op": "weather_set", "state": {"prev_wind_speed": 2, "prev_wind_dir": [1, 0], "target_wind_speed": 2, "target_wind_dir": [-1, 0]}},
    {"op": "weather_message", "type": "SimNewDay", "date": {"year": 2001, "month": 3, "day": 16}, "expect": true},
    {"op": "weather_expect", "state": {"wind_speed": 2, "wind_dir": [0, 0]}},

    {"op": "weather_rng", "stub": {"uniform": [0.5], "gaussian": [0]}},
    {"op": "weather_env", "hemisphere": 0, "month": 3},
    {"op": "weather_message", "type": "SimNewMonth", "data3": 3, "expect": true},
    {"op": "weather_expect", "state": {"wind_month": 9, "last_season": 2, "wind_speed": 3, "wind_dir": [0, 1]}},
    {"op": "weather_message", "type": "SimNewDay", "date": {"year": 2001, "month": 3, "day": 16}, "expect": true},
    {"op": "weather_message", "type": "SimNewDay", "date": {"year": 2001, "month": 3, "day": 30}, "expect": true},
    {"op": "weather_expect", "state": {"wind_speed": 3, "wind_dir": [0, 1]}}
  ]
}
