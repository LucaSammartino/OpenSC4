{
  "format": 1,
  "name": "net_corner_rule",
  "spec": ["network-manager 7.6", "network-manager 16.11"],
  "description": "A road at (10, 10) and a terrain message over x 9..10, z 9..10 (flat terrain at 0). Corners 0.005 above: kept (d <= 0.01); 0.02 above: destroyed with the surface tool; 0.001 below: destroyed; kind 4: kept whatever the height; a NaN difference does not count (kept). A pipe 0.02 off survives kind 1 and is destroyed by kind 3 (pipe tool, type 4). Kind 5 makes no destroy query at all (mask 0x1FFF). Kind 6 keeps a piece with flag 0x80000. The corner rule itself: d < 0 or (double) d > 0.01.",
  "steps": [
    {"op": "net_call", "method": "corner_mismatch", "args": [0.005], "expect": false},
    {"op": "net_call", "method": "corner_mismatch", "args": [0.01], "expect": false},
    {"op": "net_call", "method": "corner_mismatch", "args": [0.0100001], "expect": true},
    {"op": "net_call", "method": "corner_mismatch", "args": [-0.000001], "expect": true},
    {"op": "net_call", "method": "corner_mismatch", "args": ["nan"], "expect": false},
    {"op": "net_occupant", "occupant": "0x50", "flags": ["road"], "cell": [10, 10], "height": 0.005},
    {"op": "net_create"},
    {"op": "net_init"},
    {"op": "net_clear_events"},
    {"op": "net_message", "type": "TerrainChanged", "data1": "0x000A000A", "data2": "0x000A000A", "data4": 1},
    {"op": "net_expect_events", "filter": {"event": "destroy"}, "events": []},
    {"op": "net_occupant", "occupant": "0x50", "height": 0.02},
    {"op": "net_message", "type": "TerrainChanged", "data1": "0x000A000A", "data2": "0x000A000A", "data4": 1},
    {"op": "net_expect_events", "filter": {"event": "destroy"}, "events": [{"type": 0, "occupants": ["0x50"]}]},
    {"op": "net_occupant", "occupant": "0x50", "height": -0.001},
    {"op": "net_message", "type": "TerrainChanged", "data1": "0x000A000A", "data2": "0x000A000A", "data4": 1},
    {"op": "net_expect_events", "filter": {"event": "destroy"}, "events": [{"type": 0, "occupants": ["0x50"]}]},
    {"op": "net_message", "type": "TerrainChanged", "data1": "0x000A000A", "data2": "0x000A000A", "data4": 4},
    {"op": "net_expect_events", "filter": {"event": "destroy"}, "events": []},
    {"op": "net_occupant", "occupant": "0x50", "height": "nan"},
    {"op": "net_message", "type": "TerrainChanged", "data1": "0x000A000A", "data2": "0x000A000A", "data4": 1},
    {"op": "net_expect_events", "filter": {"event": "destroy"}, "events": []},

    {"op": "net_occupant", "occupant": "0x50", "remove": true},
    {"op": "net_occupant", "occupant": "0x51", "flags": ["pipe"], "cell": [10, 10], "height": 0.02},
    {"op": "net_message", "type": "TerrainChanged", "data1": "0x000A000A", "data2": "0x000A000A", "data4": 1},
    {"op": "net_expect_events", "filter": {"event": "destroy"}, "events": []},
    {"op": "net_message", "type": "TerrainChanged", "data1": "0x000A000A", "data2": "0x000A000A", "data4": 3},
    {"op": "net_expect_events", "filter": {"event": "destroy"}, "events": [{"type": 4, "occupants": ["0x51"]}]},
    {"op": "net_message", "type": "TerrainChanged", "data1": "0x000A000A", "data2": "0x000A000A", "data4": 5},
    {"op": "net_expect_event_count", "filter": {"event": "query", "mask": "0x1FFF"}, "count": 0},
    {"op": "net_expect_event_count", "filter": {"event": "destroy"}, "count": 0},
    {"op": "net_clear_events"},

    {"op": "net_occupant", "occupant": "0x51", "remove": true},
    {"op": "net_occupant", "occupant": "0x52", "flags": ["road", "flag_80000"], "cell": [10, 10], "height": 1.0},
    {"op": "net_message", "type": "TerrainChanged", "data1": "0x000A000A", "data2": "0x000A000A", "data4": 6},
    {"op": "net_expect_events", "filter": {"event": "destroy"}, "events": []},
    {"op": "net_message", "type": "TerrainChanged", "data1": "0x000A000A", "data2": "0x000A000A", "data4": 1},
    {"op": "net_expect_events", "filter": {"event": "destroy"}, "events": [{"type": 0, "occupants": ["0x52"]}]}
  ]
}
