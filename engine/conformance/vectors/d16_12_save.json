{
  "format": 1,
  "name": "demand_save_round_trip",
  "spec": ["demand 12.1", "demand 12.2", "demand 13", "demand 16.12"],
  "description": "Write -> read -> write gives identical bytes for both record types; the record layouts of 12.1 (nodes as object references, ascending key; previous census) and 12.2 (min before max, flag byte, cap as float). A version 1 simulator record (4 ignored uint32) and a version 1 node record (byte cap) load; version 3 is rejected (the store ignores the Read result, so the simulator stays empty and not loaded, while a node is marked loaded first and keeps its defaults). A loaded simulator starts its census immediately; loaded nodes keep their totals when the exemplars are re-applied (min/max and region use are re-applied), and a node added by a new exemplar gets its initial values.",
  "steps": [
    {"op": "demand_exemplar", "instance": "0x1011", "min": -1000, "max": 1000, "region_use": 1},
    {"op": "demand_exemplar", "instance": "0x21010", "min": -6000, "max": 6000, "demand": 20},
    {"op": "demand_env", "cells": [1, 1], "clock_step": 0},
    {"op": "demand_building", "type": "0x100", "purpose": 1},
    {"op": "demand_cells", "cells": [{"x": 0, "z": 0, "building_type": "0x100", "wealth": 1, "eq": 0, "desirability": 100, "capacity": 10, "workforce": 0.5}]},
    {"op": "demand_create"},
    {"op": "demand_init"},
    {"op": "demand_call", "method": "set_economy_bonuses", "args": [0.5, 0.25]},
    {"op": "demand_env", "air": 10},
    {"op": "demand_message", "type": "SimNewMonth"},
    {"op": "demand_message", "type": "SimIdle", "data3": 100},
    {"op": "demand_message", "type": "SimIdle", "data3": 100},
    {"op": "demand_node", "key": "0x21010", "method": "add_to_demand", "args": [100]},
    {"op": "demand_message", "type": "PreSave", "expect": true},
    {"op": "demand_expect", "state": {"census_state": 3, "commercial_relief": 10, "industrial_relief": 1}},
    {"op": "demand_save", "slot": "a"},
    {"op": "demand_expect_payload", "slot": "a", "class": "simulator", "hex": ""},
    {"op": "demand_expect_payload", "slot": "a", "class": "node", "entry": 0, "hex": "02001110000000002041000000000000000000000000000000000000000000007ac400007a44000020c101000000000000000000000000"},
    {"op": "demand_expect_payload", "slot": "a", "class": "node", "entry": 1, "hex": "020010100200000000000000f042000000000000000000000000000000000080bbc50080bb450000f04201000000000000000000000000"},
    {"op": "demand_load", "slot": "a"},
    {"op": "demand_expect", "state": {"initialized": false, "loaded_from_save": true, "co_economy_bonus": 0.5, "i_economy_bonus": 0.25, "commercial_relief": 10, "industrial_relief": 1, "node_keys": ["0x1011", "0x21010"]}},
    {"op": "demand_expect_node", "key": "0x1011", "state": {"loaded_from_save": true, "supply": 10, "active_demand": -10, "region_use": 0}},
    {"op": "demand_expect_save", "slot": "a"},
    {"op": "demand_exemplar", "instance": "0x21020", "min": -6000, "max": 6000, "demand": 33},
    {"op": "demand_init", "expect": true},
    {"op": "demand_expect", "state": {"initialized": true, "census_state": 0, "co_economy_bonus": 0.5, "commercial_relief": 10, "node_keys": ["0x1011", "0x21010", "0x21020"]}},
    {"op": "demand_expect_node", "key": "0x1011", "state": {"supply": 10, "region_use": 1}},
    {"op": "demand_expect_node", "key": "0x21010", "state": {"demand": 120, "active_demand": 120}},
    {"op": "demand_expect_node", "key": "0x21020", "state": {"demand": 33, "loaded_from_save": false}},
    {"op": "demand_message", "type": "SimIdle", "data3": 100},
    {"op": "demand_expect", "state": {"census_state": 2}},
    {"op": "demand_expect_node", "key": "0x1011", "state": {"new_supply": 0}},
    {"op": "demand_save", "slot": "base"},
    {"op": "demand_save", "slot": "v1"},
    {"op": "demand_patch", "slot": "v1", "class": "simulator", "offset": 0, "hex": "0100"},
    {"op": "demand_patch", "slot": "v1", "class": "simulator", "offset": 2, "insert": true, "hex": "01000000020000000300000004000000"},
    {"op": "demand_load", "slot": "v1"},
    {"op": "demand_expect", "state": {"loaded_from_save": true, "co_economy_bonus": 0.5, "i_economy_bonus": 0.25, "commercial_relief": 10}},
    {"op": "demand_expect_save", "slot": "base"},
    {"op": "demand_save", "slot": "v3"},
    {"op": "demand_patch", "slot": "v3", "class": "simulator", "offset": 0, "hex": "0300"},
    {"op": "demand_save", "slot": "n3"},
    {"op": "demand_load", "slot": "v3"},
    {"op": "demand_expect", "state": {"loaded_from_save": false, "co_economy_bonus": 0, "commercial_relief": 0, "node_keys": []}},
    {"op": "demand_patch", "slot": "n3", "class": "node", "offset": 0, "hex": "0300"},
    {"op": "demand_load", "slot": "n3"},
    {"op": "demand_expect", "state": {"loaded_from_save": true, "co_economy_bonus": 0.5, "node_keys": ["0x1011", "0x21010", "0x21020"]}},
    {"op": "demand_expect_node", "key": "0x1011", "state": {"loaded_from_save": true, "id": 0, "supply": 0}},
    {"op": "demand_expect_node", "key": "0x21010", "state": {"loaded_from_save": true, "id": "0x21010", "demand": 120}},
    {"op": "demand_new_node", "node": "R"},
    {"op": "demand_node_record", "node": "R", "read": true, "hex": "0100341200000000803f00000040000000000000000000000000000000000000c8c20000c8420000a040018fc2f53c0000000032", "expect": true},
    {"op": "demand_expect_node", "node": "R", "state": {"loaded_from_save": true, "id": "0x1234", "supply": 1, "demand": 2, "active_min": -100, "active_max": 100, "active_demand": 5, "economy_modifier": 0.03, "demand_cap": 0.5, "flag": 1}},
    {"op": "demand_node_record", "node": "R", "hex": "0200341200000000803f00000040000000000000000000000000000000000000c8c20000c8420000a040018fc2f53c000000000000003f"},
    {"op": "demand_node", "node": "R", "method": "init"},
    {"op": "demand_expect_node", "node": "R", "state": {"id": "0x1234", "supply": 1}},
    {"op": "demand_new_node", "node": "S"},
    {"op": "demand_node_record", "node": "S", "read": true, "hex": "0300341200000000803f00000040000000000000000000000000000000000000c8c20000c8420000a040018fc2f53c0000000032", "expect": false},
    {"op": "demand_expect_node", "node": "S", "state": {"loaded_from_save": true, "id": 0}},
    {"op": "demand_new_node", "node": "T"},
    {"op": "demand_node_record", "node": "T", "read": true, "hex": "0100341200000000803f", "expect": false}
  ]
}
