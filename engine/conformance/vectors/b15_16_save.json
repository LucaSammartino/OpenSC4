{
  "format": 1,
  "name": "budget_save",
  "spec": ["budget 11", "budget 11.1", "budget 11.2", "budget 11.3", "budget 15.16", "foundations 3"],
  "description": "The three records through the class-object store: write -> read -> write is byte-identical; a loaded budget skips the new-city setup at Init; budget versions 3 and 6 ([choice]) and line-item versions 3 and 5 are rejected; a version-4 budget whose agriculture rate is 0.0 gets the initial rate at Init (not for version 5, nor for a non-zero rate); a version-9 department converts percent to fraction and version 11 is rejected; group names come from LTEXT after loading; YTD income and expense are not saved.",
  "steps": [
    {"op": "budget_env", "difficulty": 2, "year": 2000, "month": 1, "ordinance_income": 50, "ordinance_expense": 30,
      "ltext": [{"group": "0x6A3FF01C", "instance": 8192, "text": "Services"}]},
    {"op": "budget_create"},
    {"op": "budget_init", "tuning": {"0x6A9C7718": [500000, 200000, 100000], "0x090E0A9F": -100000,
      "0x490E0AA6": 5000, "0x090E0AAC": 10, "0x890E0AB4": 200000, "0x8A3FB98D": 8.5, "0x0A3FB9A8": 120,
      "0x0C032488": [9, 9, 9], "0xEBFF69E7": [1.2, 1.1, 1.0]}},
    {"op": "budget_lots", "lots": [{"purpose": 1, "building_wealth": 1, "lot_wealth": 1, "value": 10000}]},
    {"op": "budget_call", "method": "create_department_budget", "args": [4096, 8192], "expect": 4096},
    {"op": "budget_dept", "dept": 4096, "method": "create_line_item", "args": [1, false], "expect": 1},
    {"op": "budget_dept", "dept": 4096, "method": "create_line_item", "args": [2, true], "expect": 2},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "set_full_expenses", "args": [1000]},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "set_secondary_info", "args": [3]},
    {"op": "budget_line", "dept": 4096, "line": 2, "method": "set_display_flag", "args": [2, true]},
    {"op": "budget_holder", "holder": "H", "props": {"0xEA54D283": {"u32": [4096]}, "0xEA54D284": {"u32": [2]},
      "0xEA54D285": {"u32": [7]}, "0xEA54D286": {"i64": [100]}}},
    {"op": "budget_dept", "dept": 4096, "method": "add_locally_funded_object", "args": ["H", 7], "expect": true},
    {"op": "budget_dept", "dept": 4096, "method": "set_funding_percentage", "args": [0.5, 0]},
    {"op": "budget_call", "method": "create_department_budget", "args": [4097, 8192], "expect": 4097},
    {"op": "budget_call", "method": "set_tax_rate", "args": [3, 11.5]},
    {"op": "budget_call", "method": "issue_bond", "args": [10000], "expect": true},
    {"op": "budget_env", "month": 2},
    {"op": "budget_call", "method": "settle_month"},
    {"op": "budget_expect", "state": {"ytd_income": 125}},

    {"op": "budget_save", "slot": "a"},
    {"op": "budget_expect_refs", "refs": {"H": 2}},
    {"op": "budget_load", "slot": "a", "read_ok": true},
    {"op": "budget_expect", "state": {"loaded_from_save": true, "initialized": false, "agriculture_rate_fix": false,
      "funds": 109422, "shadow_funds": 109422, "total_borrowed": 10000, "bond_count": 1, "last_tax_income": 75,
      "ytd_income": 0, "ytd_expense": 0, "ytd_tax_income": 75, "last_month_income": 125, "department_ids": [4096, 4097],
      "ordinance_income_by_month": {"0": 50}, "tax": {"0": {"weighted_assessed": 10000, "monthly_tax": 75}, "3": {"rate": 11.5}},
      "bonds": [{"due_month": 1, "due_year": 2010, "remaining": 14637, "principal_left": 9947}]}},
    {"op": "budget_expect_refs", "refs": {"H": 2}, "note": "the new department holds one, the dropped original released its own"},
    {"op": "budget_dept", "dept": 4096, "method": "funding_percentage", "expect": 0.5},
    {"op": "budget_dept", "dept": 4096, "method": "is_locally_funded_object", "args": ["H", 7], "expect": true},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "current_expenses", "expect": 500},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "secondary_info", "expect": 3},
    {"op": "budget_line", "dept": 4096, "line": 2, "method": "display_flags", "expect": 7},
    {"op": "budget_line", "dept": 4096, "line": 2, "method": "is_local", "expect": true},
    {"op": "budget_line", "dept": 4096, "line": 2, "method": "current_expenses", "expect": 50},
    {"op": "budget_expect_save", "slot": "a"},
    {"op": "clear_events"},
    {"op": "budget_init", "tuning": {"0x6A9C7718": [500000, 200000, 100000], "0x0C032488": [5, 5, 5]}},
    {"op": "budget_expect", "state": {"initialized": true, "funds": 109422, "tax": {"0": {"rate": 9}, "8": {"rate": 9}}}},
    {"op": "expect_event_count", "filter": {"event": "post", "type": "FundsChanged"}, "count": 0},
    {"op": "budget_expect_save", "slot": "a"},

    {"op": "budget_call", "method": "set_group_name", "args": [8192, "Custom"]},
    {"op": "budget_expect_groups", "groups": [{"id": 8192, "name": "Custom", "departments": [4096, 4097]}]},
    {"op": "budget_save", "slot": "named"},
    {"op": "budget_load", "slot": "named"},
    {"op": "budget_expect_groups", "groups": [{"id": 8192, "name": "Services", "departments": [4096, 4097]}]},

    {"op": "budget_load", "slot": "a"},
    {"op": "budget_save", "slot": "v3"},
    {"op": "budget_save", "slot": "v6"},
    {"op": "budget_save", "slot": "line3"},
    {"op": "budget_save", "slot": "line5"},
    {"op": "budget_save", "slot": "dept9"},
    {"op": "budget_save", "slot": "dept11"},
    {"op": "budget_patch", "slot": "v3", "class": "budget", "offset": 0, "hex": "0300"},
    {"op": "budget_patch", "slot": "v6", "class": "budget", "offset": 0, "hex": "0600"},
    {"op": "budget_patch", "slot": "line3", "class": "line", "entry": 0, "offset": 0, "hex": "0300"},
    {"op": "budget_patch", "slot": "line5", "class": "line", "entry": 1, "offset": 0, "hex": "0500"},
    {"op": "budget_patch", "slot": "dept9", "class": "department", "entry": 0, "offset": 0, "hex": "0900"},
    {"op": "budget_patch", "slot": "dept9", "class": "department", "entry": 0, "offset": 15, "hex": "000048420000f042"},
    {"op": "budget_patch", "slot": "dept11", "class": "department", "entry": 0, "offset": 0, "hex": "0b00"},

    {"op": "budget_load", "slot": "v3", "read_ok": false,
     "note": "the store still creates and reads every entry (Read results are ignored); the budget stays in its initial state and holds no departments"},
    {"op": "budget_expect", "state": {"funds": 0, "bond_count": 0, "department_ids": []}},
    {"op": "budget_init", "tuning": {"0x6A9C7718": [500000, 200000, 100000]}},
    {"op": "budget_expect", "state": {"funds": 100000}, "note": "Init runs the new-city setup"},
    {"op": "budget_load", "slot": "v6", "read_ok": false},
    {"op": "budget_expect", "state": {"funds": 0, "department_ids": []}},

    {"op": "budget_load", "slot": "line3", "read_ok": true},
    {"op": "budget_dept", "dept": 4096, "method": "all_line_items", "expect": [0, 2],
     "note": "the rejected line keeps ID 0 and the department keys it by GetID()"},
    {"op": "budget_load", "slot": "line5", "read_ok": true},
    {"op": "budget_dept", "dept": 4096, "method": "all_line_items", "expect": [0, 1]},
    {"op": "budget_line", "dept": 4096, "line": 0, "method": "is_local", "expect": false},
    {"op": "budget_line", "dept": 4096, "line": 0, "method": "full_expenses", "expect": 0},

    {"op": "budget_load", "slot": "dept9"},
    {"op": "budget_dept", "dept": 4096, "method": "funding_percentage", "expect": 0.5},
    {"op": "budget_dept", "dept": 4096, "method": "max_funding_percentage", "expect": 1.2},
    {"op": "budget_dept", "dept": 4096, "method": "all_line_items", "expect": [1, 2]},
    {"op": "budget_load", "slot": "dept11", "read_ok": true,
     "note": "the department stays in its initial state: no lines, no local objects, p = 1"},
    {"op": "budget_dept", "dept": 4096, "method": "funding_percentage", "expect": 1.0},
    {"op": "budget_dept", "dept": 4096, "method": "all_line_items", "expect": []},
    {"op": "budget_dept", "dept": 4097, "method": "all_line_items", "expect": []},

    {"op": "budget_create"},
    {"op": "budget_init", "tuning": {"0x6A9C7718": [500000, 200000, 100000], "0x0C032488": [9, 9, 9]}},
    {"op": "budget_call", "method": "set_tax_rate", "args": [8, 0]},
    {"op": "budget_save", "slot": "agri5"},
    {"op": "budget_save", "slot": "agri4"},
    {"op": "budget_patch", "slot": "agri4", "class": "budget", "offset": 0, "hex": "0400"},
    {"op": "budget_load", "slot": "agri4", "read_ok": true},
    {"op": "budget_expect", "state": {"agriculture_rate_fix": true, "tax": {"8": {"rate": 0}}}},
    {"op": "budget_init", "tuning": {"0x0C032488": [5, 6, 7]}},
    {"op": "budget_expect", "state": {"tax": {"0": {"rate": 9}, "8": {"rate": 7}}}},
    {"op": "budget_load", "slot": "agri5", "read_ok": true},
    {"op": "budget_expect", "state": {"agriculture_rate_fix": false}},
    {"op": "budget_init", "tuning": {"0x0C032488": [5, 6, 7]}},
    {"op": "budget_expect", "state": {"tax": {"8": {"rate": 0}}}},
    {"op": "budget_create"},
    {"op": "budget_init", "tuning": {"0x6A9C7718": [500000, 200000, 100000], "0x0C032488": [9, 9, 9]}},
    {"op": "budget_save", "slot": "agri4b"},
    {"op": "budget_patch", "slot": "agri4b", "class": "budget", "offset": 0, "hex": "0400"},
    {"op": "budget_load", "slot": "agri4b", "read_ok": true},
    {"op": "budget_expect", "state": {"agriculture_rate_fix": false, "tax": {"8": {"rate": 9}}}},
    {"op": "budget_patch", "slot": "agri4b", "class": "budget", "offset": 1062, "hex": "00000000"},
    {"op": "budget_load", "slot": "agri4b", "read_ok": true},
    {"op": "budget_expect", "state": {"agriculture_rate_fix": true, "tax": {"8": {"rate": 0}}}}
  ]
}
