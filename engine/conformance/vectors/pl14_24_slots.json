{
  "format": 1,
  "name": "plumbing_slots",
  "spec": ["plumbing 10.1", "plumbing 10.4", "plumbing 14.24"],
  "description": "Test 24: with last month produced = 2^32 + 5 = 4294967301, GetWaterProductionCapacity returns EAX = 5 (the low 32 bits; the SDK's int64 is wrong, EDX is not set); the same for consumed, imported, exported and GetWaterDemand (2^32 + 7 -> 7). Return channels of 10.1: IsCellWatered (slot 11) sets AL only, AreWateredBuildingsInCell (8) the full EAX, the five int64 getters (14-17, 23) EAX only, GetSupplyValueMapPtr (6), FindWaterBuildings (27) and GetWaterProducers (28) nothing meaningful (a replacement returns true), QueryInterface (0) and GetWaterProducerInfo (24) AL only, the counts EAX. GetWaterProducers lists producers in list order (push_front: newest first); GetWaterProducerInfo of a non-producer -> AL 0; GetOccupantMonthlyUpkeepCost is the budget item's cost, AL 0 without one; GetWaterProduction of a non-producer is 0.",
  "steps": [
    {"op": "plumbing_create"},
    {"op": "plumbing_init"},
    {"op": "plumbing_set", "state": {"last_produced": 4294967301, "last_consumed": 4294967302, "last_imported": 8589934595, "last_exported": -1, "demand": 4294967303}},
    {"op": "plumbing_call", "method": "water_production_capacity", "expect": 5},
    {"op": "plumbing_call", "method": "water_consumed", "expect": 6},
    {"op": "plumbing_call", "method": "water_imported", "expect": 3},
    {"op": "plumbing_call", "method": "water_exported", "expect": 4294967295},
    {"op": "plumbing_call", "method": "water_demand", "expect": 7},
    {"op": "plumbing_call", "method": "water_demand_64", "expect": 4294967303},
    {"op": "plumbing_call", "method": "eax_of", "args": [4294967301], "expect": 5},
    {"op": "plumbing_call", "method": "slot_return", "args": [0], "expect": "AlOnly"},
    {"op": "plumbing_call", "method": "slot_return", "args": [1], "expect": "Eax"},
    {"op": "plumbing_call", "method": "slot_return", "args": [5], "expect": "AlOnly"},
    {"op": "plumbing_call", "method": "slot_return", "args": [6], "expect": "NoneMeaningful"},
    {"op": "plumbing_call", "method": "slot_return", "args": [7], "expect": "Eax"},
    {"op": "plumbing_call", "method": "slot_return", "args": [8], "expect": "FullEax"},
    {"op": "plumbing_call", "method": "slot_return", "args": [9], "expect": "FullEax"},
    {"op": "plumbing_call", "method": "slot_return", "args": [11], "expect": "AlOnly"},
    {"op": "plumbing_call", "method": "slot_return", "args": [12], "expect": "Eax"},
    {"op": "plumbing_call", "method": "slot_return", "args": [14], "expect": "EaxOnly"},
    {"op": "plumbing_call", "method": "slot_return", "args": [17], "expect": "EaxOnly"},
    {"op": "plumbing_call", "method": "slot_return", "args": [22], "expect": "Eax"},
    {"op": "plumbing_call", "method": "slot_return", "args": [23], "expect": "EaxOnly"},
    {"op": "plumbing_call", "method": "slot_return", "args": [24], "expect": "AlOnly"},
    {"op": "plumbing_call", "method": "slot_return", "args": [25], "expect": "AlOnly"},
    {"op": "plumbing_call", "method": "slot_return", "args": [26], "expect": "AlOnly"},
    {"op": "plumbing_call", "method": "slot_return", "args": [27], "expect": "NoneMeaningful"},
    {"op": "plumbing_call", "method": "slot_return", "args": [28], "expect": "NoneMeaningful"},

    {"op": "plumbing_building", "label": "pump", "x": 5, "z": 5, "props": {"0x88ED3303": {"u32": 1000}},
      "budget": {"department": "0xAA4014B4", "line": 9, "cost": 250}},
    {"op": "plumbing_building", "label": "pump2", "x": 9, "z": 9, "props": {"0x88ED3303": {"u32": 400}}},
    {"op": "plumbing_building", "label": "house", "x": 12, "z": 5, "props": {"0xC8ED2D84": {"u32": 1}}},
    {"op": "plumbing_call", "method": "water_producers", "expect": ["pump2", "pump"]},
    {"op": "plumbing_call", "method": "num_water_sources", "expect": 2},
    {"op": "plumbing_call", "method": "water_producer_info", "args": ["house"], "expect": null},
    {"op": "plumbing_call", "method": "water_production", "args": ["house"], "expect": 0},
    {"op": "plumbing_call", "method": "occupant_monthly_upkeep_cost", "args": ["pump"], "expect": 250},
    {"op": "plumbing_call", "method": "occupant_monthly_upkeep_cost", "args": ["pump2"], "expect": null},
    {"op": "plumbing_call", "method": "supply_value", "args": [5, 5], "expect": 0},
    {"op": "plumbing_call", "method": "supply_value", "args": [-1, 70], "expect": 0},
    {"op": "plumbing_call", "method": "is_cell_watered", "args": [100, 100], "expect": false}
  ]
}
