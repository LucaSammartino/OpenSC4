    {"op": "residential_tract", "x": 0, "z": 0, "pop": [1250, 0, 0]},
    {"op": "residential_set", "state": {"state": 5}},
    {"op": "residential_run_to", "state": 7, "steps": 2},
    {"op": "residential_expect_props", "occupant": 1, "props": {"0x09220161": 1250, "0x2A976C20": 0.8, "0xE9244B2E": 1000, "0x292453C5": 0.8}},
    {"op": "residential_tract", "x": 0, "z": 0, "pop": [0, 0, 0]},
    {"op": "residential_set", "state": {"state": 5}},
    {"op": "residential_run_to", "state": 7, "steps": 2},
    {"op": "residential_expect_props", "occupant": 1, "props": {"0x09220161": 0, "0x2A976C20": 1.0, "0xE9244B2E": 1000, "0x292453C5": 1.0}},
    {"op": "residential_tract", "x": 0, "z": 0, "pop": [500, 0, 0]},
    {"op": "residential_set", "state": {"state": 5}},
    {"op": "residential_run_to", "state": 7, "steps": 2},
    {"op": "residential_expect_props", "occupant": 1, "props": {"0x09220161": 500, "0x2A976C20": 1.0, "0xE9244B2E": 1000, "0x292453C5": 1.0}}
  ]
