{
  "format": 1,
  "name": "tgrid_read",
  "spec": ["simgrid 5", "simgrid 2", "simgrid 10.10"],
  "description": "Read rejects a version other than 1, otherwise takes every field as stored, including the CLSID (a u8 grid then reports 0x49B9E603). [choice] a truncated record fails and leaves the grid unchanged. The 0x49B9E601 factory makes a u8 grid; 0x49B9E600 is not registered.",
  "steps": [
    {"op": "tg_city", "cells": [256, 256], "width": [16, 16]},
    {"op": "tg_create", "name": "a", "type": "u8", "tract_size": 2},
    {"op": "tg_read", "grid": "a", "hex": "0200 01 02E6B949", "expect": false},
    {"op": "tg_call", "grid": "a", "method": "count_x", "expect": 128},
    {"op": "tg_read", "grid": "a", "hex": "0100 01 03E6B949 00000000 01000000 00000000 01000000 01000000 00008041 00008041 0000803D 0000803D 05", "expect": true},
    {"op": "tg_call", "grid": "a", "method": "clsid", "expect": 1236919811},
    {"op": "tg_call", "grid": "a", "method": "geometry", "expect": {"size": 1, "shift": 0, "count_x": 1, "count_z": 1, "width_x": 16.0, "width_z": 16.0, "inv_width_x": 0.0625, "inv_width_z": 0.0625}},
    {"op": "tg_call", "grid": "a", "method": "get_tract_value", "args": [0, 0], "expect": 5},
    {"op": "tg_call", "grid": "a", "method": "is_init", "expect": true},
    {"op": "tg_read", "grid": "a", "hex": "0100 01 03E6B949 00000000 01000000 00000000 01000000 01000000 00008041 00008041 0000803D 0000803D", "expect": false},
    {"op": "tg_read", "grid": "a", "hex": "0100 00 02E6B949 00000000 01000000 00000000 FFFFFFFF 01000000 00008041 00008041 0000803D 0000803D", "expect": false},
    {"op": "tg_call", "grid": "a", "method": "get_tract_value", "args": [0, 0], "expect": 5},
    {"op": "tg_create", "name": "b", "clsid": 1236919809, "expect_type": "u8"},
    {"op": "tg_call", "grid": "b", "method": "clsid", "expect": 1236919810},
    {"op": "tg_create", "name": "c", "clsid": 1236919818, "expect_type": "f32"},
    {"op": "tg_create", "name": "x", "clsid": 1236919808, "expect": false}
  ]
}
