{
  "format": 1,
  "name": "ordinance_loading",
  "spec": ["ordinance 3.2", "ordinance 3.5", "ordinance 8.1", "ordinance 13.1"],
  "description": "Init of a new city creates exactly the ordinances of type-14 exemplars whose instance ID has a registered class (a type-5 exemplar, an unregistered standard class and an unknown class produce nothing), keys them by GetID (property 0x28EBBC30, which may differ from the instance), Inits them (enabled = true) and leaves them unavailable; a duplicate ID keeps the first one created. Names fall back from LTEXT (0x6A416B21, first word non-zero) to the string property 0x28EBBC32 to \"0x%08x\"; descriptions likewise.",
  "steps": [
    {"op": "ordinance_env", "classes": ["0x8BD4FC74", "0xA2BF1DDC", "0x00D0723D", "0x62BF1DAA", "0x82B9999B", "0xE0D0722E"],
      "ltext": [{"instance": "0x82B9999B", "text": "Power Conservation"}, {"instance": "0x00D0723D", "text": ""}]},
    {"op": "ordinance_exemplar", "instance": "0x82B9999B", "year": 1970, "enact": -20, "repeal": -10, "constant": 0, "factor": -0.005,
      "chance": 0.005, "advisor": 7, "name_ltext": true, "name": "Power Conservation (property)",
      "description_ltext": [0, 1, 2], "description": "Use less power"},
    {"op": "ordinance_exemplar", "instance": "0x00D0723D", "name": "CPR Training", "name_ltext": true, "enact": -10},
    {"op": "ordinance_exemplar", "instance": "0x62BF1DAA"},
    {"op": "ordinance_exemplar", "instance": "0xA2BF1DDC", "exemplar_type": 5, "name": "Carpool"},
    {"op": "ordinance_exemplar", "instance": "0xA2BF1E43", "name": "Clean Air (class not registered)"},
    {"op": "ordinance_exemplar", "instance": "0x12345678", "name": "No class at all"},
    {"op": "ordinance_exemplar", "group": "0x11112222", "instance": "0x00D0723D", "name": "Duplicate CPR", "enact": -99},
    {"op": "ordinance_exemplar", "instance": "0xE0D0722E", "id": "0x11111111", "name": "Nuclear Free Zone"},

    {"op": "ordinance_create"},
    {"op": "ordinance_init", "expect": true},
    {"op": "ordinance_expect", "state": {"initialized": true, "loaded_from_save": false,
      "keys": ["0x00D0723D", "0x11111111", "0x62BF1DAA", "0x82B9999B"], "monthly_expense": 0, "monthly_income": 0, "pending": 0}},
    {"op": "ordinance_expect_object", "id": "0x82B9999B", "state": {"class": "0x82B9999B", "initialized": true, "enabled": true,
      "available": false, "on": false, "id": "0x82B9999B", "name": "Power Conservation", "description": "Use less power",
      "year_first_available": 1970, "chance_availability": 0.005, "enactment_income": -20, "retracment_income": -10,
      "monthly_constant_income": 0, "monthly_income_factor": -0.005, "advisor_id": 7, "is_income_ordinance": false,
      "adjusted": 0, "key": ["0x6534284A", "0xA9C2C209", "0x82B9999B"], "misc_parent": "0x82B9999B"}},
    {"op": "ordinance_expect_object", "id": "0x00D0723D", "state": {"name": "CPR Training", "description": "0x00d0723d", "enactment_income": -10}},
    {"op": "ordinance_expect_object", "id": "0x62BF1DAA", "state": {"name": "0x62bf1daa", "description": "0x62bf1daa", "enabled": true}},
    {"op": "ordinance_expect_object", "id": "0x11111111", "state": {"class": "0xE0D0722E", "name": "Nuclear Free Zone"}},
    {"op": "ordinance_object", "id": "0x82B9999B", "method": "has_misc_property", "args": ["0x28EBBC35"], "expect": true},
    {"op": "ordinance_call", "method": "available_count", "expect": 0},
    {"op": "ordinance_call", "method": "is_ordinance_enabled", "args": ["0x62BF1DAA"], "expect": true},
    {"op": "ordinance_call", "method": "is_ordinance_enabled", "args": ["0xA2BF1E43"], "expect": false},
    {"op": "ordinance_expect_events", "events": []},
    {"op": "ordinance_init", "expect": true},
    {"op": "ordinance_expect", "state": {"keys": ["0x00D0723D", "0x11111111", "0x62BF1DAA", "0x82B9999B"]}},
    {"op": "ordinance_shutdown", "expect": true},
    {"op": "ordinance_expect", "state": {"initialized": false, "keys": ["0x00D0723D", "0x11111111", "0x62BF1DAA", "0x82B9999B"]}},
    {"op": "ordinance_expect_object", "id": "0x62BF1DAA", "state": {"initialized": true, "enabled": true}}
  ]
}
