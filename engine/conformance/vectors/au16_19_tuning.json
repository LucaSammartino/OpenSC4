      "op": "aud_data_tuning",
      "state": {
        "default_voice_gate": 3,
        "default_one_shot": 10,
        "default_update_period": 30,
        "shipped_voice_gate": 3,
        "shipped_one_shot": 10,
        "shipped_update_period": 30
      }
    },
    {
      "op": "aud_manager_tuning",
      "voice_gate": 7,
      "one_shot": 8,
      "update_period": 9
    },
    {
      "op": "aud_manager_expect",
      "state": {
        "voice_gate": 7,
        "one_shot": 8,
        "update_period": 9,
        "tuning_log": 0
      }
    },
    {
      "op": "aud_manager_tuning",
      "voice_gate": 0,
      "one_shot": 4294967295,
      "update_period": 0,
      "note": "no clamping is applied (10.8)"
    },
    {
      "op": "aud_manager_expect",
      "state": {
        "voice_gate": 0,
        "one_shot": 4294967295,
        "update_period": 0
      }
    },
    {
