{
  "format": 1,
  "name": "tn11_21_ferry_water_cell_and_type",
  "spec": ["traffic-network 4.9.1", "traffic-network 4.9.5"],
  "description": "TN10 and TN18. An 8 x 8 city whose row z = 0 is water. Lot 8 (1,1)-(1,2), type 0: departure and arrival markers at (1,2), then a water marker at (1,1) (its first side whose neighbour is outside the lot and under water is side 1, so the water cell is that neighbour N = (1,0), not the marker's cell), then a second water marker at (1,2) with no such side ((0,2), (2,2), (1,3) are dry and (1,1) is inside the lot): it writes nothing, so (1,0) stays. Lot 9 (3,1)-(3,2) is type 2, which never activates (its count word in the original is a heap pointer): no terminal, and GetFerryTerminalCount is 0 for every type >= 2. Lot 10 (5,1)-(5,2) has only a water marker with no qualifying side: the water cell is not found, no terminal.",
  "steps": [
    {"op": "tn_env", "cells": [8, 8], "tuning": "shipped"},
    {"op": "tn_init"},
    {"op": "tn_water", "rect": [0, 0, 7, 0], "depth": 40.7, "body": 1},
    {"op": "tn_occupant", "id": 60, "kind": "building", "cell": [1, 2], "props": {"0x0BD86FD3": {"u8": 0}}},
    {"op": "tn_occupant", "id": 61, "kind": "prop", "cell": [1, 2], "prop_type": "0x2C520000", "note": "departure"},
    {"op": "tn_occupant", "id": 62, "kind": "prop", "cell": [1, 2], "prop_type": "0x2C530000", "note": "arrival"},
    {"op": "tn_occupant", "id": 63, "kind": "prop", "cell": [1, 1], "prop_type": "0x2C540000", "note": "water: N = (1,0)"},
    {"op": "tn_occupant", "id": 64, "kind": "prop", "cell": [1, 2], "prop_type": "0x2C540000", "note": "water with no qualifying side"},
    {"op": "tn_lot", "id": 8, "rect": [1, 1, 1, 2], "building": 60},
    {"op": "tn_occupant", "id": 70, "kind": "building", "cell": [3, 2], "props": {"0x0BD86FD3": {"u8": 2}}},
    {"op": "tn_occupant", "id": 71, "kind": "prop", "cell": [3, 2], "prop_type": "0x2C520000"},
    {"op": "tn_occupant", "id": 72, "kind": "prop", "cell": [3, 2], "prop_type": "0x2C530000"},
    {"op": "tn_occupant", "id": 73, "kind": "prop", "cell": [3, 1], "prop_type": "0x2C540000"},
    {"op": "tn_lot", "id": 9, "rect": [3, 1, 3, 2], "building": 70},
    {"op": "tn_occupant", "id": 80, "kind": "building", "cell": [5, 2], "props": {"0x0BD86FD3": {"u8": 0}}},
    {"op": "tn_occupant", "id": 81, "kind": "prop", "cell": [5, 2], "prop_type": "0x2C520000"},
    {"op": "tn_occupant", "id": 82, "kind": "prop", "cell": [5, 2], "prop_type": "0x2C530000"},
    {"op": "tn_occupant", "id": 83, "kind": "prop", "cell": [5, 2], "prop_type": "0x2C540000"},
    {"op": "tn_lot", "id": 10, "rect": [5, 1, 5, 2], "building": 80},
    {"op": "tn_call", "method": "do_post_city_init"},

    {"op": "tn_call", "method": "lot_activated", "args": [8], "expect": false},
    {"op": "tn_expect_ferry", "index": 0, "terminal": {"departure": [1, 2], "arrival": [1, 2], "water": [1, 0], "type": 0, "mask": 1}},
    {"op": "tn_call", "method": "lot_activated", "args": [9], "expect": false},
    {"op": "tn_call", "method": "lot_activated", "args": [10], "expect": false},
    {"op": "tn_expect_ferry", "index": 1, "terminal": null},
    {"op": "tn_expect_state", "state": {"terminal_count": 1, "ferry_counts": [1, 0]}},
    {"op": "tn_expect_cell", "cell": [3, 2], "expect": {"wormhole": 0}, "note": "no type-2 terminal, so no ferry phase there"},
    {"op": "tn_call", "method": "ferry_terminal_count", "args": [0], "expect": 1},
    {"op": "tn_call", "method": "ferry_terminal_count", "args": [1], "expect": 0},
    {"op": "tn_call", "method": "ferry_terminal_count", "args": [2], "expect": 0, "note": "the original returns the potential-accident vector's begin pointer"},
    {"op": "tn_call", "method": "ferry_terminal_count", "args": [3], "expect": 0},
    {"op": "tn_call", "method": "ferry_terminal_count", "args": [4], "expect": 0}
  ]
}
