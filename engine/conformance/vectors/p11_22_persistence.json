    {"op": "pollution_patch", "slot": "v3", "offset": 181, "delete": 4},
    {"op": "pollution_load", "slot": "v3", "expect": true},
    {"op": "pollution_expect", "state": {"loaded": true, "decomposed_last_month": 0, "last_produced": 123, "avg_garbage": 44,
      "efficiency": 0.5, "garbage_capacity": 456, "department": "department", "wtp": ["wtp"]}},

