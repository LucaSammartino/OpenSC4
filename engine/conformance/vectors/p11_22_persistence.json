{
  "format": 1,
  "name": "pollution_persistence",
  "spec": ["pollution 6", "pollution 11.22"],
  "description": "Test 22 on a 16 x 16-cell city (8 x 8 tracts, table iterator of 64 entries). The version-4 record (section 6 layout): u16 version (0), 8 grid refs of 8 bytes (2..66), cellX, cellZ (..74), four lists (water treatment 1 ref, incinerators 1 ref, two empty: 12 + 12 + 4 + 4 -> 106), recyclingCount, avgAir, avgWater (..118), six s32 sums (..142), developedTracts (142..146), avgGarbage u16 (..148), two capacities (..156), recyclingEffect f32 (..160), flag u8 (..161), totalUncollected (..165), unused64, lastMonthCost (..181), decomposedLastMonth (181..185), 2 x 56 counter bytes (..297), decomposed, exportCapacity, activeLandfillCells, tractsPerDay (..313), the iterator 3 + 20 + 4 + 64 x 2 + 12 = 167 bytes (..480), four dirty flags (..484), efficiency, supply, capacity (..496), department ref (..504). Write -> read -> write is byte-identical (after Init of the loaded object, which keeps every saved field). radiationSum is not saved (reads 0), effectsVisible is back to true, loaded is set. A version-3 record (decomposedLastMonth deleted) loads and leaves that field at its initial 0; a version-2 record also carries a string after developedTracts and a u32 after the dirty flags, both skipped. A version-5 record is rejected: the object stays as constructed (loaded false), while the store load itself is clean. The loaded lists and department hold the references the stream handed over.",
  "steps": [
    {"op": "pollution_env", "cells": [16, 16]},
    {"op": "pollution_create"},
    {"op": "pollution_init"},
    {"op": "pollution_occupant", "occupant": "wtp", "props": {"0xC8EBD131": {"u32": 100}}},
    {"op": "pollution_occupant", "occupant": "inc", "props": {"0xA8EBCF0C": {"u32": 200}}},
    {"op": "pollution_message", "type": "OccupantInserted", "occupant": "wtp"},
    {"op": "pollution_message", "type": "OccupantInserted", "occupant": "inc"},
    {"op": "pollution_set_grid", "grid": "air_val", "tracts": [{"x": 3, "z": 4, "v": 1234}]},
    {"op": "pollution_set_grid", "grid": "garbage_val", "cells": [{"x": 5, "z": 6, "v": "0x8064"}]},
    {"op": "pollution_set", "state": {"avg_air": 11, "air_sum": 22, "developed_tracts": 33, "avg_garbage": 44, "total_uncollected": 55,
      "last_month_cost": 66, "decomposed_last_month": 77, "last_produced": 123, "recycled": 1.5, "export_capacity": 9,
      "garbage_supply": 1000, "garbage_capacity": 456, "efficiency": 0.5, "dirty_air": true, "radiation_sum": 5,
      "effects_visible": false, "unused64": -3}},
    {"op": "pollution_save", "slot": "a"},
    {"op": "pollution_expect_payload", "slot": "a", "length": 504,
      "at": [{"offset": 0, "hex": "0400"}, {"offset": 74, "hex": "01000000"}, {"offset": 86, "hex": "01000000"},
        {"offset": 98, "hex": "00000000"}, {"offset": 102, "hex": "00000000"}, {"offset": 110, "hex": "0B000000"},
        {"offset": 142, "hex": "21000000"}, {"offset": 146, "hex": "2C00"}, {"offset": 165, "hex": "FDFFFFFFFFFFFFFF"},
        {"offset": 181, "hex": "4D000000"}, {"offset": 185, "hex": "7B00000000000000"}, {"offset": 301, "hex": "09000000"},
        {"offset": 480, "hex": "00010000"}, {"offset": 484, "hex": "0000003F"}, {"offset": 492, "hex": "C8010000"}]},
    {"op": "pollution_save", "slot": "v3"},
    {"op": "pollution_save", "slot": "v2"},
    {"op": "pollution_save", "slot": "v5"},

    {"op": "pollution_load", "slot": "a", "expect": true},
    {"op": "pollution_expect", "state": {"loaded": true, "initialized": false, "avg_air": 11, "air_sum": 22, "developed_tracts": 33,
      "avg_garbage": 44, "total_uncollected": 55, "last_month_cost": 66, "decomposed_last_month": 77, "last_produced": 123,
      "recycled": 1.5, "export_capacity": 9, "garbage_supply": 1000, "garbage_capacity": 456, "efficiency": 0.5, "dirty_air": true,
      "radiation_sum": 0, "effects_visible": true, "unused64": -3, "tracts_per_day": 4, "wtp": ["wtp"], "incinerators": ["inc"],
      "wte_plants": [], "recycling": [], "department": "department", "grids": [true, true, true, true, true, true, true, true]}},
    {"op": "pollution_expect_grid", "grid": "air_val", "others": 0, "tracts": [{"x": 3, "z": 4, "v": 1234}]},
    {"op": "pollution_call", "method": "garbage_value", "args": [5, 6], "expect": -65436},
    {"op": "pollution_expect_refs", "refs": {"wtp": 3, "inc": 3, "department": 2}},
    {"op": "pollution_clear_events"},
    {"op": "pollution_init"},
    {"op": "pollution_expect_event_count", "filter": {"event": "create_department"}, "count": 0},
