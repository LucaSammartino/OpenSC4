    {"op": "pollution_expect_event_count", "filter": {"event": "add_agent"}, "count": 2},
    {"op": "pollution_expect", "state": {"initialized": true, "avg_air": 11, "blocks_x": 2}},
    {"op": "pollution_expect_save", "slot": "a"},

