    {"op": "pollution_patch", "slot": "v5", "offset": 0, "hex": "0500"},
    {"op": "pollution_load", "slot": "v5", "expect": true},
    {"op": "pollution_expect", "state": {"loaded": false, "avg_air": 0, "garbage_capacity": 0, "department": null, "wtp": [],
