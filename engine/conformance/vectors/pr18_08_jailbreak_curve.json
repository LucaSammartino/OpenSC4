{
  "format": 1,
  "name": "protection_jailbreak_curve",
  "spec": ["protection 9.5", "protection 18.8"],
  "description": "Test 8: GetChanceOfJailbreak = curveEA614F63(GetJailedPercentage() x 100) x 0.01 with the shipped curve (0,0)(80,0)(90,10)(100,100): jailed 950 / capacity 1000 -> 0.95f -> 95 -> 55 -> 55 x 0.01f = 0.55f (0x3F0CCCCD); 0.85f -> 5 -> 0.049999997 (0x3D4CCCCC, not 0.05f: protection 6.2 PR3, float32 0.01f; bit-exact expectations added with that answer); 0.8f -> 0. Zero for a non-jail, for a total population <= 0 and for a jail already breaking out. Hand-derived; bit patterns from an independent numpy float32 model.",
  "steps": [
    {"op": "protection_create", "kind": "police"},
    {"op": "protection_env", "tuning": "shipped"},
    {"op": "protection_init"},
    {"op": "protection_call", "method": "curve", "args": ["jailbreak", 95], "expect": 55.0},
    {"op": "protection_call", "method": "curve", "args": ["jailbreak", 85], "expect": 5.0},
    {"op": "protection_call", "method": "curve", "args": ["jailbreak", 80], "expect": 0.0},
    {"op": "protection_occupants", "21": {"props": {"0x48D71EE0": {"u32": 1000}}, "items": {"0xEA56768A": {"local": 1.0}}}},
    {"op": "protection_message", "type": "OccupantInserted", "occupant": 21},
    {"op": "protection_set", "state": {"jailed": 950}},
    {"op": "protection_call", "method": "recalculate"},
    {"op": "protection_call", "method": "chance_of_jailbreak", "args": [21], "bits": true, "expect": "0x3F0CCCCD"},
    {"op": "protection_set", "state": {"jailed": 850}},
    {"op": "protection_call", "method": "recalculate"},
    {"op": "protection_call", "method": "chance_of_jailbreak", "args": [21], "bits": true, "expect": "0x3D4CCCCC"},
    {"op": "protection_set", "state": {"jailed": 800}},
    {"op": "protection_call", "method": "recalculate"},
    {"op": "protection_call", "method": "chance_of_jailbreak", "args": [21], "expect": 0.0},
    {"op": "protection_call", "method": "chance_of_jailbreak", "args": [99], "expect": 0.0},
    {"op": "protection_set", "state": {"jailed": 950, "population": 0}},
    {"op": "protection_call", "method": "chance_of_jailbreak", "args": [21], "expect": 0.0},
    {"op": "protection_call", "method": "recalculate"},
    {"op": "protection_call", "method": "begin_jailbreak", "args": [21], "expect": true},
    {"op": "protection_call", "method": "chance_of_jailbreak", "args": [21], "expect": 0.0}
  ]
}
