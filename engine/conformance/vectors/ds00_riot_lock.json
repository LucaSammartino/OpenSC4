{
  "format": 1,
  "name": "disaster_riot_lock",
  "spec": ["disasters 3.1", "disasters 6.2", "disasters 6.3", "disasters 6.4", "disasters 6.5", "disasters 6.7", "network-manager 10"],
  "description": "MarkRiotNetworkOccupants(x, z) locks the network occupants of the cells within 3 of the riot's start and of each leader's cell (x outer, then z) against the player's bulldozer: once per occupant, a reference held and UnsetRemovalFlags(2). The bounds compare unsigned, so a riot within 3 cells of the west or north edge locks nothing. A walking leader locks again around each new network occupant it stands on and holds a reference to that occupant until it moves on or ends. AttemptDisasterStart returns null; a riot whose leaders are gone stays in its manager in phase 3, so nothing unlocks until the manager's Shutdown or until an instance Shutdown removes the last riot: then every locked occupant gets SetRemovalFlags(2) and its reference back.",
  "steps": [
    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_cell", "rect": [0, 20, 63, 20], "road": true, "network_base": "0x7000",
      "note": "piece 0x7000 + x on row 20"},
    {"op": "dis_cell", "cell": [11, 21], "network": "0x7100"},
    {"op": "dis_clear_events"},
    {"op": "dis_call", "method": "attempt_start", "args": ["riot", 10, 20], "expect": null},
    {"op": "dis_call", "method": "manager_instances", "args": ["riot"], "expect": [1]},
    {"op": "dis_expect", "state": {"riot_locked": ["0x7007", "0x7008", "0x7009", "0x700A", "0x700B", "0x7100", "0x700C", "0x700D"]}},
    {"op": "dis_expect_events", "filter": {"event": "unset_removal"}, "events": [
      {"event": "unset_removal", "occupant": "0x7007", "flags": 2},
      {"event": "unset_removal", "occupant": "0x7008", "flags": 2},
      {"event": "unset_removal", "occupant": "0x7009", "flags": 2},
      {"event": "unset_removal", "occupant": "0x700A", "flags": 2},
      {"event": "unset_removal", "occupant": "0x700B", "flags": 2},
      {"event": "unset_removal", "occupant": "0x7100", "flags": 2},
      {"event": "unset_removal", "occupant": "0x700C", "flags": 2},
      {"event": "unset_removal", "occupant": "0x700D", "flags": 2}
    ]},
    {"op": "dis_expect_refs", "refs": {"0x7007": 1, "0x700A": 1, "0x7100": 1}},

    {"op": "dis_call", "method": "attempt_start", "args": ["riot", 2, 20], "expect": null, "note": "x < 3: nothing locked"},
    {"op": "dis_expect_event_count", "filter": {"event": "unset_removal"}, "count": 0},
    {"op": "dis_call", "method": "attempt_start", "args": ["riot", 20, 2], "expect": null, "note": "z < 3: no road near, no leader, nothing locked"},
    {"op": "dis_call", "method": "manager_instances", "args": ["riot"], "expect": [1, 2, 3]},
    {"op": "dis_expect_event_count", "filter": {"event": "unset_removal"}, "count": 0},

    {"op": "dis_cell", "cell": [10, 20], "police": 255},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000, "note": "the leader ends; the riot stays in phase 3"},
    {"op": "dis_expect_riot", "instance": 1, "state": {"phase": 3, "leader_count": 0}},
    {"op": "dis_expect_event_count", "filter": {"event": "set_removal"}, "count": 0},
    {"op": "dis_expect", "state": {"riot_locked": ["0x7007", "0x7008", "0x7009", "0x700A", "0x700B", "0x7100", "0x700C", "0x700D"]}},
    {"op": "dis_cell", "cell": [2, 20], "police": 255},
    {"op": "dis_tick", "instance": 2, "advance_ms": 1000},
    {"op": "dis_expect_riot", "instance": 2, "state": {"phase": 3, "leader_count": 0}},
    {"op": "dis_expect_event_count", "filter": {"event": "set_removal"}, "count": 0},
    {"op": "dis_shutdown", "expect": true, "note": "every riot remains: the manager's Shutdown unlocks"},
    {"op": "dis_expect_events", "filter": {"event": "set_removal"}, "events": [
      {"event": "set_removal", "occupant": "0x7007", "flags": 2},
      {"event": "set_removal", "occupant": "0x7008", "flags": 2},
      {"event": "set_removal", "occupant": "0x7009", "flags": 2},
      {"event": "set_removal", "occupant": "0x700A", "flags": 2},
      {"event": "set_removal", "occupant": "0x700B", "flags": 2},
      {"event": "set_removal", "occupant": "0x7100", "flags": 2},
      {"event": "set_removal", "occupant": "0x700C", "flags": 2},
      {"event": "set_removal", "occupant": "0x700D", "flags": 2}
    ]},
    {"op": "dis_expect_refs", "refs": {"0x7007": 0, "0x700A": 0, "0x7100": 0}},

    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_cell", "rect": [10, 20, 10, 20], "police": 0},
    {"op": "dis_call", "method": "attempt_start", "args": ["riot", 10, 20], "expect": null},
    {"op": "dis_expect", "state": {"riot_locked": ["0x7007", "0x7008", "0x7009", "0x700A", "0x700B", "0x7100", "0x700C", "0x700D"]}},
    {"op": "dis_tick", "instance": 1, "note": "step 1: the leader stands on 0x700A"},
    {"op": "dis_expect_refs", "refs": {"0x700A": 2, "0x7009": 1}},
    {"op": "dis_automaton", "automaton": "0xA002", "cell": [20, 20], "note": "the third leader of the run"},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000, "note": "step 2: it has walked to 0x7014"},
    {"op": "dis_expect", "state": {"riot_locked": ["0x7007", "0x7008", "0x7009", "0x700A", "0x700B", "0x7100", "0x700C", "0x700D",
      "0x7011", "0x7012", "0x7013", "0x7014", "0x7015", "0x7016", "0x7017"]}},
    {"op": "dis_expect_refs", "refs": {"0x700A": 1, "0x7014": 2, "0x7011": 1}},
    {"op": "dis_clear_events"},
    {"op": "dis_call", "method": "instance_shutdown", "args": [1], "note": "the last riot leaves the manager"},
    {"op": "dis_expect_event_count", "filter": {"event": "end_leader"}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "set_removal"}, "count": 15},
    {"op": "dis_expect", "state": {"riot_locked": []}},
    {"op": "dis_expect_refs", "refs": {"0x700A": 0, "0x7014": 0, "0x7011": 0}},
    {"op": "dis_expect_riot", "instance": 1, "absent": true},
    {"op": "dis_call", "method": "manager_instances", "args": ["riot"], "expect": []}
  ]
}
