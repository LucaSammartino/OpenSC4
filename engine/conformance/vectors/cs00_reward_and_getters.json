{
  "format": 1,
  "name": "citysit_reward_and_getters",
  "spec": ["city-situation 4.5", "city-situation 8"],
  "description": "A success with situation flag 0x40 adds its GUID to the first free reward entry and saves the preferences; a count of 0xFFFF stays; without money or aura nothing is deposited and no aura added. The getters of section 8 answer the active advice's aura and money, the targets of a target mission and the visible flag (SetCSIVisible re-shows the indicators).",
  "steps": [
    {"op": "citysit_create"},
    {"op": "citysit_add_ref", "expect": 1},
    {"op": "citysit_advice", "advice": "0x500", "guid": "0x8C151EFD", "flags": "0x40"},
    {"op": "citysit_automaton", "automaton": "0x700", "position": [100, 200]},
    {"op": "citysit_init", "expect": true},
    {"op": "citysit_call", "method": "initiate_situation", "args": ["0x500", "0x700", false], "expect": true},
    {"op": "citysit_call", "method": "activate_situation", "args": []},
    {"op": "citysit_ticks", "count": 1, "ms": 16},
    {"op": "citysit_ticks", "count": 1, "ms": 4000},
    {"op": "citysit_expect", "state": {"status": 3, "countdown": 0}},
    {"op": "citysit_clear_events"},
    {"op": "citysit_set", "success_counts": {"0x8C151EFD": 65535}},
    {"op": "citysit_env", "rewards": [5]},
    {"op": "citysit_call", "method": "handle_status_changed", "args": [1]},
    {"op": "citysit_ticks", "count": 1, "ms": 1000},
    {"op": "citysit_expect", "state": {"success_counts": {"0x8C151EFD": 65535}}},
    {"op": "citysit_expect_world", "state": {"rewards": [5, "0x8C151EFD"]}},
    {"op": "citysit_expect_event_count", "filter": {"event": "save_preferences"}, "count": 1},
    {"op": "citysit_expect_event_count", "filter": {"event": "deposit"}, "count": 0},
    {"op": "citysit_expect_event_count", "filter": {"event": "aura"}, "count": 0},
    {"op": "citysit_call", "method": "end_situation", "args": []},
    {"op": "citysit_call", "method": "get_situation_aura", "args": [], "expect": null},
    {"op": "citysit_call", "method": "get_situation_money", "args": [], "expect": null},
    {"op": "citysit_advice", "advice": "0x502", "guid": 3, "mission_type": 1, "target": "0x900", "target_count": 3, "success_money": 5000, "success_aura": [32, 10]},
    {"op": "citysit_call", "method": "initiate_situation", "args": ["0x502", null, false], "expect": true},
    {"op": "citysit_call", "method": "get_situation_aura", "args": [], "expect": [32, 10]},
    {"op": "citysit_call", "method": "get_situation_money", "args": [], "expect": 5000},
    {"op": "citysit_call", "method": "get_current_target", "args": [], "expect": "0x900"},
    {"op": "citysit_call", "method": "get_num_targets", "args": [], "expect": 3},
    {"op": "citysit_call", "method": "get_current_target_index", "args": [], "expect": 0},
    {"op": "citysit_call", "method": "get_num_targets_remaining", "args": [], "expect": 3},
    {"op": "citysit_call", "method": "get_current_target_name", "args": [], "expect": "target 0x900"},
    {"op": "citysit_clear_events"},
    {"op": "citysit_call", "method": "set_csi_visible", "args": [false]},
    {"op": "citysit_call", "method": "get_csi_visible", "args": [], "expect": false},
    {"op": "citysit_expect_events", "events": [{"event": "show_all_indicators", "kind": 4, "visible": false}]},
    {"op": "citysit_call", "method": "handle_tuning_parameters_changed", "args": [], "expect": true}
  ]
}
