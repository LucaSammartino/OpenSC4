{
  "format": 1,
  "name": "dispatch_state_events",
  "spec": ["dispatch 3", "dispatch 4.4", "dispatch 12.6"],
  "description": "Automaton event 7 with state 5 posts active once; a second state 5 posts nothing; state 3 posts inactive; state 0 posts inactive (when active), then end, and removes the record, releasing the automaton and the station. An unknown automaton answers true; another code answers false. Event 3 revokes the record (end only).",
  "steps": [
    {"op": "dispatch_create"},
    {"op": "dispatch_init", "expect": true},
    {"op": "dispatch_source", "source": "0x500", "types": [1], "stations": [{"station": "0x600", "base": 1, "count": 3}]},
    {"op": "dispatch_clear_events"},
    {"op": "dispatch_call", "method": "dispatch", "args": [1, 1, 1], "expect": 1},
    {"op": "dispatch_clear_events"},
    {"op": "dispatch_message", "type": "AutomatonEvent", "automaton_of": 1, "code": 7, "state": 5, "expect": true},
    {"op": "dispatch_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0xE94671EC", "dispatch_type": 1, "id": 1}]},
    {"op": "dispatch_call", "method": "get_dispatch_info", "args": [1], "expect": {"active": true}},
    {"op": "dispatch_message", "type": "AutomatonEvent", "automaton_of": 1, "code": 7, "state": 5, "expect": true},
    {"op": "dispatch_expect_events", "filter": {"event": "post"}, "events": []},
    {"op": "dispatch_message", "type": "AutomatonEvent", "automaton_of": 1, "code": 7, "state": 3, "expect": true},
    {"op": "dispatch_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0xE94671ED", "dispatch_type": 1, "id": 1}]},
    {"op": "dispatch_message", "type": "AutomatonEvent", "automaton_of": 1, "code": 7, "state": 5, "expect": true},
    {"op": "dispatch_clear_events"},
    {"op": "dispatch_message", "type": "AutomatonEvent", "automaton_of": 1, "code": 7, "state": 0, "expect": true},
    {"op": "dispatch_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0xE94671ED", "dispatch_type": 1, "id": 1}, {"event": "post", "type": "0x894671F6", "dispatch_type": 1, "id": 1}]},
    {"op": "dispatch_expect", "state": {"record_count": 0}},
    {"op": "dispatch_expect_refs", "refs": {"0x600": 0}},
    {"op": "dispatch_message", "type": "AutomatonEvent", "object": "0x4321", "code": 7, "state": 5, "expect": true},
    {"op": "dispatch_message", "type": "AutomatonEvent", "object": "0x4321", "code": 4, "state": 5, "expect": false},
    {"op": "dispatch_call", "method": "dispatch", "args": [1, 1, 1], "expect": 2},
    {"op": "dispatch_clear_events"},
    {"op": "dispatch_message", "type": "AutomatonEvent", "automaton_of": 2, "code": 3, "expect": true},
    {"op": "dispatch_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x894671F6", "dispatch_type": 1, "id": 2}]},
    {"op": "dispatch_expect", "state": {"record_count": 0}}
  ]
}
