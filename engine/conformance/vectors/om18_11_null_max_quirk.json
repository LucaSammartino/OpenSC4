{
  "format": 1,
  "name": "om18_11_null_max_quirk",
  "spec": ["occupant-manager 8.4", "occupant-manager 9.3", "occupant-manager 15", "occupant-manager 18.11"],
  "description": "Slot 40 with a null max on a 1024 m city uses (count, count) = (64, 64): x up to 65 * 16 - 0.1 = 1039.9 m (world cell 80), so an occupant at x 1030 (cell 80) is found [quirk 8]. An explicit max is clamped to 63 (x up to 1023.9). Slot 47 has the same conversion. Slot 38's null max is the city's last cell 79.",
  "steps": [
    {"op": "om_create"},
    {"op": "om_call", "method": "set_city_size", "args": [1024, 1024], "expect": true},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_occupant", "occupant": "0x8", "min": [1030, 0, 10], "max": [1035, 10, 20]},
    {"op": "om_call", "method": "insert", "occupant": "0x8", "data4": 0, "expect": true},
    {"op": "om_expect_occupant", "occupant": "0x8", "state": {"om_box": [80, 64, 80, 64]}},
    {"op": "om_call", "method": "by_standard_cells", "expect": true, "expect_list": ["0x8"]},
    {"op": "om_call", "method": "by_standard_cells", "max": [100, 100], "expect": true, "expect_list": []},
    {"op": "om_call", "method": "by_cells", "expect": true, "expect_list": []},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "iterate_by_standard_cells", "expect": true},
    {"op": "om_expect_events", "filter": {"event": "callback"}, "events": [{"event": "callback", "occupant": "0x8"}]},
    {"op": "om_call", "method": "first_by_standard_cells", "expect": "0x8", "note": "slot 34's null max is (count, count) too"}
  ]
}
