    {"op": "aura_clear_events"},
    {"op": "aura_call", "method": "read_tuning"},
    {"op": "aura_expect_events", "events": []},
    {"op": "aura_expect", "state": {"long_decay": 0.6, "base_aura": [5, 0, -3], "curves": {"crime": true}}},
    {"op": "aura_env", "tuning": "shipped"},
    {"op": "aura_message", "type": "ExemplarChanged", "data1": "0xE7E2C2DB", "data2": "0x12345678", "expect": true},
    {"op": "aura_message", "type": "ExemplarChanged", "data1": "0x12345678", "data2": "0xAA023079", "expect": true},
    {"op": "aura_expect_events", "events": []},
    {"op": "aura_expect", "state": {"long_decay": 0.6}},
    {"op": "aura_message", "type": "ExemplarChanged", "data1": "0xE7E2C2DB", "data2": "0xAA023079", "expect": true},
    {"op": "aura_expect_events", "events": [{"event": "base_aura", "values": [0, 0, 0]}]},
    {"op": "aura_expect", "state": {"long_decay": 0.9, "short_decay": 0.75, "hotspot": [-50, 3, 4], "curves": {"park": true, "air": true, "water": true, "garbage": true, "radiation": true, "school": true, "hospital": true, "crime": true, "trip": true, "congestion": true, "tax_change": true, "value_wealth": true, "riot": true}}},
    {"op": "aura_env", "tuning_remove": ["0xEA023270"]},
    {"op": "aura_call", "method": "read_tuning"},
    {"op": "aura_expect", "state": {"curves": {"park": false, "crime": true}}},
    {"op": "aura_set", "state": {"state": 6}},
    {"op": "aura_idle", "expect_state": 7}
  ]
