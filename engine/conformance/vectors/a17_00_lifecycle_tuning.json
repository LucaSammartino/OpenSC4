    {"op": "aura_expect", "state": {"long_decay": 0.6, "short_decay": 0.4, "base_aura": [0, 0, 0], "hotspot": [196, 8, 16], "transient_magnitude": [0, 0, 0, 0], "transient_radius": [0, 0, 0, 0], "curves": {"park": false, "air": false, "water": false, "garbage": false, "radiation": false, "school": false, "hospital": false, "crime": false, "trip": false, "congestion": false, "tax_change": false, "value_wealth": false, "riot": false}}},
    {"op": "aura_env", "tuning_props": {"0xEA02327C": {"i32": 5}, "0xEA02327E": {"i32": -3}, "0xEA02327A": {"f32": 0.5}, "0xEA0232A0": {"i32": [-40, 2]}, "0xEA023270": {"f32": 1.5}, "0xEA023277": {"f32": [0, 1, 10, 2]}, "0xEA023291": {"i32": [4]}}},
    {"op": "aura_call", "method": "read_tuning"},
    {"op": "aura_expect_events", "events": [{"event": "base_aura", "values": [5, 0, -3]}]},
    {"op": "aura_expect", "state": {"long_decay": 0.5, "short_decay": 0.4, "base_aura": [5, 0, -3], "hotspot": [196, 8, 16], "transient_magnitude": [0, 4, 0, 0], "transient_radius": [0, 0, 0, 0], "curves": {"park": false, "crime": true, "air": false, "riot": false}}},
    {"op": "aura_env", "tuning_remove": ["0xEA02327C", "0xEA02327E", "0xEA02327A"]},
