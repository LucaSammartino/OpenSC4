    {"op": "aura_shutdown", "expect": true},
    {"op": "aura_expect_events", "events": [{"event": "registry_remove"}, {"event": "remove_agent"}, {"event": "unsubscribe", "types": ["0x99EF1142", "0x99EF1143", "0xC2C09554", "0xC53D10AA", "0x26D31EC1"]}]},
