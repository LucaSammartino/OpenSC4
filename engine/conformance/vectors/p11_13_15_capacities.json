    {"op": "pollution_occupant", "occupant": "aged", "powered": false, "budget": {"line": 10, "cost": 1500, "index": 0},
      "props": {"0xA8EBCF0C": {"u32": 1000}, "0x8A1E07EE": {"f32": [0, 1, 100, 0.5]}, "0xC910B4CF": {"f32": 50}}},
    {"op": "pollution_call", "method": "current_capacity", "args": ["0xA8EBCF0C", "aged"], "expect": [true, 0]},
    {"op": "pollution_call", "method": "current_occupant_efficiency", "args": ["aged"], "expect": [false, 0]},
    {"op": "pollution_occupant", "occupant": "rec", "props": {"0x88ED1059": {"f32": 40}}},
    {"op": "pollution_call", "method": "recycling_center_current_capacity", "args": ["rec"], "expect": [true, 0.32]},

    {"op": "pollution_env", "funding": 0.9},
    {"op": "pollution_call", "method": "end_of_cycle"},
    {"op": "pollution_expect", "state": {"efficiency_bits": "0x3F4CCCCC"}},
    {"op": "pollution_call", "method": "incinerator_current_capacity", "args": ["inc"], "expect": [true, 799]},
    {"op": "pollution_env", "funding": 1.0},
