{
  "format": 1,
  "name": "disaster_riot_timing",
  "spec": ["disasters 6.2", "disasters 6.3", "disasters 6.4", "disasters 6.5", "disasters 6.7", "disasters 18.7"],
  "description": "A riot on a road row at coverage 0 with one leader, placed at the road cell's corner plus 16 x RandomDoubleUniform per axis. AttemptDisasterStart returns null; the riot is in its manager's list. A new leader starts at stage -1, maximum stage -1, counter 0. The riot's next step starts at 0, so step n runs at riot second n - 1 and a tick inside a second runs nothing (next := elapsed + 1). With the shipped tuning (30 s a stage, leaders spawned 0, 1, 0, 1, 0, 0) step 1 moves the leader to stage 0 and sends its stage-0 riot message; step 30 (29 s) reaches stage 1 and spawns one leader; step 90 (89 s) reaches stage 3 and spawns one more (and the leader spawned at step 30 spawns its own at step 60, whose own spawns at step 90); the first leader ends at step 180 (179 s). At coverage 255 the counter drops by 4: stage -1, so the leader ends at its next step; the riot with no leaders goes to phase 3 and ends its episode but stays in its manager, and AttemptDisasterStart keeps returning null.",
  "steps": [
    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_cell", "rect": [0, 20, 63, 20], "road": true},
    {"op": "dis_env", "doubles": [0.5, 0.25]},
    {"op": "dis_clear_events"},
    {"op": "dis_call", "method": "attempt_start", "args": ["riot", 10, 20], "expect": null},
    {"op": "dis_call", "method": "manager_instances", "args": ["riot"], "expect": [1]},
    {"op": "dis_expect_event_count", "filter": {"event": "leader", "automaton": "0xA000", "x": 168, "z": 324}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "history", "series": "0xAA8C87C7", "value": 1}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "register_tick", "instance": 1, "priority": "0xC0"}, "count": 1},
    {"op": "dis_expect_riot", "instance": 1, "state": {"phase": 1, "leader_count": 1, "next_s": 0,
      "leaders": [{"automaton": "0xA000", "counter": 0, "stage": -1, "max_stage": -1, "cell": [10, 20]}]}},
    {"op": "dis_tick", "instance": 1, "note": "step 1 at 0 s"},
    {"op": "dis_expect_riot", "instance": 1, "state": {"leader_count": 1, "elapsed_s": 0, "next_s": 1,
      "leaders": [{"automaton": "0xA000", "counter": 1, "stage": 0, "max_stage": 0, "cell": [10, 20]}]}},
    {"op": "dis_expect_event_count", "filter": {"event": "riot_message", "automaton": "0xA000"}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "riot_message", "automaton": "0xA000", "stage": 0}, "count": 1},
    {"op": "dis_tick", "instance": 1, "advance_ms": 500, "note": "inside the second: no step"},
    {"op": "dis_expect_riot", "instance": 1, "state": {"next_s": 1, "leaders": [{"automaton": "0xA000", "counter": 1, "stage": 0, "max_stage": 0, "cell": [10, 20]}]}},
    {"op": "dis_tick", "instance": 1, "advance_ms": 500},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000, "count": 27, "note": "steps 2 to 29"},
    {"op": "dis_expect_riot", "instance": 1, "state": {"leader_count": 1, "elapsed_s": 28}},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000, "note": "step 30 (29 s): stage 1 spawns one"},
    {"op": "dis_expect_riot", "instance": 1, "state": {"leader_count": 2}},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000, "count": 60, "note": "step 90 (89 s)"},
    {"op": "dis_expect_riot", "instance": 1, "state": {"leader_count": 5, "elapsed_s": 89}},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000, "count": 89},
    {"op": "dis_expect_event_count", "filter": {"event": "end_leader", "automaton": "0xA000"}, "count": 0},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000, "note": "step 180 (179 s)"},
    {"op": "dis_expect_event_count", "filter": {"event": "riot_message", "automaton": "0xA000", "stage": 1}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "riot_message", "automaton": "0xA000", "stage": 3}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "end_leader", "automaton": "0xA000"}, "count": 1},

    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_cell", "rect": [0, 20, 63, 20], "police": 255},
    {"op": "dis_cell", "cell": [10, 20], "police": 0},
    {"op": "dis_call", "method": "attempt_start", "args": ["riot", 10, 20], "expect": null},
    {"op": "dis_expect_riot", "instance": 1, "state": {"leader_count": 1}},
    {"op": "dis_tick", "instance": 1, "note": "step 1: stage 0"},
    {"op": "dis_cell", "cell": [10, 20], "police": 255},
    {"op": "dis_clear_events"},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000},
    {"op": "dis_expect_event_count", "filter": {"event": "riot_effect", "stage": -1}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "end_leader"}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "post", "type": "0xAA1B2002"}, "count": 1},
    {"op": "dis_expect_riot", "instance": 1, "state": {"phase": 3, "leader_count": 0}},
    {"op": "dis_expect_instance", "instance": 1, "state": {"phase": 3, "tick": true}},
    {"op": "dis_call", "method": "active_count", "args": ["riot"], "expect": 0},
    {"op": "dis_call", "method": "manager_instances", "args": ["riot"], "expect": [1]},
    {"op": "dis_call", "method": "attempt_start", "args": ["riot", 30, 20], "expect": null, "note": "coverage 255: the leader is refused; the instance stays in phase 0"},
    {"op": "dis_call", "method": "manager_instances", "args": ["riot"], "expect": [1, 2]},
    {"op": "dis_expect_riot", "instance": 2, "state": {"phase": 0, "leader_count": 0}}
  ]
}
