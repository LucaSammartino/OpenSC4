{
  "format": 1,
  "name": "disaster_riot_timing",
  "spec": ["disasters 6.2", "disasters 6.3", "disasters 6.4", "disasters 6.5", "disasters 18.7"],
  "description": "A riot on a road row at coverage 0 with one leader, placed at the road cell's corner plus 16 x RandomDoubleUniform per axis. With the shipped tuning (30 s a stage, leaders spawned 1, 0, 1, 0, 0, 0) the leader reaches stage 1 at 30 s and spawns one leader; at 90 s it reaches stage 3 and spawns one more (and the leader spawned at 30 s spawns its own at 60 s and 90 s); the first leader ends at 180 s, after its stage-1 and stage-3 riot messages. At coverage 255 the counter is -4 after 1 s: stage -1, so the leader ends at once, and the riot with no leaders ends its episode and leaves its manager.",
  "steps": [
    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_cell", "rect": [0, 20, 63, 20], "road": true},
    {"op": "dis_env", "doubles": [0.5, 0.25]},
    {"op": "dis_clear_events"},
    {"op": "dis_call", "method": "attempt_start", "args": ["riot", 10, 20], "expect": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "leader", "automaton": "0xA000", "x": 168, "z": 324}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "history", "series": "0xAA8C87C7", "value": 1}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "register_tick", "instance": 1, "priority": "0xC0"}, "count": 1},
    {"op": "dis_expect_riot", "instance": 1, "state": {"phase": 1, "leader_count": 1,
      "leaders": [{"automaton": "0xA000", "counter": 0, "stage": 0, "max_stage": 0, "cell": [10, 20]}]}},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000, "count": 29},
    {"op": "dis_expect_riot", "instance": 1, "state": {"leader_count": 1}},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000, "note": "30 s: stage 1 spawns one"},
    {"op": "dis_expect_riot", "instance": 1, "state": {"leader_count": 2}},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000, "count": 60, "note": "90 s"},
    {"op": "dis_expect_riot", "instance": 1, "state": {"leader_count": 5}},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000, "count": 89},
    {"op": "dis_expect_event_count", "filter": {"event": "end_leader", "automaton": "0xA000"}, "count": 0},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000, "note": "180 s"},
    {"op": "dis_expect_event_count", "filter": {"event": "riot_message", "automaton": "0xA000", "stage": 1}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "riot_message", "automaton": "0xA000", "stage": 3}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "end_leader", "automaton": "0xA000"}, "count": 1},

    {"op": "dis_create"},
    {"op": "dis_init", "expect": true},
    {"op": "dis_cell", "rect": [0, 20, 63, 20], "police": 255},
    {"op": "dis_cell", "cell": [10, 20], "police": 0},
    {"op": "dis_call", "method": "attempt_start", "args": ["riot", 10, 20], "expect": 1},
    {"op": "dis_expect_riot", "instance": 1, "state": {"leader_count": 1}},
    {"op": "dis_cell", "cell": [10, 20], "police": 255},
    {"op": "dis_clear_events"},
    {"op": "dis_tick", "instance": 1, "advance_ms": 1000},
    {"op": "dis_expect_event_count", "filter": {"event": "riot_effect", "stage": -1}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "end_leader"}, "count": 1},
    {"op": "dis_expect_event_count", "filter": {"event": "post", "type": "0xAA1B2002"}, "count": 1},
    {"op": "dis_expect_riot", "instance": 1, "absent": true},
    {"op": "dis_call", "method": "active_count", "args": ["riot"], "expect": 0}
  ]
}
