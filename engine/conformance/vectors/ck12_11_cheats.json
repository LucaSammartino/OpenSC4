{
  "format": 1,
  "name": "ck12_11_cheats",
  "spec": ["clock24 4.8", "clock24 4.9", "clock24 12"],
  "description": "Test 11. The cheat message 0x230E27AC (data1 = the cheat ID, the typed text). 'WhatTimeIzIt 7' calls SetHour(7); 'WhatTimeIzIt' alone does nothing; 'WhatTimeIzIt 25' at 12:30 gives hour 1; 'WhatTimeIzIt abc' gives hour 0 (atol). 'Stopwatch PAUSE' pauses (lower-cased); 'Stopwatch resume' resumes; 'Stopwatch magnify 5000' gives 2000; 'Stopwatch magnify' alone does nothing; 'Stopwatch magnify 0.5' gives atol 0, clamped to 0.05. Another argument, another cheat ID or another message changes nothing. DoMessage always returns true.",
  "steps": [
    {"op": "ck_create"},
    {"op": "ck_call", "method": "init"},
    {"op": "ck_clear_events"},
    {"op": "ck_call", "method": "cheat", "args": ["WhatTimeIzIt", "WhatTimeIzIt 7"], "expect": true},
    {"op": "ck_expect", "state": {"seconds": 25200}},
    {"op": "ck_expect_events", "events": [{"event": "post", "name": "HourChanged", "data2": 7, "data3": 0}, {"event": "post", "name": "TimeTick", "data2": 7, "data3": 0}]},
    {"op": "ck_call", "method": "cheat", "args": ["WhatTimeIzIt", "WhatTimeIzIt"], "expect": true},
    {"op": "ck_expect", "state": {"seconds": 25200}},
    {"op": "ck_set", "seconds": "12:30:00"},
    {"op": "ck_call", "method": "cheat", "args": ["0x281F7858", "WhatTimeIzIt 25"]},
    {"op": "ck_expect", "state": {"seconds": 3600}},
    {"op": "ck_call", "method": "cheat", "args": ["WhatTimeIzIt", "WhatTimeIzIt abc"]},
    {"op": "ck_expect", "state": {"seconds": 0}},
    {"op": "ck_clear_events"},
    {"op": "ck_call", "method": "cheat", "args": ["Stopwatch", "Stopwatch PAUSE"], "expect": true},
    {"op": "ck_expect", "state": {"pause_count": 1, "timer_running": false}},
    {"op": "ck_expect_events", "events": [{"event": "post", "name": "PauseChanged", "data2": 1, "data3": 0}]},
    {"op": "ck_call", "method": "cheat", "args": ["Stopwatch", "Stopwatch resume"]},
    {"op": "ck_expect", "state": {"pause_count": 0, "timer_running": true}},
    {"op": "ck_call", "method": "cheat", "args": ["Stopwatch", "Stopwatch magnify 5000"]},
    {"op": "ck_expect", "state": {"magnification": 2000}},
    {"op": "ck_call", "method": "cheat", "args": ["Stopwatch", "Stopwatch magnify"]},
    {"op": "ck_expect", "state": {"magnification": 2000}},
    {"op": "ck_call", "method": "cheat", "args": ["Stopwatch", "Stopwatch magnify 0.5"]},
    {"op": "ck_expect", "state": {"magnification_bits": "0x3D4CCCCD"}},
    {"op": "ck_call", "method": "cheat", "args": ["Stopwatch", "Stopwatch magnify 300"]},
    {"op": "ck_expect", "state": {"magnification": 300}},
    {"op": "ck_clear_events"},
    {"op": "ck_call", "method": "cheat", "args": ["Stopwatch", "Stopwatch stop"], "expect": true},
    {"op": "ck_call", "method": "cheat", "args": ["Stopwatch", "Stopwatch"], "expect": true},
    {"op": "ck_call", "method": "cheat", "args": ["0x1234", "x pause"], "expect": true},
    {"op": "ck_call", "method": "message", "args": ["0x1234", "0xC9B73FBB", "Stopwatch pause"], "expect": true},
    {"op": "ck_call", "method": "message", "args": ["0x230E27AC", "0xC9B73FBB", null], "expect": true},
    {"op": "ck_expect", "state": {"pause_count": 0, "magnification": 300, "seconds": 0}},
    {"op": "ck_expect_event_count", "count": 0}
  ]
}
