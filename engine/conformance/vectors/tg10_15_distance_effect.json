{
  "format": 1,
  "name": "tgrid_distance_effect",
  "spec": ["simgrid 7.2", "simgrid 10.15"],
  "description": "AddDistanceEffect: Manhattan distance to the nearest mask tract (computed before the target changes), k = float32((near - far) / radius); tracts with 0 < dist < radius become clamp(trunc(target + near - dist k), 0, 255). Mask tracts and tracts at dist >= radius are unchanged.",
  "steps": [
    {"op": "tg_city", "cells": [7, 1], "width": [16, 16]},
    {"op": "tg_create", "name": "a", "type": "u8", "tract_size": 1},
    {"op": "tg_set", "grid": "a", "rows": [[0], [10], [10], [10], [10], [10], [10]]},
    {"op": "tg_distance_effect", "target": "a", "mask": "a", "value": 0, "radius": 3.0, "near": 30, "far": 0},
    {"op": "tg_expect", "grid": "a", "rows": [[0], [30], [20], [10], [10], [10], [10]]},
    {"op": "tg_city", "cells": [5, 5], "width": [16, 16]},
    {"op": "tg_create", "name": "t", "type": "u8", "tract_size": 1},
    {"op": "tg_create", "name": "m", "type": "u8", "tract_size": 1},
    {"op": "tg_set", "grid": "m", "fill": 1, "cells": [[2, 2, 7]]},
    {"op": "tg_distance_effect", "target": "t", "mask": "m", "value": 7, "radius": 3.0, "near": 30, "far": 0},
    {"op": "tg_expect", "grid": "t", "cells": [[0, 2, 10], [1, 1, 10], [1, 2, 20], [1, 3, 10], [2, 0, 10], [2, 1, 20], [2, 3, 20], [2, 4, 10], [3, 1, 10], [3, 2, 20], [3, 3, 10], [4, 2, 10]], "others": 0},
    {"op": "tg_create", "name": "c", "type": "u8", "tract_size": 1},
    {"op": "tg_set", "grid": "c", "fill": 250},
    {"op": "tg_distance_effect", "target": "c", "mask": "m", "value": 7, "radius": 2.0, "near": 40, "far": -20},
    {"op": "tg_expect", "grid": "c", "cells": [[2, 1, 255], [1, 2, 255], [3, 2, 255], [2, 3, 255]], "others": 250},
    {"op": "tg_distance_effect", "target": "c", "mask": "m", "value": 7, "radius": 2.0, "near": -600, "far": 0},
    {"op": "tg_expect", "grid": "c", "cells": [[2, 1, 0], [1, 2, 0], [3, 2, 0], [2, 3, 0]], "others": 250},
    {"op": "tg_create", "name": "z", "type": "u8", "tract_size": 1},
    {"op": "tg_distance_effect", "target": "z", "mask": "m", "value": 9, "radius": 3.0, "near": 30, "far": 0},
    {"op": "tg_expect", "grid": "z", "others": 0}
  ]
}
