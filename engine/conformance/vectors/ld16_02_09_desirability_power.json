{
  "format": 1,
  "name": "lot_developer_desirability_and_power",
  "spec": ["lot-developer 5.1", "lot-developer 9", "lot-developer 16"],
  "description": "Test 2 (desirability threshold, §5.1, §16) and the power-changed handler (§9). TestDesirability: d = r24(float(cellValue) * 0.01) is low when d < the abandon threshold (shipped 0.3). With the shipped threshold: cell value 29 -> 0.29 (low), 30 -> 0.29999998 (low), 31 -> 0.31 (not low). A not-low value resets the counter to 0; a low value increments it and returns whether counter <= r + 2. The lot must be livable and its developer must exist and not be purpose 5. DoPowerChanged (§9): for each lot in the rectangle, powered = CheatIgnorePower or IsPowered(cx, cz) with NO needs-power test; a change flips the lot's has_power and moves condition 0<->1; when not powered and needs power it adds a power zot (a building always qualifies, an empty lot only when IsEmptyLotSuitableForZot); otherwise it removes a power zot (also for empty lots). No counters change and no state changes here.",
  "steps": [
    {"op": "ldev_world", "terrain_cells": [64, 64]},
    {"op": "ldev_tuning", "shipped": true},

    {"op": "ldev_profile", "building": "0x3001", "purpose": 1, "wealth": 1, "note": "test 2: desirability threshold"},
    {"op": "ldev_dev", "id": 700, "purpose": 1, "wealth": 1, "desirability": 29, "water_cap": 5},
    {"op": "ldev_occ", "id": 500, "is_building": true, "bbox": [[0, 0, 0], [16, 10, 16]]},
    {"op": "ldev_lot", "id": 1, "x": 0, "z": 0, "state": 3, "building_type": "0x3001", "building": 500,
      "wealth": 1, "livable": true},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},

    {"op": "ldev_dev", "id": 700, "purpose": 1, "wealth": 1, "desirability": 29, "note": "cell 29 -> 0.29 low"},
    {"op": "ldev_test_desirability", "lot": 1, "at": [0, 0], "expect": true, "note": "counter 0 -> 1, tolerance 2 for (0,0)"},
    {"op": "ldev_expect_lot", "lot": 1, "prop": {"low_desirability": 1}},
    {"op": "ldev_expect_draws", "draws": [["R1", 7, 0]], "note": "a low value draws R1 on the temporary generator seeded (0<<16)+0 = 0, first raw 0"},
    {"op": "ldev_dev", "id": 700, "desirability": 30, "note": "cell 30 -> 0.29999998 still low"},
    {"op": "ldev_test_desirability", "lot": 1, "at": [0, 0], "expect": true},
    {"op": "ldev_expect_lot", "lot": 1, "prop": {"low_desirability": 2}},
    {"op": "ldev_expect_draws", "draws": [["R1", 7, 0]]},
    {"op": "ldev_dev", "id": 700, "desirability": 31, "note": "cell 31 -> 0.31 not low: the counter resets"},
    {"op": "ldev_test_desirability", "lot": 1, "at": [0, 0], "expect": true},
    {"op": "ldev_expect_lot", "lot": 1, "prop": {"low_desirability": 0}},
    {"op": "ldev_expect_draws", "draws": [], "note": "the not-low path returns before the draw"},

    {"op": "ldev_lot", "id": 1, "counter": {"low_desirability": 2}},
    {"op": "ldev_dev", "id": 700, "desirability": 10},
    {"op": "ldev_test_desirability", "lot": 1, "at": [0, 0], "expect": false,
      "note": "counter 2 -> 3, tolerance for (0,0) is 2, so 3 > 2 fails (R1 drawn)"},
    {"op": "ldev_expect_draws", "draws": [["R1", 7, 0]]},

    {"op": "ldev_lot", "id": 2, "x": 0, "z": 0, "state": 1, "note": "a non-livable lot passes and resets the counter"},
    {"op": "ldev_lot", "id": 2, "livable": false, "counter": {"low_desirability": 5}},
    {"op": "ldev_test_desirability", "lot": 2, "at": [0, 0], "expect": true},
    {"op": "ldev_expect_lot", "lot": 2, "prop": {"low_desirability": 0}},

    {"op": "ldev_dev", "id": 701, "purpose": 5, "wealth": 1, "desirability": 10, "note": "a purpose-5 (farm) developer passes without touching the counter"},
    {"op": "ldev_profile", "building": "0x3005", "purpose": 5, "wealth": 1},
    {"op": "ldev_lot", "id": 3, "x": 0, "z": 0, "state": 3, "building_type": "0x3005", "building": 500,
      "wealth": 1, "livable": true, "counter": {"low_desirability": 7}},    {"op": "ldev_test_desirability", "lot": 3, "at": [0, 0], "expect": true},
    {"op": "ldev_expect_lot", "lot": 3, "prop": {"low_desirability": 7}, "note": "counter untouched"},
    {"op": "ldev_expect_draws", "draws": [], "note": "no draw for purpose 5"},

    {"op": "ldev_clear_lots", "note": "§9: power changed"},
    {"op": "ldev_occ", "id": 500, "is_building": true, "bbox": [[0, 0, 0], [16, 10, 16]], "cells": [0, 0, 0, 0]},
    {"op": "ldev_profile", "building": "0x3001", "purpose": 1, "wealth": 1},
    {"op": "ldev_lot", "id": 1, "x": 0, "z": 0, "state": 3, "building_type": "0x3001", "building": 500,
      "condition": 0, "needs_power": true, "has_power": true},
    {"op": "ldev_surrounding", "in_rect": [1]},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_cells", "powered": [[0, 0, 0]], "note": "power lost"},
    {"op": "ldev_clear_events"},
    {"op": "ldev_power_changed", "rect": [0, 0, 0, 0]},
    {"op": "ldev_expect_lot", "lot": 1, "condition": 1, "has_power": false, "prop": {"zot": 4}},
    {"op": "ldev_cells", "powered": [[0, 0, 1]], "note": "power restored"},
    {"op": "ldev_clear_events"},
    {"op": "ldev_power_changed", "rect": [0, 0, 0, 0]},
    {"op": "ldev_expect_lot", "lot": 1, "condition": 0, "has_power": true, "prop": {"zot": 0}},
    {"op": "ldev_expect_events", "filter": {"event": "prop_remove"}, "events": [{"event": "prop_remove"}]},

    {"op": "ldev_lot", "id": 4, "x": 8, "z": 8, "state": 1, "zone": 1, "building_type": 0, "no_building": true,
      "needs_power": true, "has_power": true, "condition": 0, "note": "an empty lot at (8,8): (8+8) mod 4 = 0 so it is zot-suitable"},
    {"op": "ldev_surrounding", "in_rect": [4]},
    {"op": "ldev_cells", "powered": [[8, 8, 0]]},
    {"op": "ldev_clear_events"},
    {"op": "ldev_power_changed", "rect": [8, 8, 8, 8]},
    {"op": "ldev_expect_lot", "lot": 4, "has_power": false, "prop": {"zot": 4}},

    {"op": "ldev_lot", "id": 5, "x": 9, "z": 8, "state": 1, "zone": 1, "no_building": true,
      "needs_power": true, "has_power": true, "condition": 0, "note": "an empty lot at (9,8): (9+8) mod 4 != 0 so not zot-suitable"},
    {"op": "ldev_surrounding", "in_rect": [5]},
    {"op": "ldev_cells", "powered": [[9, 8, 0]]},
    {"op": "ldev_clear_events"},
    {"op": "ldev_power_changed", "rect": [9, 8, 9, 8]},
    {"op": "ldev_expect_lot", "lot": 5, "has_power": false, "note": "has_power still flips (no needs-power test), but no zot"},
    {"op": "ldev_expect_lot", "lot": 5, "prop": {"zot": null}}
  ]
}
