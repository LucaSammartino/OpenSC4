{
  "format": 1,
  "name": "demolition_record",
  "spec": ["demolition 7", "demolition 12.1"],
  "description": "The record is the version alone: Write emits exactly 01 00; Read of 01 00 succeeds, of 02 00 fails, and a cut record fails.",
  "steps": [
    {"op": "demolition_create"},
    {"op": "demolition_init", "expect": true},
    {"op": "demolition_clear_events"},
    {"op": "demolition_write", "expect": true, "hex": "0100"},
    {"op": "demolition_read", "hex": "0100", "expect": true},
    {"op": "demolition_read", "hex": "0200", "expect": false},
    {"op": "demolition_read", "hex": "01", "expect": false}
  ]
}
