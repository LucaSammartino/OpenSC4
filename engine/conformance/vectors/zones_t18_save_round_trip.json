{
  "format": 1,
  "name": "zones_t18_save_round_trip",
  "spec": [
    "zones 10.1",
    "zones 10.2",
    "zones 15.18"
  ],
  "description": "Conformance test 18 (save round trip, \u00a710). A new 64 x 64 city. The zone manager's record (\u00a710.1) is version 1, a zone-grid reference (class 0x49B9E603), zoneCount[0] = 4096 and the rest 0, undeveloped 16 x 4096, unnamedPerType 16 x 4096, {4096, 0, 0, 0}, the tuning arrays of \u00a74 (min, max, creation, destruction, texture instances, drag colours), display alpha 170, both development-failure maps empty (n1 = 0, n2 = 0) and five null service references: 759 bytes, pinned exactly. Max slopes and the default alpha are not saved (\u00a710.1). The zone developer's record (\u00a710.2) is version 1, countX 64, countZ 64 and 4096 null lot references: 16394 bytes, its header pinned and its length checked. The round trip then goes through the class-object store: two lots at (10,10) and (30,30) are created out of first-cell order, and after the reload the master list is first-cell order (x outer, z inner) - the quirk of \u00a710.2 - so the lot at (10,10) comes first. After the reload the developer's record is 16402 bytes: the two lots are now real references (id + class, 8 bytes each) rather than null references (4 bytes).",
  "steps": [
    {
      "op": "zone_env",
      "cells": [
        64,
        64
      ]
    },
    {
      "op": "zone_create",
      "session": 0
    },
    {
      "op": "zone_init"
    },
    {
      "op": "zone_record",
      "target": "manager",
      "byte_length": 759
    },
    {
      "op": "zone_record",
      "target": "manager",
      "hex": ""
    },
    {
      "op": "zone_record",
      "target": "developer",
      "byte_length": 16394
    },
    {
      "op": "zone_record",
      "target": "developer",
      "hex_prefix": "0100400000004000000000000000000000000000"
    },
    {
      "op": "zone_lot",
      "rect": [
        30,
        30,
        30,
        30
      ],
      "facing": 0,
      "zone": 1
    },
    {
      "op": "zone_lot",
      "rect": [
        10,
        10,
        10,
        10
      ],
      "facing": 0,
      "zone": 1
    },
    {
      "op": "zone_call",
      "method": "master_lots",
      "expect": [
        "0x1000",
        "0x1001"
      ]
    },
    {
      "op": "zone_save",
      "slot": "s0"
    },
    {
      "op": "zone_load",
      "slot": "s0",
      "expect": true
    },
    {
      "op": "zone_expect",
      "state": {
        "manager_loaded": true,
        "developer_loaded": true,
        "lot_count": 2
      }
    },
    {
      "op": "zone_call",
      "target": "manager",
      "method": "is_loaded",
      "expect": true
    },
    {
      "op": "zone_call",
      "method": "master_lots",
      "expect": [
        "0x1001",
        "0x1000"
      ]
    },
    {
      "op": "zone_record",
      "target": "developer",
      "byte_length": 16402,
      "note": "After the reload the two lots are real references (an id and a class each, 8 bytes) instead of null references (4 bytes), so the record grows by 2 x 4 = 8 bytes."
    },
    {
      "op": "zone_call",
      "target": "manager",
      "method": "zone_count",
      "args": [
        0
      ],
      "expect": 4096
    },
    {
      "op": "zone_call",
      "target": "manager",
      "method": "min_zone_size",
      "args": [
        7
      ],
      "expect": 4
    },
    {
      "op": "zone_call",
      "target": "manager",
      "method": "zone_display_alpha",
      "expect": 170
    }
  ]
}
