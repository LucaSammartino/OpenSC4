{
  "format": 1,
  "name": "lot_developer_daily_pass",
  "spec": ["lot-developer 4.1", "lot-developer 4.2", "lot-developer 16"],
  "description": "Tests 3, 4 and 18 (§4.1, §4.2, §16). Daily quota: perDay = n / 28 + 1 (signed), so n = 100 -> 4, n = 27 -> 1, n = 28 -> 2, n = 0 -> no work and true. Wrap day: 29 lots (perDay = 2); days 1-14 visit L1-L28 two per day; on day 15 the iterator reaches L29 and then the end of the list, so the pass returns false with dailyState 3; the re-delivery starts a new cycle from the front (visited reset, snapshots retaken) and visits L1, L2, so that day updates three lots (quirk 1). UpdateLot order for a grown building: TestDesirability, TestPower, TestWater, TestTravel always run, in that order, and the LAST failing test gives the reason; SetState is called once. A lot failing desirability and water records reason 3; failing all four records reason 4.",
  "steps": [
    {"op": "ldev_world", "terrain_cells": [64, 64]},

    {"op": "ldev_clear_lots", "note": "test 3: daily quota"},
    {"op": "ldev_make_lots", "count": 100},
    {"op": "ldev_create", "seed": 1},
    {"op": "ldev_expect", "per_day": 4, "note": "n=100 -> 100/28+1 = 4"},

    {"op": "ldev_clear_lots"},
    {"op": "ldev_make_lots", "count": 27},
    {"op": "ldev_create", "seed": 1},
    {"op": "ldev_expect", "per_day": 1, "note": "n=27 -> 27/28+1 = 1"},

    {"op": "ldev_clear_lots"},
    {"op": "ldev_make_lots", "count": 28},
    {"op": "ldev_create", "seed": 1},
    {"op": "ldev_expect", "per_day": 2, "note": "n=28 -> 28/28+1 = 2"},

    {"op": "ldev_clear_lots"},
    {"op": "ldev_create", "seed": 1},
    {"op": "ldev_expect", "per_day": 0, "note": "n=0 -> no work"},
    {"op": "ldev_daily", "expect": true, "note": "empty city: true"},
    {"op": "ldev_expect", "daily_state": 3},

    {"op": "ldev_clear_lots", "note": "test 4: wrap day, 29 lots, perDay 2"},
    {"op": "ldev_make_lots", "count": 29},
    {"op": "ldev_create", "seed": 1},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_expect", "per_day": 2, "daily_state": 0},
    {"op": "ldev_daily", "expect": true},
    {"op": "ldev_expect", "visited": 0, "daily_state": 1, "note": "day 1: two lots, visited reset, finished for today"},
    {"op": "ldev_daily", "expect": true},
    {"op": "ldev_daily", "expect": true},
    {"op": "ldev_daily", "expect": true},
    {"op": "ldev_daily", "expect": true},
    {"op": "ldev_daily", "expect": true},
    {"op": "ldev_daily", "expect": true},
    {"op": "ldev_daily", "expect": true},
    {"op": "ldev_daily", "expect": true},
    {"op": "ldev_daily", "expect": true},
    {"op": "ldev_daily", "expect": true},
    {"op": "ldev_daily", "expect": true},
    {"op": "ldev_daily", "expect": true},
    {"op": "ldev_daily", "expect": true},
    {"op": "ldev_expect", "daily_state": 1, "note": "14 days: L1-L28 visited, the cycle is still running"},
    {"op": "ldev_clear_events"},
    {"op": "ldev_daily", "expect": false, "note": "day 15: L29 then the end of the list -> false, dailyState 3"},
    {"op": "ldev_expect", "daily_state": 3},
    {"op": "ldev_expect_event_count", "filter": {"event": "reset_travel_pop"}, "count": 1,
      "note": "only the 29th lot was visited on that delivery"},
    {"op": "ldev_clear_events"},
    {"op": "ldev_daily", "expect": true, "note": "re-delivery: a new cycle from the front, L1 and L2"},
    {"op": "ldev_expect", "daily_state": 1},
    {"op": "ldev_expect_event_count", "filter": {"event": "reset_travel_pop"}, "count": 2,
      "note": "two lots from the start of the list"},

    {"op": "ldev_clear_lots", "note": "test 18: abandonment order, the last failing test wins"},
    {"op": "ldev_occ", "id": 500, "is_building": true, "bbox": [[0, 0, 0], [16, 10, 16]]},
    {"op": "ldev_profile", "building": "0x3001", "purpose": 1, "wealth": 1},
    {"op": "ldev_dev", "id": 700, "purpose": 1, "wealth": 1, "desirability": -100, "water_cap": 0},
    {"op": "ldev_cfg", "id": 9, "cfg_id": "0x60000009", "w": 1, "h": 1, "stage": 5},
    {"op": "ldev_lot", "id": 1, "x": 0, "z": 0, "state": 3, "building_type": "0x3001", "building": 500,
      "cfg": 9, "wealth": 1, "livable": true, "needs_power": true, "has_power": true,
      "road": true, "job": true,
      "counter": {"low_desirability": 100, "no_water": 100},
      "note": "desirability -100 is low and the counter is past the tolerance -> fails; water: stage 5 > cap 0 -> fails; power: powered and has_power agree -> passes (2); travel: road, job and trip length -> passes"},
    {"op": "ldev_cells", "powered": [[0, 0, 1]], "trip": [[0, 0, 1]]},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_clear_events"},
    {"op": "ldev_update_lot", "lot": 1, "expect": true, "note": "the state changed"},
    {"op": "ldev_expect_lot", "lot": 1, "state": 4},
    {"op": "ldev_expect_events", "filter": {"event": "set_state"},
      "note": "water (reason 3) is the last failing test; SetState is called once",
      "events": [{"event": "set_state", "lot": 1, "state": 4, "reason": 3}]},

    {"op": "ldev_lot", "id": 1, "state": 3, "has_power": false, "road": false,
      "counter": {"low_desirability": 100, "no_water": 100, "no_power": 100, "travel": 100},
      "note": "now all four fail: desirability low, unpowered for the third time, dry, no road"},
    {"op": "ldev_cells", "powered": [[0, 0, 0]], "trip": [[0, 0, 1]]},
    {"op": "ldev_clear_events"},
    {"op": "ldev_update_lot", "lot": 1, "expect": true},
    {"op": "ldev_expect_events", "filter": {"event": "set_state"},
      "note": "commute (reason 4) is the last of the four failing tests",
      "events": [{"event": "set_state", "lot": 1, "state": 4, "reason": 4}]}
  ]
}
