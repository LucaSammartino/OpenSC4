{
  "format": 1,
  "name": "development_types_keys_zones",
  "spec": ["building-development 4.7.3", "building-development 11.1", "building-development 11.2", "building-development 11.3"],
  "description": "Tests 1-3, by hand from 4.7.3. GetDeveloperType: (1, 2) -> 0x1020; (3, 1) -> 0 (office has no $); (3, 3) -> 0x3330; (5, 0) -> 0x4100 (industry ignores wealth); (4, 2) -> 0 (tourism); (1, 0) -> 0. GetWealth: 0x4300 -> 2, 0x3320 -> 2, 0x1234 -> 0. GetBuildingMapKey = uint8(4p + w + 1): (1, 1) -> 6, (3, 3) -> 16, (8, 3) -> 36, (64, 0) -> 257 mod 256 = 1. BuildingFitsInZone(bz, cz): (1, 3) true, (3, 1) false, (0, 0x0B) true, (8, 9) true, (4, 2) false, (5, 6) true, (0, 0x0F) true, (2, 2) true. GrowthStageFitsInZone(stage, zone): (4, 1) false, (3, 4) true, (6, 5) true, (7, 2) false, (15, 3) true, (1, 0) false, (1, 10) false.",
  "steps": [
    {"op": "development_eval", "fn": "developer_type", "args": [1, 2], "expect": "0x1020"},
    {"op": "development_eval", "fn": "developer_type", "args": [3, 1], "expect": 0},
    {"op": "development_eval", "fn": "developer_type", "args": [3, 3], "expect": "0x3330"},
    {"op": "development_eval", "fn": "developer_type", "args": [5, 0], "expect": "0x4100"},
    {"op": "development_eval", "fn": "developer_type", "args": [4, 2], "expect": 0},
    {"op": "development_eval", "fn": "developer_type", "args": [1, 0], "expect": 0},
    {"op": "development_eval", "fn": "wealth", "args": ["0x4300"], "expect": 2},
    {"op": "development_eval", "fn": "wealth", "args": ["0x3320"], "expect": 2},
    {"op": "development_eval", "fn": "wealth", "args": ["0x1234"], "expect": 0},
    {"op": "development_eval", "fn": "building_map_key", "args": [1, 1], "expect": 6},
    {"op": "development_eval", "fn": "building_map_key", "args": [3, 3], "expect": 16},
    {"op": "development_eval", "fn": "building_map_key", "args": [8, 3], "expect": 36},
    {"op": "development_eval", "fn": "building_map_key", "args": [64, 0], "expect": 1},
    {"op": "development_eval", "fn": "building_fits_in_zone", "args": [1, 3], "expect": true},
    {"op": "development_eval", "fn": "building_fits_in_zone", "args": [3, 1], "expect": false},
    {"op": "development_eval", "fn": "building_fits_in_zone", "args": [0, 11], "expect": true},
    {"op": "development_eval", "fn": "building_fits_in_zone", "args": [8, 9], "expect": true},
    {"op": "development_eval", "fn": "building_fits_in_zone", "args": [4, 2], "expect": false},
    {"op": "development_eval", "fn": "building_fits_in_zone", "args": [5, 6], "expect": true},
    {"op": "development_eval", "fn": "building_fits_in_zone", "args": [0, 15], "expect": true},
    {"op": "development_eval", "fn": "building_fits_in_zone", "args": [2, 2], "expect": true},
    {"op": "development_eval", "fn": "growth_stage_fits_in_zone", "args": [4, 1], "expect": false},
    {"op": "development_eval", "fn": "growth_stage_fits_in_zone", "args": [3, 4], "expect": true},
    {"op": "development_eval", "fn": "growth_stage_fits_in_zone", "args": [6, 5], "expect": true},
    {"op": "development_eval", "fn": "growth_stage_fits_in_zone", "args": [7, 2], "expect": false},
    {"op": "development_eval", "fn": "growth_stage_fits_in_zone", "args": [15, 3], "expect": true},
    {"op": "development_eval", "fn": "growth_stage_fits_in_zone", "args": [1, 0], "expect": false},
    {"op": "development_eval", "fn": "growth_stage_fits_in_zone", "args": [1, 10], "expect": false}
  ]
}
