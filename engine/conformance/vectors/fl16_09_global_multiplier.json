{
  "format": 1,
  "name": "flammability_global_multiplier",
  "spec": ["flammability 6.4", "flammability 5", "flammability 6.3", "flammability 14.2", "flammability 16.9"],
  "description": "Test 9, derived by hand from 6.4: f = GetCumulativeFactor(0x28F42AA0, 0); in summer (season 2) f = float32(f * summerMultiplier). Smoke Detectors 0.95 in summer with the code default 1.2: float32(0.95f * 1.2f) = float32(1.1400000310) ~ 1.14; shipped summer 1.0 -> 0.95; not summer -> 0.95. [choice] no ordinance simulator -> 1.0; no weather -> not summer. A new city keeps 0 until SeasonChange or OrdinanceUpdated (14.2): an insertion then writes raw 100 but adjusted 0, and IsCellFlammable is false. The messages only recompute the multiplier (grids untouched); a later insertion uses it: roundHE(100 * 1.14000003) = 114.",
  "steps": [
    {"op": "flam_call", "method": "global_multiplier", "args": [0.95, 2, 1.2], "expect": 1.14},
    {"op": "flam_call", "method": "global_multiplier", "args": [0.95, 2, 1.0], "expect": 0.95},
    {"op": "flam_call", "method": "global_multiplier", "args": [0.95, 1, 1.2], "expect": 0.95},
    {"op": "flam_call", "method": "global_multiplier", "args": [null, null, 1.2], "expect": 1.0},
    {"op": "flam_call", "method": "global_multiplier", "args": [null, 2, 1.2], "expect": 1.2},

    {"op": "flam_env", "cells": [8, 8], "factor": 0.95, "season": 2,
      "occupants": [{"id": 1, "type": "building", "flam": 100, "cell": [1, 1]}, {"id": 2, "type": "building", "flam": 100, "cell": [2, 2]}]},
    {"op": "flam_tuning", "none": true},
    {"op": "flam_create"},
    {"op": "flam_init"},
    {"op": "flam_expect", "state": {"global_multiplier": 0}},
    {"op": "flam_message", "type": "InsertOccupant", "occupant": 1, "expect": true},
    {"op": "flam_expect_grid", "grid": "raw", "cells": [[1, 1, 100]], "others": 0},
    {"op": "flam_expect_grid", "grid": "adjusted", "all": 0},
    {"op": "flam_call", "method": "is_cell_flammable", "args": [1, 1], "expect": false},
    {"op": "flam_call", "method": "compute_global_multiplier", "expect": 1.14},
    {"op": "flam_expect", "state": {"global_multiplier": 0}},
    {"op": "flam_message", "type": "SeasonChange", "expect": true},
    {"op": "flam_expect", "state": {"global_multiplier": 1.14}},
    {"op": "flam_expect_grid", "grid": "adjusted", "all": 0},
    {"op": "flam_message", "type": "InsertOccupant", "occupant": 2},
    {"op": "flam_expect_grid", "grid": "adjusted", "cells": [[2, 2, 114]], "others": 0},
    {"op": "flam_call", "method": "is_cell_flammable", "args": [2, 2], "expect": true},
    {"op": "flam_env", "season": 1},
    {"op": "flam_message", "type": "OrdinanceUpdated", "expect": true},
    {"op": "flam_expect", "state": {"global_multiplier": 0.95}},
    {"op": "flam_env", "factor": null, "season": null},
    {"op": "flam_message", "type": "SeasonChange"},
    {"op": "flam_expect", "state": {"global_multiplier": 1.0}},

    {"op": "flam_env", "factor": 0.95, "season": 2},
    {"op": "flam_tuning", "shipped": true},
    {"op": "flam_create"},
    {"op": "flam_init"},
    {"op": "flam_message", "type": "SeasonChange"},
    {"op": "flam_expect", "state": {"global_multiplier": 0.95}}
  ]
}
