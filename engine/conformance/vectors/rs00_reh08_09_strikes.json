{
  "format": 1,
  "name": "residential_strikes",
  "spec": ["REH 4.9", "REH 5", "REH 11.8", "REH 11.9", "residential 10.1"],
  "description": "The parts of REH tests 8 and 9 this core decides (slots 6-11). Slots 8 / 9 return false when the service is not on strike (nothing posted). On strike they call EndStrike(dept, today - start): flag and start := 0 and the end-of-strike message is posted with the block's ID (0x077ACCD0 education, 0x077ACCD2 health), no occupant, data2 = 0 and data3 = the length in days (1501 - 1000 = 501, 1501 - 1400 = 101). Slots 10 / 11 return 1.0 while the service is on strike, otherwise the combined chance over the group lists (REH 4.9): 0 without buildings; one building per group list, in the can-strike group (0x1A03 schools, 0x1A02 hospitals) with grade 0.4 -> c = curve(40) x 0.01 = 0.5 per list -> (0.5 + 0.5) - 0.25 = 0.75.",
  "steps": [
    {"op": "residential_create"},
    {"op": "residential_init", "expect": true},
    {"op": "residential_clear_events"},
    {"op": "residential_call", "method": "end_school_strike", "expect": false},
    {"op": "residential_call", "method": "end_health_strike", "expect": false},
    {"op": "residential_expect_events", "events": []},
    {"op": "residential_set", "state": {"education": {"strike_flag": 1, "strike_start": 1000}}},
    {"op": "residential_env", "today": 1501},
    {"op": "residential_call", "method": "school_is_on_strike", "expect": true},
    {"op": "residential_call", "method": "health_is_on_strike", "expect": false},
    {"op": "residential_call", "method": "end_school_strike", "expect": true},
    {"op": "residential_expect_events", "events": [{"event": "strike", "type": "0x077ACCD0", "occupant": null, "data2": 0, "data3": 501}]},
    {"op": "residential_expect", "state": {"education": {"strike_flag": 0, "strike_start": 0}}},
    {"op": "residential_call", "method": "school_is_on_strike", "expect": false},
    {"op": "residential_set", "state": {"health": {"strike_flag": 1, "strike_start": 1400}}},
    {"op": "residential_call", "method": "end_health_strike", "expect": true},
    {"op": "residential_expect_events", "events": [{"event": "strike", "type": "0x077ACCD2", "occupant": null, "data2": 0, "data3": 101}]},

    {"op": "residential_call", "method": "chance_of_school_strike", "expect": 0},
    {"op": "residential_env",
      "groups": {"1": ["0x150F", "0x1A03"], "2": ["0x1510", "0x1A03"], "3": ["0x1512", "0x1A02"], "4": ["0x1513", "0x1A02"]},
      "props": {"1": {"0x292453C5": {"f32": 0.4}}, "2": {"0x292453C5": {"f32": 0.4}}, "3": {"0x092453CB": {"f32": 0.4}}, "4": {"0x092453CB": {"f32": 0.4}}}},
    {"op": "residential_set", "state": {"lists": {"school_groups": [[1], [2]], "hospital_groups": [[3], [4]]}}},
    {"op": "residential_call", "method": "chance_of_school_strike", "expect": 0.75},
    {"op": "residential_call", "method": "chance_of_health_strike", "expect": 0.75},
    {"op": "residential_set", "state": {"health": {"strike_flag": 1}}},
    {"op": "residential_call", "method": "chance_of_health_strike", "expect": 1.0},
    {"op": "residential_call", "method": "chance_of_school_strike", "expect": 0.75},
    {"op": "residential_call", "method": "slot", "args": [8], "expect": ["EndSchoolStrike", 0, "AL"]}
  ]
}
