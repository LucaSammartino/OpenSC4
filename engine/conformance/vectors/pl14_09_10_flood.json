      {"x": 12, "z": 8, "v": 1}, {"x": 15, "z": 5, "v": 1}, {"x": 16, "z": 5, "v": 0}, {"x": 0, "z": 5, "v": 1},
      {"x": 5, "z": 11, "v": 1}, {"x": 5, "z": 12, "v": 0}, {"x": 13, "z": 9, "v": 1}, {"x": 14, "z": 9, "v": 1}, {"x": 14, "z": 10, "v": 0}]},
    {"op": "plumbing_call", "method": "are_watered_buildings_in_cell", "args": [12, 5], "expect": true},
    {"op": "plumbing_call", "method": "is_building_watered", "args": ["house"], "expect": true},
    {"op": "plumbing_expect_occupant", "occupant": "pump", "props": {"0x08D9763D": 300}},
    {"op": "plumbing_expect", "state": {"last_produced": 1000, "last_consumed": 300, "last_imported": 0, "last_exported": 0,
      "last_building_cells": 1, "last_watered_cells": 1, "pass_counter": 1, "state": 9, "factor": 1.0,
      "producers": [{"occupant": "pump", "production": 1000, "efficiency": 1.0, "visited": true, "assigned": true}],
      "iterator": {"state": 2, "x": 0, "z": 64, "step": 1, "rect": [0, 0, 63, 63]}, "last_pass_pipe_count": 5, "unused_counter": 0}},
    {"op": "plumbing_expect_event_count", "filter": {"event": "redisplay", "min": [0, 0], "max": [15, 11]}, "count": 1},
    {"op": "plumbing_expect_events", "events": [
