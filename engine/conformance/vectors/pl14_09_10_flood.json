    {"op": "plumbing_pipe_row", "prefix": "w", "from": [5, 5], "to": [9, 5]},
    {"op": "plumbing_building", "label": "house", "x": 12, "z": 5, "props": {"0xC8ED2D84": {"u32": 300}}},
    {"op": "plumbing_expect_flags", "cells": [{"x": 5, "z": 5, "v": "0x34"}, {"x": 7, "z": 5, "v": "0x15"}, {"x": 9, "z": 5, "v": "0x11"}, {"x": 12, "z": 5, "v": "0x40"}]},
    {"op": "plumbing_expect", "state": {"demand": 300}},
    {"op": "plumbing_clear_events"},
