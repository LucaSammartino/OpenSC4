{
  "format": 1,
  "name": "flammability_occupant_raw",
  "spec": ["flammability 6.1", "flammability 16.1", "foundations 5.2"],
  "description": "Test 1, derived by hand from 6.1: raw = clamp(roundHE(p * m), 0, 255) with m = the abandonment multiplier for buildings (0x278128A0) and props (0xA823821E) on a lot of condition 4, else 1; flora (0x74758926) never gets it; other types give 0; an absent property gives 0. Labels follow the M3 erratum (type IDs): the spec's 'a prop on an abandoned lot -> no multiplier' is the flora type 0x74758926 here, and a prop 0xA823821E does get the multiplier. 150 on a normal lot -> 150; condition 4 -> roundHE(150 * 1.1f) = roundHE(165.0000036) = 165 (code default), 150 * 1.5 = 225 (shipped); 200 * 1.5 = 300 -> 255; 3 * 1.5 = 4.5 -> 4 and 5 * 1.5 = 7.5 -> 8 (ties to even); condition 3 and no lot -> no multiplier. [choice] the property is read as the integer value of its first element (a float 150.7 truncates to 150).",
  "steps": [
    {"op": "flam_env", "cells": [8, 8],
      "lots": [{"id": 1, "condition": 0}, {"id": 3, "condition": 3}, {"id": 4, "condition": 4}],
      "occupants": [
        {"id": 1, "type": "building", "flam": 150, "lot": 1, "cell": [0, 0]},
        {"id": 2, "type": "building", "flam": 150, "lot": 4, "cell": [0, 0]},
        {"id": 3, "type": "building", "flam": 200, "lot": 4, "cell": [0, 0]},
        {"id": 4, "type": "building", "flam": 3, "lot": 4, "cell": [0, 0]},
        {"id": 5, "type": "building", "flam": 5, "lot": 4, "cell": [0, 0]},
        {"id": 6, "type": "prop", "flam": 150, "lot": 4, "cell": [0, 0]},
        {"id": 7, "type": "flora", "flam": 150, "lot": 4, "cell": [0, 0]},
        {"id": 8, "type": "0x088E1962", "flam": 150, "lot": 1, "cell": [0, 0]},
        {"id": 9, "type": "building", "flam": null, "lot": 4, "cell": [0, 0]},
        {"id": 10, "type": "building", "flam": 150, "lot": 3, "cell": [0, 0]},
        {"id": 11, "type": "building", "flam": 150, "cell": [0, 0]},
        {"id": 12, "type": "building", "flam": {"f32": 150.7}, "cell": [0, 0]},
        {"id": 13, "type": "flora", "flam": 0, "cell": [0, 0]}]},
    {"op": "flam_tuning", "none": true},
    {"op": "flam_create"},
    {"op": "flam_init"},
    {"op": "flam_call", "method": "occupant_raw", "args": [1], "expect": 150},
    {"op": "flam_call", "method": "occupant_raw", "args": [2], "expect": 165},
    {"op": "flam_call", "method": "occupant_raw", "args": [6], "expect": 165},
    {"op": "flam_call", "method": "occupant_raw", "args": [7], "expect": 150},
    {"op": "flam_call", "method": "occupant_raw", "args": [8], "expect": 0},
    {"op": "flam_call", "method": "occupant_raw", "args": [9], "expect": 0},
    {"op": "flam_call", "method": "occupant_raw", "args": [10], "expect": 150},
    {"op": "flam_call", "method": "occupant_raw", "args": [11], "expect": 150},
    {"op": "flam_call", "method": "occupant_raw", "args": [12], "expect": 150},
    {"op": "flam_call", "method": "occupant_raw", "args": [13], "expect": 0},

    {"op": "flam_tuning", "shipped": true},
    {"op": "flam_create"},
    {"op": "flam_init"},
    {"op": "flam_call", "method": "occupant_raw", "args": [1], "expect": 150},
    {"op": "flam_call", "method": "occupant_raw", "args": [2], "expect": 225},
    {"op": "flam_call", "method": "occupant_raw", "args": [3], "expect": 255},
    {"op": "flam_call", "method": "occupant_raw", "args": [4], "expect": 4},
    {"op": "flam_call", "method": "occupant_raw", "args": [5], "expect": 8},
    {"op": "flam_call", "method": "occupant_raw", "args": [6], "expect": 225},
    {"op": "flam_call", "method": "occupant_raw", "args": [7], "expect": 150},
    {"op": "flam_call", "method": "occupant_raw", "args": [8], "expect": 0},
    {"op": "flam_call", "method": "occupant_raw", "args": [9], "expect": 0},

    {"op": "flam_call", "method": "occupant_raw_value", "args": [150, 1.1], "expect": 165},
    {"op": "flam_call", "method": "occupant_raw_value", "args": [3, 1.5], "expect": 4},
    {"op": "flam_call", "method": "occupant_raw_value", "args": [5, 1.5], "expect": 8},
    {"op": "flam_call", "method": "occupant_raw_value", "args": [200, 1.5], "expect": 255},
    {"op": "flam_call", "method": "occupant_raw_value", "args": [-4, 1.5], "expect": 0}
  ]
}
