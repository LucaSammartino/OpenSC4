{
  "format": 1,
  "name": "om14_reentrant_callbacks",
  "spec": ["occupant-manager 9.1", "occupant-manager 9.2", "occupant-manager 14"],
  "description": "Callbacks may change the grid. Slot 44 (live walk, lock held): a callback on C removing C and A goes on with B and never visits A ([choice] after an unlinked node the walk continues with the node that took its place). Slot 42 (batch per cell, held references): an occupant removed by an earlier callback of the same batch is still called, then released. A list query nested in a callback works (local duplicate sets).",
  "steps": [
    {"op": "om_create"},
    {"op": "om_call", "method": "set_city_size", "args": [1024, 1024], "expect": true},
    {"op": "om_call", "method": "init", "expect": true},
    {"op": "om_occupant", "occupant": "0x1", "min": [10, 0, 10], "max": [20, 10, 20]},
    {"op": "om_occupant", "occupant": "0x2", "min": [10, 0, 10], "max": [20, 10, 20]},
    {"op": "om_occupant", "occupant": "0x3", "min": [10, 0, 10], "max": [20, 10, 20]},
    {"op": "om_call", "method": "insert", "occupant": "0x1", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x2", "data4": 0, "expect": true},
    {"op": "om_call", "method": "insert", "occupant": "0x3", "data4": 0, "expect": true},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "iterate", "expect": true, "actions": {"0x3": [{"method": "remove", "occupant": "0x3", "expect": true}, {"method": "remove", "occupant": "0x1", "expect": true}]}},
    {"op": "om_expect_events", "filter": {"event": "callback"}, "events": [{"event": "callback", "occupant": "0x3"}, {"event": "callback", "occupant": "0x2"}]},
    {"op": "om_expect_cell", "cell": [64, 64], "occupants": ["0x2"]},
    {"op": "om_occupant", "occupant": "0x4", "min": [10, 0, 10], "max": [20, 10, 20]},
    {"op": "om_call", "method": "insert", "occupant": "0x4", "data4": 0, "expect": true},
    {"op": "om_clear_events"},
    {"op": "om_call", "method": "iterate_by_bbox", "min": [0, -1, 0], "max": [30, 11, 30], "expect": true, "actions": {"0x4": [{"method": "remove", "occupant": "0x2", "expect": true}, {"method": "by_cells", "min": [64, 64], "max": [65, 65], "expect": true, "expect_list": ["0x4"]}]}},
    {"op": "om_expect_events", "filter": {"event": "callback"}, "events": [{"event": "callback", "occupant": "0x4"}, {"event": "callback", "occupant": "0x2"}]},
    {"op": "om_expect_event_count", "filter": {"event": "action_error"}, "count": 0},
    {"op": "om_expect_refs", "refs": {"0x1": 0, "0x2": 0, "0x3": 0, "0x4": 1}}
  ]
}
