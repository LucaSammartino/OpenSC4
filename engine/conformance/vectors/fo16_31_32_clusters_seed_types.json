{
  "format": 1,
  "name": "flora_clusters_seed_types",
  "spec": ["flora 6.11", "flora 6.7.2", "flora 14"],
  "description": "Derived by hand from flora 6.11 (tests 31 and 32 of 16). Chain S 0x10 -> M 0x20 -> L 0x30 (next links). AdvanceClusterType(a, b) = next(b) if b is reachable from a (a = b included), else next(a) if a is reachable from b, else 0: (S, S) -> M; (S, M) -> L; (M, S) -> L; (L, S) -> next(L) = 0; (M, L) -> next(L) = 0; an unrelated type U 0x40 -> 0; [choice] a two-type cycle X 0x50 <-> Y 0x60 ends the walk after map size + 1 steps: (X, Y) -> next(Y) = X. Seed types (AddStaticFloraData): each new record seeds itself, then every registered record whose seed type equals the new record's next type gets the new type. Chain S2 0x110 -> C 0x120: registered C then S2 -> C seeds S2 (and S2 seeds S2); registered S2 then C -> C seeds C. The key-0 default record (seed type 0) is captured by the next type registered after Init whose next type is 0. A seeding cluster plants its seed type: a mature C (seed type S2) drops a seed of type S2.",
  "steps": [
    {"op": "flora_types", "types": [{"type": "0x10", "next": "0x20"}, {"type": "0x20", "next": "0x30"}, {"type": "0x30"}, {"type": "0x40"},
      {"type": "0x50", "next": "0x60"}, {"type": "0x60", "next": "0x50"}]},
    {"op": "flora_create"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_call", "method": "advance_cluster_type", "args": ["0x10", "0x10"], "expect": "0x20"},
    {"op": "flora_call", "method": "advance_cluster_type", "args": ["0x10", "0x20"], "expect": "0x30"},
    {"op": "flora_call", "method": "advance_cluster_type", "args": ["0x20", "0x10"], "expect": "0x30"},
    {"op": "flora_call", "method": "advance_cluster_type", "args": ["0x30", "0x10"], "expect": 0},
    {"op": "flora_call", "method": "advance_cluster_type", "args": ["0x20", "0x30"], "expect": 0},
    {"op": "flora_call", "method": "advance_cluster_type", "args": ["0x10", "0x40"], "expect": 0},
    {"op": "flora_call", "method": "advance_cluster_type", "args": ["0x40", "0x10"], "expect": 0},
    {"op": "flora_call", "method": "advance_cluster_type", "args": ["0x10", "0x99"], "expect": 0},
    {"op": "flora_call", "method": "advance_cluster_type", "args": ["0x50", "0x60"], "expect": "0x50"},
    {"op": "flora_call", "method": "advance_cluster_type", "args": [0, 0], "expect": 0},
    {"op": "flora_expect_record", "type": "0x10", "seed_type": "0x10"},
    {"op": "flora_expect_record", "type": "0x20", "seed_type": "0x20"},

    {"op": "flora_types", "types": [{"type": "0x120", "table": 0.6, "seeds": 1}, {"type": "0x110", "next": "0x120", "table": 0.6}]},
    {"op": "flora_registry", "reset": true},
    {"op": "flora_create"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_expect_record", "type": "0x120", "seed_type": "0x110"},
    {"op": "flora_expect_record", "type": "0x110", "seed_type": "0x110"},
    {"op": "flora_expect_record", "type": 0, "seed_type": 0},
    {"op": "flora_call", "method": "add_static", "args": [{"type": "0x130"}], "expect": true},
    {"op": "flora_expect_record", "type": 0, "seed_type": "0x130"},
    {"op": "flora_expect_record", "type": "0x130", "seed_type": "0x130"},
    {"op": "flora_env", "date": 5000, "occupants": [
      {"id": 1, "type": "flora", "flora_type": "0x120", "pos": [500, 260, 500], "birth": 4000, "last_seed": 0, "state": 2}]},
    {"op": "flora_set", "state": {"today": 5000}},
    {"op": "flora_rng", "doubles": [0.75, 0.5, 0]},
    {"op": "flora_clear_events"},
    {"op": "flora_call", "method": "simulate_existing", "args": [1]},
    {"op": "flora_expect_events", "filter": {"event": "set_type"}, "events": [{"event": "set_type", "occupant": 1000, "value": "0x110"}]},
    {"op": "flora_expect_occupant", "occupant": 1000, "pos": [564, 260, 500], "flora_type": "0x110"},

    {"op": "flora_types", "types": [{"type": "0x110", "next": "0x120"}, {"type": "0x120"}]},
    {"op": "flora_registry", "reset": true},
    {"op": "flora_create"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_expect_record", "type": "0x120", "seed_type": "0x120"},
    {"op": "flora_expect_record", "type": "0x110", "seed_type": "0x110"}
  ]
}
