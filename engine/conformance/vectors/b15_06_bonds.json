{
  "format": 1,
  "name": "budget_bonds",
  "spec": ["budget 5.4", "budget 6", "budget 15.6"],
  "description": "Bond rounding to the increment (7,499 -> 5,000; 1 -> 5,000), the size, count and total limits (the total limit is reached by re-initialising with smaller limits while bonds are open), the shipped payment (10,000 at 8.5 % over 120 months: 123 a month, full cost 14,760) and a full amortisation: 120 payments, the 119th settlement sets the last payment to the principal left (214), the 120th removes the bond with BondFinished. GetAllLoans and totalBorrowed month by month.",
  "steps": [
    {"op": "budget_env", "difficulty": 2, "year": 2000, "month": 1},
    {"op": "budget_create"},
    {"op": "budget_init", "tuning": {"0x6A9C7718": [500000, 200000, 100000], "0x090E0A9F": -100000,
      "0x490E0AA6": 5000, "0x090E0AAC": 10, "0x890E0AB4": 200000, "0x8A3FB98D": 8.5, "0x0A3FB9A8": 120}},
    {"op": "budget_call", "method": "bond_increment", "expect": 5000},
    {"op": "budget_call", "method": "current_borrowing_limit", "expect": 2000000},
    {"op": "budget_call", "method": "current_bond_limit", "expect": 200000},
    {"op": "budget_call", "method": "current_max_outstanding_bonds_limit", "expect": 10},
    {"op": "budget_call", "method": "loan_time_in_months", "expect": 120},
    {"op": "budget_call", "method": "monthly_payment_for_loan", "args": [10000], "expect": 123},
    {"op": "budget_call", "method": "full_cost_of_loan", "args": [10000], "expect": 14760},

    {"op": "clear_events"},
    {"op": "budget_call", "method": "issue_bond", "args": [0], "expect": false},
    {"op": "budget_call", "method": "issue_bond", "args": [205000], "expect": false},
    {"op": "expect_event_count", "filter": {"event": "post"}, "count": 0},
    {"op": "budget_call", "method": "issue_bond", "args": [7499], "expect": true},
    {"op": "budget_expect", "state": {"total_borrowed": 5000, "funds": 105000, "bond_count": 1}},
    {"op": "budget_call", "method": "issue_bond", "args": [1], "expect": true},
    {"op": "budget_expect", "state": {"total_borrowed": 10000, "funds": 110000, "bond_count": 2}},
    {"op": "budget_call", "method": "issue_bond", "args": [204999], "expect": true, "note": "rounds down to 200,000"},
    {"op": "budget_expect", "state": {"total_borrowed": 210000, "bond_count": 3}},
    {"op": "repeat", "count": 7, "steps": [{"op": "budget_call", "method": "issue_bond", "args": [5000], "expect": true}]},
    {"op": "budget_expect", "state": {"total_borrowed": 245000, "bond_count": 10}},
    {"op": "budget_call", "method": "issue_bond", "args": [5000], "expect": false, "note": "count limit"},
    {"op": "budget_expect", "state": {"total_borrowed": 245000, "bond_count": 10}},
    {"op": "budget_shutdown"},
    {"op": "budget_init", "tuning": {"0x490E0AA6": 5000, "0x090E0AAC": 12, "0x890E0AB4": 21000, "0x8A3FB98D": 8.5,
      "0x0A3FB9A8": 120}},
    {"op": "budget_call", "method": "current_borrowing_limit", "expect": 252000},
    {"op": "budget_call", "method": "issue_bond", "args": [5000], "expect": true},
    {"op": "budget_call", "method": "issue_bond", "args": [5000], "expect": false, "note": "250,000 + 5,000 > 252,000"},
    {"op": "budget_expect", "state": {"total_borrowed": 250000, "bond_count": 11}},

    {"op": "budget_create"},
    {"op": "budget_init", "tuning": {"0x6A9C7718": [500000, 200000, 100000], "0x090E0A9F": -100000,
      "0x490E0AA6": 5000, "0x090E0AAC": 10, "0x890E0AB4": 200000, "0x8A3FB98D": 8.5, "0x0A3FB9A8": 120}},
    {"op": "clear_events"},
    {"op": "budget_call", "method": "issue_bond", "args": [10000], "expect": true},
    {"op": "expect_events", "filter": {"event": "post"}, "events": [
      {"type": "BondIssued", "data1": 0, "data2": 0, "data3": 0, "void1": "budget", "unknown": "budget"},
      {"type": "FundsChanged", "void1": "budget", "unknown": "budget"}
    ]},
    {"op": "budget_expect", "state": {"funds": 110000, "total_borrowed": 10000, "bond_count": 1,
      "bonds": [{"due_month": 1, "due_year": 2010, "amount": 10000, "full_cost": 14760, "remaining": 14760, "paid": 0,
                 "monthly_payment": 123, "principal_left": 10000}]}},
    {"op": "budget_expect_loans", "loans": [{"months_remaining": 0, "years_remaining": 10, "total_loan_amount": 10000,
      "remaining_payment": 10000, "monthly_payment": 123}]},
    {"op": "budget_call", "method": "total_monthly_bond_payments", "expect": 123},

    {"op": "budget_env", "advance_month": true},
    {"op": "budget_call", "method": "settle_month"},
    {"op": "budget_expect", "state": {"funds": 109877, "total_borrowed": 10000,
      "bonds": [{"remaining": 14637, "paid": 123, "monthly_payment": 123, "principal_left": 9947}]}},
    {"op": "budget_expect_loans", "loans": [{"months_remaining": 11, "years_remaining": 9, "total_loan_amount": 10000,
      "remaining_payment": 9947, "monthly_payment": 123}]},
    {"op": "budget_env", "advance_month": true},
    {"op": "budget_call", "method": "settle_month"},
    {"op": "budget_expect", "state": {"bonds": [{"remaining": 14514, "paid": 246, "principal_left": 9894}]}},
    {"op": "budget_expect_loans", "loans": [{"months_remaining": 10, "years_remaining": 9, "remaining_payment": 9894}]},

    {"op": "repeat", "count": 10, "steps": [
      {"op": "budget_env", "advance_month": true},
      {"op": "budget_call", "method": "settle_month"}
    ]},
    {"op": "budget_expect", "state": {"bonds": [{"remaining": 13284, "paid": 1476, "principal_left": 9342}],
      "ytd_bond_payments": 0}},
    {"op": "budget_expect_loans", "loans": [{"months_remaining": 0, "years_remaining": 9, "remaining_payment": 9342}]},
    {"op": "budget_env", "advance_month": true},
    {"op": "budget_call", "method": "settle_month"},
    {"op": "budget_expect", "state": {"bonds": [{"remaining": 13161, "paid": 1599, "principal_left": 9285}]}},
    {"op": "budget_expect_loans", "loans": [{"months_remaining": 11, "years_remaining": 8, "remaining_payment": 9285}]},

    {"op": "repeat", "count": 105, "steps": [
      {"op": "budget_env", "advance_month": true},
      {"op": "budget_call", "method": "settle_month"}
    ]},
    {"op": "budget_expect", "state": {"bonds": [{"remaining": 246, "paid": 14514, "monthly_payment": 123,
      "principal_left": 335}]}},
    {"op": "budget_expect_loans", "loans": [{"months_remaining": 2, "years_remaining": 0, "remaining_payment": 335,
      "monthly_payment": 123}]},
    {"op": "budget_env", "advance_month": true},
    {"op": "budget_call", "method": "settle_month"},
    {"op": "budget_expect", "state": {"ytd_bond_payments": 1353, "total_borrowed": 10000, "bond_count": 1,
      "bonds": [{"remaining": 123, "paid": 14637, "monthly_payment": 214, "principal_left": 214}]}},
    {"op": "budget_call", "method": "total_monthly_bond_payments", "expect": 214},
    {"op": "budget_expect_loans", "loans": [{"months_remaining": 1, "years_remaining": 0, "remaining_payment": 214,
      "monthly_payment": 214}]},

    {"op": "clear_events"},
    {"op": "budget_env", "advance_month": true},
    {"op": "budget_call", "method": "settle_month"},
    {"op": "expect_events", "filter": {"event": "post"}, "events": [
      {"type": "BondFinished", "data1": 0, "data2": 0, "data3": 0, "void1": "budget", "unknown": "budget"},
      {"type": "FundsChanged"}
    ]},
    {"op": "budget_expect", "state": {"funds": 95149, "total_borrowed": 0, "bond_count": 0, "bonds": [],
      "ytd_bond_payments": 0, "last_month_expense": 214}},
    {"op": "budget_expect_loans", "loans": []},
    {"op": "budget_call", "method": "total_monthly_bond_payments", "expect": 0}
  ]
}
