{
  "format": 1,
  "name": "dispatch_dispatch",
  "spec": ["dispatch 4.3", "dispatch 12.4"],
  "description": "Dispatch with no registered source returns 0 and leaves nextID; with a source whose CanDispatch is true and a free unit it returns nextID + 1, appends one record (type, ID, call number of the nearest free unit, target at the terrain altitude, the station held) and posts begin once. CanDispatch false, or all units busy without an active pylon, give 0 without consuming an ID. A vehicle that fails to begin is revoked (end posted) and consumes the ID.",
  "steps": [
    {"op": "dispatch_create"},
    {"op": "dispatch_init", "expect": true},
    {"op": "dispatch_call", "method": "dispatch", "args": [1, 10, 20], "expect": 0},
    {"op": "dispatch_expect", "state": {"next_id": 0, "record_count": 0}},
    {"op": "dispatch_source", "source": "0x500", "types": [1], "stations": [{"station": "0x600", "base": 1, "count": 3}]},
    {"op": "dispatch_clear_events"},
    {"op": "dispatch_call", "method": "dispatch", "args": [1, 10, 20], "expect": 1},
    {"op": "dispatch_expect", "state": {"next_id": 1, "record_count": 1}},
    {"op": "dispatch_call", "method": "get_dispatch_info", "args": [1], "expect": {"type": 1, "id": 1, "call": 1, "active": false, "target": [10, 0.3, 20], "station": "0x600", "pylon": null}},
    {"op": "dispatch_expect_refs", "refs": {"0x600": 1}},
    {"op": "dispatch_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0xE94671EB", "dispatch_type": 1, "id": 1}]},
    {"op": "dispatch_expect_units", "source": "0x500", "masks": [6]},
    {"op": "dispatch_source", "source": "0x500", "can": false},
    {"op": "dispatch_call", "method": "can_dispatch", "args": [1, 0, 0], "expect": false},
    {"op": "dispatch_call", "method": "dispatch", "args": [1, 0, 0], "expect": 0},
    {"op": "dispatch_expect", "state": {"next_id": 1}},
    {"op": "dispatch_source", "source": "0x500", "can": true, "all_busy": true},
    {"op": "dispatch_call", "method": "dispatch", "args": [1, 0, 0], "expect": 0},
    {"op": "dispatch_expect", "state": {"next_id": 1}},
    {"op": "dispatch_source", "source": "0x500", "all_busy": false},
    {"op": "dispatch_env", "vehicles_fail": true},
    {"op": "dispatch_clear_events"},
    {"op": "dispatch_call", "method": "dispatch", "args": [1, 0, 0], "expect": 0},
    {"op": "dispatch_expect", "state": {"next_id": 2, "record_count": 1}},
    {"op": "dispatch_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x894671F6", "dispatch_type": 1, "id": 2}]}
  ]
}
