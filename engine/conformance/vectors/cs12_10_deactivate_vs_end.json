{
  "format": 1,
  "name": "citysit_deactivate_vs_end",
  "spec": ["city-situation 4.3.1", "city-situation 4.4", "city-situation 12"],
  "description": "Section 12 test 10 (CS6). DeactivateSituation during the 4000 ms countdown clears the mission state, sends 0xABBBCA64 data1 = 0 and releases the advice, but leaves the countdown, the time limit and the indicators: the countdown runs out on later ticks, ending its effect and unfreezing the automata. EndSituation releases the situation effect, sets the time limit to 0, stops the countdown effect (the value stays and still unfreezes the automata when it runs out), deactivates and re-shows the indicators.",
  "steps": [
    {"op": "citysit_create"},
    {"op": "citysit_add_ref", "expect": 1},
    {"op": "citysit_advice", "advice": "0x500", "guid": "0x8C151EFD", "time_limit": 60},
    {"op": "citysit_automaton", "automaton": "0x700"},
    {"op": "citysit_init", "expect": true},
    {"op": "citysit_call", "method": "initiate_situation", "args": ["0x500", "0x700", false], "expect": true},
    {"op": "citysit_call", "method": "activate_situation", "args": []},
    {"op": "citysit_ticks", "count": 1, "ms": 16},
    {"op": "citysit_clear_events"},
    {"op": "citysit_call", "method": "deactivate_situation", "args": []},
    {"op": "citysit_expect_events", "events": [{"event": "clear_mission_state", "advice": "0x500"}, {"event": "send", "type": "0xABBBCA64", "advice": "0x500", "data1": 0}]},
    {"op": "citysit_expect_refs", "refs": {"0x500": 0}},
    {"op": "citysit_expect", "state": {"status": 4, "active_situation": null, "active_automaton": null, "countdown": 4000, "time_limit": 60}},
    {"op": "citysit_call", "method": "countdown_is_in_progress", "args": [], "expect": true},
    {"op": "citysit_ticks", "count": 1, "ms": 1000},
    {"op": "citysit_expect_events", "events": []},
    {"op": "citysit_ticks", "count": 1, "ms": 3000},
    {"op": "citysit_expect_events", "events": [{"event": "countdown_end"}, {"event": "freeze", "manager": "0x43", "on": false}, {"event": "freeze", "manager": "0x45", "on": false}, {"event": "freeze", "manager": "0x44", "on": false}, {"event": "freeze", "manager": "0x46", "on": false}]},
    {"op": "citysit_call", "method": "initiate_situation", "args": ["0x500", "0x700", false], "expect": true},
    {"op": "citysit_call", "method": "activate_situation", "args": []},
    {"op": "citysit_ticks", "count": 1, "ms": 16},
    {"op": "citysit_clear_events"},
    {"op": "citysit_call", "method": "end_situation", "args": []},
    {"op": "citysit_expect_events", "events": [{"event": "release_situation_effect"}, {"event": "countdown_end"}, {"event": "clear_mission_state", "advice": "0x500"}, {"event": "send", "type": "0xABBBCA64", "advice": "0x500", "data1": 0}, {"event": "show_all_indicators", "kind": 4, "visible": true}]},
    {"op": "citysit_expect", "state": {"status": 4, "active_situation": null, "countdown": 4000, "time_limit": 0}},
    {"op": "citysit_ticks", "count": 1, "ms": 4000},
    {"op": "citysit_expect_events", "events": [{"event": "freeze", "manager": "0x43", "on": false}, {"event": "freeze", "manager": "0x45", "on": false}, {"event": "freeze", "manager": "0x44", "on": false}, {"event": "freeze", "manager": "0x46", "on": false}]},
    {"op": "citysit_call", "method": "countdown_is_in_progress", "args": [], "expect": false}
  ]
}
