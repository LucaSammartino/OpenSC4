{
  "format": 1,
  "name": "budget_settlement",
  "spec": ["budget 5.1", "budget 5.4", "budget 15.3"],
  "description": "Stub ordinance (income 50, expense 30) and neighbours (income 7, expense 11), one department with one non-local line (full 1000, p = 0.5) and one 10,000 bond (123 a month): funds change by exactly income - expense (57 - 664). YTD, last-month and by-month values and the three history series follow 5.1, including the 0xFFFFFFFF clamp for a value of 2^32 or more.",
  "steps": [
    {"op": "budget_env", "difficulty": 2, "year": 2000, "month": 1, "ordinance_income": 50, "ordinance_expense": 30,
      "neighbor_income": 7, "neighbor_expense": 11},
    {"op": "budget_create"},
    {"op": "budget_init", "tuning": {"0x6A9C7718": [500000, 200000, 100000], "0x090E0A9F": -100000,
      "0x490E0AA6": 5000, "0x090E0AAC": 10, "0x890E0AB4": 200000, "0x8A3FB98D": 8.5, "0x0A3FB9A8": 120,
      "0xEBFF69E7": [1.2, 1.1, 1.0]}},
    {"op": "budget_call", "method": "create_department_budget", "args": [4096, 8192], "expect": 4096},
    {"op": "budget_dept", "dept": 4096, "method": "create_line_item", "args": [1, false], "expect": 1},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "set_full_expenses", "args": [1000]},
    {"op": "budget_dept", "dept": 4096, "method": "set_funding_percentage", "args": [0.5, 0]},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "current_expenses", "expect": 500},
    {"op": "budget_call", "method": "issue_bond", "args": [10000], "expect": true},
    {"op": "budget_expect", "state": {"funds": 110000, "total_borrowed": 10000, "bond_count": 1}},
    {"op": "budget_call", "method": "total_monthly_expense", "expect": 664, "note": "live: 30 + 11 + 500 + 123"},
    {"op": "budget_call", "method": "total_monthly_income", "expect": 57},
    {"op": "clear_events"},

    {"op": "budget_env", "month": 2},
    {"op": "budget_call", "method": "settle_month"},
    {"op": "budget_expect", "state": {"funds": 109393, "shadow_funds": 109393,
      "ytd_income": 57, "ytd_expense": 664, "last_month_income": 57, "last_month_expense": 664,
      "ytd_tax_income": 0, "last_tax_income": 0, "ytd_ordinance_income": 50, "ytd_ordinance_expense": 30,
      "ordinance_income_by_month": {"0": 50, "1": 0}, "ordinance_expense_by_month": {"0": 30},
      "ytd_bond_payments": 123,
      "bonds": [{"due_month": 1, "due_year": 2010, "amount": 10000, "full_cost": 14760, "remaining": 14637, "paid": 123,
                 "monthly_payment": 123, "principal_left": 9947}]}},
    {"op": "budget_dept", "dept": 4096, "method": "total_spending", "expect": 500},
    {"op": "expect_events", "filter": {"event": "history"}, "events": [
      {"series": "0x6A51178B", "value": 57},
      {"series": "0xCA5BA3FB", "value": 664},
      {"series": "0x4A5BA3D0", "value": 109}
    ]},

    {"op": "budget_env", "month": 3, "ordinance_income": 5000000000},
    {"op": "budget_call", "method": "settle_month"},
    {"op": "expect_events", "filter": {"event": "history"}, "events": [
      {"series": "0x6A51178B", "value": -1},
      {"series": "0xCA5BA3FB", "value": 664},
      {"series": "0x4A5BA3D0", "value": 5000108}
    ]},
    {"op": "budget_expect", "state": {"funds": 5000108736, "last_month_income": 5000000007,
      "ordinance_income_by_month": {"0": 50, "1": 5000000000}}}
  ]
}
