{
  "format": 1,
  "name": "net_lot_record_and_lifecycle",
  "spec": ["network-manager 3.2", "network-manager 4.2", "network-manager 8.6", "network-manager 17"],
  "description": "Component 11 with one lot and one pothole: u16 2, u32 1, key (10, 10) = 0x0A0A, the occupant (object 1), configuration ID 2, u32 1, key (5, 6) = 0x0506, the effect prop (object 2): 34 bytes. Read into a new manager keeps the configuration ID only (no configuration before Init) and writes the same bytes; Init resolves it. With configuration 2 missing at Init the lot is dropped without release (quirk) while the pothole stays. RedevelopLot removes the cell's street props and flora and draws again once per object. Shutdown unsubscribes the 6 messages, releases the lots, stops and releases the potholes, and empties both maps.",
  "steps": [
    {"op": "net_config", "id": 1, "piece": "0x100"},
    {"op": "net_config", "id": 2, "piece": "0x100", "objects": [
      {"kind": "prop", "offset": [3, 0, 5], "ids": ["0xA1", "0xA2"]},
      {"kind": "flora", "offset": [8, 0, 8], "ids": ["0xF1"]},
      {"kind": "prop", "flags": 1, "ids": ["0xEE"]}]},
    {"op": "net_occupant", "occupant": "0x40", "flags": ["street", "usable"], "piece": "0x100", "cell": [10, 10]},
    {"op": "net_create"},
    {"op": "net_init", "of": "lots"},
    {"op": "net_env", "u32s": [1]},
    {"op": "net_message", "of": "lots", "type": "UsableChanged", "data1": 1, "unknown": "0x40"},
    {"op": "net_expect_lot", "cell": [10, 10], "state": {"config": 2}},
    {"op": "net_expect_event_count", "filter": {"event": "prop", "id": "0xEE"}, "count": 0},
    {"op": "net_clear_events"},
    {"op": "net_call", "method": "redevelop_lot", "args": [10, 10]},
    {"op": "net_expect_events", "events": [
      {"event": "remove_props", "cell": [10, 10]},
      {"event": "demolish_flora", "cell": [10, 10]},
      {"event": "draw", "n": 2},
      {"event": "prop", "id": "0xA1", "token": "0x5002"},
      {"event": "prop28", "prop": "0x5002", "value": 0},
      {"event": "draw", "n": 1},
      {"event": "flora", "id": "0xF1", "token": "0x5003"},
      {"event": "flora28", "flora": "0x5003", "index": 1},
      {"event": "intersection", "occupant": "0x40"}
    ]},
    {"op": "net_expect_lot", "cell": [10, 10], "state": {"config": 2, "occupant": "0x40"}},
    {"op": "net_call", "method": "do_road_damage_change", "args": [5, 6, true]},
    {"op": "net_write", "of": "lots", "slot": "a", "expect": true, "length": 34,
      "hex": "0200 01000000 0A0A 01000000 94EF21A8 02000000 01000000 0605 02000000 94EF21A8",
      "registered": ["0x40", "0x5004"]},

    {"op": "net_create", "of": "lots"},
    {"op": "net_read", "of": "lots", "slot": "a", "reuse": true, "expect": true},
    {"op": "net_expect", "of": "lots", "state": {"initialized": false,
      "lots": [{"cell": [10, 10], "occupant": "0x40", "config": null, "config_id": 2, "locked": false}],
      "potholes": [{"cell": [5, 6], "prop": "0x5004"}]}},
    {"op": "net_write", "of": "lots", "slot": "b", "expect": true},
    {"op": "net_expect_record", "slot": "b", "same_as": "a"},
    {"op": "net_init", "of": "lots"},
    {"op": "net_expect_lot", "cell": [10, 10], "state": {"config": 2, "config_id": 2}},
    {"op": "net_call", "method": "configuration_by_id", "args": [2], "expect": true},
    {"op": "net_call", "method": "configuration_by_id", "args": [3], "expect": false},

    {"op": "net_create", "of": "lots"},
    {"op": "net_read", "of": "lots", "slot": "a", "reuse": true, "expect": true},
    {"op": "net_config", "clear": true, "id": 1, "piece": "0x100"},
    {"op": "net_init", "of": "lots"},
    {"op": "net_expect", "of": "lots", "state": {"lots": [], "potholes": [{"cell": [5, 6], "prop": "0x5004"}]}},
    {"op": "net_write", "of": "lots", "expect": true, "hex": "0200 00000000 01000000 0605 01000000 94EF21A8"},
    {"op": "net_read", "of": "lots", "reuse": true, "hex": "0100", "expect": false},

    {"op": "net_create", "of": "lots"},
    {"op": "net_init", "of": "lots"},
    {"op": "net_read", "of": "lots", "slot": "a", "reuse": true, "expect": true},
    {"op": "net_expect_refs", "refs": {"0x40": 4, "0x5004": 4}},
    {"op": "net_clear_events"},
    {"op": "net_shutdown", "of": "lots", "expect": true},
    {"op": "net_expect_events", "events": [
      {"event": "unsubscribe", "type": "0x89D3E9F3"},
      {"event": "unsubscribe", "type": "0x99EF1143"},
      {"event": "unsubscribe", "type": "0xA9B6C2D6"},
      {"event": "unsubscribe", "type": "0x07699455"},
      {"event": "unsubscribe", "type": "0xE8BDA2E7"},
      {"event": "unsubscribe", "type": "0x69247DC8"},
      {"event": "effect_stop", "prop": "0x5004"}
    ]},
    {"op": "net_expect_refs", "refs": {"0x40": 3, "0x5004": 3}},
    {"op": "net_expect", "of": "lots", "state": {"lots": [], "potholes": [], "initialized": false}}
  ]
}
