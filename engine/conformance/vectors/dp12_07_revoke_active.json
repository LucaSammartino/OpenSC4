{
  "format": 1,
  "name": "dispatch_revoke_active",
  "spec": ["dispatch 4.5", "dispatch 12.7"],
  "description": "RevokeDispatchByID of an active record posts end only (no inactive) and returns the unit (RevokeDispatchFromStation once, the unit free again); a second revoke answers false. Without a source for the type, EndDispatch fails and the record is erased anyway.",
  "steps": [
    {"op": "dispatch_create"},
    {"op": "dispatch_init", "expect": true},
    {"op": "dispatch_source", "source": "0x500", "types": [1], "stations": [{"station": "0x600", "base": 1, "count": 3}]},
    {"op": "dispatch_clear_events"},
    {"op": "dispatch_call", "method": "dispatch", "args": [1, 1, 1], "expect": 1},
    {"op": "dispatch_call", "method": "update_dispatch_state", "args": [1, 5]},
    {"op": "dispatch_expect_units", "source": "0x500", "masks": [6]},
    {"op": "dispatch_clear_events"},
    {"op": "dispatch_call", "method": "revoke_dispatch_by_id", "args": [1], "expect": true},
    {"op": "dispatch_expect_event_count", "filter": {"event": "revoke_from_station"}, "count": 1},
    {"op": "dispatch_expect_events", "filter": {"event": "post"}, "events": [{"event": "post", "type": "0x894671F6", "dispatch_type": 1, "id": 1}]},
    {"op": "dispatch_expect_units", "source": "0x500", "masks": [7]},
    {"op": "dispatch_call", "method": "revoke_dispatch_by_id", "args": [1], "expect": false},
    {"op": "dispatch_call", "method": "dispatch", "args": [1, 1, 1], "expect": 2},
    {"op": "dispatch_call", "method": "unregister_dispatch_source", "args": ["0x500"]},
    {"op": "dispatch_call", "method": "revoke_dispatch_by_id", "args": [2], "expect": false},
    {"op": "dispatch_expect", "state": {"record_count": 0}}
  ]
}
