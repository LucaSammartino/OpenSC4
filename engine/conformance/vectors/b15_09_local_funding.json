{
  "format": 1,
  "name": "budget_local_funding",
  "spec": ["budget 7", "budget 7.3", "budget 7.4", "budget 15.9"],
  "description": "Per-building funding with two buildings costing 100 on one local line. SetLocalFundingPercent(H1, 0.5) moves the department to 75 % (((5000 - 10000) + 20000) / 200 x 0.01), recomputes the line (150), writes 50 % on H1 and posts BudgetForOccupantChanged with the occupant; out-of-range or unregistered calls are ignored. SetLocalFullFunding(H2, 300) gives 87.5 %, full 400, current 350. RemoveLocallyFundedObject(H2) sets H2's cost property to 0, drops the reference and gives 50 %, current 50; removing the last building resets the department to 100 %.",
  "steps": [
    {"op": "budget_env", "difficulty": 2, "year": 2000, "month": 1},
    {"op": "budget_create"},
    {"op": "budget_init"},
    {"op": "budget_call", "method": "create_department_budget", "args": [4096, 8192], "expect": 4096},
    {"op": "budget_dept", "dept": 4096, "method": "create_line_item", "args": [1, true], "expect": 1},
    {"op": "budget_holder", "holder": "H1", "occupant": true, "props": {"0xEA54D283": {"u32": [4096]},
      "0xEA54D284": {"u32": [1]}, "0xEA54D285": {"u32": [2857002764]}, "0xEA54D286": {"i64": [100]}}},
    {"op": "budget_holder", "holder": "H2", "props": {"0xEA54D283": {"u32": [4096]},
      "0xEA54D284": {"u32": [1]}, "0xEA54D285": {"u32": [2857002764]}, "0xEA54D286": {"i64": [100]}}},
    {"op": "budget_holder", "holder": "H3", "props": {"0xEA54D283": {"u32": [4096]},
      "0xEA54D284": {"u32": [1]}, "0xEA54D285": {"u32": [2857002764]}, "0xEA54D286": {"i64": [100]}}},
    {"op": "budget_dept", "dept": 4096, "method": "add_locally_funded_object", "args": ["H1", 2857002764], "expect": true},
    {"op": "budget_dept", "dept": 4096, "method": "add_locally_funded_object", "args": ["H2", 2857002764], "expect": true},
    {"op": "budget_dept", "dept": 4096, "method": "add_locally_funded_object", "args": ["H1", 1], "expect": false,
     "note": "[choice] no item for that purpose"},
    {"op": "budget_expect_holder", "holder": "H1", "prop": "0xEA54D287", "values": {"f32": [100]}},
    {"op": "budget_dept", "dept": 4096, "method": "is_locally_funded_object", "args": ["H1", 2857002764], "expect": true},
    {"op": "budget_dept", "dept": 4096, "method": "is_locally_funded_object", "args": ["H3", 2857002764], "expect": false},
    {"op": "budget_dept", "dept": 4096, "method": "local_funding_percent", "args": ["H1", 2857002764], "expect": 1.0},
    {"op": "budget_dept", "dept": 4096, "method": "local_full_funding", "args": ["H1", 2857002764], "expect": 100},
    {"op": "budget_dept", "dept": 4096, "method": "local_full_funding", "args": ["H3", 2857002764], "expect": 0},
    {"op": "budget_dept", "dept": 4096, "method": "has_locally_funded_items_by_purpose", "args": [2857002764], "expect": true},
    {"op": "budget_dept", "dept": 4096, "method": "has_locally_funded_items_by_purpose", "args": [1], "expect": false},
    {"op": "budget_dept", "dept": 4096, "method": "locally_funded_items_by_purpose", "args": [2857002764], "expect": ["H1", "H2"]},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "full_expenses", "expect": 200},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "current_expenses", "expect": 200},

    {"op": "clear_events"},
    {"op": "budget_dept", "dept": 4096, "method": "set_local_funding_percent", "args": ["H1", 0.5, 2857002764]},
    {"op": "budget_dept", "dept": 4096, "method": "funding_percentage", "expect": 0.75},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "current_expenses", "expect": 150},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "full_expenses", "expect": 200},
    {"op": "budget_expect_holder", "holder": "H1", "prop": "0xEA54D287", "values": {"f32": [50]}},
    {"op": "budget_expect_holder", "holder": "H2", "prop": "0xEA54D287", "values": {"f32": [100]}},
    {"op": "budget_dept", "dept": 4096, "method": "local_funding_percent", "args": ["H1", 2857002764], "expect": 0.5},
    {"op": "expect_events", "filter": {"event": "post", "type": "BudgetForOccupantChanged"}, "events": [
      {"unknown": "H1"}
    ]},
    {"op": "clear_events"},
    {"op": "budget_dept", "dept": 4096, "method": "set_local_funding_percent", "args": ["H1", 0.5, 2857002764]},
    {"op": "expect_event_count", "filter": {"event": "post"}, "count": 0, "note": "unchanged amount: no message, no SetPct"},
    {"op": "budget_dept", "dept": 4096, "method": "set_local_funding_percent", "args": ["H1", 1.5, 2857002764]},
    {"op": "budget_dept", "dept": 4096, "method": "set_local_funding_percent", "args": ["H1", -0.1, 2857002764]},
    {"op": "budget_dept", "dept": 4096, "method": "set_local_funding_percent", "args": ["H3", 0.2, 2857002764]},
    {"op": "budget_dept", "dept": 4096, "method": "funding_percentage", "expect": 0.75},
    {"op": "budget_expect_holder", "holder": "H1", "prop": "0xEA54D287", "values": {"f32": [50]}},
    {"op": "budget_expect_holder", "holder": "H3", "prop": "0xEA54D287", "absent": true},
    {"op": "expect_event_count", "filter": {"event": "post"}, "count": 0},

    {"op": "budget_dept", "dept": 4096, "method": "set_local_funding_percent", "args": ["H2", 0.5, 2857002764]},
    {"op": "budget_dept", "dept": 4096, "method": "funding_percentage", "expect": 0.5},
    {"op": "expect_event_count", "filter": {"event": "post", "type": "BudgetForOccupantChanged"}, "count": 0,
     "note": "H2 is not an occupant"},
    {"op": "budget_dept", "dept": 4096, "method": "set_local_funding_percent", "args": ["H2", 1.0, 2857002764]},
    {"op": "budget_dept", "dept": 4096, "method": "funding_percentage", "expect": 0.75},

    {"op": "clear_events"},
    {"op": "budget_dept", "dept": 4096, "method": "set_local_full_funding", "args": ["H2", 300, 2857002764]},
    {"op": "budget_dept", "dept": 4096, "method": "funding_percentage", "expect": 0.875},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "full_expenses", "expect": 400},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "current_expenses", "expect": 350},
    {"op": "budget_expect_holder", "holder": "H2", "prop": "0xEA54D286", "values": {"i64": [300]}},
    {"op": "budget_dept", "dept": 4096, "method": "local_full_funding", "args": ["H2", 2857002764], "expect": 300},
    {"op": "expect_event_count", "filter": {"event": "post", "type": "IdealMonthlyFundingChanged"}, "min": 1, "max": 2},
    {"op": "expect_event_count", "filter": {"event": "post", "type": "FundingPercentageChanged"}, "count": 1},

    {"op": "budget_expect_refs", "refs": {"H1": 2, "H2": 2}},
    {"op": "budget_dept", "dept": 4096, "method": "remove_locally_funded_object", "args": ["H2", 2857002764]},
    {"op": "budget_dept", "dept": 4096, "method": "funding_percentage", "expect": 0.5},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "full_expenses", "expect": 100},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "current_expenses", "expect": 50},
    {"op": "budget_expect_holder", "holder": "H2", "prop": "0xEA54D286", "values": {"i64": [0]}},
    {"op": "budget_dept", "dept": 4096, "method": "is_locally_funded_object", "args": ["H2", 2857002764], "expect": false},
    {"op": "budget_expect_refs", "refs": {"H1": 2, "H2": 1}},

    {"op": "budget_dept", "dept": 4096, "method": "remove_locally_funded_object", "args": ["H1", 2857002764]},
    {"op": "budget_dept", "dept": 4096, "method": "funding_percentage", "expect": 1.0},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "full_expenses", "expect": 0},
    {"op": "budget_line", "dept": 4096, "line": 1, "method": "current_expenses", "expect": 0},
    {"op": "budget_expect_holder", "holder": "H1", "prop": "0xEA54D286", "values": {"i64": [0]}},
    {"op": "budget_dept", "dept": 4096, "method": "has_locally_funded_items_by_purpose", "args": [2857002764], "expect": false},
    {"op": "budget_expect_refs", "refs": {"H1": 1, "H2": 1}}
  ]
}
