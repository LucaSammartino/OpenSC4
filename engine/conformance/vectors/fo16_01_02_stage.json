{
  "format": 1,
  "name": "flora_stage",
  "spec": ["flora 6.7.2", "flora 3.4", "flora 14"],
  "description": "Derived by hand from flora 6.7.2 (tests 1 and 2 of 16). One type 0x1000 with the code-default floats (maturity 730, lifespan 1460, max age 1560, seeding age 730) and a table of 0.6 everywhere (score 0.6 >= minimum 0.3). today = 5000; the sim date (now) is 5000 and every last seeding date 5000, so 5000 + 365 < 5000 is false and nothing seeds. The stage of age a: 0 below 0.5 * 730 = 365, 1 from 365, 2 from 730, rebirth from 1460 (and from max age 1560). Each occupant starts in the state of the previous age class, so: 364 (state 0) -> 0, no change; 365 (state 0) -> 1, SetState(1) and one 0x99EF1145; 729 (state 1) -> 1, nothing; 730 (state 1) -> 2, SetState(2) and one change; 1459 (state 2) -> 2, nothing; 1460 and 2000 (state 2) -> rebirth: birth := today 5000, state 0, one change. Test 2: birth = today + 10 makes the unsigned age 2^32 - 10 -> rebirth. A standing burnt tree (state 3, age 100) is reborn too (quirk 6.7.2).",
  "steps": [
    {"op": "flora_types", "types": [{"type": "0x1000", "table": 0.6}]},
    {"op": "flora_env", "date": 5000, "occupants": [
      {"id": 1, "type": "flora", "pos": [8, 260, 8], "flora_type": "0x1000", "birth": 4636, "last_seed": 5000, "state": 0},
      {"id": 2, "type": "flora", "pos": [40, 260, 8], "flora_type": "0x1000", "birth": 4635, "last_seed": 5000, "state": 0},
      {"id": 3, "type": "flora", "pos": [72, 260, 8], "flora_type": "0x1000", "birth": 4271, "last_seed": 5000, "state": 1},
      {"id": 4, "type": "flora", "pos": [104, 260, 8], "flora_type": "0x1000", "birth": 4270, "last_seed": 5000, "state": 1},
      {"id": 5, "type": "flora", "pos": [136, 260, 8], "flora_type": "0x1000", "birth": 3541, "last_seed": 5000, "state": 2},
      {"id": 6, "type": "flora", "pos": [168, 260, 8], "flora_type": "0x1000", "birth": 3540, "last_seed": 5000, "state": 2},
      {"id": 7, "type": "flora", "pos": [200, 260, 8], "flora_type": "0x1000", "birth": 3000, "last_seed": 5000, "state": 2},
      {"id": 8, "type": "flora", "pos": [232, 260, 8], "flora_type": "0x1000", "birth": 5010, "last_seed": 5000, "state": 2},
      {"id": 9, "type": "flora", "pos": [264, 260, 8], "flora_type": "0x1000", "birth": 4900, "last_seed": 5000, "state": 3}]},
    {"op": "flora_create"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_set", "state": {"today": 5000}},
    {"op": "flora_clear_events"},

    {"op": "flora_call", "method": "simulate_existing", "args": [1], "note": "age 364"},
    {"op": "flora_expect_events", "events": []},
    {"op": "flora_call", "method": "simulate_existing", "args": [2], "note": "age 365"},
    {"op": "flora_expect_events", "events": [{"event": "set_state", "occupant": 2, "value": 1}, {"event": "change", "occupant": 2}]},
    {"op": "flora_call", "method": "simulate_existing", "args": [3], "note": "age 729"},
    {"op": "flora_expect_events", "events": []},
    {"op": "flora_call", "method": "simulate_existing", "args": [4], "note": "age 730"},
    {"op": "flora_expect_events", "events": [{"event": "set_state", "occupant": 4, "value": 2}, {"event": "change", "occupant": 4}]},
    {"op": "flora_call", "method": "simulate_existing", "args": [5], "note": "age 1459"},
    {"op": "flora_expect_events", "events": []},
    {"op": "flora_call", "method": "simulate_existing", "args": [6], "note": "age 1460"},
    {"op": "flora_expect_events", "events": [{"event": "set_birth", "occupant": 6, "value": 5000}, {"event": "set_state", "occupant": 6, "value": 0},
      {"event": "change", "occupant": 6}]},
    {"op": "flora_call", "method": "simulate_existing", "args": [7], "note": "age 2000"},
    {"op": "flora_expect_events", "events": [{"event": "set_birth", "occupant": 7, "value": 5000}, {"event": "set_state", "occupant": 7, "value": 0},
      {"event": "change", "occupant": 7}]},
    {"op": "flora_call", "method": "simulate_existing", "args": [8], "note": "age 2^32 - 10"},
    {"op": "flora_expect_events", "events": [{"event": "set_birth", "occupant": 8, "value": 5000}, {"event": "set_state", "occupant": 8, "value": 0},
      {"event": "change", "occupant": 8}]},
    {"op": "flora_call", "method": "simulate_existing", "args": [9], "note": "standing burnt tree"},
    {"op": "flora_expect_events", "events": [{"event": "set_birth", "occupant": 9, "value": 5000}, {"event": "set_state", "occupant": 9, "value": 0},
      {"event": "change", "occupant": 9}]},
    {"op": "flora_expect_occupant", "occupant": 2, "state": 1, "birth": 4635, "in_manager": true},
    {"op": "flora_expect_occupant", "occupant": 4, "state": 2},
    {"op": "flora_expect_occupant", "occupant": 6, "state": 0, "birth": 5000, "in_manager": true},
    {"op": "flora_expect_occupant", "occupant": 8, "state": 0, "birth": 5000},
    {"op": "flora_expect_occupant", "occupant": 9, "state": 0, "birth": 5000, "flora_type": "0x1000"},
    {"op": "flora_expect_event_count", "filter": {"event": "rng"}, "count": 0}
  ]
}
