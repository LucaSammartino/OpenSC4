    {"op": "gdev_init", "exemplar": "0x1010", "expect": false},
    {"op": "gdev_expect_events", "events": [{"event": "acquire_service", "service": "land_value", "ok": true}, {"event": "acquire_service", "service": "traffic", "ok": true}, {"event": "create_grid", "instance": "0x01001010", "size": 64}, {"event": "create_grid", "instance": "0x02101010", "size": 64}, {"event": "create_grid", "instance": "0x02001010", "size": 64}, {"event": "create_grid", "instance": "0x03001010", "size": 64}, {"event": "create_grid", "instance": "0x05001010", "size": 64}, {"event": "create_grid", "instance": "0x06001010", "size": 64}, {"event": "get_demand", "id": "0x00001010", "index": "0x00020000", "node": "src"}, {"event": "add_ref", "object": "src"}, {"event": "set_tract_size", "which": "zoned", "grid": "0x01001010", "size": 4}, {"event": "set_tract_size", "which": "working", "grid": "0x02101010", "size": 4}, {"event": "set_tract_size", "which": "desirability", "grid": "0x02001010", "size": 4}, {"event": "set_tract_size", "which": "population", "grid": "0x03001010", "size": 4}, {"event": "set_tract_size", "which": "capacity", "grid": "0x05001010", "size": 4}, {"event": "set_tract_size", "which": "max_capacity", "grid": "0x06001010", "size": 4}, {"event": "acquire_message_server", "ok": true}, {"event": "subscribe", "types": ["0xE8BDA2E7", "0x07699455"]}]},
    {"op": "gdev_expect", "state": {"initialized": false, "update_state": 0, "services": ["city", "bds", "occupant_manager", "zone_manager", "land_value", "traffic"], "message_server": true, "iterator": {"x": 0, "z": 0, "rect": [0, 0, 15, 15], "state": "fresh"}, "grids": {"zoned": "0x01001010", "working": "0x02101010"}}},
    {"op": "gdev_expect_grid", "grid": "working", "size": 4, "counts": [16, 16], "instance": "0x02101010"},
    {"op": "gdev_env", "no_simulator": false},
    {"op": "gdev_init", "exemplar": "0x1010", "expect": true},
    {"op": "gdev_expect_events", "events": [{"event": "release", "object": "src"}, {"event": "get_demand", "id": "0x00001010", "index": "0x00020000", "node": "src"}, {"event": "add_ref", "object": "src"}, {"event": "agent", "level": 10, "name": "cSC4GrowthDeveloper", "flags": 2}, {"event": "agent", "level": 4, "name": "cSC4GrowthDeveloper", "flags": 2}]},
    {"op": "gdev_expect_refs", "refs": {"src": 1}},
