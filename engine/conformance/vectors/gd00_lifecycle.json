    {"op": "gdev_expect_events", "events": [{"event": "remove_agent"}, {"event": "unsubscribe", "types": ["0xE8BDA2E7", "0x07699455"]}, {"event": "release_message_server"}, {"event": "grid_shutdown", "which": "zoned", "grid": "0x01001010"}, {"event": "grid_shutdown", "which": "working", "grid": "0x02101010"}, {"event": "grid_shutdown", "which": "desirability", "grid": "0x02001010"}, {"event": "grid_shutdown", "which": "population", "grid": "0x03001010"}, {"event": "grid_shutdown", "which": "capacity", "grid": "0x05001010"}, {"event": "grid_shutdown", "which": "max_capacity", "grid": "0x06001010"}, {"event": "release", "object": "src"}, {"event": "release_service", "service": "bds"}, {"event": "release_service", "service": "land_value"}, {"event": "release_service", "service": "traffic"}, {"event": "release_service", "service": "zone_manager"}, {"event": "release_service", "service": "occupant_manager"}, {"event": "release_service", "service": "city"}]},
    {"op": "gdev_expect", "state": {"initialized": false, "services": [], "message_server": false, "holder": false, "iterator": null, "curves": [], "stage_count": 8, "source_demand": null, "grids": {"zoned": null, "working": null, "desirability": null, "population": null, "capacity": null, "max_capacity": null}}},
    {"op": "gdev_expect_refs", "refs": {"src": 0}},
    {"op": "gdev_shutdown", "expect": true},
    {"op": "gdev_expect_events", "events": []},
    {"op": "gdev_init", "exemplar": "0x1010", "expect": true},
    {"op": "gdev_expect_event_count", "filter": {"event": "create_grid", "size": 4}, "count": 6},
    {"op": "gdev_expect_event_count", "filter": {"event": "set_tract_size"}, "count": 0},
    {"op": "gdev_expect", "state": {"initialized": true, "curves": ["land_value", "slope", "r1", "r2", "r3", "co2", "co3", "park", "air", "water", "garbage", "radiation", "school", "hospital", "crime", "commute", "traffic", "landmark", "transient"]}},
    {"op": "gdev_clear_events"},
    {"op": "gdev_call", "method": "add_ref", "expect": 2},
    {"op": "gdev_call", "method": "release", "expect": 1},
    {"op": "gdev_expect_events", "events": []},
    {"op": "gdev_call", "method": "release", "expect": 0},
    {"op": "gdev_expect_event_count", "filter": {"event": "remove_agent"}, "count": 1},
    {"op": "gdev_expect", "state": {"destroyed": true, "initialized": false, "ref_count": 0}},
    {"op": "gdev_create", "label": "nullholder"},
    {"op": "gdev_clear_events"},
    {"op": "gdev_init", "null": true, "expect": false},
    {"op": "gdev_expect_events", "events": [{"event": "acquire_service", "service": "city"}, {"event": "acquire_service", "service": "bds"}, {"event": "acquire_service", "service": "occupant_manager"}, {"event": "acquire_service", "service": "zone_manager"}, {"event": "acquire_service", "service": "land_value"}, {"event": "acquire_service", "service": "traffic"}]},
    {"op": "gdev_expect", "state": {"grids": {"zoned": null}, "iterator": null}},
    {"op": "gdev_create", "label": "noserver"},
    {"op": "gdev_env", "no_message_server": true},
    {"op": "gdev_init", "props": {"0x00000021": {"u32": "0x1010"}, "0x87CD6300": {"u8": 1}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 1}, "0x87CD6332": {"u8": 1}}, "expect": false},
    {"op": "gdev_expect_event_count", "filter": {"event": "agent"}, "count": 0},
    {"op": "gdev_expect_event_count", "filter": {"event": "subscribe"}, "count": 0},
    {"op": "gdev_expect", "state": {"initialized": false, "message_server": false, "grids": {"zoned": "0x01001010"}}},
    {"op": "gdev_env", "no_message_server": false},
    {"op": "gdev_init", "props": {"0x00000021": {"u32": "0x1010"}, "0x87CD6300": {"u8": 1}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 1}, "0x87CD6332": {"u8": 1}}, "expect": true},
    {"op": "gdev_expect_event_count", "filter": {"event": "subscribe"}, "count": 1},
    {"op": "gdev_create", "label": "nogrids"},
    {"op": "gdev_env", "no_grids": true},
    {"op": "gdev_init", "props": {"0x00000021": {"u32": "0x1010"}, "0x87CD6300": {"u8": 1}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 1}, "0x87CD6332": {"u8": 1}}, "expect": true},
