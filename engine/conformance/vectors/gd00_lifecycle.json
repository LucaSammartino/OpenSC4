{
  "format": 1,
  "name": "growth_developer_lifecycle",
  "spec": ["growth-developer 1", "growth-developer 1.2", "growth-developer 1.3", "growth-developer 10"],
  "description": "Creation, Init and Shutdown (hand-derived from 1.2 / 1.3): Init takes the six services in order (a missing one fails and the ones taken are kept, so the next Init resumes), stores the holder, creates the null grids at the constructor size 64 with instance type + offset, sets state 0, creates the iterator, reads the tuning (0x87CD6301 -> GetDemand + AddRef; the tract size 4 differs -> SetTractSize on all six; the iterator covers W's 16 x 16 tracts), takes the message server and subscribes, and fails without the simulator; the next Init adds the agents (levels 10 and 4, flags 2). Init is idempotent. Shutdown removes the agents and notifications, shuts the grids down in creation order, releases the node and the services (BDS, land value, traffic, zone manager, occupant manager, city) and deletes the 19 curves (stage curves stay). A re-Init creates the grids at the kept size 4. Release at 1 shuts down and destroys. Init(null) and a missing message server fail ([choice] for null). Without grids the developer still runs ([choice]). QueryInterface and the slot table of 10.1.",
  "steps": [
    {"op": "gdev_env", "cells": [64, 64], "demand": [{"id": "0x1010", "index": "0x20000", "label": "src"}]},
    {"op": "gdev_call", "method": "query_interface", "args": [1], "expect": "Primary"},
    {"op": "gdev_call", "method": "query_interface", "args": ["0xE7CDD662"], "expect": "Primary"},
    {"op": "gdev_call", "method": "query_interface", "args": ["0x452294AA"], "expect": "MessageTarget"},
    {"op": "gdev_call", "method": "query_interface", "args": ["0xE4FDA3D4"], "expect": "Serializable"},
    {"op": "gdev_call", "method": "query_interface", "args": ["0x12345"], "expect": null},
    {"op": "gdev_call", "method": "slot", "args": [29], "expect": ["EstimateDesirability", 8, "Ax"]},
    {"op": "gdev_call", "method": "slot", "args": [24], "expect": ["GetAbandonmentThreshold", 4, "St0"]},
    {"op": "gdev_call", "method": "slot", "args": [19], "expect": ["GetPowerSupplyCap", 0, "Al"]},
    {"op": "gdev_call", "method": "slot", "args": [30], "expect": ["GetSubjectiveThresholds", 12, "None"]},
    {"op": "gdev_create", "add_ref": false},
    {"op": "gdev_expect", "state": {"initialized": false, "ref_count": 0, "update_state": 0, "tract_size": 64, "baseline": 80, "phantom_demand": true, "iterator": null, "grids": {"zoned": null, "working": null}}},
    {"op": "gdev_call", "method": "add_ref", "expect": 1},
