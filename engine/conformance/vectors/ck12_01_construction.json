{
  "format": 1,
  "name": "ck12_01_construction",
  "spec": ["clock24 2", "clock24 4.1", "clock24 4.2", "clock24 12"],
  "description": "Test 1. Construction: seconds = visualSeconds = 43200, magnification 100, min 0.05 (0x3D4CCCCD), max 2000, night 20 / 4, notifications on, mode 0, timer stopped. GetTimePercentage = 43200 x 1.1574074e-05f = 0.5 (the float of 1/86400; see the coverage notes on the spec's bit pattern), GetHour 12, IsNight false, GetEventHour 0/1/2 = 20/4/0. QueryInterface: 1, 0x681BD53A, 0x452294AA, 0xE4FDA3D4 and the system service's 0x287FB697. Init (4.2): AddSystemService, AddToOnIdle, the two cheats registered and subscribed, the timer started; a second Init does nothing. Shutdown: the timer reset, seconds 0, cheats removed (notification, then the code), on-idle and the service removed; a second Shutdown does nothing.",
  "steps": [
    {"op": "ck_create"},
    {"op": "ck_expect", "state": {"seconds": 43200, "visual_seconds": 43200, "magnification": 100, "min_magnification_bits": "0x3D4CCCCD", "max_magnification": 2000, "night_start": 20, "night_end": 4, "notifications": true, "visual_mode": 0, "initialized": false, "timer_running": false, "timer_elapsed": 0, "pause_count": 0, "hidden_pause_count": 0}},
    {"op": "ck_call", "method": "time_percentage", "expect_bits": "0x3F000000"},
    {"op": "ck_call", "method": "visual_time_percentage", "expect": 0.5},
    {"op": "ck_call", "method": "hour", "expect": 12},
    {"op": "ck_call", "method": "minute", "expect": 0},
    {"op": "ck_call", "method": "second", "expect": 0},
    {"op": "ck_call", "method": "is_night", "expect": false},
    {"op": "ck_call", "method": "event_hour", "args": [0], "expect": 20},
    {"op": "ck_call", "method": "event_hour", "args": [1], "expect": 4},
    {"op": "ck_call", "method": "event_hour", "args": [2], "expect": 0},
    {"op": "ck_call", "method": "query_interface", "args": [1], "expect": true},
    {"op": "ck_call", "method": "query_interface", "args": ["0x681BD53A"], "expect": true},
    {"op": "ck_call", "method": "query_interface", "args": ["0x452294AA"], "expect": true},
    {"op": "ck_call", "method": "query_interface", "args": ["0xE4FDA3D4"], "expect": true},
    {"op": "ck_call", "method": "query_interface", "args": ["0x287FB697"], "expect": true},
    {"op": "ck_call", "method": "query_interface", "args": ["0xA7E7F929"], "expect": false},
    {"op": "ck_call", "method": "init", "expect": true},
    {"op": "ck_expect_events", "events": [{"event": "add_system_service"}, {"event": "add_to_on_idle"}, {"event": "register_cheat", "id": "0x281F7858", "name": "WhatTimeIzIt"}, {"event": "add_cheat_notification", "id": "0x281F7858"}, {"event": "register_cheat", "id": "0xC9B73FBB", "name": "Stopwatch"}, {"event": "add_cheat_notification", "id": "0xC9B73FBB"}]},
    {"op": "ck_expect", "state": {"initialized": true, "timer_running": true}},
    {"op": "ck_call", "method": "init", "expect": true},
    {"op": "ck_expect_event_count", "count": 0},
    {"op": "ck_idle", "advance": 100},
    {"op": "ck_call", "method": "shutdown", "expect": true},
    {"op": "ck_expect_events", "events": [{"event": "remove_cheat_notification", "id": "0x281F7858"}, {"event": "unregister_cheat", "id": "0x281F7858"}, {"event": "remove_cheat_notification", "id": "0xC9B73FBB"}, {"event": "unregister_cheat", "id": "0xC9B73FBB"}, {"event": "remove_from_on_idle"}, {"event": "remove_system_service"}]},
    {"op": "ck_expect", "state": {"initialized": false, "seconds": 0, "visual_seconds": 43200, "timer_running": false, "timer_elapsed": 0}},
    {"op": "ck_call", "method": "shutdown", "expect": true},
    {"op": "ck_expect_event_count", "count": 0},
    {"op": "ck_env", "cheat_manager": false},
    {"op": "ck_create"},
    {"op": "ck_call", "method": "init", "expect": true},
    {"op": "ck_call", "method": "shutdown", "expect": true},
    {"op": "ck_expect_events", "events": [{"event": "add_system_service"}, {"event": "add_to_on_idle"}, {"event": "remove_from_on_idle"}, {"event": "remove_system_service"}]}
  ]
}
