{
  "format": 1,
  "name": "growth_developer_phantom",
  "spec": ["growth-developer 5.3", "growth-developer 14.11"],
  "description": "Test 11, phantom demand (state 19), by the rules of 5.3 (Python float32 model). Flag on, growth threshold 50, one zoned tract with W 30 and capacity 667 -> population rhe(r24(667 x 0.3f)) = 200. g = 20: f = r24(20 x 0.01f) is a float32 tie (214748360 x 2^-30, halfway) that rounds to even, 0x3E4CCCCC (the spec's figure says 0x3E4CCCCD = 0.2f); r24(200 x f) = 39.999996 -> ftol 39 (the spec says 40). SPEC QUESTION: the figures assume 0.2f; the rules give 39. Last 0 -> AddToDemandValue(39.0) on the source node (0x87CD6301 -> GetDemand(0x1010, 0x20000), AddRef). No change -> no call. Flag off (re-Init after Shutdown) with last = 40 -> AddToDemandValue(-40.0), last 0. Without a source node the call is skipped but the sum is stored ([choice]).",
  "steps": [
    {"op": "gdev_env", "cells": [16, 16], "demand": [{"id": "0x1010", "index": "0x20000", "label": "src"}]},
    {"op": "gdev_create"},
    {"op": "gdev_init", "props": {"0x00000021": {"u32": "0x1010"}, "0x87CD6300": {"u8": 1}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 1}, "0x87CD6332": {"u8": 1}, "0x87CD6357": {"i32": 30}, "0x87CD6355": {"i32": 50}, "0x87CD6354": {"i32": 50}, "0x87CD6356": {"bool": true}, "0x87CD6301": {"u32": "0x1010"}}, "expect": true},
    {"op": "gdev_expect", "state": {"source_demand": "src", "phantom_demand": true}},
    {"op": "gdev_expect_refs", "refs": {"src": 1}},
    {"op": "gdev_set", "grid": "zoned", "tracts": [[0, 0, 1]]},
    {"op": "gdev_set", "grid": "capacity", "tracts": [[0, 0, 667]]},
    {"op": "gdev_clear_events"},
    {"op": "gdev_update"},
    {"op": "gdev_expect_grid", "grid": "population", "tracts": [[0, 0, 200]], "nonzero": 1},
    {"op": "gdev_expect_events", "filter": {"event": "add_to_demand"}, "events": [{"event": "add_to_demand", "node": "src", "value": 39.0, "bits": "0x421C0000"}]},
    {"op": "gdev_expect", "state": {"last_phantom_sum": 39, "growth": [], "decline": [[0, 0, 1]]}},
    {"op": "gdev_call", "method": "phantom_term", "args": [50, 30, 200], "expect": 39},
    {"op": "gdev_call", "method": "phantom_term", "args": [50, 25, 200], "expect": 50},
    {"op": "gdev_call", "method": "phantom_term", "args": [50, 50, 200], "expect": null},
    {"op": "gdev_call", "method": "phantom_term", "args": [50, -300, 200], "expect": 200},
    {"op": "gdev_update"},
    {"op": "gdev_expect_events", "filter": {"event": "add_to_demand"}, "events": []},
    {"op": "gdev_shutdown", "expect": true},
    {"op": "gdev_expect_refs", "refs": {"src": 0}},
    {"op": "gdev_init", "props": {"0x00000021": {"u32": "0x1010"}, "0x87CD6300": {"u8": 1}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 1}, "0x87CD6332": {"u8": 1}, "0x87CD6357": {"i32": 30}, "0x87CD6355": {"i32": 50}, "0x87CD6354": {"i32": 50}, "0x87CD6301": {"u32": "0x1010"}}, "expect": true},
    {"op": "gdev_expect", "state": {"phantom_demand": false, "last_phantom_sum": 39}},
    {"op": "gdev_set", "state": {"last_phantom_sum": 40}},
    {"op": "gdev_clear_events"},
    {"op": "gdev_update"},
    {"op": "gdev_expect_events", "filter": {"event": "add_to_demand"}, "events": [{"event": "add_to_demand", "node": "src", "value": -40.0, "bits": "0xC2200000"}]},
    {"op": "gdev_expect", "state": {"last_phantom_sum": 0}},
    {"op": "gdev_expect_demand", "totals": {"src": -1}},
    {"op": "gdev_create", "label": "nonode"},
    {"op": "gdev_init", "props": {"0x00000021": {"u32": "0x1010"}, "0x87CD6300": {"u8": 1}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 1}, "0x87CD6332": {"u8": 1}, "0x87CD6357": {"i32": 30}, "0x87CD6355": {"i32": 50}, "0x87CD6356": {"bool": true}}, "expect": true},
    {"op": "gdev_set", "grid": "zoned", "tracts": [[0, 0, 1]]},
    {"op": "gdev_set", "grid": "capacity", "tracts": [[0, 0, 667]]},
    {"op": "gdev_clear_events"},
    {"op": "gdev_update"},
    {"op": "gdev_expect_event_count", "filter": {"event": "add_to_demand"}, "count": 0},
    {"op": "gdev_expect", "state": {"last_phantom_sum": 39}}
  ]
}
