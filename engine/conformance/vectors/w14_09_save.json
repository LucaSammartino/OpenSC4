    {"op": "weather_expect_save", "slot": "c"},

    {"op": "weather_load", "slot": "c"},
    {"op": "weather_env", "size": [32, 32]},
    {"op": "weather_tuning", "shipped": true, "props": {"0xA7607D73": {"f32": 70}}},
    {"op": "weather_clear_events"},
    {"op": "weather_init", "expect": true},
    {"op": "weather_expect", "state": {"count_x": 16, "size_x": 256, "base_temp": 70, "ambient_temp": 70, "ambient_moisture": 0.2, "wind_month": 2,
      "iterator": {"state": "running", "index": 0, "current": 41}}},
    {"op": "weather_expect_grid", "grid": "moisture_base", "size": [16, 16], "cells": [{"x": 2, "z": 3, "v": 7}]},
    {"op": "weather_expect_grid", "grid": "moisture", "cells": [{"x": 4, "z": 5, "v": 250}]},
    {"op": "weather_expect_grid", "grid": "temperature", "cells": [{"x": 15, "z": 15, "v": 3}]},
    {"op": "weather_expect_grid", "grid": "sea_mask", "rect": [0, 0, 15, 16], "inside": 1, "outside": 0},
    {"op": "weather_expect_events", "events": []},
    {"op": "weather_env", "size": [16, 16]},
    {"op": "weather_tuning", "shipped": true},

    {"op": "weather_patch", "slot": "v1", "offset": 0, "hex": "0100"},
    {"op": "weather_patch", "slot": "v1", "offset": 1289, "insert": true,
      "hex": "010000000000803f0000004000004040000080400200000002000000010203040000000000000000"},
