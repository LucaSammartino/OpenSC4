    {"op": "weather_load", "slot": "v3"},
    {"op": "weather_expect", "state": {"loaded_from_save": true, "count_x": 0, "wind_month": -1, "last_season": -1}},
    {"op": "weather_init", "expect": true},
    {"op": "weather_expect", "state": {"count_x": 0, "cells_per_week": 0, "initialized": true}},
    {"op": "weather_call", "method": "do_weekly_simulation", "expect": false},
