{
  "format": 1,
  "name": "weather_save",
  "spec": ["weather 10", "weather 8.1", "weather 7", "weather 14.9"],
  "description": "The weather record (class 0x2990C1BC, version 2) is written in the section 10 order (byte grids as u32 rows, u32 cols, cells; the iterator as s8 state, s8 mode, u8 dirty, rect, count, table, index, current, step; the generator as u32, u32, s32, f64) and write -> read -> write is byte-identical. The saved generator state continues the same sequences (a loaded copy, once Init has re-read windSpread, which is not saved, draws the same wind as the original). Read sets loadedFromSave first and rejects version >= 3; versions 0 and 1 carry a legacy block (u32 n, n x 4 f32, two byte grids, a grid with a count >= 1,000,000 skipped without data) after targetWindDir that is read and discarded. Init on a loaded city keeps the saved sizes and pattern, re-reads the tuning, resets the ambient values to the base values and restarts the iterator.",
  "steps": [
    {"op": "weather_env", "size": [16, 16], "month": 1, "sea_level": -1, "heights": [{"x": 0, "z": 0, "w": 4, "d": 8, "h": -5}]},
    {"op": "weather_tuning", "shipped": true},
    {"op": "weather_create", "rng": {"seed": 7}},
    {"op": "weather_init", "expect": true},
    {"op": "weather_message", "type": "SimNewMonth", "data3": 1, "expect": true},
    {"op": "weather_set", "state": {"moisture_base_cells": [{"x": 2, "z": 3, "v": 7}], "moisture_cells": [{"x": 4, "z": 5, "v": 250}],
      "temperature_cells": [{"x": 15, "z": 15, "v": 3}]}},
    {"op": "weather_expect", "state": {"water_rects": [[0, 0, 4, 8]], "last_season": 0, "wind_month": 1}},
    {"op": "weather_save", "slot": "a"},
    {"op": "weather_save", "slot": "v1"},
    {"op": "weather_save", "slot": "v0"},
    {"op": "weather_save", "slot": "v3"},
    {"op": "weather_save", "slot": "short"},
    {"op": "weather_expect_payload", "slot": "a", "length": 1313, "at": [
      {"offset": 0, "hex": "0200100000001000000000008041000080410000803d0000803d000080430000804301000000010000000100000001000000010000000000000000008242"},
      {"offset": 74, "hex": "1000000010000000"},
      {"offset": 338, "hex": "1000000010000000"},
      {"offset": 342, "hex": "1000000001010101"},
      {"offset": 602, "hex": "010000000000000000000000040000000800000001010000000000000000000f0000000f00000000010000000000000000000029000000b3000000"},
      {"offset": 661, "hex": "000100000a000000"},
      {"offset": 1309, "hex": "01000000"}]},

    {"op": "weather_call", "method": "new_current_ambient_values", "args": [2]},
