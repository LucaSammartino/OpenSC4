    {"op": "weather_load", "slot": "a"},
    {"op": "weather_expect", "state": {"loaded_from_save": true, "initialized": false, "count_x": 16, "water_rects": [[0, 0, 4, 8]],
      "last_season": 0, "wind_month": 1, "cells_per_week": 256, "iterator": {"state": "running", "index": 0, "current": 41, "step": 179}}},
    {"op": "weather_expect_save", "slot": "a"},
