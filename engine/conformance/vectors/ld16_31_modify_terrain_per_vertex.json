{
  "format": 1,
  "name": "lot_developer_modify_terrain_per_vertex",
  "spec": ["lot-developer 17.3", "lot-developer 17.4", "lot-developer 16"],
  "description": "Test 31 (§17.3), the per-vertex rules of cISC4Demolition::ModifyTerrainHeight that the lot developer relies on. ModifyTerrainHeight belongs to the demolition utility (demolition.md §4.7): in game it is the original's, here the scripted world models §17.3. It is reached through slot 19 with force on the lot (4, 4, 5, 5), whose only interior vertex is (5, 5): one ModifyTerrainHeight(1, 1, 5, 5, 5, 5, 100, lot, 5, null) per call, and slot 19 returns the CALL count (1) whatever was written. h = 100: vertex (5, 5) at 100.04 is skipped (|d| < 0.05); at 100.05 (float32 100.05000305) it is written; a water vertex is skipped; a vertex under an immovable occupant whose bounding box spans z 70..90 and has min.x = 94.4 is skipped (the closed square around vertex 5 is [65.5, 94.5] and 94.4 <= 94.5); with min.x = 94.6 it is written. A neighbouring lot with locked vertices in one of the four cells around the vertex ((4, 4) ... (5, 5)) blocks the write; the same lock on the lot passed as exempt does not.",
  "steps": [
    {"op": "ldev_terrain", "flat": 100},
    {"op": "ldev_lot", "id": 1, "x": 4, "z": 4, "w": 2, "h": 2, "state": 2},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},

    {"op": "ldev_terrain", "vertex": [[5, 5, 100.04]]},
    {"op": "ldev_clear_events"},
    {"op": "ldev_level_internal", "rect": [4, 4, 5, 5], "target": 100, "skip_water": false, "force": true, "lot": 1, "expect": 1},
    {"op": "ldev_expect_events", "events": [
      {"event": "modify_terrain", "per_vertex": true, "rect": [5, 5, 5, 5], "h": 100, "exempt": 1}]},
    {"op": "ldev_expect_terrain", "vertex": [[5, 5, 100.04]]},

    {"op": "ldev_terrain", "vertex": [[5, 5, 100.05]]},
    {"op": "ldev_level_internal", "rect": [4, 4, 5, 5], "target": 100, "skip_water": false, "force": true, "lot": 1, "expect": 1},
    {"op": "ldev_expect_events", "events": [
      {"event": "modify_terrain", "per_vertex": true, "rect": [5, 5, 5, 5], "h": 100},
      {"event": "set_altitude", "x": 5, "z": 5, "h": 100},
      {"event": "redisplay", "rect": [4, 4, 6, 6], "reason": 5}]},

    {"op": "ldev_terrain", "vertex": [[5, 5, 103]], "water_vertices": [[5, 5]]},
    {"op": "ldev_level_internal", "rect": [4, 4, 5, 5], "target": 100, "skip_water": false, "force": true, "lot": 1, "expect": 1,
      "note": "skipWater false: slot 19 passes the vertex on, and ModifyTerrainHeight itself skips the water vertex"},
    {"op": "ldev_expect_events", "filter": {"event": "set_altitude"}, "events": []},
    {"op": "ldev_level_internal", "rect": [4, 4, 5, 5], "target": 100, "skip_water": true, "force": true, "lot": 1, "expect": 0,
      "note": "skipWater true: slot 19 makes no call at all for a water vertex"},
    {"op": "ldev_expect_events", "events": []},

    {"op": "ldev_terrain", "reset": true, "vertex": [[5, 5, 103]]},
    {"op": "ldev_occ", "id": 50, "is_building": true, "immovable": true, "cells": [5, 4, 6, 5], "bbox": [[94.4, 100, 70], [120, 120, 90]]},
    {"op": "ldev_level_internal", "rect": [4, 4, 5, 5], "target": 100, "skip_water": false, "force": true, "lot": 1, "expect": 1},
    {"op": "ldev_expect_events", "filter": {"event": "set_altitude"}, "events": []},
    {"op": "ldev_occ", "id": 50, "bbox": [[94.6, 100, 70], [120, 120, 90]]},
    {"op": "ldev_level_internal", "rect": [4, 4, 5, 5], "target": 100, "skip_water": false, "force": true, "lot": 1, "expect": 1},
    {"op": "ldev_expect_events", "filter": {"event": "set_altitude"}, "events": [{"x": 5, "z": 5, "h": 100}]},
    {"op": "ldev_occ", "id": 50, "immovable": false},

    {"op": "ldev_terrain", "vertex": [[5, 5, 103]]},
    {"op": "ldev_lot", "id": 2, "x": 4, "z": 6, "w": 2, "h": 1, "state": 3, "locked": true, "order": false,
      "note": "a neighbour on cells (4, 6) and (5, 6): not around vertex (5, 5)"},
    {"op": "ldev_level_internal", "rect": [4, 4, 5, 5], "target": 100, "skip_water": false, "force": true, "lot": 1, "expect": 1},
    {"op": "ldev_expect_events", "filter": {"event": "set_altitude"}, "events": [{"x": 5, "z": 5}]},

    {"op": "ldev_terrain", "vertex": [[5, 5, 103]]},
    {"op": "ldev_lot", "id": 3, "x": 5, "z": 5, "w": 1, "h": 1, "state": 3, "locked": true, "order": false,
      "note": "a locked neighbour on cell (5, 5), one of the four cells around vertex (5, 5)"},
    {"op": "ldev_level_internal", "rect": [4, 4, 5, 5], "target": 100, "skip_water": false, "force": true, "lot": 1, "expect": 1},
    {"op": "ldev_expect_events", "filter": {"event": "set_altitude"}, "events": []},
    {"op": "ldev_level_internal", "rect": [4, 4, 5, 5], "target": 100, "skip_water": false, "force": true, "lot": 3, "expect": 1,
      "note": "the same lock on the exempt lot: written"},
    {"op": "ldev_expect_events", "filter": {"event": "set_altitude"}, "events": [{"x": 5, "z": 5, "h": 100}]}
  ]
}
