    {"op": "ordinance_call", "method": "set_ordinance_on", "args": ["0x00D0723D", true], "expect": true},
    {"op": "ordinance_expect_events", "events": [
      {"event": "post", "type": "OrdinanceUpdated", "id": "0x00D0723D", "value": 0},
      {"event": "post", "type": "OrdinanceUpdated", "id": "0x00D0723D", "value": 0}]},
    {"op": "ordinance_expect", "state": {"pending": -20}},
    {"op": "ordinance_expect_object", "id": "0x00D0723D", "state": {"available": false, "on": true, "adjusted": 10}},
    {"op": "ordinance_call", "method": "is_ordinance_on", "args": ["0x00D0723D"], "expect": false},
    {"op": "ordinance_call", "method": "on_count", "expect": 0},
    {"op": "ordinance_message", "type": "SimNewMonth", "expect": true},
    {"op": "ordinance_expect_events", "events": [
      {"event": "post", "type": "AvailabilityChanged", "id": "0x00D0723D", "value": 1},
      {"event": "post", "type": "OrdinanceUpdated", "id": "0x00D0723D", "value": 1},
      {"event": "post", "type": "AvailabilityChanged", "id": "0xA0D07129", "value": 1},
      {"event": "post", "type": "MonthlyDone"}]},
    {"op": "ordinance_expect", "state": {"monthly_expense": 20, "monthly_income": 0, "pending": -10}},
    {"op": "ordinance_expect_object", "id": "0x00D0723D", "state": {"available": true, "on": true, "adjusted": 0}},

    {"op": "ordinance_call", "method": "set_ordinance_on", "args": ["0xA0D07129", true], "expect": true},
    {"op": "ordinance_expect_events", "events": [{"event": "post", "type": "OrdinanceUpdated", "id": "0xA0D07129", "value": 1}]},
    {"op": "ordinance_call", "method": "set_ordinance_on", "args": ["0xA0D07129", false], "expect": true},
    {"op": "ordinance_expect_events", "events": [
      {"event": "demolish", "lots": [1, 3]},
      {"event": "hide", "building_type": "0x033A0000"},
      {"event": "remove_control", "id": "0x88F154FB"},
      {"event": "post", "type": "OrdinanceUpdated", "id": "0xA0D07129", "value": 0}]},
    {"op": "ordinance_object", "id": "0xA0D07129", "method": "set_on", "args": [false], "expect": true},
    {"op": "ordinance_expect_events", "events": [
      {"event": "demolish", "lots": []},
      {"event": "hide", "building_type": "0x033A0000"}]},
    {"op": "ordinance_call", "method": "set_ordinance_available", "args": ["0xA0D07129", false], "expect": true},
    {"op": "ordinance_call", "method": "set_ordinance_on", "args": ["0xA0D07129", true], "expect": true},
    {"op": "ordinance_env", "lots": [{"lot": 9, "building_type": "0x033A0000"}], "view_control": "0x12345678"},
    {"op": "ordinance_clear_events"},
    {"op": "ordinance_call", "method": "set_ordinance_available", "args": ["0xA0D07129", true], "expect": true},
    {"op": "ordinance_expect_events", "events": [
