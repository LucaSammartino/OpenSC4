    {"op": "ordinance_new", "ordinance": "curfew", "class": "0xC2BF1DC5", "instance": "0xC2BF1DC5"},
    {"op": "ordinance_object", "ordinance": "curfew", "method": "init", "expect": true},
    {"op": "ordinance_object", "ordinance": "curfew", "method": "force_available", "args": [true], "expect": true},
    {"op": "ordinance_object", "ordinance": "curfew", "method": "force_on", "args": [true], "expect": true},
    {"op": "ordinance_expect", "state": {"pending": -30}},
    {"op": "ordinance_clear_events"},
    {"op": "ordinance_call", "method": "add_ordinance", "args": ["curfew"], "expect": true},
    {"op": "ordinance_expect_events", "events": [
