      {"event": "post", "type": "OrdinanceUpdated", "id": "0xC2BF1DC5", "value": 1}]},
    {"op": "ordinance_expect", "state": {"pending": -50, "keys": ["0x00D0723D", "0xA0D07129", "0xC2BF1DC5"]}},
    {"op": "ordinance_expect_refs", "refs": {"curfew": 2}},
    {"op": "ordinance_call", "method": "remove_ordinance", "args": ["curfew"], "expect": true},
    {"op": "ordinance_expect_events", "events": [
      {"event": "post", "type": "OrdinanceUpdated", "id": "0xC2BF1DC5", "value": 0},
      {"event": "post", "type": "AvailabilityChanged", "id": "0xC2BF1DC5", "value": 0}]},
    {"op": "ordinance_expect", "state": {"pending": -60, "keys": ["0x00D0723D", "0xA0D07129"]}},
    {"op": "ordinance_expect_refs", "refs": {"curfew": 1}},
    {"op": "ordinance_call", "method": "remove_ordinance", "args": ["curfew"], "expect": false},

    {"op": "ordinance_foreign", "ordinance": "plugin", "id": "0x0000BEEF", "name": "Plugin Law", "enact": -7, "repeal": -3, "monthly": -5,
      "available": true, "on": true},
    {"op": "ordinance_call", "method": "add_ordinance", "args": ["plugin"], "expect": true},
    {"op": "ordinance_expect_events", "events": [
      {"event": "post", "type": "AvailabilityChanged", "id": "0x0000BEEF", "value": 1},
      {"event": "post", "type": "OrdinanceUpdated", "id": "0x0000BEEF", "value": 1},
      {"event": "post", "type": "OrdinanceUpdated", "id": "0x0000BEEF", "value": 1}]},
    {"op": "ordinance_expect", "state": {"pending": -74, "keys": ["0x0000BEEF", "0x00D0723D", "0xA0D07129"]}},
    {"op": "ordinance_foreign", "ordinance": "plugin2", "id": "0x0000BEEF", "name": "Plugin Law v2", "enact": -1, "repeal": -1, "conditions": false},
    {"op": "ordinance_call", "method": "add_ordinance", "args": ["plugin2"], "expect": true},
    {"op": "ordinance_expect_events", "events": [
      {"event": "post", "type": "OrdinanceUpdated", "id": "0x0000BEEF", "value": 0},
      {"event": "post", "type": "AvailabilityChanged", "id": "0x0000BEEF", "value": 0}]},
    {"op": "ordinance_expect", "state": {"pending": -77}},
    {"op": "ordinance_expect_refs", "refs": {"plugin": 1, "plugin2": 2}},
    {"op": "ordinance_call", "method": "ordinance_by_name", "args": ["plugin law V2"], "expect": "0x0000BEEF"},
    {"op": "ordinance_call", "method": "is_ordinance_available", "args": ["0x0000BEEF"], "expect": false},
    {"op": "ordinance_message", "type": "SimNewMonth", "expect": true},
    {"op": "ordinance_call", "method": "is_ordinance_available", "args": ["0x0000BEEF"], "expect": false},
    {"op": "ordinance_expect", "state": {"monthly_expense": 127, "monthly_income": 100, "pending": 0}}
  ]
}
