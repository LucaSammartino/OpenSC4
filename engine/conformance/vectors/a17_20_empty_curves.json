{
  "format": 1,
  "name": "aura_empty_curves",
  "spec": ["aura 6", "aura 6.6", "aura 10", "aura 17.20", "foundations 4.1", "foundations 4.3"],
  "description": "Test 20 [choice]: a curve property with fewer than 2 values gives a curve object with no points in the original (n = count / 2), which it evaluates (a crash, or a stale y after an in-place reload); FreeCity4 treats it as absent. Crime curve 0xEA023277 as a scalar 5.0, as a one-element array [5.0] or as an empty array: absent, so state 10 skips the stage (work 10 stays 10 with crime 255). Three values (0, 10, 255): one point (0, 10), the odd value ignored, a constant 10 (foundations 4.3): work 10 -> 20. An empty park curve property: absent, and state 6 advances to 7 without touching the work grid (6.6 [choice]). Hand-derived.",
  "steps": [
    {"op": "aura_create"},
    {"op": "aura_init", "expect": true},
    {"op": "aura_env", "grids": {"crime": {"fill": 255}}},
    {"op": "aura_env", "tuning_props": {"0xEA023277": {"f32": 5.0}}},
    {"op": "aura_call", "method": "read_tuning"},
    {"op": "aura_expect", "state": {"curves": {"crime": false}}},
    {"op": "aura_set_grid", "grid": "work", "fill": -128, "cells": [[0, 0, 10]]},
    {"op": "aura_set", "state": {"state": 10}},
    {"op": "aura_idle", "expect_state": 11},
    {"op": "aura_expect_grid", "grid": "work", "cells": [[0, 0, 10]], "others": -128},
    {"op": "aura_env", "tuning_props": {"0xEA023277": {"f32": [5.0]}}},
    {"op": "aura_call", "method": "read_tuning"},
    {"op": "aura_expect", "state": {"curves": {"crime": false}}},
    {"op": "aura_set_grid", "grid": "work", "fill": -128, "cells": [[0, 0, 10]]},
    {"op": "aura_set", "state": {"state": 10}},
    {"op": "aura_idle", "expect_state": 11},
    {"op": "aura_expect_grid", "grid": "work", "cells": [[0, 0, 10]], "others": -128},
    {"op": "aura_env", "tuning_props": {"0xEA023277": {"f32": []}}},
    {"op": "aura_call", "method": "read_tuning"},
    {"op": "aura_expect", "state": {"curves": {"crime": false}}},
    {"op": "aura_set_grid", "grid": "work", "fill": -128, "cells": [[0, 0, 10]]},
    {"op": "aura_set", "state": {"state": 10}},
    {"op": "aura_idle", "expect_state": 11},
    {"op": "aura_expect_grid", "grid": "work", "cells": [[0, 0, 10]], "others": -128},
    {"op": "aura_env", "tuning_props": {"0xEA023277": {"f32": [0, 10, 255]}}},
    {"op": "aura_call", "method": "read_tuning"},
    {"op": "aura_expect", "state": {"curves": {"crime": true}}},
    {"op": "aura_set_grid", "grid": "work", "fill": -128, "cells": [[0, 0, 10]]},
    {"op": "aura_set", "state": {"state": 10}},
    {"op": "aura_idle", "expect_state": 11},
    {"op": "aura_expect_grid", "grid": "work", "cells": [[0, 0, 20]], "others": -128},
    {"op": "aura_env", "tuning_props": {"0xEA023270": {"f32": []}}},
    {"op": "aura_call", "method": "read_tuning"},
    {"op": "aura_expect", "state": {"curves": {"park": false}}},
    {"op": "aura_set_grid", "grid": "park_map", "fill": 100},
    {"op": "aura_set_grid", "grid": "work", "fill": -128, "cells": [[0, 0, 10]]},
    {"op": "aura_set", "state": {"state": 6}},
    {"op": "aura_idle", "expect_state": 7},
    {"op": "aura_expect_grid", "grid": "work", "cells": [[0, 0, 10]], "others": -128}
  ]
}
