{
  "format": 1,
  "name": "demolition_effects",
  "spec": ["demolition 4.9", "demolition 12.13"],
  "description": "With cause byte 0 no effect is created (the tree is removed silently); a dry run never creates one. Committed with cause 1 on a clicked tree: its sound, the occupant effect 0x120 with the click's ray, the removal, then the group effect 0x100 at the region's centre cell.",
  "steps": [
    {"op": "demolition_create"},
    {"op": "demolition_init", "expect": true},
    {"op": "demolition_clear_events"},
    {"op": "demolition_occupant", "occupant": "0x40", "type": "flora", "cell": [4, 4], "cost": 5},
    {"op": "demolition_region", "do_it": true, "rect": [4, 4, 4, 4], "privilege": 1, "flags": 0},
    {"op": "demolition_expect_event_count", "filter": {"event": "effect"}, "count": 0},
    {"op": "demolition_expect_event_count", "filter": {"event": "group"}, "count": 0},
    {"op": "demolition_expect_event_count", "filter": {"event": "remove", "occupant": "0x40", "flag": true}, "count": 1},
    {"op": "demolition_occupant", "occupant": "0x40", "flags": 1},
    {"op": "demolition_clear_events"},
    {"op": "demolition_region", "do_it": false, "rect": [4, 4, 4, 4], "privilege": 1, "flags": 1},
    {"op": "demolition_expect_events", "events": []},
    {"op": "demolition_region", "do_it": true, "rect": [4, 4, 4, 4], "privilege": 1, "flags": 1, "clicked": "0x40", "sx": 7, "sy": 8, "expect": {"ok": true, "cost": 5}},
    {"op": "demolition_expect_events", "events": [{"event": "sound", "occupant": "0x40"}, {"event": "effect", "occupant": "0x40", "keys": ["0x120"], "ray": [7, 8], "grey": false}, {"event": "remove", "occupant": "0x40", "flag": true}, {"event": "group", "instance": "0x100", "x": 4, "z": 4}, {"event": "queue", "on": true}, {"event": "queue", "on": false}]}
  ]
}
