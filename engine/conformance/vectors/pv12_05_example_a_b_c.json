{
  "format": 1,
  "name": "prop_developer_examples_a_b_c",
  "spec": ["prop-developer 4.3", "prop-developer 4.4", "prop-developer 4.5", "prop-developer 5", "prop-developer 12"],
  "description": "Section 12 tests 5 and 6, worked examples A, B and C of section 4.5, with scripted generators. A: a lot of occupancy 0.5 and wealth 2 with four optional prop objects listing props 0x500 (wealth 2) and 0x501 (wealth 3): slots 4, N = 2, want (2, 0, 0); RS(0, 4) = 2 picks object 2, the wealth requester keeps 0x500 and draws U(1) from its file generator, the prop is created with requester index 0; RS(0, 3) = 1 picks object 1 of the remaining (0, 1, 3). Exactly two member draws. B: the two props are kept (one wealth draw each), slots 4 = opt 2 + k 2, nothing removed or created, no member draw. C: occupancy 0.25: N = 1, one removal with RS(0, 2) = 1 (the second kept prop), slots 5, no creation. With the session generators (seed) the same visit makes two member and two wealth draws.",
  "steps": [
    {"op": "pv_requester", "token": "0x13B42BB8", "share": 0, "satisfaction": "0x49A1E996", "custom": true},
    {"op": "pv_requester", "token": "0x11347690", "share": 0, "satisfaction": "0xE9A4300B", "custom": false},
    {"op": "pv_create"},
    {"op": "pv_init", "expect": true},
    {"op": "pv_add_requester", "token": "0x13B42BB8", "class": "0x8990C09A"},
    {"op": "pv_add_requester", "token": "0x11347690", "class": "0x8990C065"},
    {"op": "pv_clear_events"},
    {"op": "pv_env", "profiles": [["0x500", "0x49A1E995", 2], ["0x501", "0x49A1E995", 3]]},
    {"op": "pv_lot", "lot": "0x10", "x": 0, "z": 0, "occupancy": 0.5, "wealth": 2, "objects": [{"tag": "0xA0", "ids": ["0x500", "0x501"]}, {"tag": "0xA1", "ids": ["0x500", "0x501"]}, {"tag": "0xA2", "ids": ["0x500", "0x501"]}, {"tag": "0xA3", "ids": ["0x500", "0x501"]}]},
    {"op": "pv_script", "member": [2, 1], "wealth": [0, 0]},
    {"op": "pv_update_block", "block": [0, 0]},
    {"op": "pv_expect_block", "state": {"lots": 1, "occ_sum": 0.5, "slots": 4, "kept_all": 0, "target": 2, "want": [2, 0, 0], "kept": [0, 0, 0], "removed": 0, "created": 2, "member_draws": 2, "stopped": false}},
    {"op": "pv_expect_events", "filter": {"event": "draw"}, "events": [{"gen": "member", "call": "RS", "lo": 0, "hi": 4, "value": 2}, {"gen": "wealth", "call": "U", "n": 1, "value": 0}, {"gen": "member", "call": "RS", "lo": 0, "hi": 3, "value": 1}, {"gen": "wealth", "call": "U", "n": 1, "value": 0}]},
    {"op": "pv_expect_prop", "prop": "0x9000", "state": {"exists": true, "type": "0x500", "lot": "0x10", "tag": "0xA2", "requester": 0}},
    {"op": "pv_expect_prop", "prop": "0x9001", "state": {"exists": true, "type": "0x500", "tag": "0xA1", "requester": 0}},

    {"op": "pv_clear_events"},
    {"op": "pv_script", "wealth": [0, 0]},
    {"op": "pv_update_block", "block": [0, 0]},
    {"op": "pv_expect_block", "state": {"slots": 4, "kept_all": 2, "target": 2, "want": [2, 0, 0], "kept": [2, 0, 0], "removed": 0, "created": 0, "member_draws": 0}},
    {"op": "pv_expect_events", "filter": {"event": "draw"}, "events": [{"gen": "wealth", "call": "U", "n": 1}, {"gen": "wealth", "call": "U", "n": 1}]},

    {"op": "pv_lot", "lot": "0x10", "occupancy": 0.25},
    {"op": "pv_script", "member": [1], "wealth": [0, 0]},
    {"op": "pv_update_block", "block": [0, 0]},
    {"op": "pv_expect_block", "state": {"slots": 5, "kept_all": 2, "target": 1, "want": [1, 0, 0], "kept": [2, 0, 0], "removed": 1, "created": 0, "member_draws": 1}},
    {"op": "pv_expect_events", "filter": {"event": "draw", "gen": "member"}, "events": [{"call": "RS", "lo": 0, "hi": 2, "value": 1}]},
    {"op": "pv_expect_prop", "prop": "0x9001", "state": {"exists": false}},
    {"op": "pv_expect_prop", "prop": "0x9000", "state": {"exists": true}},

    {"op": "pv_lot", "lot": "0x10", "occupancy": 0.5},
    {"op": "pv_prop", "prop": "0x9000", "lot": null, "cell": [40, 40]},
    {"op": "pv_create", "seed": "0x12345678"},
    {"op": "pv_init", "expect": true},
    {"op": "pv_add_requester", "token": "0x13B42BB8", "class": "0x8990C09A"},
    {"op": "pv_add_requester", "token": "0x11347690", "class": "0x8990C065"},
    {"op": "pv_clear_events"},
    {"op": "pv_update_block", "block": [0, 0]},
    {"op": "pv_expect_block", "state": {"created": 2, "member_draws": 2}},
    {"op": "pv_expect_event_count", "filter": {"event": "draw", "gen": "member"}, "count": 2},
    {"op": "pv_expect_event_count", "filter": {"event": "draw", "gen": "wealth"}, "count": 2}
  ]
}
