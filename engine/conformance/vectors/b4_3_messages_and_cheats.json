{
  "format": 1,
  "name": "budget_messages_and_cheats",
  "spec": ["budget 4.1", "budget 4.3", "budget 10"],
  "description": "DoMessage: SimBegin posts FundsChanged; SimNewMonth settles; CityEstablished resets funds and every rate (not the max rates); ToggleBudgetDialog selects the panel and opens the window, other data1 values are ignored. Cheats: WeaknessPays +1000, Moolah <n> sets the funds (false without an argument), unknown cheats return false, RiskyMoney deposits 10,000 only in an established city ([choice] true either way) and eventually starts disaster 0x42963812, which resets its counter. New-city Init sets the 12 tax-rate history queues to 365 and records funds / 1000.",
  "steps": [
    {"op": "budget_env", "difficulty": 1, "year": 2000, "month": 1, "ordinance_income": 10, "city_size": [1024, 512]},
    {"op": "budget_create"},
    {"op": "clear_events"},
    {"op": "budget_init", "tuning": {"0x6A9C7718": [500000, 200000, 100000], "0x0C032488": [7, 8, 9], "0x890E0A99": 20}},
    {"op": "expect_event_count", "filter": {"event": "history_queue", "length": 365}, "count": 12},
    {"op": "expect_event_count", "filter": {"event": "history_queue", "series": "0xAABAAA9F"}, "count": 1},
    {"op": "expect_event_count", "filter": {"event": "history_queue", "series": "0xAABAAAAA"}, "count": 1},
    {"op": "expect_events", "filter": {"event": "history"}, "events": [{"series": "0x4A5BA3D0", "value": 200}]},
    {"op": "budget_expect", "state": {"funds": 200000, "tax": {"0": {"rate": 8, "max_rate": 20}, "11": {"rate": 8}}}},

    {"op": "budget_message", "type": "SimBegin", "expect": true},
    {"op": "expect_events", "filter": {"event": "post"}, "events": [{"type": "FundsChanged", "void1": "budget"}]},
    {"op": "budget_message", "type": "SimNewMonth", "expect": true},
    {"op": "budget_expect", "state": {"funds": 200010, "last_month_income": 10}},
    {"op": "budget_message", "type": "0x12345678", "expect": true, "note": "anything else: ignored, true"},

    {"op": "budget_call", "method": "set_tax_rate", "args": [3, 12]},
    {"op": "budget_call", "method": "set_total_funds", "args": [5]},
    {"op": "clear_events"},
    {"op": "budget_env", "difficulty": 0},
    {"op": "budget_message", "type": "CityEstablished", "expect": true},
    {"op": "budget_expect", "state": {"funds": 500000, "shadow_funds": 500000,
      "tax": {"3": {"rate": 7, "max_rate": 20}, "0": {"rate": 7}}}},
    {"op": "expect_events", "filter": {"event": "post"}, "events": [{"type": "FundsChanged"}]},

    {"op": "budget_message", "type": "ToggleBudgetDialog", "data1": "0x892230F2", "expect": true},
    {"op": "budget_expect", "state": {"panel_flag": 1}},
    {"op": "budget_message", "type": "ToggleBudgetDialog", "data1": "0xC92230EE", "expect": true},
    {"op": "budget_expect", "state": {"panel_flag": 0}},
    {"op": "budget_message", "type": "ToggleBudgetDialog", "data1": 7, "expect": true},
    {"op": "expect_events", "filter": {"event": "show_budget_window"}, "events": [{"panel": 1}, {"panel": 0}]},

    {"op": "budget_cheat", "id": "WeaknessPays", "expect": true},
    {"op": "budget_expect", "state": {"funds": 501000}},
    {"op": "budget_cheat", "id": "Moolah", "text": "moolah 123456789012", "expect": true},
    {"op": "budget_expect", "state": {"funds": 123456789012, "shadow_funds": 123456789012}},
    {"op": "budget_cheat", "id": "Moolah", "text": "moolah", "expect": false},
    {"op": "budget_expect", "state": {"funds": 123456789012}},
    {"op": "budget_cheat", "id": "0x11111111", "expect": false},

    {"op": "budget_call", "method": "set_total_funds", "args": [0]},
    {"op": "budget_env", "established": false},
    {"op": "budget_cheat", "id": "RiskyMoney", "expect": true},
    {"op": "budget_expect", "state": {"funds": 0, "risky_money_counter": 0}},
    {"op": "budget_env", "established": true},
    {"op": "budget_cheat", "id": "RiskyMoney", "expect": true},
    {"op": "budget_expect", "state": {"funds": 10000, "risky_money_counter": 1}},
    {"op": "repeat", "count": 9, "steps": [{"op": "budget_cheat", "id": "RiskyMoney", "expect": true}]},
    {"op": "budget_expect", "state": {"funds": 100000, "risky_money_counter": 10},
     "note": "the disaster does not exist in this world: the counter keeps growing"},
    {"op": "expect_event_count", "filter": {"event": "disaster"}, "count": 0},
    {"op": "budget_env", "disasters": ["0x42963812"]},
    {"op": "clear_events"},
    {"op": "budget_cheat", "id": "RiskyMoney"},
    {"op": "budget_cheat", "id": "RiskyMoney"},
    {"op": "budget_cheat", "id": "RiskyMoney"},
    {"op": "budget_cheat", "id": "RiskyMoney"},
    {"op": "budget_cheat", "id": "RiskyMoney"},
    {"op": "budget_cheat", "id": "RiskyMoney"},
    {"op": "expect_event_count", "filter": {"event": "disaster", "id": "0x42963812"}, "min": 1,
     "note": "from counter 11 on, p >= 1 - 1/3.2 per call"}
  ]
}
