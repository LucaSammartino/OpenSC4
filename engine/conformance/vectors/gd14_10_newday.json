{
  "format": 1,
  "name": "growth_developer_newday",
  "spec": ["growth-developer 3.1", "growth-developer 14.10"],
  "description": "Test 10, the NewDay 'not finished' rule (hand-derived): false when state != 0 and state < today - startDay (unsigned). Start 100, today 103: state 2 -> false, 3 -> true, 0 -> true; today 100 -> true for every state; today 50 wraps (elapsed 2^32 - 50) -> false. Through the message (DoIdle(5) first): with a deadline after one tract per call the update stays in state 18 and NewDay answers false (18 < 100); then 19 and 20 still answer false and the call that reaches 0 answers true. A NewDay in state 1 records the start day (elapsed 0). SimIdle runs DoIdle(data3); other messages do nothing and answer true.",
  "steps": [
    {"op": "gdev_env", "cells": [16, 16], "date": 103},
    {"op": "gdev_create"},
    {"op": "gdev_init", "props": {"0x00000021": {"u32": "0x1010"}, "0x87CD6300": {"u8": 1}, "0x87CD6310": {"u8": 4}, "0x87CD6330": {"u8": 1}, "0x87CD6332": {"u8": 1}}, "expect": true},
    {"op": "gdev_set", "state": {"start_day": 100, "update_state": 2}},
    {"op": "gdev_call", "method": "new_day_finished", "expect": false},
    {"op": "gdev_set", "state": {"update_state": 3}},
    {"op": "gdev_call", "method": "new_day_finished", "expect": true},
    {"op": "gdev_set", "state": {"update_state": 0}},
    {"op": "gdev_call", "method": "new_day_finished", "expect": true},
    {"op": "gdev_env", "date": 100},
    {"op": "gdev_set", "state": {"update_state": 2}},
    {"op": "gdev_call", "method": "new_day_finished", "expect": true},
    {"op": "gdev_set", "state": {"update_state": 3}},
    {"op": "gdev_call", "method": "new_day_finished", "expect": true},
    {"op": "gdev_set", "state": {"update_state": 0}},
    {"op": "gdev_call", "method": "new_day_finished", "expect": true},
    {"op": "gdev_set", "state": {"update_state": 20}},
    {"op": "gdev_call", "method": "new_day_finished", "expect": true},
    {"op": "gdev_env", "date": 50},
    {"op": "gdev_set", "state": {"update_state": 2}},
    {"op": "gdev_call", "method": "new_day_finished", "expect": false},
    {"op": "gdev_env", "date": 200, "timer_checks": 1},
    {"op": "gdev_set", "state": {"update_state": 17}},
    {"op": "gdev_idle"},
    {"op": "gdev_message", "type": "SimNewDay", "expect": false},
    {"op": "gdev_expect", "state": {"update_state": 18, "iterator": {"x": 0, "z": 0, "state": "running"}}},
    {"op": "gdev_message", "type": "SimNewDay", "expect": false},
    {"op": "gdev_expect", "state": {"update_state": 18, "iterator": {"x": 1, "z": 0}}},
    {"op": "gdev_env", "timer_checks": null},
    {"op": "gdev_message", "type": "SimNewDay", "expect": false},
    {"op": "gdev_expect", "state": {"update_state": 19}},
    {"op": "gdev_message", "type": "SimNewDay", "expect": false},
    {"op": "gdev_message", "type": "SimNewDay", "expect": true},
    {"op": "gdev_expect", "state": {"update_state": 0}},
    {"op": "gdev_call", "method": "start_map_update"},
    {"op": "gdev_message", "type": "SimNewDay", "expect": true},
    {"op": "gdev_expect", "state": {"update_state": 2, "start_day": 200}},
    {"op": "gdev_message", "type": "SimIdle", "data3": 5, "expect": true},
    {"op": "gdev_expect", "state": {"update_state": 3}},
    {"op": "gdev_message", "type": "0x12345678", "expect": true},
    {"op": "gdev_expect", "state": {"update_state": 3}}
  ]
}
