    {"op": "commercial_expect_grid", "grid": "CO3", "note": "the previous result is kept: no seed and no passes (CM5)",
      "cells": [{"x": 0, "z": 0, "v": 10}, {"x": 7, "z": 0, "v": 10}], "count": {"10": 8, "9": 56}},
