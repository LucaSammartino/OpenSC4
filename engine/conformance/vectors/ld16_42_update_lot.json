{
  "format": 1,
  "name": "lot_developer_update_lot",
  "spec": ["lot-developer 4.2", "lot-developer 10.3"],
  "description": "UpdateLot for the three lot kinds (§4.2). Grown building (purpose != 0): the four tests always run in the order desirability, power, water, travel; the last failing one gives the reason; SetCondition is set from TestCondition; a coffee-bar purpose-2 lot draws R3 when the cheat is on. Purpose 0 (civic/plopped): TestPower only, and the condition is moved 0->1 (unpowered), 1->0 (powered), 5/6->0, then TestTravel when powered; no travel test on the c=0-and-unpowered stop. Empty lot (type 0), only when zotsAllowed: after 30 days with canCheckCommute a temporary purpose-1 (zones 1-3) or purpose-3 (zones 4-6) TestTravel runs, and IsEmptyLotSuitableForZot gates a TestPower. The business-unit step 5 always runs: a lot with no unit resets and adds its travel population, and PickUnitToJoin (which may draw R2) runs when the lot is livable and has no road access. Draw order for a grown building is R1 -> R3 -> R2 (§10.3).",
  "steps": [
    {"op": "ldev_world", "terrain_cells": [64, 64]},
    {"op": "ldev_tuning", "shipped": true},

    {"op": "ldev_occ", "id": 500, "is_building": true, "bbox": [[0, 0, 0], [16, 10, 16]], "cells": [0, 0, 0, 0]},
    {"op": "ldev_profile", "building": "0x3001", "purpose": 1, "wealth": 1},
    {"op": "ldev_dev", "id": 700, "purpose": 1, "wealth": 1, "desirability": 100, "water_cap": 5},
    {"op": "ldev_cfg", "id": 9, "cfg_id": "0x60000009", "w": 1, "h": 1, "stage": 1},
    {"op": "ldev_lot", "id": 1, "x": 0, "z": 0, "state": 3, "building_type": "0x3001", "building": 500,
      "cfg": 9, "wealth": 1, "livable": true, "has_power": true, "road": true, "job": true,
      "condition": 0, "days": 10, "occupancy": 1.0},
    {"op": "ldev_cells", "powered": [[0, 0, 1]], "watered": [[0, 0, 1]], "trip": [[0, 0, 1]]},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},

    {"op": "ldev_clear_events"},
    {"op": "ldev_update_lot", "lot": 1, "expect": false, "note": "all four tests pass: no state change"},
    {"op": "ldev_expect_lot", "lot": 1, "state": 3, "condition": 0},
    {"op": "ldev_expect_draws", "draws": [], "note": "desirability high (not low) -> no R1; residence not purpose 2 -> no R3; road access -> no R2"},

    {"op": "ldev_lot", "id": 1, "has_power": false, "counter": {"no_power": 100, "no_water": 100, "low_desirability": 100}},
    {"op": "ldev_cells", "powered": [[0, 0, 0]], "watered": [[0, 0, 0]]},
    {"op": "ldev_dev", "id": 700, "desirability": -100},
    {"op": "ldev_clear_events"},
    {"op": "ldev_update_lot", "lot": 1, "expect": true, "note": "all four fail: the last (travel) gives reason 4"},
    {"op": "ldev_expect_lot", "lot": 1, "state": 4},
    {"op": "ldev_expect_draws", "draws": [["R1", 7, 0]], "note": "only the desirability draw; no coffee bar (purpose 1), no unit draw (has road access until the travel test flips it? road is still true so PickUnitToJoin is not reached)"},

    {"op": "ldev_clear_lots", "note": "purpose 0 (civic): power-only handling"},
    {"op": "ldev_profile", "building": "0x4000", "purpose": 0, "wealth": 1},
    {"op": "ldev_lot", "id": 2, "x": 0, "z": 0, "state": 3, "building_type": "0x4000", "building": 500,
      "condition": 0, "needs_power": true, "has_power": true},
    {"op": "ldev_cells", "powered": [[0, 0, 0]], "note": "unpowered"},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_clear_events"},
    {"op": "ldev_update_lot", "lot": 2, "expect": false, "note": "civic: no state change from UpdateLot"},
    {"op": "ldev_expect_lot", "lot": 2, "condition": 1, "note": "condition 0 and unpowered -> SetCondition(1); TestPower itself may also set it, but the result is 1"},

    {"op": "ldev_lot", "id": 2, "condition": 1, "has_power": false},
    {"op": "ldev_cells", "powered": [[0, 0, 1]], "note": "powered"},
    {"op": "ldev_clear_events"},
    {"op": "ldev_update_lot", "lot": 2, "expect": false},
    {"op": "ldev_expect_lot", "lot": 2, "condition": 0, "note": "condition 1 and powered -> SetCondition(0)"},

    {"op": "ldev_lot", "id": 2, "condition": 5},
    {"op": "ldev_clear_events"},
    {"op": "ldev_update_lot", "lot": 2, "expect": false},
    {"op": "ldev_expect_lot", "lot": 2, "condition": 0, "note": "condition 5 -> SetCondition(0)"},

    {"op": "ldev_clear_lots", "note": "empty lot: zot gate and the business-unit step"},
    {"op": "ldev_profile", "building": "0x6000", "purpose": 6, "wealth": 1},
    {"op": "ldev_lot", "id": 3, "x": 4, "z": 4, "zone": 8, "state": 1, "building_type": 0, "no_building": true,
      "livable": true, "road": false, "note": "empty industrial lot at (4,4): (4 mod 4 = 0 and 4 mod 4 = 0) -> zot-suitable; no road access and livable -> PickUnitToJoin"},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_world", "sim_date": 100},
    {"op": "ldev_message", "msg": "0x26D31EC4", "note": "CityEstablished: noZotUntilDay = 100 + 31 = 131"},
    {"op": "ldev_set", "no_zot_until_day": 0, "note": "force zotsAllowed (today > noZotUntilDay)"},
    {"op": "ldev_clear_events"},
    {"op": "ldev_update_lot", "lot": 3, "expect": false},
    {"op": "ldev_expect_events", "filter": {"event": "reset_travel_pop"}, "events": [{"event": "reset_travel_pop", "lot": 3}],
      "note": "no unit: the travel population is reset and re-added"},

    {"op": "ldev_clear_lots", "note": "a grown lot without a unit and without road access draws R2 in PickUnitToJoin"},
    {"op": "ldev_profile", "building": "0x6000", "purpose": 6, "wealth": 1},
    {"op": "ldev_lot", "id": 4, "x": 0, "z": 0, "state": 3, "building_type": "0x6000", "building": 500,
      "livable": true, "road": false, "cfg": 9},
    {"op": "ldev_dev", "id": 701, "purpose": 6, "wealth": 1, "desirability": 100, "water_cap": 5},
    {"op": "ldev_cells", "powered": [[0, 0, 1]], "watered": [[0, 0, 1]], "trip": [[0, 0, 1]]},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_clear_events"},
    {"op": "ldev_update_lot", "lot": 4, "expect": false,
      "note": "tests pass (desirability high, powered, watered, road... road is false so travel may fail); PickUnitToJoin has no candidate neighbours so it draws nothing"},
    {"op": "ldev_expect_events", "filter": {"event": "reset_travel_pop"}, "events": [{"event": "reset_travel_pop", "lot": 4}]}
  ]
}
