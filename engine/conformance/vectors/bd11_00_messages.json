{
  "format": 1,
  "name": "bds_messages",
  "spec": ["building-development 3.2", "building-development 4.12", "building-development 1.4"],
  "description": "The messages of 3.2 and 4.12, by hand. Cheats: HowDryIAm sets ignore plumbing, FightThePower ignore power, Barstuck toggles the coffee bar (twice -> off again); an unknown cheat ID does nothing; ignore caps and debug growth stay false. Special buildings: occupant 70 (group 0x150A) and 71 (group 0x150B) are appended with an AddRef each; 72 (group 0x1500) and 73 (group 0x150A but a preview occupant, property 0x029244DB) are ignored; inserting 70 again appends it again (list order, duplicates kept). Removing 70 removes the first match and releases it; removing 74 (in the group, not in the list) or 72 does nothing; a message without an occupant does nothing. Shutdown releases the remaining specials in list order. Terrain changed: x1 = (data1 >> 16) - 1 clamped >= 0, x2 = data1 & 0xFFFF clamped <= 63 (64 x 64 cells), same for z: data1 0x00030005, data2 0x00000040 -> (2, 0)-(5, 63); kind = data4 = 7 (not 1-3) -> UpdateLotElements(lot, 7) (the whole kind, §4.11) for each lot in the rectangle (lots 1 and 3, not 2 outside). PlaceBuilding with parameters (0x100, 40.0, 72.0) -> AddNewBuildingOccupant(0x100, {40, 72, -1}, 2) [quirk]: the second float lands in y, z = -1; y >= 0 so no area altitude; orientation 2 keeps the box. Fewer than 3 parameters or an unknown type -> nothing. Every message returns true.",
  "steps": [
    {"op": "bds_process", "seed": 1},
    {"op": "bds_exemplars", "list": [{"building": "0x100", "purpose": 1, "wealth": 1}]},
    {"op": "bds_create"},
    {"op": "bds_init", "expect": true},

    {"op": "bds_message", "type": "Cheat", "data1": "0x491865E1", "expect": true},
    {"op": "bds_call", "method": "cheats", "expect": {"plumbing": true, "power": false, "caps": false, "debug_growth": false, "coffee_bar": false}},
    {"op": "bds_message", "type": "Cheat", "data1": "0x08DAD89A"},
    {"op": "bds_message", "type": "Cheat", "data1": "0x6AB6A2D7"},
    {"op": "bds_call", "method": "cheats", "expect": {"plumbing": true, "power": true, "caps": false, "debug_growth": false, "coffee_bar": true}},
    {"op": "bds_message", "type": "Cheat", "data1": "0x6AB6A2D7"},
    {"op": "bds_message", "type": "Cheat", "data1": "0x12345678"},
    {"op": "bds_message", "type": "Cheat", "data1": "0x491865E1"},
    {"op": "bds_call", "method": "cheats", "expect": {"plumbing": true, "power": true, "caps": false, "debug_growth": false, "coffee_bar": false}},

    {"op": "bds_occupants", "list": [
      {"id": 70, "groups": ["0x150A"], "pos": [8, 0, 8]},
      {"id": 71, "groups": ["0x2000", "0x150B"]},
      {"id": 72, "groups": ["0x1500"]},
      {"id": 73, "groups": ["0x150A"], "preview": true},
      {"id": 74, "groups": ["0x150B"]}]},
    {"op": "bds_clear_events"},
    {"op": "bds_message", "type": "OccupantInserted", "occupant": 70, "expect": true},
    {"op": "bds_message", "type": "OccupantInserted", "occupant": 71},
    {"op": "bds_message", "type": "OccupantInserted", "occupant": 72},
    {"op": "bds_message", "type": "OccupantInserted", "occupant": 73},
    {"op": "bds_message", "type": "OccupantInserted", "occupant": 70},
    {"op": "bds_message", "type": "OccupantInserted"},
    {"op": "bds_expect_events", "events": [
      {"event": "add_ref", "occ": 70}, {"event": "add_ref", "occ": 71}, {"event": "add_ref", "occ": 70}]},
    {"op": "bds_call", "method": "special_buildings", "expect": [70, 71, 70]},
    {"op": "bds_expect_refs", "occupants": {"70": 2, "71": 1, "72": 0, "73": 0}},
    {"op": "bds_clear_events"},
    {"op": "bds_message", "type": "OccupantRemoved", "occupant": 70, "expect": true},
    {"op": "bds_message", "type": "OccupantRemoved", "occupant": 74},
    {"op": "bds_message", "type": "OccupantRemoved", "occupant": 72},
    {"op": "bds_message", "type": "OccupantRemoved", "occupant": 73},
    {"op": "bds_expect_events", "events": [{"event": "release", "occ": 70}]},
    {"op": "bds_expect", "state": {"special_buildings": [71, 70]}},
    {"op": "bds_expect_refs", "occupants": {"70": 1, "71": 1, "74": 0}},

    {"op": "bds_call", "method": "unpack_terrain_rect", "args": ["0x00030005", "0x00000040", 64, 64], "expect": [2, 0, 5, 63]},
    {"op": "bds_call", "method": "unpack_terrain_rect", "args": ["0x00000000", "0x0001FFFF", 64, 64], "expect": [0, 0, 0, 63]},
    {"op": "bds_call", "method": "unpack_terrain_rect", "args": ["0x000B0003", "0x00050004", 64, 64], "expect": [10, 4, 3, 4]},
    {"op": "bds_lots", "lots": [
      {"id": 1, "building_type": "0x100", "rect": [2, 2, 3, 3]},
      {"id": 2, "building_type": "0x100", "rect": [10, 10, 11, 11]},
      {"id": 3, "building_type": "0x100", "rect": [5, 60, 6, 61]}]},
    {"op": "bds_clear_events"},
    {"op": "bds_message", "type": "TerrainChanged", "data1": "0x00030005", "data2": "0x00000040", "data4": 7, "expect": true},
    {"op": "bds_expect_events", "events": [
      {"event": "update_lot_elements", "lot": 1, "kind": 7},
      {"event": "update_lot_elements", "lot": 3, "kind": 7}]},
    {"op": "bds_clear_events"},
    {"op": "bds_message", "type": "TerrainChanged", "data1": "0x000B0003", "data2": "0x00010040", "data4": 7},
    {"op": "bds_expect_events", "events": []},

    {"op": "bds_occupants", "list": [{"id": 0, "bbox": [[-8, 0, -4], [8, 10, 4]]}]},
    {"op": "bds_world", "next_token": 500},
    {"op": "bds_clear_events"},
    {"op": "bds_message", "type": "PlaceBuilding", "params": [["0x100"], [0, 40.0], [0, 72.0]], "expect": true},
    {"op": "bds_expect_events", "events": [
      {"event": "create_occupant", "occ": 500},
      {"event": "set_building_type", "occ": 500, "type": "0x100"},
      {"event": "load_occupant", "occ": 500, "type": "0x100", "result": true},
      {"event": "set_bbox", "occ": 500, "min": [-8, 0, -4], "max": [8, 10, 4]},
      {"event": "set_position", "occ": 500, "pos": [40, 72, -1]},
      {"event": "set_orientation", "occ": 500, "orientation": 2},
      {"event": "init_occupant", "occ": 500},
      {"event": "insert_occupant", "occ": 500, "result": true},
      {"event": "release", "occ": 500}]},
    {"op": "bds_clear_events"},
    {"op": "bds_message", "type": "PlaceBuilding", "params": [["0x100"], [0, 40.0]]},
    {"op": "bds_message", "type": "PlaceBuilding", "params": [["0x101"], [0, 40.0], [0, 72.0]]},
    {"op": "bds_message", "type": "PlaceBuilding"},
    {"op": "bds_expect_events", "events": []},

    {"op": "bds_shutdown", "expect": true},
    {"op": "bds_expect_events", "filter": {"event": "release"}, "events": [{"occ": 71}, {"occ": 70}]},
    {"op": "bds_expect_refs", "occupants": {"70": 0, "71": 0}}
  ]
}
