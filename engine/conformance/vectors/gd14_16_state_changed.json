{
  "format": 1,
  "name": "growth_developer_state_changed",
  "spec": ["growth-developer 6.3", "growth-developer 14.16"],
  "description": "Test 16, StateChanged (hand-derived from 6.3): occupied = 2 <= state < 4 (low byte). Old 1 -> new 2 with the developer's wealth adds the lot's capacity as in test 3 (22 / 18, total 40); a wealth mismatch does nothing (no calls); building type 0 only calls GetBuildingType(true) and discards it (quirk 6); 2 -> 3 and 4 -> 5 do not change occupancy; 3 -> 4 removes the capacity; 0 -> 0x102 counts as occupied (byte compare). A message without a lot is ignored ([choice]).",
  "steps": [
    {"op": "gdev_env", "cells": [16, 16], "purposes": {"0x1234": 1}},
    {"op": "gdev_lot", "label": "lot", "building_type": "0x1234", "capacity": 40, "size": [2, 3], "rect": [3, 0, 4, 2], "location": [3, 0]},
    {"op": "gdev_create"},
    {"op": "gdev_init", "exemplar": "0x1010", "expect": true},
    {"op": "gdev_clear_events"},
    {"op": "gdev_message", "type": "StateChanged", "lot": "lot", "data1": 1, "data2": 2, "data3": "0x1234", "data4": 1, "expect": true},
    {"op": "gdev_expect_grid", "grid": "capacity", "tracts": [[0, 0, 22], [1, 0, 18]]},
    {"op": "gdev_call", "method": "total_capacity", "expect": 40},
    {"op": "gdev_clear_events"},
    {"op": "gdev_message", "type": "StateChanged", "lot": "lot", "data1": 3, "data2": 4, "data3": "0x1234", "data4": 2},
    {"op": "gdev_expect_events", "events": []},
    {"op": "gdev_message", "type": "StateChanged", "lot": "lot", "data1": 1, "data2": 2, "data3": 0, "data4": 1},
    {"op": "gdev_expect_events", "events": [{"event": "lot_building_type", "lot": "lot", "flag": true}]},
    {"op": "gdev_message", "type": "StateChanged", "lot": "lot", "data1": 2, "data2": 3, "data3": "0x1234", "data4": 1},
    {"op": "gdev_message", "type": "StateChanged", "lot": "lot", "data1": 4, "data2": 5, "data3": "0x1234", "data4": 1},
    {"op": "gdev_expect_events", "events": []},
    {"op": "gdev_expect_grid", "grid": "capacity", "tracts": [[0, 0, 22], [1, 0, 18]]},
    {"op": "gdev_message", "type": "StateChanged", "lot": "lot", "data1": 3, "data2": 4, "data3": "0x1234", "data4": 1},
    {"op": "gdev_expect_grid", "grid": "capacity", "tracts": [[0, 0, 0], [1, 0, 0]]},
    {"op": "gdev_call", "method": "total_capacity", "expect": 0},
    {"op": "gdev_message", "type": "StateChanged", "lot": "lot", "data1": 0, "data2": "0x102", "data3": "0x1234", "data4": 1},
    {"op": "gdev_expect_grid", "grid": "capacity", "tracts": [[0, 0, 22], [1, 0, 18]]},
    {"op": "gdev_call", "method": "total_capacity", "expect": 40},
    {"op": "gdev_clear_events"},
    {"op": "gdev_message", "type": "StateChanged", "data1": 1, "data2": 2, "data3": "0x1234", "data4": 1},
    {"op": "gdev_expect_events", "events": []}
  ]
}
