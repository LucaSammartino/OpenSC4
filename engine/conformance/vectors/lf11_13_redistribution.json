{
  "format": 1,
  "name": "lf11_13_redistribution",
  "spec": ["landfill 4.7.4", "landfill 11"],
  "description": "Conformance test 13. A 4x2 zone (W = 3, H = 1): three valid heaps of capacity 100 holding 100, 50, 0 (total 150) give share 100 and stay 100, 50, 0. The reverse order 0, 50, 100 is spread back to 100, 50, 0.",
  "steps": [
