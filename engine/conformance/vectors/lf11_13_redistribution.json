    {"op": "landfill_expect", "zone_state": {"w": 3, "h": 1}},
    {"op": "landfill_heaps", "heaps": [[0, 0, true, true, 100, 100], [1, 0, true, true, 100, 50], [2, 0, true, false, 100, 0]]},
    {"op": "landfill_redistribute"},
    {"op": "landfill_expect", "zone_state": {"heaps": [[0, 0, true, true, 100, 100], [1, 0, true, true, 100, 50], [2, 0, true, false, 100, 0]]}},
    {"op": "landfill_heaps", "heaps": [[0, 0, true, false, 100, 0], [1, 0, true, true, 100, 50], [2, 0, true, true, 100, 100]]},
    {"op": "landfill_redistribute"},
    {"op": "landfill_expect", "zone_state": {"heaps": [[0, 0, true, false, 100, 100], [1, 0, true, true, 100, 50], [2, 0, true, true, 100, 0]]}}
  ]
