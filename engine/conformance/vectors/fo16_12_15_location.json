{
  "format": 1,
  "name": "flora_location_check",
  "spec": ["flora 6.4", "flora 6.4.1"],
  "description": "Derived by hand from flora 6.4 and 6.4.1 (tests 12 to 15 of 16). Type 0x1000 has the code defaults (clearance radius 3, height 3, slope tolerance 0.5); 0x2000 is a water type. City 1024 m, sea 250, ground 260, flat (normal.y 1). Test 12: box min x = x - 3: x = 2.9 -> -0.1 < 0 -> false; x = 3 -> 0, passes; x + 3 = 1024 -> passes (SizeX < max.x is false); x = 1021.5 -> max 1024.5 > 1024 -> false; the same on z. Test 13, off-lot: normal.y 0.5 <= 1 - 0.5 -> false; 0.51 -> passes; on a lot the slope test is skipped. Test 14: ground 240 < sea 250 off-lot: land type false, water type passes; on a lot both pass. Test 15 at (500, 500), clearance box (497, 244, 497)..(503, 263, 503): a prop whose box (502, 260, 502)..(506, 265, 506) overlaps -> false; excluding that prop -> true; a power-line network occupant (flag 0x20 only) does not block; a street (flag 0x8, in 0x1F4F) overlapping -> false; an unknown occupant type does not block; a building's box that only touches the clearance box face (min x 503) -> true (the strict test of 6.4 [compat]: touching boxes do not intersect), one at min x 503.5 -> true, one reaching 0.5 m into it (min x 502.5) -> false; a landfill box below the clearance box (top 243.5 < 244) does not block, one reaching into it does; an unregistered type -> false.",
  "steps": [
    {"op": "flora_types", "types": [{"type": "0x1000", "table": 0.6}, {"type": "0x2000", "table": 0.6, "water": true}]},
    {"op": "flora_create"},
    {"op": "flora_init", "expect": true},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 2.9, 500], "expect": false},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 3, 500], "expect": true},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 1021, 500], "expect": true},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 1021.5, 500], "expect": false},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 500, 2.9], "expect": false},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 500, 3], "expect": true},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 500, 1021], "expect": true},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 500, 1021.5], "expect": false},
    {"op": "flora_call", "method": "location_ok", "args": ["0x5555", 500, 500], "expect": false},

    {"op": "flora_env", "normals": [[0, 0, 100, 1024, 0.5], [100.5, 0, 200, 1024, 0.51]], "lots": [[50, 0, 60, 1024]]},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 20, 500], "expect": false},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 150, 500], "expect": true},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 55, 500], "expect": true},

    {"op": "flora_env", "grounds": [[300, 0, 400, 1024, 240]], "lots": [[350, 0, 360, 1024]]},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 320, 500], "expect": false},
    {"op": "flora_call", "method": "location_ok", "args": ["0x2000", 320, 500], "expect": true},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 355, 500], "expect": true},
    {"op": "flora_call", "method": "location_ok", "args": ["0x2000", 355, 500], "expect": true},

    {"op": "flora_env", "occupants": [{"id": 1, "type": "prop", "bbox": [[502, 260, 502], [506, 265, 506]]}]},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 500, 500], "expect": false},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 500, 500, 1], "expect": true},
    {"op": "flora_env", "forget": [1], "occupants": [{"id": 2, "type": "network", "network": "0x20", "bbox": [[490, 250, 490], [510, 270, 510]]}]},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 500, 500], "expect": true},
    {"op": "flora_env", "forget": [2], "occupants": [{"id": 3, "type": "network", "network": "0x8", "bbox": [[490, 250, 490], [510, 270, 510]]}]},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 500, 500], "expect": false},
    {"op": "flora_env", "forget": [3], "occupants": [{"id": 4, "type": "0x12345678", "bbox": [[490, 250, 490], [510, 270, 510]]}]},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 500, 500], "expect": true},
    {"op": "flora_env", "occupants": [{"id": 5, "type": "building", "bbox": [[503, 250, 490], [510, 270, 510]]}]},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 500, 500], "expect": true},
    {"op": "flora_env", "forget": [5], "occupants": [{"id": 6, "type": "building", "bbox": [[503.5, 250, 490], [510, 270, 510]]}]},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 500, 500], "expect": true},
    {"op": "flora_env", "forget": [6], "occupants": [{"id": 9, "type": "building", "bbox": [[502.5, 250, 490], [510, 270, 510]]}]},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 500, 500], "expect": false},
    {"op": "flora_env", "forget": [9]},
    {"op": "flora_env", "occupants": [{"id": 7, "type": "landfill", "bbox": [[499, 200, 499], [501, 243.5, 501]]}]},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 500, 500], "expect": true},
    {"op": "flora_env", "occupants": [{"id": 8, "type": "landfill", "bbox": [[499, 250, 499], [501, 255, 501]]}]},
    {"op": "flora_call", "method": "location_ok", "args": ["0x1000", 500, 500], "expect": false},
    {"op": "flora_call", "method": "blocks_flora", "args": ["flora"], "expect": true},
    {"op": "flora_call", "method": "blocks_flora", "args": ["building"], "expect": true},
    {"op": "flora_call", "method": "blocks_flora", "args": ["landfill"], "expect": true},
    {"op": "flora_call", "method": "blocks_flora", "args": ["prop"], "expect": true},
    {"op": "flora_call", "method": "blocks_flora", "args": ["network", "0x1F4F"], "expect": true},
    {"op": "flora_call", "method": "blocks_flora", "args": ["network", "0x20B0"], "expect": false},
    {"op": "flora_call", "method": "blocks_flora", "args": ["network", null], "expect": false},
    {"op": "flora_call", "method": "blocks_flora", "args": ["0x12345678", "0x8"], "expect": false}
  ]
}
