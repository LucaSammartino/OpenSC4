{
  "format": 1,
  "name": "ck12_09_setters",
  "spec": ["clock24 4.6", "clock24 12"],
  "description": "Test 9. SetHour(25) at 12:30 -> hour 1: seconds 3600, HourChanged (1, 0) and TimeTick (1, 0); SetHour(12) at 12:30 does nothing. SetMinute(75) at 13:20:30 -> minute 15: (13 x 60 + 15) x 60 = 47,700 (returned); SetSeconds(61) -> 1: 47,701 (returns GetMinute, 15). SetTimePercentage(-0.5): -43,200 wraps to 4,294,924,096, mod 86,400 = 66,496; 0.999999 x 86400 = 86,399.91 -> 86,399; 1.5 -> 129,600 mod 86,400 = 43,200. SetTimeMagnificationMinMax(10, 5) gives min 10, max 10 and leaves the magnification (135); SetTimeMagnification(3) is then clamped to 10. No setter changes visualSeconds or posts anything else.",
  "steps": [
    {"op": "ck_create"},
    {"op": "ck_call", "method": "init"},
    {"op": "ck_set", "seconds": "12:30:00", "visual_seconds": "12:30:00"},
    {"op": "ck_clear_events"},
    {"op": "ck_call", "method": "set_hour", "args": [25]},
    {"op": "ck_expect", "state": {"seconds": 3600, "visual_seconds": 45000}},
    {"op": "ck_expect_events", "events": [{"event": "post", "name": "HourChanged", "data2": 1, "data3": 0}, {"event": "post", "name": "TimeTick", "data2": 1, "data3": 0}]},
    {"op": "ck_set", "seconds": "12:30:00"},
    {"op": "ck_call", "method": "set_hour", "args": [12]},
    {"op": "ck_expect", "state": {"seconds": 45000}},
    {"op": "ck_set", "seconds": "13:20:30"},
    {"op": "ck_call", "method": "set_minute", "args": [75], "expect": 47700},
    {"op": "ck_call", "method": "set_seconds", "args": [61], "expect": 15},
    {"op": "ck_expect", "state": {"seconds": 47701}},
    {"op": "ck_call", "method": "set_time_percentage", "args": [-0.5]},
    {"op": "ck_expect", "state": {"seconds": 66496}},
    {"op": "ck_call", "method": "set_time_percentage", "args": [0.999999]},
    {"op": "ck_expect", "state": {"seconds": 86399}},
    {"op": "ck_call", "method": "set_time_percentage", "args": [1.5]},
    {"op": "ck_expect", "state": {"seconds": 43200}},
    {"op": "ck_call", "method": "set_time_magnification_min_max", "args": [10, 5], "expect": true},
    {"op": "ck_call", "method": "time_magnification_min_max", "expect": [10, 10]},
    {"op": "ck_call", "method": "time_magnification", "expect": 135},
    {"op": "ck_call", "method": "set_time_magnification", "args": [3], "expect": true},
    {"op": "ck_call", "method": "time_magnification", "expect": 10},
    {"op": "ck_expect", "state": {"visual_seconds": 45000}},
    {"op": "ck_expect_event_count", "count": 0}
  ]
}
