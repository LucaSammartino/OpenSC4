      {"event": "department", "id": "0x09188F42", "name": "0xCA493A56", "max": 1.2, "init": 0.25, "token": 900},
      {"event": "department", "id": "0xAA538CB3", "name": "0xCA538D98", "max": 1.2, "init": 1.0, "token": 901},
      {"event": "department", "id": "0x09188F4C", "name": "0x6A493A66", "max": 1.2, "init": 0.25, "token": 902},
      {"event": "department", "id": "0x4A538CC6", "name": "0x8A538DAC", "max": 1.2, "init": 1.0, "token": 903}
    ]},
    {"op": "residential_expect", "state": {
      "initialized": true, "city_started": true, "message_server_held": true,
      "population_size": 2, "eq_size": 2, "proximity_size": 1, "state": 0,
