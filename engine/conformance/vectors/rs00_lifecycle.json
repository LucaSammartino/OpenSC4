    {"op": "residential_expect_grid", "grid": "proximity1", "size": 1, "counts": [8, 8], "instance": "0x49D5BC96"},
    {"op": "residential_expect_grid", "grid": "age", "instance": "0x69D5C303"},
    {"op": "residential_expect_grid", "grid": "school_coverage6", "instance": "0x69D5C30D"},
