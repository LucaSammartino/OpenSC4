      {"event": "acquire_developers"},
      {"event": "demand_node"},
      {"event": "message_server"},
      {"event": "subscribe", "type": "0x99EF1142"},
      {"event": "subscribe", "type": "0x99EF1143"},
      {"event": "budget_simulator"},
      {"event": "simulator"},
      {"event": "add_agent", "level": 0, "name": "cSC4ResidentialSimulator", "flags": 2},
      {"event": "add_agent", "level": 10, "name": "cSC4ResidentialSimulator", "flags": 2},
      {"event": "add_agent", "level": 6, "name": "cSC4ResidentialSimulator", "flags": 2},
      {"event": "add_agent", "level": 4, "name": "cSC4ResidentialSimulator", "flags": 2},
      {"event": "queue_length", "series": "0xCA545CAB", "length": 2},
      {"event": "queue_length", "series": "0xCA545CCA", "length": 2},
      {"event": "queue_length", "series": "0xCA545CAC", "length": 2},
      {"event": "queue_length", "series": "0xCA545CCB", "length": 2},
