{
  "format": 1,
  "name": "lot_developer_interface_and_business_units",
  "spec": ["lot-developer 5.7", "lot-developer 11.1", "lot-developer 10.3", "lot-developer 16"],
  "description": "Test 19 (§11.1, §16) and the business-unit helpers (§5.7). Interface degenerates: slot 23 IsAreaDeveloped and slot 24 IsLotDeveloped always return false (a shared stub); slot 32 GetLotDevelopmentCost returns the cost as an int64. PickUnitToJoin (§5.7) returns without a draw when the lot already has a unit, has no building type, or the profile purpose is not 5-8; otherwise it gathers the surrounding lots for side flags 1,2,4,8 (appending), keeps the neighbours with a building type, state > 1 or a unit, and the same purpose (a farm neighbour must have a building, an industrial one road access or a road-access designate), and if there is at least one candidate draws R2 = Uniform(count) on the FILE generator, joins that candidate's unit (creating one when it has none) and, for purpose 5, points the lot's travel designate at the unit's first member, else sets unitChanged. NeedsAnchorBuilding (§5.7): purpose not 6-8 -> false; a lot in the rectangle whose building is in occupant group 0x3000 -> true; else a surrounding lot with a building type, state > 1 or a unit and the same purpose -> false; else true.",
  "steps": [
    {"op": "ldev_world", "terrain_cells": [64, 64]},
    {"op": "ldev_tuning", "shipped": true},

    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_lot", "id": 1, "x": 0, "z": 0, "state": 3},
    {"op": "ldev_area_developed", "rect": [0, 0, 3, 3], "expect": false, "note": "slot 23 always false"},
    {"op": "ldev_area_developed", "lot": 1, "expect": false, "note": "slot 24 always false"},
    {"op": "ldev_terrain", "alt": [[1, 104]]},
    {"op": "ldev_dev_cost", "rect": [0, 0, 0, 0], "expect": 4, "note": "slot 32: slope 4.0 -> s 0.25 -> curve 4.499996 -> cost 4 (int64)"},
    {"op": "ldev_dev_cost", "rect": [2, 2, 2, 2], "expect": 0, "note": "a flat rectangle: cost 0"},

    {"op": "ldev_clear_lots", "note": "§5.7: PickUnitToJoin, industrial purpose 6"},
    {"op": "ldev_profile", "building": "0x6000", "purpose": 6, "wealth": 1},
    {"op": "ldev_occ", "id": 40, "is_building": true},
    {"op": "ldev_occ", "id": 41, "is_building": true},
    {"op": "ldev_lot", "id": 1, "x": 0, "z": 0, "state": 3, "building_type": "0x6000", "building": 40, "road": false},
    {"op": "ldev_lot", "id": 2, "x": 1, "z": 0, "state": 3, "building_type": "0x6000", "building": 41, "road": true,
      "note": "a candidate neighbour: same purpose, has a building, road access"},
    {"op": "ldev_surrounding", "lot": {"1": [2]}},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_clear_events"},
    {"op": "ldev_pick_unit", "lot": 1},
    {"op": "ldev_expect_draws", "draws": [["R2", 1, 0]], "note": "one candidate: Uniform(1) = 0"},
    {"op": "ldev_expect_lot", "lot": 1, "note": "joined a new unit (candidate 2 had none)"},
    {"op": "ldev_expect_events", "filter": {"event": "unit_create"}, "events": [{"event": "unit_create"}]},
    {"op": "ldev_expect", "unit_changed": true, "note": "purpose 6 (not 5): unitChanged is set"},

    {"op": "ldev_clear_lots", "note": "a lot that already has a unit draws nothing"},
    {"op": "ldev_unit", "id": 90, "members": [2]},
    {"op": "ldev_profile", "building": "0x6000", "purpose": 6, "wealth": 1},
    {"op": "ldev_lot", "id": 1, "x": 0, "z": 0, "state": 3, "building_type": "0x6000", "unit": 90},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_pick_unit", "lot": 1},
    {"op": "ldev_expect_draws", "draws": [], "note": "already has a unit: no draw"},

    {"op": "ldev_clear_lots", "note": "a residence (purpose 1) is not 5-8: no draw"},
    {"op": "ldev_profile", "building": "0x3001", "purpose": 1, "wealth": 1},
    {"op": "ldev_lot", "id": 1, "x": 0, "z": 0, "state": 3, "building_type": "0x3001"},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_pick_unit", "lot": 1},
    {"op": "ldev_expect_draws", "draws": []},

    {"op": "ldev_clear_lots", "note": "§5.7: NeedsAnchorBuilding"},
    {"op": "ldev_profile", "building": "0x6000", "purpose": 6, "wealth": 1},
    {"op": "ldev_occ", "id": 50, "is_building": true, "group": "0x3000"},
    {"op": "ldev_lot", "id": 1, "x": 0, "z": 0, "state": 3, "building_type": "0x6000", "building": 50},
    {"op": "ldev_surrounding", "in_rect": [1]},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_needs_anchor", "rect": [0, 0, 0, 0], "purpose": 1, "expect": false, "note": "purpose not 6-8"},
    {"op": "ldev_needs_anchor", "rect": [0, 0, 0, 0], "purpose": 6, "expect": true,
      "note": "a lot in the rectangle whose building is in group 0x3000 -> true"},

    {"op": "ldev_clear_lots", "note": "no anchor-group building, but a same-purpose neighbour with state > 1 -> false"},
    {"op": "ldev_occ", "id": 51, "is_building": true, "group": "0x1000"},
    {"op": "ldev_lot", "id": 1, "x": 0, "z": 0, "state": 3, "building_type": "0x6000", "building": 51},
    {"op": "ldev_surrounding", "in_rect": [], "rect": [1]},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_needs_anchor", "rect": [0, 0, 0, 0], "purpose": 6, "expect": false,
      "note": "the surrounding lot 1 has a building type, state > 1 and the same purpose -> false"},

    {"op": "ldev_clear_lots", "note": "no anchor building and no suitable neighbour -> true"},
    {"op": "ldev_surrounding", "in_rect": [], "rect": []},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},
    {"op": "ldev_needs_anchor", "rect": [0, 0, 0, 0], "purpose": 6, "expect": true}
  ]
}
