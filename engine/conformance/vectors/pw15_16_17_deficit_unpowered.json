{
  "format": 1,
  "name": "power_deficit_unpowered",
  "spec": ["power 6.6", "power 7.5", "power 15.16", "power 15.17"],
  "description": "Tests 16 and 17, by hand from 6.6 steps 5, 7, 8 and 7.5 step 3. State 3: deficit := production > consumption ? f32(int((production - consumption) / production)) : 0 -> 1000/500: int(500 / 1000) = 0 -> 0.0; consumption 0 -> int(1000 / 1000) = 1 -> 1.0; production 0 -> 0. Month: deficit := consumption > production > 0 ? the same expression : 0 -> 1000/2000: int(-1000 / 1000) = -1 -> -1.0; 1000/1500: int(-500 / 1000) = 0 -> 0.0; production 0 -> 0. Unpowered % (history 0xAA11FB59) = consumers > 0 ? trunc((1 - powered / consumers) x 100) : 0, no clamp, 24-bit: 4/3 -> 25; 3/2 -> 0.6666667, 0.3333333 x 100 = 33.33333 -> 33; 0 consumers -> 0; 4/5 -> -25. The unpowered count is max(0, consumers - powered): 1, 1, 0, 0.",
  "steps": [
    {"op": "power_create"},
    {"op": "power_init"},
    {"op": "power_message", "type": "ConnectionsReady"},
    {"op": "power_set", "state": {"state": 3, "production": 1000, "consumption": 500}},
    {"op": "power_idle", "expect_state": 4},
    {"op": "power_expect", "state": {"deficit": 0.0, "last_production": 1000, "last_consumption": 500}},
    {"op": "power_set", "state": {"state": 3, "production": 1000, "consumption": 0}},
    {"op": "power_idle"},
    {"op": "power_expect", "state": {"deficit": 1.0}},
    {"op": "power_set", "state": {"state": 3, "production": 0, "consumption": 0}},
    {"op": "power_idle"},
    {"op": "power_expect", "state": {"deficit": 0.0}},

    {"op": "power_set", "state": {"production": 1000, "consumption": 2000}},
    {"op": "power_message", "type": "SimNewMonth"},
    {"op": "power_expect", "state": {"deficit": -1.0, "recompute": true, "age_plants": true}},
    {"op": "power_set", "state": {"production": 1000, "consumption": 1500}},
    {"op": "power_message", "type": "SimNewMonth"},
    {"op": "power_expect", "state": {"deficit": 0.0}},
    {"op": "power_set", "state": {"production": 1000, "consumption": 1000, "deficit": 0.5}},
    {"op": "power_message", "type": "SimNewMonth"},
    {"op": "power_expect", "state": {"deficit": 0.0}},
    {"op": "power_set", "state": {"production": 0, "consumption": 1500, "deficit": 0.5}},
    {"op": "power_message", "type": "SimNewMonth"},
    {"op": "power_expect", "state": {"deficit": 0.0}},

    {"op": "power_clear_events"},
    {"op": "power_set", "state": {"state": 3, "consumers": 4, "powered": 3}},
    {"op": "power_idle"},
    {"op": "power_expect", "state": {"unpowered": 1}},
    {"op": "power_set", "state": {"state": 3, "consumers": 3, "powered": 2}},
    {"op": "power_idle"},
    {"op": "power_call", "method": "unpowered_consumer_count", "expect": 1},
    {"op": "power_set", "state": {"state": 3, "consumers": 0, "powered": 0}},
    {"op": "power_idle"},
    {"op": "power_expect", "state": {"unpowered": 0}},
    {"op": "power_set", "state": {"state": 3, "consumers": 4, "powered": 5}},
    {"op": "power_idle"},
    {"op": "power_expect", "state": {"unpowered": 0}},
    {"op": "power_expect_events", "filter": {"event": "history", "series": "0xAA11FB59"}, "events": [
      {"event": "history", "series": "0xAA11FB59", "value": 25},
      {"event": "history", "series": "0xAA11FB59", "value": 33},
      {"event": "history", "series": "0xAA11FB59", "value": 0},
      {"event": "history", "series": "0xAA11FB59", "value": -25}]}
  ]
}
