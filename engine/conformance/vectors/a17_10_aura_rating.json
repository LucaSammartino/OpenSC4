    {"op": "aura_expect_events", "events": [{"event": "history", "series": "0x0A5CBF37", "value": 12}]},
    {"op": "aura_expect", "state": {"mayor_rating": 12, "max_rating": 20, "max_location": [2, 2], "min_rating": -10, "min_location": [6, 2], "low_tracts": []}},
