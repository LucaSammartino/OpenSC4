{
  "format": 1,
  "name": "dispatch_tool",
  "spec": ["dispatch 4.7", "dispatch 12.10"],
  "description": "BeginDispatchTool(1) with one station of 3 units, mask 0b101: two pylons with call numbers base and base + 2; GetAvailablePylonCount(1) = 2 (0 for another type); BeginDispatchTool(1) again is true, of another type false; EndDispatchTool(0) is false, EndDispatchTool(1) true and the list is empty, the pylons released. Free units count only below 'count'.",
  "steps": [
    {"op": "dispatch_create"},
    {"op": "dispatch_init", "expect": true},
    {"op": "dispatch_source", "source": "0x500", "types": [1], "stations": [{"station": "0x600", "base": 1, "count": 3}]},
    {"op": "dispatch_clear_events"},
    {"op": "dispatch_source", "source": "0x500", "stations": [{"station": "0x600", "base": 1, "count": 3, "mask": 5}]},
    {"op": "dispatch_call", "method": "begin_dispatch_tool", "args": [1], "expect": true},
    {"op": "dispatch_expect", "state": {"tool_type": 1, "available_calls": [1, 3]}},
    {"op": "dispatch_call", "method": "get_available_pylon_count", "args": [1], "expect": 2},
    {"op": "dispatch_call", "method": "get_available_pylon_count", "args": [0], "expect": 0},
    {"op": "dispatch_call", "method": "begin_dispatch_tool", "args": [1], "expect": true},
    {"op": "dispatch_call", "method": "begin_dispatch_tool", "args": [0], "expect": false},
    {"op": "dispatch_call", "method": "end_dispatch_tool", "args": [0], "expect": false},
    {"op": "dispatch_call", "method": "end_dispatch_tool", "args": [1], "expect": true},
    {"op": "dispatch_expect", "state": {"tool_type": 8, "available_pylons": []}},
    {"op": "dispatch_expect_event_count", "filter": {"event": "pylon_shutdown"}, "count": 2},
    {"op": "dispatch_source", "source": "0x500", "stations": [{"station": "0x600", "base": 1, "count": 3, "mask": 255}]},
    {"op": "dispatch_call", "method": "get_available_pylon_count", "args": [1], "expect": 3}
  ]
}
