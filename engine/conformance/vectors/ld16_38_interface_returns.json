{
  "format": 1,
  "name": "lot_developer_interface_returns",
  "spec": ["lot-developer 11.1", "lot-developer 17", "lot-developer 16"],
  "description": "Test 38 (§17 interface returns), the parts the core decides; the register channels and pops (slot 42 has no defined return, slot 53 pops 8, slot 39 returns the address of orient) are interface properties checked by the plugin's ctest (seam op 52). Dry terrain flat at 100 except (1, 1) = 103 and (2, 2) = 104. Slot 18 reads an int32 cell rectangle: (1, 1, 1, 1) averages vertices (1..2, 1..2) = 407 / 4 = 101.75. Slot 19 returns the CALL count in EAX, not 0/1 (four forced calls on a 3 x 3 rectangle, two of which write nothing). Slot 20 LevelBorderingVertices(rect, h, unused, lot) returns ModifyTerrainHeight's EAX, the number of vertices written: (0, 0, 1, 1) at h = 100 writes (1, 1) and (2, 2) -> 2; again -> 0, and no redisplay. Slot 21 returns ModifyTerrainHeight's EAX too: in area mode with a locked lot other than the exempt one in Q, the count n is returned although nothing is written [quirk §17.3]. Slot 61 UpdateLotFoundation returns without any call when the lot's flags have neither bit 0 nor bit 1 (AL is then the flags' low byte, no defined value: 0 for flags 0, non-zero for flags 4).",
  "steps": [
    {"op": "ldev_terrain", "flat": 100, "vertex": [[1, 1, 103], [2, 2, 104]]},
    {"op": "ldev_lot", "id": 1, "x": 0, "z": 0, "w": 2, "h": 2, "state": 2},
    {"op": "ldev_create", "seed": 12345},
    {"op": "ldev_init", "expect": true},

    {"op": "ldev_area_altitude", "rect": [1, 1, 1, 1], "water": true, "average": true, "expect": 101.75},
    {"op": "ldev_area_altitude", "rect": [0, 0, 1, 1], "water": true, "average": true, "expect": 100.77778},

    {"op": "ldev_clear_events"},
    {"op": "ldev_level_internal", "rect": [0, 0, 3, 3], "target": 100, "skip_water": false, "force": true, "lot": 1, "expect": 9,
      "note": "nine interior vertices (1..3, 1..3), one call each; only two are written"},
    {"op": "ldev_expect_event_count", "filter": {"event": "modify_terrain"}, "count": 9},
    {"op": "ldev_expect_event_count", "filter": {"event": "set_altitude"}, "count": 2},
    {"op": "ldev_clear_events"},
    {"op": "ldev_level_internal", "rect": [0, 0, 3, 3], "target": 100, "skip_water": false, "force": true, "lot": 1, "expect": 9,
      "note": "nothing left to write: still the call count"},
    {"op": "ldev_expect_event_count", "filter": {"event": "set_altitude"}, "count": 0},
    {"op": "ldev_clear_events"},

    {"op": "ldev_terrain", "vertex": [[1, 1, 103], [2, 2, 104]]},
    {"op": "ldev_level_bordering", "rect": [0, 0, 1, 1], "h": 100, "lot": 1, "expect": 2},
    {"op": "ldev_expect_events", "events": [
      {"event": "modify_terrain", "per_vertex": true, "rect": [0, 0, 2, 2], "h": 100, "exempt": 1},
      {"event": "set_altitude", "x": 1, "z": 1, "h": 100},
      {"event": "set_altitude", "x": 2, "z": 2, "h": 100},
      {"event": "redisplay", "rect": [0, 0, 3, 3], "reason": 5}]},
    {"op": "ldev_level_bordering", "rect": [0, 0, 1, 1], "h": 100, "lot": 1, "expect": 0},
    {"op": "ldev_expect_events", "events": [
      {"event": "modify_terrain", "per_vertex": true, "rect": [0, 0, 2, 2], "h": 100, "exempt": 1}]},

    {"op": "ldev_terrain", "vertex": [[1, 1, 103], [2, 2, 104]]},
    {"op": "ldev_lot", "id": 2, "x": 2, "z": 2, "w": 1, "h": 1, "state": 3, "locked": true, "order": false},
    {"op": "ldev_attempt_levelling", "rect": [0, 0, 1, 1], "water": true, "per_vertex": false, "max_slope": "flt_max", "lot": 1, "expect": 9,
      "note": "area mode: n = 9 vertices differ by more than 0.05 from 100.77778; lot 2 in Q is locked, so nothing is written"},
    {"op": "ldev_expect_events", "events": [
      {"event": "modify_terrain", "per_vertex": false, "rect": [0, 0, 2, 2], "h": 100.77778, "exempt": 1}]},
    {"op": "ldev_expect_terrain", "vertex": [[1, 1, 103], [2, 2, 104], [0, 0, 100]]},
    {"op": "ldev_attempt_levelling", "rect": [0, 0, 1, 1], "water": true, "per_vertex": false, "max_slope": "flt_max", "lot": 2, "expect": 9,
      "note": "the locked lot is the exempt one: written"},
    {"op": "ldev_expect_events", "events": [
      {"event": "modify_terrain", "per_vertex": false, "rect": [0, 0, 2, 2], "h": 100.77778, "exempt": 2},
      {"event": "set_altitude_rect", "rect": [0, 0, 2, 2], "h": 100.77778, "reason": 5},
      {"event": "redisplay", "rect": [0, 0, 2, 2], "reason": 5}]},

    {"op": "ldev_cfg", "id": 9, "w": 1, "h": 1, "primary_foundation": ["0xA0000001", "0xA0000002"]},
    {"op": "ldev_lot", "id": 3, "x": 20, "z": 20, "state": 3, "cfg": 9, "flags": 0},
    {"op": "ldev_update_lot_foundation", "lot": 3, "expect": false},
    {"op": "ldev_lot", "id": 3, "flags": 4},
    {"op": "ldev_update_lot_foundation", "lot": 3, "expect": true, "note": "the flags' low byte, non-zero"},
    {"op": "ldev_lot", "id": 3, "flags": 256},
    {"op": "ldev_update_lot_foundation", "lot": 3, "expect": false, "note": "low byte 0"},
    {"op": "ldev_expect_events", "events": []},
    {"op": "ldev_expect_draws", "draws": []},
    {"op": "ldev_expect_lot", "lot": 3, "flags": 256}
  ]
}
