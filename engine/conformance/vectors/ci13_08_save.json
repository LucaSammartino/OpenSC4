{
  "format": 1,
  "name": "commercial_save",
  "spec": ["commercial-industrial 8.1", "commercial-industrial 8.2", "commercial-industrial 13.8"],
  "description": "Commercial record: u16 version 1, u8 flag, the CO$$ then the CO$$$ grid reference (object IDs 1 and 2, class 0x49B9E602): 19 bytes. write -> read -> write is byte-identical; the state is not saved (it stays 3). The flag is 1 when dirty or state != 3. Version 2 is rejected and changes nothing; after reading flag 1 the first DoIdle starts a rebuild, after flag 0 it does nothing. Null grids are written as 4-byte null references. Industrial: writes 01 00, reads it back, rejects version 2 and a truncated record.",
  "steps": [
    {"op": "commercial_env", "cells": 8},
    {"op": "commercial_create"},
    {"op": "commercial_set", "dirty": false},
    {"op": "commercial_write", "expect": true, "hex": "01 00 00 00 00 00 00 00 00 00 00"},
    {"op": "commercial_init", "expect": true},
    {"op": "commercial_set", "dirty": true},
    {"op": "commercial_write", "slot": "a", "expect": true, "length": 19,
      "hex": "01 00 01 01 00 00 00 02 E6 B9 49 02 00 00 00 02 E6 B9 49"},
    {"op": "commercial_read", "slot": "a", "expect": true},
    {"op": "commercial_expect", "state": {"dirty": true, "state": 3, "co2": "0x89D5B788", "co3": "0x89D5B6EF", "initialized": false}},
    {"op": "commercial_write", "slot": "b", "expect": true},
    {"op": "commercial_expect_record", "slot": "b", "same_as": "a"},
    {"op": "commercial_idle"},
    {"op": "commercial_expect", "state": {"dirty": false, "state": 0}},

    {"op": "commercial_set", "dirty": false, "state": 3},
    {"op": "commercial_write", "expect": true, "hex": "01 00 00 01 00 00 00 02 E6 B9 49 02 00 00 00 02 E6 B9 49"},
    {"op": "commercial_set", "state": 0},
    {"op": "commercial_write", "expect": true, "hex": "01 00 01 01 00 00 00 02 E6 B9 49 02 00 00 00 02 E6 B9 49"},
    {"op": "commercial_set", "state": 1},
    {"op": "commercial_write", "expect": true, "hex": "01 00 01 01 00 00 00 02 E6 B9 49 02 00 00 00 02 E6 B9 49"},
    {"op": "commercial_set", "state": 2},
    {"op": "commercial_write", "slot": "f0", "expect": true, "hex": "01 00 01 01 00 00 00 02 E6 B9 49 02 00 00 00 02 E6 B9 49"},
    {"op": "commercial_set", "state": 3},
    {"op": "commercial_write", "slot": "f0", "expect": true},

    {"op": "commercial_read", "slot": "a", "version": 2, "expect": false},
    {"op": "commercial_expect", "state": {"co2": null, "co3": null, "dirty": true}},
    {"op": "commercial_read", "slot": "f0", "expect": true},
    {"op": "commercial_expect", "state": {"dirty": false}},
    {"op": "commercial_idle"},
    {"op": "commercial_expect", "state": {"dirty": false, "state": 3}},
    {"op": "commercial_read", "hex": "01 00 01 00 00 00 00 00 00 00 00", "reuse": true, "expect": true},
    {"op": "commercial_expect", "state": {"co2": null, "co3": null, "dirty": true}},

    {"op": "industrial_create"},
    {"op": "industrial_write", "slot": "i", "expect": true, "hex": "01 00"},
    {"op": "industrial_read", "slot": "i", "expect": true},
    {"op": "industrial_read", "hex": "02 00", "expect": false},
    {"op": "industrial_read", "hex": "01", "expect": false},
    {"op": "industrial_init", "expect": true},
    {"op": "industrial_expect", "state": {"initialized": true}},
    {"op": "industrial_message", "type": "SimIdle", "expect": true},
    {"op": "industrial_shutdown", "expect": true},
    {"op": "industrial_add_ref", "expect": 1},
    {"op": "industrial_add_ref", "expect": 2},
    {"op": "industrial_release", "expect": 1},
    {"op": "industrial_release", "expect": 0},
    {"op": "industrial_expect", "state": {"destroyed": true, "initialized": false}}
  ]
}
