{
  "format": 1,
  "name": "prop_profile_defaults",
  "spec": ["prop-lotconfig A3.2", "prop-lotconfig A6.1", "prop-lotconfig T1"],
  "description": "A prop exemplar with ExemplarType 0x1E and no other property is catalogued under its instance with the default profile (class 0x2977AA47, everything else 0); CreateProp makes a plain prop occupant (the class has no GZCOM instance) with that prop type and the default box (0,0,0)-(1,1,1). With OccupantSize (2, 6, 3) the box and profile +0x04..+0x0C follow the size. Tokens of created props start at 0x1000.",
  "steps": [
    {"op": "pm_exemplar", "instance": "0x1234"},
    {"op": "pm_exemplar", "instance": "0x1235", "size": [2, 6, 3]},
    {"op": "pm_create"},
    {"op": "pm_init", "expect": true},
    {"op": "pm_call", "method": "is_prop_type_valid", "args": ["0x1234"], "expect": true},
    {"op": "pm_call", "method": "prop_profile_ptr", "args": ["0x1234"], "expect": {"class": "0x2977AA47", "size": [0, 0, 0], "satisfaction": 0, "wealth": 0, "crime": 0}},
    {"op": "pm_call", "method": "create_prop", "args": ["0x1234"], "expect": "0x1000"},
    {"op": "pm_expect_occupant", "occupant": "0x1000", "state": {"builtin": "plain", "prop_type": "0x1234", "bbox": [[0, 0, 0], [1, 1, 1]]}},
    {"op": "pm_call", "method": "prop_profile_ptr", "args": ["0x1235"], "expect": {"class": "0x2977AA47", "size": [2, 6, 3], "satisfaction": 0, "wealth": 0, "crime": 0}},
    {"op": "pm_call", "method": "create_prop", "args": ["0x1235"], "expect": "0x1001"},
    {"op": "pm_expect_occupant", "occupant": "0x1001", "state": {"builtin": "plain", "prop_type": "0x1235", "bbox": [[0, 0, 0], [2, 6, 3]]}},
    {"op": "pm_expect_refs", "refs": {"0x1000": 1, "0x1001": 1}}
  ]
}
