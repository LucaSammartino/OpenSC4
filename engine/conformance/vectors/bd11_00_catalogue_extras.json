{
  "format": 1,
  "name": "bds_catalogue_extras",
  "spec": ["building-development 4.7.1", "building-development 4.7.2", "building-development 4.7.3"],
  "description": "Catalogue loading and lookups, by hand from 4.7.1-4.7.3. Building 0x100 (group 0x1000_0000, exemplar name 'R1', localized 'Small House', purpose 1, wealth 2, capacity 12, family 0x7000); building 0x200 (no name properties, property 0x899AFBAD 'Fallback', wealth 7 -> 0 (outside 0-3), purpose 2); building 0x300 (no names, purpose missing -> 0); a second exemplar for 0x100 in group 0x1000_0001 (purpose 3, wealth 3, capacity for 0x3330 = 40, family 0x7000 again): its key replaces the first, its profile and names replace the first ('' for the missing names), and 0x100 is appended to 0x7000 again ([inferred]) -> GetBuildingTypesByFamily(F) = [0x100, 0x100], 2. Foundation 0x500 and retaining wall 0x600 are stored by instance with their keys; GetBuildingKeyFromType of a foundation is none. The post carries 3 buildings (the duplicate counts once). GetBuildingMapKey(type) uses the profile: 0x100 -> 4*3 + 3 + 1 = 16, 0x200 -> 4*2 + 0 + 1 = 9; for an unknown type it inserts a zero profile (key 1), after which GetBuildingProfilePtr finds it [compat]. GetWealth and GetDeveloperType are the 4.7.3 tables.",
  "steps": [
    {"op": "bds_process", "seed": 1},
    {"op": "bds_exemplars", "list": [
      {"building": "0x100", "purpose": 1, "wealth": 2, "capacity": 12, "families": ["0x7000"], "name": "R1", "localized": "Small House"},
      {"building": "0x200", "purpose": 2, "wealth": 7, "props": {"0x899AFBAD": {"str": "Fallback"}}},
      {"instance": "0x300", "group": "0x10000000", "props": {"0x10": {"u32": 2}, "0x27812832": {"u8": 1}}},
      {"foundation": "0x500"},
      {"wall": "0x600"},
      {"building": "0x100", "group": "0x10000001", "purpose": 3, "wealth": 3, "capacity": 40, "families": ["0x7000"]}]},
    {"op": "bds_create"},
    {"op": "bds_init", "expect": true},
    {"op": "bds_expect_events", "filter": {"event": "post"}, "events": [{"type": "0xA783EBC8", "data2": 3}]},
    {"op": "bds_expect", "state": {"building_count": 3}},
    {"op": "bds_call", "method": "building_key", "args": ["0x100"], "expect": ["0x6534284A", "0x10000001", "0x100"]},
    {"op": "bds_call", "method": "building_key", "args": ["0x500"], "expect": null},
    {"op": "bds_call", "method": "foundation_key", "args": ["0x500"], "expect": ["0x6534284A", "0x20000000", "0x500"]},
    {"op": "bds_call", "method": "foundation_key", "args": ["0x600"], "expect": null},
    {"op": "bds_call", "method": "wall_key", "args": ["0x600"], "expect": ["0x6534284A", "0x30000000", "0x600"]},
    {"op": "bds_call", "method": "profile", "args": ["0x100"], "expect": {"purpose": 3, "wealth": 3, "capacity": 40, "size": [0, 0, 0]}},
    {"op": "bds_call", "method": "profile", "args": ["0x200"], "expect": {"purpose": 2, "wealth": 0, "capacity": 0, "size": [0, 0, 0]}},
    {"op": "bds_call", "method": "profile", "args": ["0x300"], "expect": {"purpose": 0, "wealth": 1, "capacity": 0, "size": [0, 0, 0]}},
    {"op": "bds_call", "method": "exemplar_name", "args": ["0x100"], "expect": ""},
    {"op": "bds_call", "method": "building_name", "args": ["0x100"], "expect": ""},
    {"op": "bds_call", "method": "building_name", "args": ["0x200"], "expect": "Fallback"},
    {"op": "bds_call", "method": "exemplar_name", "args": ["0x200"], "expect": ""},
    {"op": "bds_call", "method": "exemplar_name", "args": ["0x999"], "expect": ""},
    {"op": "bds_call", "method": "types_by_family", "args": ["0x7000"], "expect": {"count": 2, "vector": [256, 256]}},
    {"op": "bds_call", "method": "all_foundation_types", "expect": {"count": 1, "vector": [1280]}},
    {"op": "bds_call", "method": "all_wall_types", "expect": {"count": 1, "vector": [1536]}},

    {"op": "bds_call", "method": "map_key_of_type", "args": ["0x100"], "expect": 16},
    {"op": "bds_call", "method": "map_key_of_type", "args": ["0x200"], "expect": 9},
    {"op": "bds_call", "method": "profile_ptr", "args": ["0x888"], "expect": null},
    {"op": "bds_call", "method": "map_key_of_type", "args": ["0x888"], "expect": 1},
    {"op": "bds_call", "method": "profile_ptr", "args": ["0x888"], "expect": {"purpose": 0, "wealth": 0, "capacity": 0, "size": [0, 0, 0]}},
    {"op": "bds_call", "method": "is_building_type_valid", "args": ["0x888"], "expect": false},
    {"op": "bds_call", "method": "map_key", "args": [8, 3], "expect": 36},

    {"op": "bds_call", "method": "wealth", "args": ["0x3320"], "expect": 2},
    {"op": "bds_call", "method": "wealth", "args": ["0x4400"], "expect": 3},
    {"op": "bds_call", "method": "wealth", "args": ["0x4100"], "expect": 1},
    {"op": "bds_call", "method": "wealth", "args": ["0x3310"], "expect": 0},
    {"op": "bds_call", "method": "developer_type", "args": [3, 1], "expect": 0},
    {"op": "bds_call", "method": "developer_type", "args": [7, 0], "expect": "0x4300"},
    {"op": "bds_call", "method": "developer_type", "args": [4, 2], "expect": 0},
    {"op": "bds_call", "method": "developer_type", "args": [1, 0], "expect": 0}
  ]
}
